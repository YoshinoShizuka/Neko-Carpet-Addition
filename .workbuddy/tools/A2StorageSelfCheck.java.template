package neko.voidwarehouse;

import net.minecraft.nbt.CompoundTag;
import net.minecraft.nbt.IntTag;
import net.minecraft.nbt.ListTag;
import net.minecraft.nbt.NbtAccounter;
import net.minecraft.nbt.NbtIo;
import net.minecraft.nbt.NbtOps;
import net.minecraft.nbt.Tag;
import net.minecraft.server.MinecraftServer;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;

import java.math.BigInteger;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;

/**
 * 【临时自检】A2 存储格式（配方本逐条拆分）的真服务端验收，跑完删除。
 *
 * <h2>它要回答的问题</h2>
 * <p>「配方本能不能超过 975 条」这件事，<b>只有真写盘再读回来才算数</b>。
 * 之前 2048 条之所以判死，不是因为内存里放不下，而是因为写盘时被
 * {@code NbtIo$StringFallbackDataOutput} 把内容悄悄换成空串 —— 那种失败
 * 在「内存对象」层面完全看不出来，必须过 {@code NbtIo.writeCompressed} + 读回。</p>
 *
 * <h2>为什么用全新的 VoidWarehouseData 而不是世界存档里那一个</h2>
 * <p>世界存档里可能已经有若干条配方（上一轮跑测试留下的、或者服主自己学的），
 * 那样「学满 2048 条」就会在上限处提前撞墙，<b>具体哪一条最后被收下取决于存档现状</b>，
 * 断言变成不可重复的。所以这里造一个干净的实例：同一份代码路径
 * （{@code learn → recipeTexts → recipeTextsLines → CODEC → NbtIo}）跑得一模一样，
 * 但结果确定。顺带也不会把 2048 条垃圾配方写进测试世界。</p>
 *
 * <h2>判据</h2>
 * <p>看日志末行 {@code A2 RESULT ... failures=0}。注意 {@code runServer} 崩服也返回
 * {@code EXIT=0}，所以<b>不能</b>拿退出码当判据。</p>
 */
public final class A2StorageSelfCheck {

    /** 学多少条。这是「原上限 512」的 4 倍，也是历史天花板 975 的两倍多 */
    private static final int TARGET = 2048;

    /** 历史天花板：单字符串格式下实测能存住的最大条数 */
    private static final int LEGACY_CEILING = 975;

    private static final int WAIT_TICKS = 5;

    private static boolean done;
    private static int tickIndex;
    private static int checks;
    private static int failures;
    private static final List<String> failedLabels = new ArrayList<>();
    private static long sink;

    private A2StorageSelfCheck() {
    }

    public static void run(MinecraftServer server) {
        if (done) {
            return;
        }
        if (++tickIndex < WAIT_TICKS) {
            return;
        }
        try {
            step(server);
        } catch (Throwable t) {
            failures++;
            failedLabels.add("抛异常: " + t);
            System.out.println("!! [A2] 抛异常: " + t);
            t.printStackTrace(System.out);
        }
        finish(server);
    }

    private static void step(MinecraftServer server) throws Exception {
        // 规则必须开，否则 learn() 直接返回 false（它按设计就是「规则关着就不往存档里长东西」）
        VoidWarehouseSettings.voidWarehouse = true;
        VoidWarehouseSettings.voidWarehouseCraft = true;

        // 只用来确认「接线是通的」，后面所有断言都用干净实例，不碰它
        check("A0 世界存档能拿到", VoidWarehouse.data(server) != null);

        VoidWarehouseData fresh = new VoidWarehouseData();
        fresh.insert(new ItemStack(Items.COBBLESTONE, 5));

        // ---------------------------------------------------------- 学满
        long t0 = System.nanoTime();
        int lastAccepted = -1;
        for (int i = 0; i < TARGET; i++) {
            if (fresh.learn(recipe(i))) {
                lastAccepted = i;
            }
        }
        long learnMs = (System.nanoTime() - t0) / 1_000_000L;
        check("A1 学满 " + TARGET + " 条", fresh.learnedRecipeCount() == TARGET);
        check("A1 最后收下的是第 " + TARGET + " 条", lastAccepted == TARGET - 1);
        System.out.println("   学满耗时 " + learnMs + " ms，最后收下 test:item_" + lastAccepted);

        // 第 TARGET+1 条必须被上限挡住，而不是悄悄塞进去
        check("A2 第 " + (TARGET + 1) + " 条被上限拒绝", !fresh.learn(recipe(TARGET)));
        check("A2 条数没被撑破", fresh.learnedRecipeCount() == TARGET);

        // ---------------------------------------------------------- 编码形状
        CompoundTag tag = (CompoundTag) VoidWarehouseData.CODEC
                .encodeStart(NbtOps.INSTANCE, fresh).result().orElse(null);
        check("A3 编码成功", tag != null);
        if (tag == null) {
            return;
        }
        check("A3 不再写老键 learned_recipes", !tag.contains("learned_recipes"));
        check("A3 写了新键 learned_recipes_lines", tag.contains("learned_recipes_lines"));
        Tag rawLines = tag.get("learned_recipes_lines");
        check("A3 新键是 ListTag", rawLines instanceof ListTag);
        ListTag lines = rawLines instanceof ListTag list ? list : new ListTag();
        check("A3 元素数 = " + TARGET, lines.size() == TARGET);
        System.out.println("   落盘键: " + tag.keySet());

        // ---------------------------------------------------------- 真写盘 → 读回（核心）
        Path file = Path.of(System.getProperty("java.io.tmpdir"), "nca_a2_selfcheck.dat");
        NbtIo.writeCompressed(tag, file);
        long onDisk = Files.size(file);
        CompoundTag readBack = NbtIo.readCompressed(file, NbtAccounter.unlimitedHeap());
        VoidWarehouseData back = VoidWarehouseData.CODEC
                .parse(NbtOps.INSTANCE, readBack).result().orElse(null);
        check("A4 读回成功", back != null);
        check("A4 读回 " + TARGET + " 条（这是核心）", back != null && back.learnedRecipeCount() == TARGET);
        check("A4 抽查第 1 条", back != null && back.hasRecipeFor("test:item_0"));
        check("A4 抽查最后一条", back != null && back.hasRecipeFor("test:item_" + lastAccepted));
        check("A4 物品没被牵连（圆石 5 个）",
                back != null && back.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(5)));
        System.out.println("   文件落盘 " + onDisk + " 字节（未压缩 "
                + uncompressedSize(tag) + " 字节，压缩比 "
                + String.format("%.1f", uncompressedSize(tag) / (double) onDisk) + ":1）");

        // ---------------------------------------------------------- 坏元素容忍
        // 这才是必须自写 codec 的理由：Codec.STRING.listOf() 遇到它整体失败
        ListTag polluted = new ListTag();
        for (int i = 0; i < lines.size(); i++) {
            polluted.add(i == 0 ? IntTag.valueOf(1) : lines.get(i));
        }
        CompoundTag pollutedTag = readBack.copy();
        pollutedTag.put("learned_recipes_lines", polluted);
        VoidWarehouseData tolerant = VoidWarehouseData.CODEC
                .parse(NbtOps.INSTANCE, pollutedTag).result().orElse(null);
        check("A5 有一个坏元素时仍然解码成功", tolerant != null);
        check("A5 只少了那一条", tolerant != null && tolerant.learnedRecipeCount() == TARGET - 1);
        check("A5 其余条目没受影响", tolerant != null && tolerant.hasRecipeFor("test:item_1"));
        check("A5 物品也没受影响",
                tolerant != null && tolerant.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(5)));
        if (tolerant != null) {
            sink += tolerant.learnedRecipeCount();
        }

        // ---------------------------------------------------------- 老存档兼容
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < LEGACY_CEILING; i++) {
            if (i > 0) {
                sb.append('\n');
            }
            sb.append(recipe(i).recipeId());
        }
        CompoundTag legacyTag = new CompoundTag();
        legacyTag.putString("learned_recipes", sb.toString());
        VoidWarehouseData legacy = VoidWarehouseData.CODEC
                .parse(NbtOps.INSTANCE, legacyTag).result().orElse(null);
        check("A6 老存档（单字符串）读得出来", legacy != null);
        check("A6 老存档 " + LEGACY_CEILING + " 条一条不少",
                legacy != null && legacy.learnedRecipeCount() == LEGACY_CEILING);

        // ---------------------------------------------------------- 老档升级后只写新键
        CompoundTag upgraded = (CompoundTag) VoidWarehouseData.CODEC
                .encodeStart(NbtOps.INSTANCE, legacy).result().orElse(null);
        check("A7 升级后不写老键", upgraded != null && !upgraded.contains("learned_recipes"));
        check("A7 升级后写了新键", upgraded != null && upgraded.contains("learned_recipes_lines"));
        if (upgraded != null) {
            Path file2 = Path.of(System.getProperty("java.io.tmpdir"), "nca_a2_upgraded.dat");
            NbtIo.writeCompressed(upgraded, file2);
            CompoundTag back2 = NbtIo.readCompressed(file2, NbtAccounter.unlimitedHeap());
            VoidWarehouseData migrated = VoidWarehouseData.CODEC
                    .parse(NbtOps.INSTANCE, back2).result().orElse(null);
            check("A7 升级后的存档再写再读仍是 " + LEGACY_CEILING + " 条",
                    migrated != null && migrated.learnedRecipeCount() == LEGACY_CEILING);
            check("A7 升级后抽查第一条", migrated != null && migrated.hasRecipeFor("test:item_0"));
        }

        // ---------------------------------------------------------- 空配方本不产生垃圾键
        CompoundTag emptyTag = (CompoundTag) VoidWarehouseData.CODEC
                .encodeStart(NbtOps.INSTANCE, new VoidWarehouseData()).result().orElse(null);
        check("A8 空配方本不写 learned_recipes_lines",
                emptyTag != null && !emptyTag.contains("learned_recipes_lines"));
        check("A8 空配方本也不写老键",
                emptyTag != null && !emptyTag.contains("learned_recipes"));
        System.out.println("   空对象落盘键: " + (emptyTag == null ? "-" : emptyTag.keySet()));
    }

    /**
     * NBT 编码后的真实字节数（未压缩）。
     *
     * <p>不要用 {@code ListTag.sizeInBytes()}：那个数的是<b>JVM 堆内存估算</b>
     * （含对象头，单个 {@code StringTag} 就报 36 字节以上），拿来算压缩比会差三倍。</p>
     */
    private static int uncompressedSize(CompoundTag tag) throws java.io.IOException {
        java.io.ByteArrayOutputStream buf = new java.io.ByteArrayOutputStream();
        NbtIo.write(tag, new java.io.DataOutputStream(buf));
        return buf.size();
    }

    private static VoidWarehouseRecipes.Recipe recipe(int i) {
        return new VoidWarehouseRecipes.Recipe(null, "test:item_" + i, 1,
                List.of(new VoidWarehouseRecipes.Part(List.of("minecraft:stone"), 1)));
    }

    private static void finish(MinecraftServer server) {
        done = true;
        System.out.println("---- 失败清单 ----");
        if (failedLabels.isEmpty()) {
            System.out.println("   （无）");
        } else {
            for (String s : failedLabels) {
                System.out.println("   x " + s);
            }
        }
        System.out.println("A2 RESULT checks=" + checks + " failures=" + failures + " sink=" + sink);
        server.halt(false);
    }

    private static void check(String label, boolean ok) {
        checks++;
        if (!ok) {
            failures++;
            failedLabels.add(label);
        }
        System.out.println("   " + (ok ? "ok  " : "FAIL") + " " + label);
    }
}
