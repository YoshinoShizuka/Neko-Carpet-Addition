    private static void finish(MinecraftServer server) {
        System.out.println("---- 失败清单 ----");
        if (failedLabels.isEmpty()) {
            System.out.println("   （无）");
        } else {
            for (String label : failedLabels) {
                System.out.println("   x " + label);
            }
        }
        System.out.println("A2S RESULT checks=" + checks + " failures=" + failures
                + " kneeScale=" + kneeScale + " mainScale=" + mainScale + " sink=" + sink);
        server.halt(false);
    }

    private static void check(String label, boolean ok) {
        checks++;
        if (!ok) {
            failures++;
            failedLabels.add(label);
        }
        System.out.println("   " + (ok ? "ok  " : "FAIL") + " " + label);
    }

    // ============================================================ F 组工具：复刻宽松上界
    //
    // 这三段是 VoidWarehouseRecipes#boundCap / #availOf / #forcedDemand 的**逐行复刻**，
    // 原方法是 private，压测只能用公共 API 拼回来。复刻的正确性由 F1 那条自洽断言兜底：
    // 只要「cap − 已退让 < 64」在所有成功样本上都成立，就说明这里算的上界与产品里那个是同一个数。
    //
    // 任何一个细节走样（cache 共享范围、path 是否每次新建、budget 消耗顺序）都会让上界偏大或偏小，
    // F1 会当场掉下来 —— 所以这段代码是「可证伪」的，不是凭感觉抄的。

    /** 复刻 maxCraftable 里「估一个宽松上界」的那一段。返回**合成次数**，不是成品个数。 */
    private static BigInteger capOf(VoidWarehouseRecipes.Recipe recipe, Map<String, BigInteger> stock,
                                    Map<String, List<VoidWarehouseRecipes.Recipe>> byOutput) {
        Map<String, BigInteger> cache = new HashMap<>();
        int[] budget = new int[]{512};   // == VoidWarehouseRecipes.MAX_NODES
        return boundCapOf(recipe.parts(),
                id -> availOfProbe(id, stock, byOutput, cache, new LinkedHashSet<>(), 0, budget));
    }

    /** 复刻 boundCap：单候选按物品合并后相除取 min，多候选各自相除取 max 再取 min。 */
    private static BigInteger boundCapOf(List<VoidWarehouseRecipes.Part> parts,
                                         java.util.function.Function<String, BigInteger> avail) {
        Map<String, Integer> forced = new HashMap<>();
        for (VoidWarehouseRecipes.Part part : parts) {
            if (part.candidates().size() == 1) {
                forced.merge(part.candidates().get(0), part.count(), Integer::sum);
            }
        }
        BigInteger cap = null;
        for (Map.Entry<String, Integer> entry : forced.entrySet()) {
            BigInteger each = avail.apply(entry.getKey())
                    .divide(BigInteger.valueOf(entry.getValue()));
            if (cap == null || each.compareTo(cap) < 0) {
                cap = each;
            }
        }
        for (VoidWarehouseRecipes.Part part : parts) {
            if (part.candidates().size() <= 1) {
                continue;
            }
            BigInteger best = BigInteger.ZERO;
            for (String candidate : part.candidates()) {
                BigInteger each = avail.apply(candidate)
                        .divide(BigInteger.valueOf(part.count()));
                if (each.compareTo(best) > 0) {
                    best = each;
                }
            }
            if (cap == null || best.compareTo(cap) < 0) {
                cap = best;
            }
        }
        return cap;
    }

    /** 复刻 availOf：「家里有的 + 全部拿去做能做出的」——明知共享原料会重复计数。 */
    private static BigInteger availOfProbe(String item, Map<String, BigInteger> stock,
                                           Map<String, List<VoidWarehouseRecipes.Recipe>> byOutput,
                                           Map<String, BigInteger> cache, Set<String> path,
                                           int depth, int[] budget) {
        BigInteger cached = cache.get(item);
        if (cached != null) {
            return cached;
        }
        BigInteger base = stock.getOrDefault(item, BigInteger.ZERO);
        if (depth >= VoidWarehouseRecipes.MAX_DEPTH || path.contains(item) || --budget[0] < 0) {
            return base;
        }
        List<VoidWarehouseRecipes.Recipe> subs = byOutput.get(item);
        if (subs == null || subs.isEmpty()) {
            cache.put(item, base);
            return base;
        }
        BigInteger bestMade = BigInteger.ZERO;
        path.add(item);
        try {
            for (VoidWarehouseRecipes.Recipe sub : subs) {
                BigInteger cap = boundCapOf(sub.parts(),
                        id -> availOfProbe(id, stock, byOutput, cache, path, depth + 1, budget));
                if (cap == null) {
                    continue;
                }
                bestMade = bestMade.max(cap.multiply(BigInteger.valueOf(sub.outputCount())));
            }
        } finally {
            path.remove(item);
        }
        BigInteger total = base.add(bestMade);
        cache.put(item, total);
        return total;
    }

    /**
     * 用 {@code plan()} 当真值探针，二分出「最多能取几个成品」。
     *
     * <p>为什么拿 plan 当探针：它只跑<b>一次</b> simulate，口径与真正执行扣料完全一致，
     * 所以「plan 能成」＝「点下去真能拿到」。二分的前提是「能做 k 个」对 k 单调
     * （做得越多越难），这一点由 simulate 的语义保证；万一某个贪心分支跳变，
     * 二分只会低估真值、不会高估 —— 而低估会让 need 偏大，方向上是保守的。</p>
     */
    private static long trueMaxOut(VoidWarehouseRecipes.Recipe recipe, Map<String, BigInteger> stock,
                                   Map<String, List<VoidWarehouseRecipes.Recipe>> byOutput, long hi) {
        long lo = 0;
        while (lo < hi) {
            long mid = lo + (hi - lo + 1) / 2;
            if (VoidWarehouseRecipes.plan(recipe, BigInteger.valueOf(mid), stock, byOutput) != null) {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        return lo;
    }
