    private static void buildBots(MinecraftServer server) {
        for (int i = 0; i < BOT_COUNT; i++) {
            GameProfile profile = new GameProfile(UUID.randomUUID(), "a2sbot" + i);
            ServerPlayer p = new ServerPlayer(server, level, profile, zhInfo());
            try {
                Connection conn = new Connection(PacketFlow.SERVERBOUND);
                p.connection = new ServerGamePacketListenerImpl(server, conn, p,
                        CommonListenerCookie.createInitial(profile, false));
                fakeConnection = true;
            } catch (Throwable t) {
                fakeConnection = false;
            }
            bots.add(p);
        }
        GameProfile enProfile = new GameProfile(UUID.randomUUID(), "a2sbot-en");
        enBot = new ServerPlayer(server, level, enProfile, enInfo());
        try {
            Connection conn = new Connection(PacketFlow.SERVERBOUND);
            enBot.connection = new ServerGamePacketListenerImpl(server, conn, enBot,
                    CommonListenerCookie.createInitial(enProfile, false));
        } catch (Throwable ignored) {
            // 双语组只断言 isEnglish
        }
    }

