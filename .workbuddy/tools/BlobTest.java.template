// A1 容器往返/边界/损坏输入测试（53 断言）
// 跑法（不需要 Minecraft）：
//   mkdir -p /c/tmp/blobtest/neko/voidwarehouse && cd /c/tmp/blobtest
//   cp WarehouseBlob.java.template neko/voidwarehouse/WarehouseBlob.java
//   cp BlobTest.java.template      neko/voidwarehouse/BlobTest.java
//   javac -encoding UTF-8 -d out neko/voidwarehouse/WarehouseBlob.java neko/voidwarehouse/BlobTest.java
//   java -cp out neko.voidwarehouse.BlobTest        # 期望 RESULT pass=53 fail=0
// Windows 控制台是 GBK，中文会花屏，但末尾 RESULT 行是 ASCII，可直接判。
//
package neko.voidwarehouse;

import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.Random;

/** WarehouseBlob 的往返 / 边界 / 损坏输入测试。纯 JVM，不依赖 Minecraft。 */
public final class BlobTest {

    private static int pass = 0;
    private static int fail = 0;

    public static void main(String[] args) {
        B1_roundTrip();
        B2_empty();
        B3_bigFragment();
        B4_beyondNbtLimit();
        B5_utf8();
        B6_deterministic();
        B9_corruptInputs();
        B10_noOomOnHugeCount();

        System.out.println();
        System.out.println("RESULT pass=" + pass + " fail=" + fail);
        if (fail > 0) {
            System.exit(1);
        }
    }

    // ------------------------------------------------------------------ 正向

    /** B1：往返一致，条数/内容/字节全对 */
    private static void B1_roundTrip() {
        for (int n : new int[]{1, 64, 512, 975, 2048, 5000}) {
            List<byte[]> items = new ArrayList<>();
            for (int i = 0; i < n; i++) {
                items.add(("item-" + i + "-payload").getBytes(StandardCharsets.UTF_8));
            }
            List<String> recipes = recipeTexts(n);

            byte[] blob = WarehouseBlob.encode(items, recipes);
            WarehouseBlob.Raw raw = WarehouseBlob.decode(blob);

            check("B1 n=" + n + " 物品条数", n, raw.itemFragments().size());
            check("B1 n=" + n + " 配方条数", n, raw.recipes().size());

            boolean sameItems = true;
            for (int i = 0; i < n; i++) {
                if (!Arrays.equals(items.get(i), raw.itemFragments().get(i))) {
                    sameItems = false;
                    break;
                }
            }
            check("B1 n=" + n + " 物品逐条一致", true, sameItems);
            check("B1 n=" + n + " 配方逐条一致", recipes, raw.recipes());
            System.out.printf("      n=%-5d blob=%,d B (%.1f B/条)%n",
                    n, blob.length, blob.length / (double) n);
        }
    }

    /** B2：空输入（两段都空）必须是合法的，长度 12 字节 */
    private static void B2_empty() {
        byte[] blob = WarehouseBlob.encode(List.of(), List.of());
        check("B2 空容器字节数", 12, blob.length);
        WarehouseBlob.Raw raw = WarehouseBlob.decode(blob);
        check("B2 空物品", 0, raw.itemFragments().size());
        check("B2 空配方", 0, raw.recipes().size());

        // 只有物品没有配方 / 只有配方没有物品
        byte[] onlyItems = WarehouseBlob.encode(List.of(new byte[]{1, 2, 3}), List.of());
        WarehouseBlob.Raw a = WarehouseBlob.decode(onlyItems);
        check("B2 只有物品", 1, a.itemFragments().size());
        check("B2 只有物品-无配方", 0, a.recipes().size());

        byte[] onlyRecipes = WarehouseBlob.encode(List.of(), List.of("a*b;c\u00d71"));
        WarehouseBlob.Raw b = WarehouseBlob.decode(onlyRecipes);
        check("B2 只有配方", 0, b.itemFragments().size());
        check("B2 只有配方-内容", List.of("a*b;c\u00d71"), b.recipes());
    }

    /** B3：单个片段可以远超 64 KB（容器层没有长度上限，这是换容器的理由） */
    private static void B3_bigFragment() {
        byte[] huge = new byte[300_000];
        new Random(42).nextBytes(huge);
        byte[] blob = WarehouseBlob.encode(List.of(huge), List.of("x"));
        WarehouseBlob.Raw raw = WarehouseBlob.decode(blob);
        check("B3 30 万字节片段往返", true, Arrays.equals(huge, raw.itemFragments().get(0)));
        System.out.printf("      blob=%,d B%n", blob.length);
    }

    /** B4：核心诉求 —— 2048 条配方（>65535 B）在容器里装得下且读得回来 */
    private static void B4_beyondNbtLimit() {
        List<String> recipes = recipeTexts(2048);
        int utf8 = 0;
        for (String s : recipes) {
            utf8 += s.getBytes(StandardCharsets.UTF_8).length;
        }
        byte[] blob = WarehouseBlob.encode(List.of(), recipes);
        check("B4 配方原文 > 65535", true, utf8 > 65535);
        System.out.printf("      配方原文 = %,d B（NBT 上限 65,535）；blob = %,d B%n", utf8, blob.length);

        WarehouseBlob.Raw raw = WarehouseBlob.decode(blob);
        check("B4 2048 条全部读回", 2048, raw.recipes().size());
        check("B4 内容一致", recipes, raw.recipes());
    }

    /** B5：UTF-8 —— 中文 / 符号 / emoji / 空串 */
    private static void B5_utf8() {
        List<String> recipes = List.of(
                "\u94c1\u952d*1;\u94c1\u77ff\u00d71",   // 铁锭*1;铁矿×1
                "\u4e0b\u754c\u5408\u91d1\u952d*1;\u4e0b\u754c\u5408\u91d1\u952d\u00d71",
                "",
                "emoji-\uD83D\uDE00-\u4e2d\u6587",
                "tab\there\nnewline"
        );
        byte[] blob = WarehouseBlob.encode(List.of(), recipes);
        WarehouseBlob.Raw raw = WarehouseBlob.decode(blob);
        check("B5 UTF-8 往返", recipes, raw.recipes());
    }

    /** B6：确定性 —— 同样的输入两次编码逐字节相同（可比 md5） */
    private static void B6_deterministic() {
        List<byte[]> items = List.of(new byte[]{1}, new byte[]{2, 3}, new byte[]{});
        List<String> recipes = recipeTexts(100);
        byte[] a = WarehouseBlob.encode(items, recipes);
        byte[] b = WarehouseBlob.encode(items, recipes);
        check("B6 编码确定性", true, Arrays.equals(a, b));
        check("B6 空片段合法", 0, WarehouseBlob.decode(a).itemFragments().get(2).length);
    }

    // ------------------------------------------------------------------ 反向

    /** B9：所有损坏输入都必须抛 CorruptException，且不能是 OOM / AIOOBE */
    private static void B9_corruptInputs() {
        byte[] good = WarehouseBlob.encode(
                List.of(new byte[]{9, 9, 9}), recipeTexts(3));

        expectCorrupt("B9 null", () -> WarehouseBlob.decode(null));
        expectCorrupt("B9 太短", () -> WarehouseBlob.decode(new byte[]{'N', 'C'}));
        expectCorrupt("B9 空数组", () -> WarehouseBlob.decode(new byte[0]));

        byte[] badMagic = good.clone();
        badMagic[0] = 'X';
        expectCorrupt("B9 magic 不符", () -> WarehouseBlob.decode(badMagic));

        byte[] badVersion = good.clone();
        badVersion[4] = 99;
        expectCorrupt("B9 版本不符", () -> WarehouseBlob.decode(badVersion));

        // 关键回归：payloadLength = Integer.MAX_VALUE 曾因 HEADER + len 负溢出而放行
        byte[] overflowLen = good.clone();
        overflowLen[6] = (byte) 0x7F;
        overflowLen[7] = (byte) 0xFF;
        overflowLen[8] = (byte) 0xFF;
        overflowLen[9] = (byte) 0xFF;
        expectCorrupt("B9 payloadLength 溢出", () -> WarehouseBlob.decode(overflowLen));

        byte[] negLen = good.clone();
        negLen[6] = (byte) 0x80;
        expectCorrupt("B9 payloadLength 为负", () -> WarehouseBlob.decode(negLen));

        // payload 被截断：声明长度还是原值，实际字节少了
        byte[] truncated = Arrays.copyOf(good, good.length - 5);
        expectCorrupt("B9 payload 截断", () -> WarehouseBlob.decode(truncated));

        // itemCount 巨大：varint 0xFF 0xFF 0xFF 0xFF 0x07 = 2147483647
        byte[] hugeCount = withPayload(new byte[]{
                (byte) 0xFF, (byte) 0xFF, (byte) 0xFF, (byte) 0xFF, 0x07, 0x00});
        expectCorrupt("B9 itemCount=MAX", () -> WarehouseBlob.decode(hugeCount));

        // 条数为负：第 5 字节 0x0F -> 0x0F<<28 = 负数
        byte[] negCount = withPayload(new byte[]{
                (byte) 0xFF, (byte) 0xFF, (byte) 0xFF, (byte) 0xFF, 0x0F, 0x00});
        expectCorrupt("B9 itemCount 为负", () -> WarehouseBlob.decode(negCount));

        // 片段长度巨大：pos + len 曾溢出放行
        byte[] hugeFrag = withPayload(new byte[]{
                0x01,                                     // itemCount = 1
                (byte) 0xFF, (byte) 0xFF, (byte) 0xFF, (byte) 0xFF, 0x07, // len = MAX
                0x00});
        expectCorrupt("B9 片段长度溢出", () -> WarehouseBlob.decode(hugeFrag));

        // varint 永不终止
        byte[] endlessVarint = withPayload(new byte[]{
                (byte) 0x80, (byte) 0x80, (byte) 0x80, (byte) 0x80, (byte) 0x80, (byte) 0x80});
        expectCorrupt("B9 varint 过长", () -> WarehouseBlob.decode(endlessVarint));

        // 尾部多余字节
        byte[] trailing = withPayload(new byte[]{0x00, 0x00, 0x7F});
        expectCorrupt("B9 尾部多字节", () -> WarehouseBlob.decode(trailing));

        // 良性边界：payload 后面挂垃圾（超出自述长度）应被忽略而不是报错
        byte[] padded = Arrays.copyOf(good, good.length + 8);
        WarehouseBlob.Raw raw = WarehouseBlob.decode(padded);
        check("B9 声明长度外的尾巴被忽略", 3, raw.recipes().size());
    }

    /** B10：损坏的条数不能让预分配炸成 OOM（必须走 CorruptException） */
    private static void B10_noOomOnHugeCount() {
        // itemCount = 100_000_000，但 payload 里没有对应数据
        byte[] blob = withPayload(new byte[]{
                (byte) 0x80, (byte) 0xC2, (byte) 0xD7, 0x2F, 0x00});
        long before = Runtime.getRuntime().totalMemory() - Runtime.getRuntime().freeMemory();
        expectCorrupt("B10 亿级条数不 OOM", () -> WarehouseBlob.decode(blob));
        long after = Runtime.getRuntime().totalMemory() - Runtime.getRuntime().freeMemory();
        System.out.printf("      堆变化 %+,d B%n", after - before);
    }

    // ------------------------------------------------------------------ 工具

    /** 造 n 条贴近真实体积的配方文本（含 × 这类 2 字节字符） */
    static List<String> recipeTexts(int n) {
        List<String> out = new ArrayList<>(n);
        for (int i = 0; i < n; i++) {
            out.add("minecraft:item_" + i + "*1;minecraft:ingot_a\u00d72,minecraft:ingot_b\u00d71");
        }
        return out;
    }

    private static byte[] withPayload(byte[] payload) {
        byte[] out = new byte[10 + payload.length];
        out[0] = 'N';
        out[1] = 'C';
        out[2] = 'A';
        out[3] = 'W';
        out[4] = 1;
        out[5] = 0;
        out[6] = (byte) ((payload.length >>> 24) & 0xFF);
        out[7] = (byte) ((payload.length >>> 16) & 0xFF);
        out[8] = (byte) ((payload.length >>> 8) & 0xFF);
        out[9] = (byte) (payload.length & 0xFF);
        System.arraycopy(payload, 0, out, 10, payload.length);
        return out;
    }

    private static void expectCorrupt(String name, Runnable body) {
        try {
            body.run();
            fail(name, "没有抛异常");
        } catch (WarehouseBlob.CorruptException e) {
            pass(name, e.getMessage());
        } catch (OutOfMemoryError e) {
            fail(name, "抛了 OOM（长度校验有洞）");
        } catch (Throwable t) {
            fail(name, "抛了 " + t.getClass().getSimpleName() + ": " + t.getMessage());
        }
    }

    private static void check(String name, Object expect, Object actual) {
        if (expect.equals(actual)) {
            pass(name, "");
        } else {
            fail(name, "期望 " + expect + " 实际 " + actual);
        }
    }

    private static void pass(String name, String note) {
        pass++;
        System.out.println("  OK   " + name + (note.isEmpty() ? "" : "  [" + note + "]"));
    }

    private static void fail(String name, String note) {
        fail++;
        System.out.println("  FAIL " + name + "  -> " + note);
    }
}
