/**
 * 【临时审计，五版本共用同一份源码】配方存储 + 原料兑换的完整覆盖：持久化 / 数量正确性 / 并发。
 *
 * <h2>为什么并发部分要这么写</h2>
 * <p>服务端是单线程的：20 个玩家同一 tick 点同一格，实际执行是 <b>20 次串行调用</b>，
 * 中间不会插入 tick。所以「并发」在数据层的真实语义是「连续 N 次调用」，
 * 唯一可能出问题的地方是 <b>规划与执行之间库存被改</b>（TOCTOU）以及
 * <b>部分回滚</b>（背包塞不下时 {@code returnUnplaced}）。</p>
 * <p>本工具因此分两条线：</p>
 * <ul>
 *   <li><b>可达路径</b>：串行 N 次、每次重新规划 —— 断言总量与逐人结果；</li>
 *   <li><b>不可达但要摸底</b>：<b>故意</b>在 plan 与 apply 之间改库存，看会发生什么。
 *       当前调用图里没有这种写法（规划与执行都在同一个方法体内），所以它不算 bug；
 *       但只要有人把规划与执行拆到两个 tick（异步打印机最容易这么干），
 *       这条就会变成「凭空造物」。用 {@code note()} 记录，不计入失败。</li>
 * </ul>
 * <p>真多线程那一段用的是<b>独立实例</b>，绝不碰世界里的存档 —— 数据结构并非线程安全，
 * 这段只为量出「会不会抛 / 抛什么」，属边界摸底。</p>
 */
public final class CraftExchangeAudit {

    private static final AtomicBoolean STARTED = new AtomicBoolean();
    private static int checks;
    private static int failures;

    private CraftExchangeAudit() {
    }

    public static void run(MinecraftServer server) {
        if (server.getTickCount() < 80) {
            return;
        }
        if (!STARTED.compareAndSet(false, true)) {
            return;
        }
        boolean vw = VoidWarehouseSettings.voidWarehouse;
        boolean craft = VoidWarehouseSettings.voidWarehouseCraft;
        boolean exchange = VoidWarehouseSettings.voidWarehouseExchange;
        try {
            VoidWarehouseSettings.voidWarehouse = true;
            VoidWarehouseSettings.voidWarehouseCraft = true;
            VoidWarehouseSettings.voidWarehouseExchange = true;
            persistence();
            quantities();
            concurrency(server);
            totals();
            persistenceDisk(server);
        } catch (Throwable t) {
            System.out.println("[AUDIT] 审计自身抛异常：");
            t.printStackTrace(System.out);
            failures++;
        } finally {
            VoidWarehouseSettings.voidWarehouse = vw;
            VoidWarehouseSettings.voidWarehouseCraft = craft;
            VoidWarehouseSettings.voidWarehouseExchange = exchange;
            System.out.println("AUDIT RESULT checks=" + checks + " failures=" + failures);
            server.halt(false);
        }
    }

    // ================================================================== P 持久化

    private static void persistence() {
        System.out.println("[AUDIT] P 持久化");

        // ---- P1..P4 往返：50 条配方 + 若干库存，编码 → 解码 → 逐条比对 ----
        VoidWarehouseData d = new VoidWarehouseData();
        List<String> expect = new ArrayList<>();
        for (int i = 1; i <= 50; i++) {
            VoidWarehouseRecipes.Recipe r = recipe("minecraft:stick", 4,
                    Map.of("minecraft:oak_planks", i));
            d.learn(r);
            expect.add(r.recipeId());
        }
        stock(d, Items.STONE, 64);
        stock(d, Items.IRON_INGOT, 200);
        check("P1 写入后条数 50（实测 " + d.recipeBookUsed() + "）", d.recipeBookUsed() == 50);

        CompoundTag tag = encode(d);
        check("P1b 能编码出 NBT", tag != null);
        VoidWarehouseData back = decode(tag);
        check("P2 解码成功且条数一致（实测 " + (back == null ? -1 : back.recipeBookUsed()) + "）",
                back != null && back.recipeBookUsed() == 50);
        check("P2b 配方文本逐条、按序相同", back != null && expect.equals(texts(back)));
        check("P2c 库存往返一致（石头 " + (back == null ? "-" : back.amountOf(Items.STONE))
                        + " / 铁锭 " + (back == null ? "-" : back.amountOf(Items.IRON_INGOT)) + "）",
                back != null && back.amountOf(Items.STONE).equals(BigInteger.valueOf(64))
                        && back.amountOf(Items.IRON_INGOT).equals(BigInteger.valueOf(200)));

        // 二次编码必须字节级相同：证明「读进来再写出去」不会每轮漂移
        CompoundTag tag2 = back == null ? null : encode(back);
        check("P3 再编码一次与第一次完全相同（不漂移）", tag != null && tag.equals(tag2));

        // 快照性：encode 之后再改数据，已拿到的 tag 不能跟着变
        int before = texts(d).size();
        d.learn(recipe("minecraft:torch", 4, Map.of("minecraft:coal", 1, "minecraft:stick", 1)));
        check("P3b encode 得到的是快照（事后改数据不会污染已编码的 tag）",
                texts(d).size() == before + 1 && tag != null && tag.equals(tag2));

        // ---- P4 旧格式迁移：learned_recipes 是 \n 拼接 ----
        CompoundTag legacy = new CompoundTag();
        legacy.putString("learned_recipes",
                "minecraft:stick*4;minecraft:oak_planks×2\n"
                        + "minecraft:torch*4;minecraft:coal×1,minecraft:stick×1\n"
                        + "坏行没有分号");
        VoidWarehouseData migrated = decode(legacy);
        check("P4 旧字段 learned_recipes 能读进来（好行 2 条、坏行丢掉，实测 "
                + (migrated == null ? -1 : migrated.recipeBookUsed()) + "）",
                migrated != null && migrated.recipeBookUsed() == 2);

        // 新格式优先于旧格式
        CompoundTag both = legacy.copy();
        ListTag lines = new ListTag();
        lines.add(StringTag.valueOf("minecraft:chest*1;minecraft:oak_planks×8"));
        both.put("learned_recipes_lines", lines);
        VoidWarehouseData prefer = decode(both);
        check("P4b 两种字段并存时以新格式为准（实测 "
                + (prefer == null ? -1 : prefer.recipeBookUsed()) + "）",
                prefer != null && prefer.recipeBookUsed() == 1);

        // ---- P5 大数：超过 long 的数量走字符串编码，不许丢精度 ----
        CompoundTag big = new CompoundTag();
        ListTag items = new ListTag();
        CompoundTag one = new CompoundTag();
        one.put("item", encodeStack(Items.DIRT));
        one.putString("count", "123456789012345678901234567890");
        items.add(one);
        big.put("items", items);
        VoidWarehouseData bigData = decode(big);
        check("P5 超 long 的数量精度不丢（实测 "
                        + (bigData == null ? "-" : bigData.amountOf(Items.DIRT)) + "）",
                bigData != null && bigData.amountOf(Items.DIRT)
                        .equals(new BigInteger("123456789012345678901234567890")));

        // ---- P6 满本 2048 条编解码不丢 ----
        CompoundTag full = new CompoundTag();
        ListTag many = new ListTag();
        for (int i = 0; i < 2048; i++) {
            many.add(StringTag.valueOf("minecraft:stick*4;minecraft:oak_planks×" + (i + 1)));
        }
        full.put("learned_recipes_lines", many);
        VoidWarehouseData fullData = decode(full);
        check("P6 2048 条一次性编解码不丢（实测 "
                + (fullData == null ? -1 : fullData.recipeBookUsed()) + "）",
                fullData != null && fullData.recipeBookUsed() == 2048);
    }

    // ================================================================== E 兑换数量

    private static void quantities() {
        System.out.println("[AUDIT] E 兑换数量");

        // 木棍：一次合成 2 木板 → 4 木棍
        VoidWarehouseRecipes.Recipe sticks = recipe("minecraft:stick", 4,
                Map.of("minecraft:oak_planks", 2));

        // ---- E1 取 1：必须做 1 次，余 3 个木棍入账 ----
        VoidWarehouseData d = stocked(sticks, Items.OAK_PLANKS, 64);
        VoidWarehouseData.Withdrawal w = d.withdraw(new ItemStack(Items.STICK), BigInteger.ONE);
        check("E1 取 1 木棍：给 1（实测 " + w.taken() + "）", w.taken() == 1);
        check("E1b 扣 2 木板（实测剩 " + d.amountOf(Items.OAK_PLANKS) + "）",
                d.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(62)));
        check("E1c 多做出来的 3 个木棍入账（实测 " + d.amountOf(Items.STICK) + "）",
                d.amountOf(Items.STICK).equals(BigInteger.valueOf(3)));

        // ---- E2 取 4：恰好一次合成，余量为 0 ----
        d = stocked(sticks, Items.OAK_PLANKS, 64);
        w = d.withdraw(new ItemStack(Items.STICK), BigInteger.valueOf(4));
        check("E2 取 4 木棍：给 4、扣 2 木板、无余量",
                w.taken() == 4 && d.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(62))
                        && d.amountOf(Items.STICK).equals(BigInteger.ZERO));

        // ---- E3 取 5：做 2 次，扣 4 换 8，余 3 ----
        d = stocked(sticks, Items.OAK_PLANKS, 64);
        w = d.withdraw(new ItemStack(Items.STICK), BigInteger.valueOf(5));
        check("E3 取 5 木棍：给 5、扣 4 木板、余 3",
                w.taken() == 5 && d.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(60))
                        && d.amountOf(Items.STICK).equals(BigInteger.valueOf(3)));

        // ---- E4 要超过堆叠上限：夹到 64 ----
        d = stocked(sticks, Items.OAK_PLANKS, 64);
        w = d.withdraw(new ItemStack(Items.STICK), BigInteger.valueOf(65));
        check("E4 取 65 木棍被夹到 64（实测 " + w.taken() + "）", w.taken() == 64);

        // ---- E5 只做「刚够」的次数：64 个 = 16 次，扣 32 木板，不把原料用光 ----
        d = stocked(sticks, Items.OAK_PLANKS, 63);
        w = d.withdraw(new ItemStack(Items.STICK), BigInteger.valueOf(64));
        check("E5 63 木板取 64 木棍：只做 16 次（扣 32），剩 31 木板、无余量（实测给 "
                        + w.taken() + "，剩木板 " + d.amountOf(Items.OAK_PLANKS)
                        + "，余量 " + d.amountOf(Items.STICK) + "）",
                w.taken() == 64 && d.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(31))
                        && d.amountOf(Items.STICK).equals(BigInteger.ZERO));

        // ---- E6 原料差一点：1 木板做不出 ----
        d = stocked(sticks, Items.OAK_PLANKS, 1);
        w = d.withdraw(new ItemStack(Items.STICK), BigInteger.ONE);
        check("E6 只剩 1 木板：取不到，且一个字节都没扣",
                w.isEmpty() && d.amountOf(Items.OAK_PLANKS).equals(BigInteger.ONE));

        // ---- E7 成品有货：绝不走兑换 ----
        d = stocked(sticks, Items.OAK_PLANKS, 64);
        d.insert(new ItemStack(Items.STICK, 10));
        w = d.withdraw(new ItemStack(Items.STICK), BigInteger.valueOf(5));
        check("E7 成品有货时直接扣成品（木板一个不动，实测 "
                        + d.amountOf(Items.OAK_PLANKS) + "）",
                w.taken() == 5 && d.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(64))
                        && d.amountOf(Items.STICK).equals(BigInteger.valueOf(5)));

        // ---- E8 非法请求 ----
        d = stocked(sticks, Items.OAK_PLANKS, 64);
        check("E8 want=0 返回空", d.withdraw(new ItemStack(Items.STICK), BigInteger.ZERO).isEmpty());
        check("E8b want=-1 返回空",
                d.withdraw(new ItemStack(Items.STICK), BigInteger.valueOf(-1)).isEmpty());
        check("E8c 两次非法请求没有动库存",
                d.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(64)));

        // ---- E9 9 合 1：9 铁锭 → 1 铁块 ----
        d = new VoidWarehouseData();
        stock(d, Items.IRON_INGOT, 9);
        w = d.withdraw(new ItemStack(Items.IRON_BLOCK), BigInteger.ONE);
        check("E9 9 铁锭换 1 铁块（实测给 " + w.taken() + "，剩铁锭 "
                        + d.amountOf(Items.IRON_INGOT) + "，库存铁块 "
                        + d.amountOf(Items.IRON_BLOCK) + "）",
                w.taken() == 1 && d.amountOf(Items.IRON_INGOT).equals(BigInteger.ZERO)
                        && d.amountOf(Items.IRON_BLOCK).equals(BigInteger.ZERO));

        // ---- E10 反向：1 铁块 → 9 铁锭 ----
        d = new VoidWarehouseData();
        stock(d, Items.IRON_BLOCK, 1);
        w = d.withdraw(new ItemStack(Items.IRON_INGOT), BigInteger.valueOf(9));
        check("E10 1 铁块换 9 铁锭（实测给 " + w.taken() + "，剩铁块 "
                        + d.amountOf(Items.IRON_BLOCK) + "，库存铁锭 "
                        + d.amountOf(Items.IRON_INGOT) + "）",
                w.taken() == 9 && d.amountOf(Items.IRON_BLOCK).equals(BigInteger.ZERO)
                        && d.amountOf(Items.IRON_INGOT).equals(BigInteger.ZERO));

        // ---- E11 不够一份：8 铁锭取铁块 ----
        d = new VoidWarehouseData();
        stock(d, Items.IRON_INGOT, 8);
        w = d.withdraw(new ItemStack(Items.IRON_BLOCK), BigInteger.ONE);
        check("E11 8 铁锭差一个：取不到，铁锭原样 8",
                w.isEmpty() && d.amountOf(Items.IRON_INGOT).equals(BigInteger.valueOf(8)));

        // ---- E12b 有货就不兑换：5 铁锭取 9 个只给 5（这是设计，不是缺口）----
        d = new VoidWarehouseData();
        stock(d, Items.IRON_INGOT, 5);
        stock(d, Items.IRON_BLOCK, 4);
        w = d.withdraw(new ItemStack(Items.IRON_INGOT), BigInteger.valueOf(9));
        check("E12b 成品有 5 个时取 9 只给 5，绝不跨过成品去拆铁块（实测 " + w.taken()
                        + "，铁块仍 " + d.amountOf(Items.IRON_BLOCK) + "）",
                w.taken() == 5 && d.amountOf(Items.IRON_BLOCK).equals(BigInteger.valueOf(4)));
        // 同一份库存走「按量取货」的规划路径（VoidWarehouseWithdraw 用的那条）就该补齐
        VoidWarehouseExchange.Plan fill = d.planExchange(new ItemStack(Items.IRON_INGOT),
                BigInteger.valueOf(9));
        check("E12c 按量取货那条路会补齐：5 现成 + 拆 1 铁块 = 9（实测 "
                        + (fill == null ? "-" : fill.amount()) + "）",
                fill != null && fill.amount().equals(BigInteger.valueOf(9)));

        // ---- E12 多一个：10 铁锭取 1 铁块，剩 1 ----
        d = new VoidWarehouseData();
        stock(d, Items.IRON_INGOT, 10);
        w = d.withdraw(new ItemStack(Items.IRON_BLOCK), BigInteger.ONE);
        check("E12 10 铁锭取 1 铁块：给 1，剩 1 铁锭",
                w.taken() == 1 && d.amountOf(Items.IRON_INGOT).equals(BigInteger.ONE));
    }

    // ================================================================== C 并发

    private static void concurrency(MinecraftServer server) {
        System.out.println("[AUDIT] C 并发");
        VoidWarehouseRecipes.Recipe sticks = recipe("minecraft:stick", 4,
                Map.of("minecraft:oak_planks", 2));
        List<ServerPlayer> bots = buildBots(server, 20);
        check("C0 造出 20 个真玩家（实测 " + bots.size() + "）", bots.size() == 20);

        // ---- C1 20 人各取 1，原料刚好够 20 次 ----
        VoidWarehouseData d = stocked(sticks, Items.OAK_PLANKS, 40);
        int ok = 0;
        int got = 0;
        for (ServerPlayer p : bots) {
            VoidWarehouseData.Withdrawal w = d.withdraw(new ItemStack(Items.STICK), BigInteger.ONE);
            p.getUUID();   // 玩家身份不参与数据层，这里只是为了复刻真实调用序列
            if (!w.isEmpty()) {
                ok++;
                got += w.taken();
            }
        }
        check("C1 20 人各取 1：20 人全成功（实测 " + ok + "）", ok == 20);
        check("C1b 一共给出 20 个（实测 " + got + "）", got == 20);
        // 每次合成出 4 个、给 1 个、余 3 个回仓，后 3 个人直接从库存里拿 ——
        // 所以 20 个人只需 5 次合成 = 10 个木板，这正是「余量复用」该有的样子。
        check("C1c 只做了 5 次合成 ⇒ 消耗 10 木板、剩 30（实测 " + d.amountOf(Items.OAK_PLANKS) + "）",
                d.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(30)));
        check("C1d 余量被后来的人用光了，库存不残留（实测 " + d.amountOf(Items.STICK) + "）",
                d.amountOf(Items.STICK).equals(BigInteger.ZERO));

        // ---- C2 原料真不够：9 木板只能做 4 次 = 16 个，第 17~20 个人必须空手 ----
        d = stocked(sticks, Items.OAK_PLANKS, 9);
        int ok2 = 0;
        int empty2 = 0;
        for (ServerPlayer p : bots) {
            VoidWarehouseData.Withdrawal w = d.withdraw(new ItemStack(Items.STICK), BigInteger.ONE);
            if (w.isEmpty()) {
                empty2++;
            } else {
                ok2++;
            }
        }
        check("C2 9 木板：16 人成功、4 人空手（实测 " + ok2 + " / " + empty2 + "）",
                ok2 == 16 && empty2 == 4);
        check("C2b 剩下那 1 个木板没被吃掉（实测 " + d.amountOf(Items.OAK_PLANKS) + "）",
                d.amountOf(Items.OAK_PLANKS).equals(BigInteger.ONE));
        check("C2c 仓库里没有负数库存", allNonNegative(d));

        // ---- C3 20 人各取 4，原料刚好够 ----
        d = stocked(sticks, Items.OAK_PLANKS, 40);
        int ok3 = 0;
        int got3 = 0;
        for (ServerPlayer p : bots) {
            VoidWarehouseData.Withdrawal w = d.withdraw(new ItemStack(Items.STICK), BigInteger.valueOf(4));
            if (!w.isEmpty()) {
                ok3++;
                got3 += w.taken();
            }
        }
        check("C3 20 人各取 4：全成功（实测 " + ok3 + " 人 / " + got3 + " 个）",
                ok3 == 20 && got3 == 80);
        check("C3b 木板清零、木棍无余量",
                d.amountOf(Items.OAK_PLANKS).equals(BigInteger.ZERO)
                        && d.amountOf(Items.STICK).equals(BigInteger.ZERO));

        // ---- C4 20 人抢同一批、原料只够一半 ----
        d = stocked(sticks, Items.OAK_PLANKS, 20);
        int ok4 = 0;
        int got4 = 0;
        for (ServerPlayer p : bots) {
            VoidWarehouseData.Withdrawal w = d.withdraw(new ItemStack(Items.STICK), BigInteger.valueOf(4));
            if (!w.isEmpty()) {
                ok4++;
                got4 += w.taken();
            }
        }
        check("C4 20 木板：10 人拿到 4 个、共 40 个（实测 " + ok4 + " 人 / " + got4 + " 个）",
                ok4 == 10 && got4 == 40);
        check("C4b 最终库存为零且无负数",
                d.amountOf(Items.OAK_PLANKS).equals(BigInteger.ZERO) && allNonNegative(d));

        // ---- C5 不可达但要摸底：plan 之后改库存，再 apply ----
        d = stocked(sticks, Items.OAK_PLANKS, 64);
        VoidWarehouseExchange.Plan stale =
                d.planExchange(new ItemStack(Items.STICK), BigInteger.ONE);
        d.clearContent();                      // 模拟「另一位玩家把料吃光了」
        int beforeSticks = d.amountOf(Items.STICK).intValue();
        if (stale != null) {
            d.applyExchange(stale);
        }
        note("C5 陈旧计划实测：清空库存后仍执行 plan ⇒ 木棍 " + beforeSticks + " → "
                + d.amountOf(Items.STICK) + "、木板 " + d.amountOf(Items.OAK_PLANKS)
                + "（当前调用图不可达；一旦把规划与执行拆到两个 tick 就会凭空造物）");

        // ---- C6 真多线程：独立实例，只摸底 ----
        VoidWarehouseData shared = stocked(sticks, Items.OAK_PLANKS, 4096);
        AtomicInteger errors = new AtomicInteger();
        AtomicInteger taken = new AtomicInteger();
        List<Thread> threads = new ArrayList<>();
        for (int t = 0; t < 8; t++) {
            Thread th = new Thread(() -> {
                for (int i = 0; i < 200; i++) {
                    try {
                        VoidWarehouseData.Withdrawal w =
                                shared.withdraw(new ItemStack(Items.STICK), BigInteger.ONE);
                        if (!w.isEmpty()) {
                            taken.addAndGet(w.taken());
                        }
                    } catch (Throwable ex) {
                        errors.incrementAndGet();
                    }
                }
            }, "audit-thread-" + t);
            threads.add(th);
            th.start();
        }
        for (Thread th : threads) {
            try {
                th.join(20_000L);
            } catch (InterruptedException ignored) {
                Thread.currentThread().interrupt();
            }
        }
        note("C6 真 8 线程 × 200 次：异常 " + errors.get() + " 次，共取出 " + taken.get()
                + " 个，木板剩 " + shared.amountOf(Items.OAK_PLANKS)
                + "（数据结构不是线程安全的；这段只为量边界，不计入失败）");
        for (ServerPlayer p : bots) {
            try {
                p.discard();
            } catch (Throwable ignored) {
                // 假连接，丢弃失败无所谓
            }
        }
    }

    // ================================================================== G 总账

    /**
     * 等价守恒扫：随机库存 × 随机目标 × 随机数量，每一份计划都必须满足
     * 「仓库少掉的等价 == 玩家拿到的等价」。
     *
     * <p>这条是「吞材料」与「凭空造物」的<b>统一判据</b>：少了就是吞，多了就是造。
     * 为什么不逐条断言具体数量 —— 9 合 1 的可行性是<b>跳档</b>的（整块拆、整块合），
     * 具体给几个、拆哪个，取决于库存的余数，写死就变成猜；而等价账对<b>任何</b>一条
     * 合法路线都必须成立，所以它能一网打尽。</p>
     *
     * <p>只扫 9 合 1 能计价的物品（配方扣料那套没有价值体系，另由 E 组按 consumed/surplus 对账）。</p>
     */
    private static void conservationSweep() {
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.active();
        // 族：小 → 大。跨版本物品表有差异，缺一件就整族跳过（不猜）
        String[][] families = {
                {"iron_nugget", "iron_ingot", "iron_block"},
                {"gold_nugget", "gold_ingot", "gold_block"},
                {"coal", "coal_block"},
                {"redstone", "redstone_block"},
                {"lapis_lazuli", "lapis_block"},
                {"bone_meal", "bone", "bone_block"},
                {"wheat", "hay_block"},
                {"slime_ball", "slime_block"},
                {"emerald", "emerald_block"},
                {"diamond", "diamond_block"},
                {"string", "white_wool"},
        };
        List<List<String>> usable = new ArrayList<>();
        for (String[] family : families) {
            List<String> ids = new ArrayList<>();
            boolean ok = true;
            for (String id : family) {
                if (table.valueOf(id).signum() == 0 || VoidWarehouseExchangeBootstrap.itemOf(id) == null) {
                    ok = false;
                    break;
                }
                ids.add(id);
            }
            if (ok) {
                usable.add(ids);
            }
        }
        List<String> allIds = new ArrayList<>();
        for (List<String> family : usable) {
            for (String id : family) {
                if (!allIds.contains(id)) {
                    allIds.add(id);
                }
            }
        }
        note("G3 可用族 " + usable.size() + " / " + families.length + "（缺物品或没价值的整族跳过）");
        if (usable.size() < 3) {
            check("G3 至少要有 3 个可计价的族才扫得动（实测 " + usable.size() + "）", false);
            return;
        }
        Random rnd = new Random(20260101L);
        int combos = 0;
        int plans = 0;
        int bad = 0;
        int leaked = 0;
        int negative = 0;
        StringBuilder first = new StringBuilder();
        for (int round = 0; round < 160; round++) {
            List<String> family = usable.get(rnd.nextInt(usable.size()));
            VoidWarehouseData d = new VoidWarehouseData();
            for (String id : family) {
                int n = rnd.nextInt(40);
                if (n > 0) {
                    stock(d, VoidWarehouseExchangeBootstrap.itemOf(id), n);
                }
            }
            String target = family.get(rnd.nextInt(family.size()));
            int want = 1 + rnd.nextInt(90);
            Map<String, BigInteger> before = snapshot(d, allIds);
            if (before.values().stream().allMatch(v -> v.signum() == 0)) {
                continue;   // 这一轮什么都没放，问不出计划
            }
            combos++;
            VoidWarehouseExchange.Plan plan =
                    d.planExchange(new ItemStack(VoidWarehouseExchangeBootstrap.itemOf(target)),
                            BigInteger.valueOf(want));
            if (plan == null) {
                continue;
            }
            plans++;
            d.applyExchange(plan);
            Map<String, BigInteger> after = snapshot(d, allIds);
            BigInteger lost = BigInteger.ZERO;
            for (String id : allIds) {
                lost = lost.add(before.get(id).subtract(after.get(id)).multiply(table.valueOf(id)));
            }
            BigInteger expect = plan.amount().multiply(table.valueOf(target));
            if (!lost.equals(expect)) {
                bad++;
                if (first.length() < 300) {
                    first.append("\n        ").append(family).append(" 取 ").append(target).append(" ×").append(plan.amount())
                            .append(" 实际少 ").append(lost).append(" 应少 ").append(expect)
                            .append(" deltas=").append(plan.deltas());
                }
            }
            for (String id : allIds) {
                if (!family.contains(id) && before.get(id).compareTo(after.get(id)) != 0) {
                    leaked++;
                }
            }
            if (!allNonNegative(d)) {
                negative++;
            }
        }
        note("G3 扫了 " + combos + " 组，其中 " + plans + " 组给出了计划");
        check("G3a 每一份计划都等价守恒（" + plans + " 份，坏的 " + bad + "）" + first, bad == 0);
        check("G3b 取货不会动到别的族（越界 " + leaked + " 处）", leaked == 0);
        check("G3c 扫完没有负数库存（" + negative + " 次）", negative == 0);
        // 防空转：全都规划失败的话上面三条会「全绿但什么也没验」
        check("G3d 扫的样本量够（组合 " + combos + " ≥ 60，出计划 " + plans + " ≥ 20）",
                combos >= 60 && plans >= 20);
    }

    /**
     * 配方扣料那半边的守恒扫：木板 → 木棍（2 板出 4 棍），随机库存 × 随机数量。
     *
     * <p>判据是「四件套」：<b>产出 = 剩余 + 交付</b>、<b>耗料 = 2 × 合成次数</b>。
     * 这两条同时成立才叫账平 —— 只认「玩家拿到了」会放过「仓库也多出来一截」，
     * 只认「仓库少了」会放过「玩家没拿到」。</p>
     */
    private static void craftConservationSweep() {
        VoidWarehouseRecipes.Recipe sticks = recipe("minecraft:stick", 4,
                Map.of("minecraft:oak_planks", 2));
        Random rnd = new Random(777L);
        int plans = 0;
        int badPlanks = 0;
        int badSticks = 0;
        int negative = 0;
        String first = "";
        for (int round = 0; round < 160; round++) {
            int planks0 = rnd.nextInt(200);
            int sticks0 = rnd.nextInt(12);
            VoidWarehouseData d = new VoidWarehouseData();
            d.learn(sticks);
            if (planks0 > 0) {
                stock(d, Items.OAK_PLANKS, planks0);
            }
            if (sticks0 > 0) {
                stock(d, Items.STICK, sticks0);
            }
            int p0 = d.amountOf(Items.OAK_PLANKS).intValue();
            int s0 = d.amountOf(Items.STICK).intValue();
            int want = 1 + rnd.nextInt(64);
            VoidWarehouseExchange.Plan plan =
                    d.planExchange(new ItemStack(Items.STICK), BigInteger.valueOf(want));
            if (plan == null) {
                continue;   // 料不够：整次拒绝，仓库一个字节都没动（E 组已单独验）
            }
            plans++;
            d.applyExchange(plan);
            int p1 = d.amountOf(Items.OAK_PLANKS).intValue();
            int s1 = d.amountOf(Items.STICK).intValue();
            int used = p0 - p1;
            int crafts = used / 2;
            boolean planksOk = used >= 0 && used % 2 == 0;
            // 产出 4×crafts 必须恰好等于「交付 + 剩余 − 原有」
            boolean sticksOk = (long) plan.amount().intValue() + (s1 - s0) == 4L * crafts;
            if (!planksOk) {
                badPlanks++;
            }
            if (!sticksOk) {
                badSticks++;
            }
            if (first.isEmpty() && (!planksOk || !sticksOk)) {
                first = "\n        木板 " + p0 + "→" + p1 + "、木棍 " + s0 + "→" + s1
                        + "、要 " + want + " 给 " + plan.amount() + "、合成 " + crafts + " 次、deltas=" + plan.deltas();
            }
            if (!allNonNegative(d)) {
                negative++;
            }
        }
        note("G4 配方扣料扫了 160 组，其中 " + plans + " 组给出了计划");
        check("G4a 每一组耗料都是 2 的偶数倍（坏的 " + badPlanks + "）" + first, badPlanks == 0);
        check("G4b 每一组「4 × 合成 == 交付 + 净变化」（坏的 " + badSticks + "）", badSticks == 0);
        check("G4c 扫完没有负数库存（" + negative + " 次）", negative == 0);
        check("G4d 样本量够（出计划 " + plans + " ≥ 20）", plans >= 20);
    }

    private static Map<String, BigInteger> snapshot(VoidWarehouseData d, List<String> ids) {
        Map<String, BigInteger> map = new java.util.LinkedHashMap<>();
        for (String id : ids) {
            Item item = VoidWarehouseExchangeBootstrap.itemOf(id);
            map.put(id, item == null ? BigInteger.ZERO : d.amountOf(item));
        }
        return map;
    }

    private static void totals() {
        System.out.println("[AUDIT] G 账平");
        // 一次「现成不够、拆上级补齐」的完整兑换：5 铁锭 + 4 铁块，按量取 9 铁锭。
        // 🔴 口径（踩了三次才认下来）：plan 的 deltas 记的是**仓库净变化**，
        //    玩家拿到的那 9 个**已经含在里面**了 —— 拆块 +9 与交付 −9 相抵，
        //    所以 deltas 里只剩 iron_block −1。交付（withdraw 的 ② 分支）是
        //    「先把 deltas 执行掉，再把 plan.amount() 个凭空成堆交给玩家」，**不再从库存扣一次**。
        //    于是正确的断言只有一种：仓库等价少了多少，就必须等于玩家拿到多少。
        //    写成「铁锭归零」是在要求仓库凭空少 9 个 —— 那不是账平，是丢货。
        // 本例：4 块 + 5 锭 = 41 → 拆 1 块（3 块 27 + 锭 14 = 41）→ 交付 9 → 剩 32。
        VoidWarehouseData d = new VoidWarehouseData();
        stock(d, Items.IRON_BLOCK, 4);
        stock(d, Items.IRON_INGOT, 5);
        VoidWarehouseExchange.Plan p9 =
                d.planExchange(new ItemStack(Items.IRON_INGOT), BigInteger.valueOf(9));
        check("G1 计划数量 = 9（实测 " + (p9 == null ? "-" : p9.amount()) + "）",
                p9 != null && p9.amount().equals(BigInteger.valueOf(9)));
        if (p9 != null) {
            note("G1 计划的 deltas = " + p9.deltas());
            d.applyExchange(p9);
        }
        BigInteger ingotLeft = d.amountOf(Items.IRON_INGOT);
        BigInteger blockLeft = d.amountOf(Items.IRON_BLOCK);
        BigInteger conserved = blockLeft.multiply(BigInteger.valueOf(9)).add(ingotLeft);
        check("G1a 执行后铁锭 5 个原样留着（实测 " + ingotLeft + "）：拆块得的 9 个全给了玩家，没动现成的",
                ingotLeft.equals(BigInteger.valueOf(5)));
        check("G1b 铁块 4 → 3（实测 " + blockLeft + "）", blockLeft.equals(BigInteger.valueOf(3)));
        check("G1c 等价守恒：41 − 9 = 32（实测 " + conserved + "）",
                conserved.equals(BigInteger.valueOf(32)));
        check("G1d 全程没有出现负数库存", allNonNegative(d));
        // 真实入口再走一遍：withdraw 是「有货就只给成品，绝不兑换」——
        // 库存里有 5 个铁锭，要 9 个就只给 5 个，铁块一块都不许动。
        // 这一条钉的是玩家的切身感受：「明明有铁锭，取的时候却被扣了铁粒」永远不该发生。
        // 补齐（不够就拆上级）走的是另一条路：planExchange + applyExchange，见 G1a–d。
        VoidWarehouseData d2 = new VoidWarehouseData();
        stock(d2, Items.IRON_BLOCK, 4);
        stock(d2, Items.IRON_INGOT, 5);
        VoidWarehouseData.Withdrawal w9 = d2.withdraw(new ItemStack(Items.IRON_INGOT), BigInteger.valueOf(9));
        BigInteger conserved2 = d2.amountOf(Items.IRON_BLOCK).multiply(BigInteger.valueOf(9))
                .add(d2.amountOf(Items.IRON_INGOT));
        check("G1e withdraw 有货只给成品：要 9 给 " + w9.taken() + "、仓库剩 " + conserved2
                        + " 等价（应为 5 / 36，铁块一块不动）",
                w9.taken() == 5 && conserved2.equals(BigInteger.valueOf(36))
                        && d2.amountOf(Items.IRON_BLOCK).equals(BigInteger.valueOf(4)));

        // 上面那 5 条是「一例一钉」。下面这条才是通例：deltas 是**净变化**，
        // 交付量已经含在里面（拆块 +9 与交付 −9 相抵），所以任何一份计划的等价账
        // 都必须满足「仓库少掉的 == 玩家拿到的」。这就是「吞材料 / 凭空造物」的判据。
        conservationSweep();
        craftConservationSweep();

        // 连续 200 次随机取货：库存只减不增（除余量），且永不为负
        VoidWarehouseRecipes.Recipe sticks = recipe("minecraft:stick", 4,
                Map.of("minecraft:oak_planks", 2));
        d = stocked(sticks, Items.OAK_PLANKS, 1000);
        Random rnd = new Random(12345L);
        int totalTaken = 0;
        for (int i = 0; i < 200; i++) {
            int want = 1 + rnd.nextInt(64);
            VoidWarehouseData.Withdrawal w = d.withdraw(new ItemStack(Items.STICK), BigInteger.valueOf(want));
            totalTaken += w.taken();
        }
        BigInteger planks = d.amountOf(Items.OAK_PLANKS);
        BigInteger stickLeft = d.amountOf(Items.STICK);
        // 守恒：消耗的木板 == 2 × 合成次数；合成次数 × 4 == 给出 + 剩余
        BigInteger crafts = BigInteger.valueOf(1000).subtract(planks).divide(BigInteger.valueOf(2));
        check("G2 200 次随机取货后账平：给出 " + totalTaken + " + 剩余 " + stickLeft
                        + " == 4 × 合成 " + crafts + " 次",
                BigInteger.valueOf(totalTaken).add(stickLeft)
                        .equals(crafts.multiply(BigInteger.valueOf(4))));
        check("G2b 200 次随机取货后库存无负数", allNonNegative(d));
    }

    // ================================================================== P7 真落盘

    /**
     * 真落盘往返：把<b>当前存档</b>标脏 → 同步写盘 → 从游戏自己写出的那个 {@code .dat}
     * 读回来 → 逐条比对。
     *
     * <p>P1–P6 只证明「编解码器自己跟自己对得上」。它们<b>碰不到</b>三件事：
     * {@code SavedDataStorage} 的目录规则、磁盘文件的外层包装（{@code data} 子标签）、
     * 以及写盘时机。而玩家问的是「关服再开服，配方还在不在」—— 那三件恰好就是答案。</p>
     *
     * <p>不改任何内容，只调 {@code markChanged()} 标脏再存，所以跑完世界还是原样：
     * 审计不该把档写花。</p>
     */
    private static void persistenceDisk(MinecraftServer server) {
        System.out.println("[AUDIT] P7 真落盘");
        VoidWarehouseData live = VoidWarehouse.data(server);
        if (live == null) {
            check("P7 拿得到当前存档的数据对象", false);
            return;
        }
        live.markChanged();
        check("P7a 标脏生效（isDirty = " + live.isDirty() + "）", live.isDirty());
        server.overworld().getDataStorage().saveAndJoin();
        Path world = server.getWorldPath(LevelResource.ROOT);
        // 两种目录布局都认：≤1.21.x 是 world/data/<id>.dat，26.x 改成
        // world/dimensions/minecraft/overworld/data/<ns>/<name>.dat
        Path legacy = world.resolve("data/carpet_neko_addition_void_warehouse.dat");
        Path modern = world.resolve(
                "dimensions/minecraft/overworld/data/carpet_neko_addition/void_warehouse.dat");
        if (!Files.exists(legacy) && !Files.exists(modern)) {
            // 理论上到不了（saveAndJoin 是同步的）。留着它是因为「文件根本没生成」时，
            // 后面的 mtime 断言会红成一片，反而看不出根因；这里先把写盘这条路走到底。
            note("P7 第一次写盘没生成文件，改用服务器级存档兜底");
            server.saveEverything(true, true, true);
        }
        Path file = Files.exists(modern) ? modern : legacy;
        check("P7b 游戏把档写到了 " + world.relativize(file) + "（存在 " + Files.exists(file) + "）",
                Files.exists(file));
        if (!Files.exists(file)) {
            return;
        }
        // 「文件在」不等于「这次写的」：旧档也会在。mtime 是唯一能证明「刚刚真落盘」的证据，
        // 少了这一条，读到一份三周前的空档也会全绿。
        long ageMs = System.currentTimeMillis() - modifiedAt(file);
        check("P7c 这个档是刚刚写的（mtime 距今 " + (ageMs / 1000) + " 秒，应 < 120）",
                ageMs >= 0 && ageMs < 120_000L);
        CompoundTag tag;
        try {
            tag = NbtIo.readCompressed(file, NbtAccounter.unlimitedHeap());
        } catch (Exception e) {
            check("P7d 能从磁盘读出 NBT（" + e.getClass().getSimpleName() + "）", false);
            return;
        }
        check("P7d 能从磁盘读出 NBT", tag != null);
        if (tag == null) {
            return;
        }
        // 外层包装：{ DataVersion: N, data: { … } }。剥一层再解；剥不开就直接试原标签。
        VoidWarehouseData back = null;
        Tag inner = tag.get("data");
        if (inner instanceof CompoundTag dataTag) {
            back = decode(dataTag);
        }
        boolean wrapped = back != null;
        if (back == null) {
            back = decode(tag);
        }
        check("P7e 磁盘字节解得出仓库数据（剥掉外层 data 子标签" + (wrapped ? "成功" : "——直接解原标签") + "）",
                back != null);
        if (back == null) {
            return;
        }
        List<String> onDisk = texts(back);
        List<String> inMemory = texts(live);
        check("P7f 配方条数一致（磁盘 " + onDisk.size() + " / 内存 " + inMemory.size() + "）",
                onDisk.size() == inMemory.size());
        check("P7g 配方文本按序逐条相同", onDisk.equals(inMemory));
        List<String> diskEntries = entriesOf(back);
        List<String> memoryEntries = entriesOf(live);
        check("P7h 库存逐格一致（磁盘 " + diskEntries.size() + " 格 / 内存 " + memoryEntries.size() + " 格）",
                diskEntries.equals(memoryEntries));
    }

    /** 文件最后修改时刻（毫秒）；读不到返回 0 ⇒ 上面的 age 断言必红，不会静默放过 */
    private static long modifiedAt(Path file) {
        try {
            return Files.getLastModifiedTime(file).toMillis();
        } catch (Exception e) {
            return 0L;
        }
    }

    /** 库存逐格快照（排序后比较）：物品 + 数据组件 + 数量，一格一行 */
    private static List<String> entriesOf(VoidWarehouseData data) {
        List<String> out = new ArrayList<>();
        try {
            Field f = VoidWarehouseData.class.getDeclaredField("entries");
            f.setAccessible(true);
            for (Object o : (List<?>) f.get(data)) {
                VoidWarehouseData.Entry entry = (VoidWarehouseData.Entry) o;
                out.add(entry.template().getItem().getDescriptionId()
                        + "|" + entry.template().getComponents()
                        + "=" + entry.amount());
            }
        } catch (ReflectiveOperationException ignored) {
            // 反射拿不到就返回空表，P7f 自然会红（不静默通过）
        }
        out.sort(null);
        return out;
    }

    // ================================================================== 工具

    private static VoidWarehouseData stocked(VoidWarehouseRecipes.Recipe recipe, Item item, int amount) {
        VoidWarehouseData d = new VoidWarehouseData();
        d.learn(recipe);
        stock(d, item, amount);
        return d;
    }

    private static void stock(VoidWarehouseData d, Item item, int amount) {
        int left = amount;
        while (left > 0) {
            int n = Math.min(item.getDefaultMaxStackSize(), left);
            d.insert(new ItemStack(item, n));
            left -= n;
        }
    }

    private static VoidWarehouseRecipes.Recipe recipe(String output, int outputCount,
                                                      Map<String, Integer> parts) {
        List<VoidWarehouseRecipes.Part> list = new ArrayList<>();
        for (Map.Entry<String, Integer> e : parts.entrySet()) {
            list.add(new VoidWarehouseRecipes.Part(List.of(e.getKey()), e.getValue()));
        }
        return new VoidWarehouseRecipes.Recipe(null, output, outputCount, list);
    }

    private static CompoundTag encode(VoidWarehouseData data) {
        return (CompoundTag) VoidWarehouseData.CODEC.encodeStart(NbtOps.INSTANCE, data)
                .result().orElse(null);
    }

    private static VoidWarehouseData decode(CompoundTag tag) {
        return VoidWarehouseData.CODEC.parse(NbtOps.INSTANCE, tag).result().orElse(null);
    }

    private static CompoundTag encodeStack(Item item) {
        CompoundTag out = new CompoundTag();
        out.putString("id", VoidWarehouseRecipeBook.idOf(item));
        out.putInt("count", 1);
        return out;
    }

    @SuppressWarnings("unchecked")
    private static List<String> texts(VoidWarehouseData data) {
        try {
            Field f = VoidWarehouseData.class.getDeclaredField("recipeTexts");
            f.setAccessible(true);
            return new ArrayList<>((LinkedHashSet<String>) f.get(data));
        } catch (ReflectiveOperationException e) {
            return List.of();
        }
    }

    @SuppressWarnings("unchecked")
    private static boolean allNonNegative(VoidWarehouseData data) {
        try {
            Field f = VoidWarehouseData.class.getDeclaredField("entries");
            f.setAccessible(true);
            for (Object entry : (List<Object>) f.get(data)) {
                Field a = entry.getClass().getDeclaredField("amount");
                a.setAccessible(true);
                if (((BigInteger) a.get(entry)).signum() < 0) {
                    return false;
                }
            }
            return true;
        } catch (ReflectiveOperationException e) {
            return true;   // 反射拿不到就不冤枉它
        }
    }

    private static List<ServerPlayer> buildBots(MinecraftServer server, int count) {
        List<ServerPlayer> bots = new ArrayList<>(count);
        ServerLevel level = server.overworld();
        for (int i = 0; i < count; i++) {
            GameProfile profile = new GameProfile(UUID.randomUUID(), "auditbot" + i);
            ServerPlayer p = new ServerPlayer(server, level, profile, info());
            try {
                Connection conn = new Connection(PacketFlow.SERVERBOUND);
                p.connection = new ServerGamePacketListenerImpl(server, conn, p,
                        CommonListenerCookie.createInitial(profile, false));
            } catch (Throwable ignored) {
                // 假连接建不出来也不影响数据层断言
            }
            bots.add(p);
        }
        return bots;
    }

    private static ClientInformation info() {
        return new ClientInformation("zh_cn", 2,
                net.minecraft.world.entity.player.ChatVisiblity.FULL, true, 0,
                net.minecraft.world.entity.player.Player.DEFAULT_MAIN_HAND, false, false,
                net.minecraft.server.level.ParticleStatus.ALL);
    }

    private static void check(String label, boolean ok) {
        checks++;
        if (!ok) {
            failures++;
        }
        System.out.println((ok ? "   ok   " : "   FAIL ") + label);
    }

    private static void note(String text) {
        System.out.println("   note " + text);
    }
