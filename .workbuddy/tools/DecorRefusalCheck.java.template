package neko.voidwarehouse;

import net.minecraft.core.BlockPos;
import net.minecraft.core.Direction;
import net.minecraft.core.component.DataComponents;
import net.minecraft.network.chat.Component;
import net.minecraft.server.MinecraftServer;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.world.Container;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;
import net.minecraft.world.level.block.Blocks;
import net.minecraft.world.level.block.HopperBlock;
import net.minecraft.world.level.block.entity.BlockEntity;
import net.minecraft.world.level.block.entity.HopperBlockEntity;

import java.math.BigInteger;

/**
 * 【临时自检】出料漏斗的满盒标本：<b>干净盒子照出、带装饰的盒子一个都不许出</b>。
 *
 * <h2>两组口径</h2>
 * <ol>
 *   <li><b>干净满盒</b>：不依赖配方本（①' 现场装），5 tick 出 5 个，本体 + 盒内实物各扣一份；</li>
 *   <li><b>带装饰</b>（改名 / 附魔 / 任何多出来的组件）：<b>一个物品都不许出</b>，
 *       仓库账目一个字节都不许动 —— 仓库复现不出装饰，交白板是偷偷改单，
 *       交原样是每个 tick 免费复制装饰。</li>
 * </ol>
 *
 * <p>判据只认<b>下游箱子里到底装着什么</b>与<b>仓库账目的变化量</b>。</p>
 */
public final class DecorRefusalCheck {

    private static boolean done = false;
    private static int checks = 0;
    private static int failures = 0;

    private static final int BASE_X = 500;
    private static final int BASE_Z = 500;
    private static final int TABLE_Y = 120;
    private static final int HOPPER_Y = 119;
    private static final int CHEST_Y = 118;

    private static final int TICKS = 5;
    private static final int BOX_STOCK = 100;
    private static final int COBBLE_STOCK = 10_000;
    private static final int FULL_BOX_COBBLE = VoidWarehouseShulker.capacity(new ItemStack(Items.COBBLESTONE));

    private static int stage = 0;
    private static int waited = 0;
    private static int tickIndex = 0;

    private static BlockPos table;
    private static BlockPos hopper;
    private static BlockPos chest;

    private DecorRefusalCheck() {
    }

    public static void run(MinecraftServer server) {
        if (done) {
            return;
        }
        VoidWarehouseSettings.voidWarehouse = true;
        try {
            step(server);
        } catch (Throwable t) {
            failures++;
            System.out.println("!! 自检抛异常: " + t);
            t.printStackTrace(System.out);
            finish(server);
        }
    }

    private static void step(MinecraftServer server) {
        ServerLevel level = server.overworld();
        switch (stage) {
            case 0:
                for (int cx = BASE_X >> 4; cx <= (BASE_X + 8) >> 4; cx++) {
                    for (int cz = BASE_Z >> 4; cz <= (BASE_Z + 8) >> 4; cz++) {
                        level.setChunkForced(cx, cz, true);
                    }
                }
                break;
            case 1:
                if (!level.isLoaded(new BlockPos(BASE_X, HOPPER_Y, BASE_Z))) {
                    if (++waited > 300) {
                        System.out.println("!! 区块加载超时");
                        stage = 999;
                        return;
                    }
                    return;
                }
                break;
            case 2:
                build(server);
                break;
            case 3:
                if (asHopper(level.getBlockEntity(hopper)) == null) {
                    if (++waited > 100) {
                        System.out.println("!! 漏斗方块实体没就位");
                        stage = 999;
                        return;
                    }
                    return;
                }
                System.out.println("DECOR 场地就位 满盒容量=" + FULL_BOX_COBBLE
                        + " learned=" + VoidWarehouse.data(server).learnedRecipeCount());
                break;

            // G1：干净满盒 + 两条规则全开但没学配方 → 必须出货
            case 4:
                seed(server, true, filledBox());
                break;
            case 5:
                if (measure(server, "G1", TICKS)) {
                    return;
                }
                break;

            // G2：干净满盒 + 两条规则全关 → 仍然必须出货（证明不依赖可选规则）
            case 6:
                seed(server, false, filledBox());
                break;
            case 7:
                if (measure(server, "G2", TICKS)) {
                    return;
                }
                break;

            // G3：改名满盒 → 一个都不许出
            case 8:
                seed(server, true, named(filledBox(), "改了名的盒子"));
                break;
            case 9:
                if (measure(server, "G3", 0)) {
                    return;
                }
                break;

            // G4：改名空盒（身上没有实物）→ 也不许交出「洁净本体」充数
            case 10:
                seed(server, true, named(new ItemStack(Items.SHULKER_BOX), "空盒子也有名字"));
                break;
            case 11:
                if (measure(server, "G4", 0)) {
                    return;
                }
                break;

            default:
                finish(server);
                return;
        }
        stage++;
    }

    private static void seed(MinecraftServer server, boolean rulesOn, ItemStack specimen) {
        ServerLevel level = server.overworld();
        VoidWarehouseSettings.voidWarehouseCraft = rulesOn;
        VoidWarehouseSettings.voidWarehouseExchange = rulesOn;
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.SHULKER_BOX, BOX_STOCK));
        data.insert(new ItemStack(Items.COBBLESTONE, COBBLE_STOCK));
        fillHopper(level, hopper, ItemStack.EMPTY);
        setSlot(level, hopper, 0, specimen);
        emptyChest(server, chest);
        tickIndex = 0;
    }

    /** 跑 {@code TICKS} 个 tick 的观测窗口；返回 true 表示还没跑完 */
    private static boolean measure(MinecraftServer server, String tag, int expectBoxes) {
        trace(server, tag, tickIndex);
        if (++tickIndex <= TICKS) {
            return true;
        }
        int[] c = chestStats(server, chest);
        long boxes = amount(server, Items.SHULKER_BOX);
        long cobble = amount(server, Items.COBBLESTONE);
        System.out.println("DECOR [" + tag + "] 结算 下游盒=" + c[0] + " 盒内=" + c[1]
                + " 空盒=" + boxes + " 圆石=" + cobble + " 漏斗=" + describeSlots(server, hopper));
        check(tag + " 下游收到 " + expectBoxes + " 个盒子（实际 " + c[0] + "）", c[0] == expectBoxes);
        check(tag + " 下游盒内共 " + expectBoxes * FULL_BOX_COBBLE + " 件（实际 " + c[1] + "）",
                c[1] == expectBoxes * FULL_BOX_COBBLE);
        check(tag + " 仓库空盒 " + BOX_STOCK + "→" + (BOX_STOCK - expectBoxes) + "（实际 " + boxes + "）",
                boxes == BOX_STOCK - expectBoxes);
        check(tag + " 仓库圆石 " + COBBLE_STOCK + "→" + (COBBLE_STOCK - (long) expectBoxes * FULL_BOX_COBBLE)
                + "（实际 " + cobble + "）", cobble == COBBLE_STOCK - (long) expectBoxes * FULL_BOX_COBBLE);
        check(tag + " 标本原样还在", specimenIntact(server));
        tickIndex = 0;
        return false;
    }

    private static void build(MinecraftServer server) {
        ServerLevel level = server.overworld();
        table = new BlockPos(BASE_X, TABLE_Y, BASE_Z);
        hopper = table.below();
        chest = hopper.below();
        level.setBlock(table, Blocks.CRAFTING_TABLE.defaultBlockState(), 3);
        level.setBlock(hopper, Blocks.HOPPER.defaultBlockState()
                .setValue(HopperBlock.FACING, Direction.DOWN)
                .setValue(HopperBlock.ENABLED, true), 3);
        level.setBlock(chest, Blocks.CHEST.defaultBlockState(), 3);
    }

    private static ItemStack filledBox() {
        return VoidWarehouseShulker.pack(new ItemStack(Items.COBBLESTONE), FULL_BOX_COBBLE);
    }

    private static ItemStack named(ItemStack stack, String name) {
        ItemStack copy = stack.copy();
        copy.set(DataComponents.CUSTOM_NAME, Component.literal(name));
        return copy;
    }

    // ================================================================ 观察

    private static void trace(MinecraftServer server, String tag, int tick) {
        int[] c = chestStats(server, chest);
        System.out.println("DECOR   trace " + tag + " tick" + tick
                + " 漏斗[" + describeSlots(server, hopper) + "]"
                + " 空盒=" + amount(server, Items.SHULKER_BOX)
                + " 圆石=" + amount(server, Items.COBBLESTONE)
                + " 下游盒=" + c[0] + "/内" + c[1]);
    }

    private static boolean specimenIntact(MinecraftServer server) {
        HopperBlockEntity h = asHopper(server.overworld().getBlockEntity(hopper));
        if (h == null) {
            return false;
        }
        return !h.getItem(0).isEmpty();
    }

    private static int contentsOf(ItemStack stack) {
        if (stack == null || stack.isEmpty()) {
            return 0;
        }
        int inside = 0;
        for (ItemStack in : VoidWarehouseShulker.contentsOf(stack)) {
            inside += in.getCount();
        }
        return inside;
    }

    private static String describeSlots(MinecraftServer server, BlockPos pos) {
        HopperBlockEntity h = asHopper(server.overworld().getBlockEntity(pos));
        if (h == null) {
            return "<无方块实体>";
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < h.getContainerSize(); i++) {
            ItemStack s = h.getItem(i);
            if (s.isEmpty()) {
                continue;
            }
            if (sb.length() > 0) {
                sb.append(',');
            }
            sb.append(i).append(':').append(s.getCount()).append('x')
                    .append(s.getItem().getDescriptionId());
            if (VoidWarehouseShulker.isShulkerBox(s)) {
                sb.append("(内").append(contentsOf(s)).append(')');
            }
        }
        return sb.length() == 0 ? "<空>" : sb.toString();
    }

    private static int[] chestStats(MinecraftServer server, BlockPos pos) {
        Container c = container(server, pos);
        int boxes = 0;
        int inside = 0;
        if (c == null) {
            return new int[]{0, 0};
        }
        for (int i = 0; i < c.getContainerSize(); i++) {
            ItemStack s = c.getItem(i);
            if (s.isEmpty()) {
                continue;
            }
            if (VoidWarehouseShulker.isShulkerBox(s)) {
                boxes += s.getCount();
                inside += contentsOf(s) * s.getCount();
            }
        }
        return new int[]{boxes, inside};
    }

    private static void emptyChest(MinecraftServer server, BlockPos pos) {
        Container c = container(server, pos);
        if (c == null) {
            return;
        }
        for (int i = 0; i < c.getContainerSize(); i++) {
            c.setItem(i, ItemStack.EMPTY);
        }
        if (c instanceof BlockEntity be) {
            be.setChanged();
        }
    }

    private static Container container(MinecraftServer server, BlockPos pos) {
        BlockEntity be = server.overworld().getBlockEntity(pos);
        return be instanceof Container c ? c : null;
    }

    private static HopperBlockEntity asHopper(BlockEntity be) {
        return be instanceof HopperBlockEntity h ? h : null;
    }

    private static long amount(MinecraftServer server, Item item) {
        BigInteger n = VoidWarehouse.data(server).amountOf(item);
        return n == null ? -1 : n.longValue();
    }

    private static void fillHopper(ServerLevel level, BlockPos pos, ItemStack stack) {
        HopperBlockEntity h = asHopper(level.getBlockEntity(pos));
        if (h == null) {
            return;
        }
        for (int i = 0; i < h.getContainerSize(); i++) {
            h.setItem(i, stack.copy());
        }
        h.setChanged();
    }

    private static void setSlot(ServerLevel level, BlockPos pos, int slot, ItemStack stack) {
        HopperBlockEntity h = asHopper(level.getBlockEntity(pos));
        if (h == null) {
            return;
        }
        h.setItem(slot, stack);
        h.setChanged();
    }

    private static void check(String label, boolean ok) {
        checks++;
        if (ok) {
            System.out.println("DECOR   ok   " + label);
        } else {
            failures++;
            System.out.println("DECOR   FAIL " + label);
        }
    }

    private static void finish(MinecraftServer server) {
        done = true;
        // 🔴 收尾必须拆干净：run 世界是持久的、仓库全存档唯一，
        // 留下的试样会让下一个自检多出一个漏斗抢料。
        try {
            ServerLevel level = server.overworld();
            if (hopper != null) {
                fillHopper(level, hopper, ItemStack.EMPTY);
                emptyChest(server, chest);
                level.setBlock(hopper, Blocks.AIR.defaultBlockState(), 3);
                level.setBlock(chest, Blocks.AIR.defaultBlockState(), 3);
                level.setBlock(table, Blocks.AIR.defaultBlockState(), 3);
            }
        } catch (Throwable ignored) {
            // 收尾失败不影响判据
        }
        System.out.println("SMOKE RESULT vw-decor-refusal/26.3 checks=" + checks
                + " failures=" + failures);
        server.halt(false);
    }
}
