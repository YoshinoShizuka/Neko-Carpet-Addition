package neko.voidwarehouse;

import net.minecraft.core.component.DataComponents;
import net.minecraft.network.chat.Component;
import net.minecraft.server.MinecraftServer;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;
import net.minecraft.world.item.component.ItemLore;

import java.math.BigInteger;
import java.util.List;

/**
 * 【临时自检】合成页（独立入口）+ 位置钉住（连点不点错）。
 *
 * <h2>两组口径</h2>
 * <ol>
 *   <li><b>合成入口与库存脱钩</b>：仓库里明明存着 800 个铁锭，「铁锭」的合成条目
 *       仍然必须出现在合成页；仓库页则<b>一格可兑条目都不许混进来</b>。</li>
 *   <li><b>点击目标 = 实际拿到</b>：数量排序下连点同一格，后台数量序早就换人了，
 *       界面这一格<b>不许跟着换</b>；取空之后留空洞，再点不许误取顶上来的那一件；
 *       只有停手满 {@code IDLE_TICKS} 才归位。</li>
 * </ol>
 *
 * <p>判据全部落在<b>玩家能看到的那一格</b>（{@code Container#getItem}）与
 * <b>真正拿到的那个堆叠</b>（{@code Container#removeItem}）上 ——
 * 前者是「看到的」，后者是「拿到的」，两者不一致就是玩家嘴里的「拿错物品」。</p>
 *
 * <p>本自检<b>不需要假玩家</b>：界面容器是包内可见的，直接 new 一个就能按
 * 「渲染 / 点击」两件事分别问它。菜单层（{@code VoidWarehouseMenu#clicked}）只是把这两步
 * 串起来，口径以本类为准。</p>
 */
public final class VoidWarehouseInteractionCheck {

    private static boolean done = false;
    private static int checks = 0;
    private static int failures = 0;
    private static int stage = 0;

    private static VoidWarehouseData data;
    private static VoidWarehouseViews.View view;
    private static VoidWarehousePageContainer page;
    private static MinecraftServer server;

    /** 累计「已交给玩家」的数量，用于最后的守恒断言 */
    private static long delivered = 0;

    private static final int COBBLE = 900;
    private static final int INGOT = 800;
    private static final int NUGGET = 700;
    private static final int BOX = 100;
    private static final int SEED_TOTAL = COBBLE + INGOT + NUGGET + BOX;

    private VoidWarehouseInteractionCheck() {
    }

    public static void run(MinecraftServer mcServer) {
        if (done) {
            return;
        }
        server = mcServer;
        VoidWarehouseSettings.voidWarehouse = true;
        VoidWarehouseSettings.voidWarehouseExchange = true;
        // 配方本在这一组里不参与：只用 9 合 1 表，条目集合才是确定的
        VoidWarehouseSettings.voidWarehouseCraft = false;
        try {
            step(server);
        } catch (Throwable t) {
            failures++;
            System.out.println("!! 交互自检抛异常: " + t);
            t.printStackTrace(System.out);
            finish();
        }
    }

    private static void step(MinecraftServer server) {
        data = VoidWarehouse.data(server);
        switch (stage) {
            case 0 -> g1();
            case 1 -> g2();
            case 2 -> g2b();
            case 3 -> g3();
            case 4 -> g4();
            case 5 -> g5();
            case 6 -> g6();
            default -> {
                finish();
                return;
            }
        }
        stage++;
    }

    // ================================================================ G1 合成入口与库存无关

    /**
     * 仓库里只有 9 个铁粒时，「铁锭」是一条可兑条目；再存进 64 个铁锭之后，
     * 那一条<b>必须还在</b>（老实现里它会被这条存量整个抹掉，玩家从此做不了铁锭）。
     */
    private static void g1() {
        data.clearContent();
        delivered = 0;
        data.insert(new ItemStack(Items.IRON_NUGGET, 9));
        bumpTick();
        List<VoidWarehouseData.ExchangeOffer> offers = data.exchangeOffers();
        check("G1 只有 9 铁粒 → 出现「铁锭」可兑条目" + tail(offers), hasOffer(offers, "iron_ingot"));
        check("G1 只有 9 铁粒 → 「铁块」还做不出来（不该出现）", !hasOffer(offers, "iron_block"));
        check("G1 仓库页只画真实格：1 种（实际 " + data.displayCount() + "）", data.displayCount() == 1);

        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        bumpTick();
        offers = data.exchangeOffers();
        check("G1 仓库已有 64 铁锭 → 「铁锭」条目仍在（曾经会被抹掉）", hasOffer(offers, "iron_ingot"));
        check("G1 有了铁锭 → 「铁块」条目随之出现", hasOffer(offers, "iron_block"));
        check("G1 仓库页仍是 2 种真实格，没混入可兑条目（实际 " + data.displayCount() + "）",
                data.displayCount() == 2);

        VoidWarehouseData.ExchangeOffer ingot = offer(offers, "iron_ingot");
        ItemStack shown = ingot == null ? ItemStack.EMPTY
                : VoidWarehouseData.buildCatalogDisplay(ingot, false, 64L, false);
        check("G1 合成页那一格的图标是铁锭", shown.is(Items.IRON_INGOT));
        check("G1 合成页写着「仓库已有 64」：[" + loreOf(shown) + "]", loreContains(shown, "仓库已有 64"));
        check("G1 合成页写着「左键…一组」：[" + loreOf(shown) + "]", loreContains(shown, "一组"));
        check("G1 合成页<b>不再</b>写「仓库里没有这种物品」", !loreContains(shown, "仓库里没有"));
        System.out.println("INT trace G1 offers=" + offers.size() + " 首条="
                + (offers.isEmpty() ? "<无>" : offers.get(0).itemId()));
    }

    // ================================================================ G2 连点不点错

    /**
     * 数量排序下，后台序列「每隔一次点击就换一次头」，而界面这一格必须一直是同一件东西。
     *
     * <p>种子刻意选成 <b>900 / 800 / 700 / 100</b>：圆石点两下就掉到 800 以下，
     * 后台的第一名立刻变成铁锭 —— 老实现里第 3 次点击就会拿到铁锭（玩家看到的却是圆石）。</p>
     */
    private static void g2() {
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, COBBLE));
        data.insert(new ItemStack(Items.IRON_INGOT, INGOT));
        data.insert(new ItemStack(Items.IRON_NUGGET, NUGGET));
        data.insert(new ItemStack(Items.SHULKER_BOX, BOX));
        bumpTick();
        view = new VoidWarehouseViews.View(0, false, true, 0, 0);
        page = new VoidWarehousePageContainer(data, view, false);
        page.noteInteraction();

        check("G2 数量排序：第 0 格是圆石（实际 " + describe(0) + "）", page.getItem(0).is(Items.COBBLESTONE));
        check("G2 第 1 格是铁锭、第 2 格是铁粒（" + describe(1) + " / " + describe(2) + "）",
                page.getItem(1).is(Items.IRON_INGOT) && page.getItem(2).is(Items.IRON_NUGGET));

        for (int i = 1; i <= 5; i++) {
            ItemStack seen = page.getItem(0);
            VoidWarehouseData.DisplaySlot target = page.slotAt(0);
            ItemStack got = page.removeItem(0, 64);
            boolean same = seen.is(Items.COBBLESTONE) && got.is(Items.COBBLESTONE)
                    && target.entry() != null && target.entry().template().is(Items.COBBLESTONE);
            check("G2 第 " + i + " 次连点：看到的 / 点中的 / 拿到的 都是圆石"
                    + "（看到 " + name(seen) + "、拿到 " + name(got) + "×" + got.getCount() + "）", same);
            delivered += got.getCount();
            page.noteInteraction();
        }
        check("G2 5 次连点共交出 320 个圆石（实际 " + (COBBLE - amount(Items.COBBLESTONE)) + "）",
                amount(Items.COBBLESTONE) == COBBLE - 320);
        check("G2 格子上的数字实时刷新：「" + loreOf(page.getItem(0)) + "」写着 580",
                loreContains(page.getItem(0), "580"));

        // 对照组：证明这套判据真的在拦一件会发生的事 —— 后台第一名此刻已经是铁锭
        Item top = topOfAmountOrder();
        check("G2 对照组：后台数量序已把铁锭顶到第一（实际 " + nameOf(top) + "）", top == Items.IRON_INGOT);
        check("G2 但界面第 0 格仍是圆石（钉住生效，实际 " + describe(0) + "）", page.getItem(0).is(Items.COBBLESTONE));
        System.out.println("INT trace G2 后台首格=" + nameOf(top) + " 界面首格=" + describe(0));
    }

    // ================================================================ G2b 取空留空洞

    /**
     * 一直点到圆石见底：中间每一次都必须还是圆石；取空之后这一格<b>空着</b>，
     * 绝不能把顶上来的铁锭交出去。
     */
    private static void g2b() {
        int guard = 0;
        boolean allCobble = true;
        while (amount(Items.COBBLESTONE) > 0 && guard++ < 100) {
            ItemStack got = page.removeItem(0, 64);
            if (!got.is(Items.COBBLESTONE)) {
                allCobble = false;
                System.out.println("INT   取空过程中拿到 " + name(got) + "×" + got.getCount());
                break;
            }
            delivered += got.getCount();
            page.noteInteraction();
        }
        check("G2b 取空过程中拿到的全是圆石（" + guard + " 次）", allCobble);
        check("G2b 圆石已取空（实际 " + amount(Items.COBBLESTONE) + "）", amount(Items.COBBLESTONE) == 0);
        check("G2b 取空后第 0 格是空洞（屏障占位，实际 " + describe(0) + "）", page.getItem(0).is(Items.BARRIER));
        check("G2b 空洞背后没有指向任何物品", page.slotAt(0).isEmpty());
        ItemStack again = page.removeItem(0, 64);
        check("G2b 再点空洞：什么都拿不到（实际 " + name(again) + "）", again.isEmpty());
        check("G2b 铁锭一个都没被误取（仍是 " + INGOT + "，实际 " + amount(Items.IRON_INGOT) + "）",
                amount(Items.IRON_INGOT) == INGOT);
        check("G2b 按钮格不可取出", page.removeItem(VoidWarehouseData.NAV_START, 1).isEmpty());
        System.out.println("INT trace G2b 已交出 " + delivered + " 个，页首 " + describe(0));
    }

    // ================================================================ G3 停手才归位

    /** 停手 39 tick 仍留空洞；满 40 tick 才把铁锭补上来（这就是 IDLE_TICKS 的全部语义） */
    private static void g3() {
        // 「停手计时」从这一 tick 起算：本方法每 stage 占一个 tick，
        // 上一阶段最后一次 noteInteraction() 落在<b>前</b>一个 tick，直接拿 nowTick() 当基准会差 1。
        page.noteInteraction();
        long base = VoidWarehouseData.nowTick();
        VoidWarehouseData.noteServerTick((int) (base + VoidWarehousePageContainer.IDLE_TICKS - 1));
        check("G3 停手 " + (VoidWarehousePageContainer.IDLE_TICKS - 1) + " tick：第 0 格仍是空洞（实际 "
                + describe(0) + "）", page.getItem(0).is(Items.BARRIER));
        VoidWarehouseData.noteServerTick((int) (base + VoidWarehousePageContainer.IDLE_TICKS));
        check("G3 停手满 " + VoidWarehousePageContainer.IDLE_TICKS + " tick：铁锭归位到第 0 格（实际 "
                + describe(0) + "）", page.getItem(0).is(Items.IRON_INGOT));
        check("G3 第 1 格是铁粒、第 2 格是潜影盒（" + describe(1) + " / " + describe(2) + "）",
                page.getItem(1).is(Items.IRON_NUGGET) && page.getItem(2).is(Items.SHULKER_BOX));
        // 归位之后再点就是「真的点到了这一格」，拿到的必须是铁锭
        ItemStack got = page.removeItem(0, 64);
        check("G3 归位后点第 0 格 → 拿到铁锭（实际 " + name(got) + "×" + got.getCount() + "）",
                got.is(Items.IRON_INGOT) && got.getCount() == 64);
        delivered += got.getCount();
    }

    // ================================================================ G4 合成页

    /** 底栏第 45 格是固定的界面切换钮；两个界面页码各记一份；合成页内容与库存无关 */
    private static void g4() {
        page.setCraftScreen(true);
        List<VoidWarehouseData.ExchangeOffer> offers = data.exchangeOffers();
        int expectPages = Math.max(1,
                (offers.size() + VoidWarehouseData.PAGE_SIZE - 1) / VoidWarehouseData.PAGE_SIZE);
        check("G4 合成页页数 = ceil(" + offers.size() + "/" + VoidWarehouseData.PAGE_SIZE
                + ") = " + expectPages + "（实际 " + page.pageCount() + "）", page.pageCount() == expectPages);
        check("G4 合成页第 45 格是「返回仓库」（箱子，实际 " + describe(45) + "）",
                page.getItem(VoidWarehouseData.NAV_START).is(Items.CHEST));
        check("G4 合成页条目不能从 removeItemNoUpdate 这条老路取出",
                page.removeItemNoUpdate(0).isEmpty());

        int foundAt = -1;
        for (int p = 0; p < page.pageCount() && foundAt < 0; p++) {
            page.setPage(p);
            for (int i = 0; i < VoidWarehouseData.PAGE_SIZE; i++) {
                ItemStack s = page.getItem(i);
                if (!s.isEmpty() && s.is(Items.IRON_INGOT)) {
                    foundAt = p * VoidWarehouseData.PAGE_SIZE + i;
                    break;
                }
            }
        }
        check("G4 仓库里已有 " + amount(Items.IRON_INGOT) + " 个铁锭，合成页仍列出「铁锭」"
                + "（位置 " + foundAt + "）", foundAt >= 0);
        // 仓库页不许出现可兑条目：它的格数恒等于库存种类数
        check("G4 仓库页格数 = 库存种类数（" + data.displayCount() + "），没有虚拟格",
                data.displayCount() == data.entryCount());

        page.setPage(0);
        if (!offers.isEmpty()) {
            check("G4 合成页左键说明是「一组」：[" + loreOf(page.getItem(0)) + "]",
                    loreContains(page.getItem(0), "一组"));
        }

        page.setCraftScreen(false);
        check("G4 仓库页第 45 格是「合成台」（实际 " + describe(45) + "）",
                page.getItem(VoidWarehouseData.NAV_START).is(Items.CRAFTING_TABLE));
        check("G4 仓库页页码 = 0（实际 " + view.page() + "）", view.page() == 0);
        page.setCraftScreen(true);
        page.setPage(1);
        check("G4 合成页页码独立保存（craftPage=" + view.craftPage() + "）", view.craftPage() == 1);
        page.setCraftScreen(false);
        check("G4 回仓库页：页码没被合成页顶掉（page=" + view.page() + "）", view.page() == 0);
        page.setCraftScreen(true);
        check("G4 再进合成页：还是离开时那一页（craftPage=" + view.craftPage() + "）", view.craftPage() == 1);
        page.setPage(0);
        page.setCraftScreen(false);
        System.out.println("INT trace G4 offers=" + offers.size() + " craftPages=" + expectPages);
    }

    // ================================================================ G5 守恒

    /** 一共交出去多少，仓库就少了多少 —— 不多不少（错取/多扣都会让这条红） */
    private static void g5() {
        BigInteger total = data.totalAmount();
        long expect = SEED_TOTAL - delivered;
        check("G5 守恒：仓库合计 " + expect + "（= " + SEED_TOTAL + " − 已交出 " + delivered
                + "），实际 " + total, total.longValue() == expect);
        check("G5 剩余三件：铁锭 " + (INGOT - 64) + " / 铁粒 " + NUGGET + " / 潜影盒 " + BOX,
                amount(Items.IRON_INGOT) == INGOT - 64
                        && amount(Items.IRON_NUGGET) == NUGGET
                        && amount(Items.SHULKER_BOX) == BOX);
    }

    // ================================================================ G6 惰性算源

    /**
     * {@code bulk()} / {@code boxed()} 建表时不再算（占了重算成本的一大半），改成第一次被问到时
     * 才算一次。这一组盯住两件事：<b>值必须还是规划器给的</b>、<b>不能退化成
     * 「min(堆叠上限, 可兑数量)」那种瞎猜</b>（9 个铁块兑一组铁锭，瞎猜给 64，真值是 63）。
     */
    private static void g6() {
        data.clearContent();
        data.insert(new ItemStack(Items.IRON_BLOCK, 9));
        bumpTick();
        VoidWarehouseData.ExchangeOffer ingot = offer(data.exchangeOffers(), "iron_ingot");
        check("G6 9 铁块 → 出现「铁锭」条目", ingot != null);
        if (ingot == null) {
            return;
        }
        BigInteger bulk = ingot.bulk();
        VoidWarehouseExchange.Plan byClick =
                data.planExchangeMax(new ItemStack(Items.IRON_INGOT), BigInteger.valueOf(64));
        check("G6 惰性 bulk 与点击路径同源（" + bulk + " vs "
                        + (byClick == null ? "<无>" : byClick.amount()) + "）",
                byClick != null && bulk.equals(byClick.amount()));
        check("G6 bulk 不是「min(64, 可兑 " + ingot.obtainable() + ")」的瞎猜（实际 " + bulk + "）",
                ingot.obtainable().compareTo(BigInteger.valueOf(64)) < 0
                        || !bulk.equals(BigInteger.valueOf(64)));
        check("G6 再问一次还是同一个数（缓存生效）", ingot.bulk().equals(bulk));
        BigInteger boxed = ingot.boxed();
        check("G6 boxed 也问了规划器：一盒 " + boxed + " 个", boxed.signum() > 0);
        check("G6 boxed 不超过一盒容量", boxed.compareTo(BigInteger.valueOf(
                VoidWarehouseShulker.capacity(new ItemStack(Items.IRON_INGOT)))) <= 0);
        System.out.println("INT trace G6 可兑=" + ingot.obtainable() + " bulk=" + bulk + " boxed=" + boxed);
    }

    // ================================================================ 工具

    /** 把服务端 tick 往前推一格：{@code exchangeOffers()} 的快照是<b>按 tick 合并</b>的 */
    private static void bumpTick() {
        VoidWarehouseData.noteServerTick((int) (VoidWarehouseData.nowTick() + 1));
    }

    private static long amount(Item item) {
        BigInteger n = data.amountOf(item);
        return n == null ? -1 : n.longValue();
    }

    /** 后台数量序的第一名（对照组：证明「不钉住就会换人」确有其事） */
    private static Item topOfAmountOrder() {
        int[] order = data.displayAmountOrder();
        if (order.length == 0) {
            return null;
        }
        VoidWarehouseData.DisplaySlot slot = data.displaySlotAt(order[0]);
        return slot.entry() == null ? null : slot.entry().template().getItem();
    }

    private static boolean hasOffer(List<VoidWarehouseData.ExchangeOffer> offers, String path) {
        return offer(offers, path) != null;
    }

    /** 按 path 口径找条目（9 合 1 表只留 path，配方本是全名，这里两侧都认） */
    private static VoidWarehouseData.ExchangeOffer offer(List<VoidWarehouseData.ExchangeOffer> offers,
                                                        String path) {
        for (VoidWarehouseData.ExchangeOffer o : offers) {
            String id = o.itemId();
            if (id.startsWith("minecraft:")) {
                id = id.substring("minecraft:".length());
            }
            if (id.equals(path)) {
                return o;
            }
        }
        return null;
    }

    private static String tail(List<VoidWarehouseData.ExchangeOffer> offers) {
        return offers.isEmpty() ? "（清单为空）" : "（清单 " + offers.size() + " 条）";
    }

    private static String name(ItemStack stack) {
        return stack == null || stack.isEmpty() ? "<空>" : stack.getItem().getDescriptionId();
    }

    private static String nameOf(Item item) {
        return item == null ? "<空>" : item.getDescriptionId();
    }

    /** 某一格现在长什么样（诊断用） */
    private static String describe(int slot) {
        if (page == null) {
            return "<无界面>";
        }
        ItemStack s = page.getItem(slot);
        return name(s) + "×" + s.getCount();
    }

    private static boolean loreContains(ItemStack stack, String needle) {
        if (stack == null || stack.isEmpty()) {
            return false;
        }
        ItemLore lore = stack.get(DataComponents.LORE);
        if (lore == null) {
            return false;
        }
        for (Component line : lore.lines()) {
            if (line.getString().contains(needle)) {
                return true;
            }
        }
        return false;
    }

    private static String loreOf(ItemStack stack) {
        if (stack == null || stack.isEmpty()) {
            return "<空>";
        }
        ItemLore lore = stack.get(DataComponents.LORE);
        if (lore == null) {
            return "<无 lore>";
        }
        StringBuilder sb = new StringBuilder();
        for (Component line : lore.lines()) {
            if (sb.length() > 0) {
                sb.append(" / ");
            }
            sb.append(line.getString());
        }
        return sb.toString();
    }

    private static void check(String label, boolean ok) {
        checks++;
        if (ok) {
            System.out.println("INT   ok   " + label);
        } else {
            failures++;
            System.out.println("INT   FAIL " + label);
        }
    }

    private static void finish() {
        done = true;
        // 收尾把仓库清干净：run 世界是持久的、仓库全存档唯一，
        // 留下的试样会让下一个自检读到别人的库存。
        try {
            if (data != null) {
                data.clearContent();
            }
        } catch (Throwable ignored) {
            // 收尾失败不影响判据
        }
        System.out.println("SMOKE RESULT vw-interaction checks=" + checks
                + " failures=" + failures);
        server.halt(false);
    }
}
