package neko.voidwarehouse;

import net.minecraft.server.MinecraftServer;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;

import java.math.BigInteger;
import java.util.List;

/**
 * 【临时探针】把 MP 峰值那一 tick 的「可兑表重算」拆开量：9 合 1 单独 / 加上配方本各多少。
 *
 * <p>用与 {@code SystemTest} 的 MP 峰值完全相同的种子（每条边的 small 侧各 6400），
 * 所以量出来的数能直接对上那条断言。</p>
 */
public final class OfferCostProbe {

    private static boolean done = false;
    private static int stage = 0;
    private static long tickLine = 0;
    private static VoidWarehouseData data;

    private OfferCostProbe() {
    }

    public static void run(MinecraftServer server) {
        if (done) {
            return;
        }
        data = VoidWarehouse.data(server);
        try {
            switch (stage) {
                case 0 -> {
                    VoidWarehouseSettings.voidWarehouse = true;
                    VoidWarehouseSettings.voidWarehouseExchange = true;
                    VoidWarehouseSettings.voidWarehouseCraft = false;
                    data.clearContent();
                    for (VoidWarehouseExchange.Edge edge : VoidWarehouseExchange.active().edges()) {
                        Item small = VoidWarehouseExchangeBootstrap.itemOf(edge.small());
                        if (small != null) {
                            data.insert(new ItemStack(small, 6400));
                        }
                    }
                    measure("9 合 1 only");
                }
                case 1 -> {
                    VoidWarehouseSettings.voidWarehouseCraft = true;
                    // 预热：第一次会整批重算配方本（746 条），不计时
                    bump();
                    int warm = data.exchangeOffers().size();
                    System.out.println("PROBE 预热后 offers=" + warm);
                    measure("9 合 1 + 配方本");
                }
                default -> {
                    done = true;
                    System.out.println("PROBE DONE");
                    server.halt(false);
                    return;
                }
            }
        } catch (Throwable t) {
            System.out.println("!! 探针抛异常: " + t);
            t.printStackTrace(System.out);
            done = true;
            server.halt(false);
            return;
        }
        stage++;
    }

    private static void bump() {
        VoidWarehouseData.noteServerTick((int) (++tickLine + 100_000));
    }

    private static void measure(String label) {
        long best = Long.MAX_VALUE;
        int offers = 0;
        for (int round = 0; round < 5; round++) {
            // 真的脏一下：同一件物品入库，可兑表必然要重算
            data.insert(new ItemStack(net.minecraft.world.item.Items.IRON_NUGGET, 64));
            bump();
            long t0 = System.nanoTime();
            List<VoidWarehouseData.ExchangeOffer> list = data.exchangeOffers();
            best = Math.min(best, System.nanoTime() - t0);
            offers = list.size();
        }
        // 有多少条是「仓库里本来就有这件物品」—— 正是本次改动新增出来的那些
        int stocked = 0;
        for (VoidWarehouseData.ExchangeOffer offer : data.exchangeOffers()) {
            Item item = offer.template().getItem();
            if (data.amountOf(item).signum() > 0) {
                stocked++;
            }
        }
        System.out.printf("PROBE %-18s offers=%d（其中仓库已有 %d） 重算 %6.3f ms%n",
                label, offers, stocked, best / 1_000_000.0);
    }
}
