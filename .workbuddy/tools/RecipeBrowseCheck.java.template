package neko.voidwarehouse;

import neko.voidwarehouse.recipe.RecipeDeleteResultPayload;
import neko.voidwarehouse.recipe.RecipeIndexPayload;
import neko.voidwarehouse.recipe.RecipePagePayload;
import neko.voidwarehouse.recipe.RecipeQueryPayload;
import neko.voidwarehouse.recipe.RecipeService;
import net.minecraft.nbt.NbtOps;
import net.minecraft.nbt.Tag;
import net.minecraft.server.MinecraftServer;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;

import java.util.ArrayList;
import java.util.List;

/**
 * 【临时自检】配方本的浏览（索引 / 排序 / 分页 / 白名单）与删除（回执 / 收尾 / 立刻生效）。
 *
 * <h2>为什么这一组只能咬「纯服务端」的三件事</h2>
 * <ol>
 *   <li><b>协议字段</b>：索引与分页的每个数字都是客户端要按它排版的，错一位客户端就错一屏；</li>
 *   <li><b>删除的收尾</b>：{@code forgetRecipes} 要跟 {@code learnWithResult} 逐步对齐 ——
 *       少一步就掉进「删了还能合成」或「重启又回来」；</li>
 *   <li><b>删完立刻不可得</b>：合成页那一格挂的是 {@code itemId}，删掉之后必须<b>当场</b>
 *       解析不出条目（不能等 2 秒的钉住窗口）。</li>
 * </ol>
 *
 * <p>三道闸门里只有第一道（规则）能在这里咬：第二道是 {@code player.containerMenu}、
 * 第三道是 {@code player.permissions()}，两者都要真玩家 —— 那属于网络层，本类不碰。
 * 所以本类<b>不构造假玩家</b>，只验证 {@link RecipeService} 与 {@link VoidWarehouseData}
 * 的语义；能问的前提由 {@code RecipeNetwork} 负责。</p>
 *
 * <p>分组之间互相独立：每组开头都把配方本<b>整本删空</b>（顺便用掉删除的主路径），
 * 这样每个数字都是确定的，不受上一组遗留影响。</p>
 */
public final class VoidWarehouseRecipeBrowseCheck {

    private static boolean done = false;
    private static int checks = 0;
    private static int failures = 0;
    private static int stage = 0;

    private static MinecraftServer server;
    private static VoidWarehouseData data;
    private static VoidWarehousePageContainer page;

    /** 进场时的规则状态，收尾原样还回去（别的自检按它们各自的前提取值） */
    private static boolean savedWarehouse;
    private static boolean savedExchange;
    private static boolean savedCraft;

    private static final String PLANKS = "minecraft:oak_planks";
    private static final String SWORD = "minecraft:wooden_sword";
    private static final String FRAME = "minecraft:item_frame";
    private static final String BARREL = "minecraft:barrel";
    private static final String LADDER = "minecraft:ladder";
    private static final String CHEST = "minecraft:chest";

    private VoidWarehouseRecipeBrowseCheck() {
    }

    public static void run(MinecraftServer mcServer) {
        if (done) {
            return;
        }
        server = mcServer;
        if (stage == 0) {
            savedWarehouse = VoidWarehouseSettings.voidWarehouse;
            savedExchange = VoidWarehouseSettings.voidWarehouseExchange;
            savedCraft = VoidWarehouseSettings.voidWarehouseCraft;
            VoidWarehouseSettings.voidWarehouse = true;
            // 9 合 1 关掉：它会把表里任何能换的物品也塞进合成页，条目集合就不确定了
            VoidWarehouseSettings.voidWarehouseExchange = false;
            VoidWarehouseSettings.voidWarehouseCraft = true;
        }
        try {
            step(server);
        } catch (Throwable t) {
            failures++;
            System.out.println("!! 配方本自检抛异常: " + t);
            t.printStackTrace(System.out);
            finish();
        }
    }

    private static void step(MinecraftServer mcServer) {
        data = VoidWarehouse.data(mcServer);
        switch (stage) {
            case 0 -> r1();
            case 1 -> r2();
            case 2 -> r3();
            case 3 -> r4();
            case 4 -> r5();
            case 5 -> r6();
            case 6 -> r7();
            case 7 -> r8();
            case 8 -> r9();
            default -> {
                finish();
                return;
            }
        }
        stage++;
    }

    // ================================================================ R1 索引

    /**
     * 索引包回答四个问题：一共几条能看、占了几条上限、有哪些产物、能不能删。
     *
     * <p>产物清单必须<b>去重且有序</b>：客户端拿它当过滤器的选项列表，
     * 重复项会让玩家看到两个一样的选项。
     */
    private static void r1() {
        int wiped = clearBook();
        System.out.println("RCP  trace R1 进场清掉 " + wiped + " 条旧配方");
        check("R1 清场后配方本 0 条（实际 " + data.recipeBookUsed() + "）", data.recipeBookUsed() == 0);
        check("R1 清场后快照为空（实际 " + data.recipeSnapshot().size() + "）",
                data.recipeSnapshot().isEmpty());

        learn(rec(SWORD, 1, PLANKS, 2));
        learn(rec(SWORD, 1, PLANKS, 3));   // 同产物的第二条配方：索引里该产物只能出现一次
        learn(rec(FRAME, 2, PLANKS, 1));
        learn(rec(BARREL, 1, PLANKS, 4));
        learn(rec(LADDER, 3, PLANKS, 2));

        RecipeIndexPayload index = RecipeService.index(data);
        check("R1 协议版本 = " + RecipeIndexPayload.PROTOCOL + "（实际 " + index.protocol() + "）",
                index.protocol() == RecipeIndexPayload.PROTOCOL);
        check("R1 可浏览条数 = 5（实际 " + index.total() + "）", index.total() == 5);
        check("R1 已用条数 = 5（实际 " + index.used() + "）", index.used() == 5);
        check("R1 已用条数 = 配方本用量（" + index.used() + " / " + data.recipeBookUsed() + "）",
                index.used() == data.recipeBookUsed());
        check("R1 可浏览条数 = 解码成功的条数（" + index.total() + " / "
                + data.recipeSnapshot().size() + "）", index.total() == data.recipeSnapshot().size());
        check("R1 规则开着 ⇒ canDelete = true（实际 " + index.canDelete() + "）", index.canDelete());
        check("R1 代次 = 数据里的代次（" + index.generation() + " / " + data.recipeGeneration() + "）",
                index.generation() == data.recipeGeneration());

        List<String> outputs = index.outputs();
        check("R1 产物清单去重：5 条配方 4 个产物（实际 " + outputs.size() + "）", outputs.size() == 4);
        check("R1 同产物的两条配方只占一项（剑出现 "
                + countOf(outputs, SWORD) + " 次）", countOf(outputs, SWORD) == 1);
        check("R1 产物清单按字典序递增：" + outputs, ascending(outputs));
        check("R1 产物清单与快照里的产物集合一致", sameSet(outputs, outputsOf(data.recipeSnapshot())));
        System.out.println("RCP trace R1 outputs=" + outputs);
    }

    // ================================================================ R2 OUTPUT 排序 + 分页拼回

    /**
     * 分页能成立的前提：<b>同一个全序</b>切出来的片子正好拼回整体。
     *
     * <p>判据不看「顺序等于某个写死的列表」（那只是把实现的排序键抄一遍），
     * 而是看三条结构性质：严格递增（是序）、不重不漏（是划分）、跨页首尾相接（是同一个序切出来的）。</p>
     */
    private static void r2() {
        clearBook();
        learn(rec(SWORD, 1, PLANKS, 2));
        learn(rec(FRAME, 2, PLANKS, 1));
        learn(rec(BARREL, 1, PLANKS, 4));
        learn(rec(LADDER, 3, PLANKS, 2));
        learn(rec(CHEST, 1, PLANKS, 8));

        List<RecipePagePayload.Entry> all = entries(query(0, 32, RecipeQueryPayload.SORT_OUTPUT, null));
        check("R2 一页能拿全 5 条（实际 " + all.size() + "）", all.size() == 5);
        check("R2 全序严格递增（产物 → recipeId）：" + ids(all), strictlyOrdered(all));

        List<RecipePagePayload.Entry> p0 = entries(query(0, 2, RecipeQueryPayload.SORT_OUTPUT, null));
        List<RecipePagePayload.Entry> p1 = entries(query(1, 2, RecipeQueryPayload.SORT_OUTPUT, null));
        List<RecipePagePayload.Entry> p2 = entries(query(2, 2, RecipeQueryPayload.SORT_OUTPUT, null));
        check("R2 每页 2 条（实际 " + p0.size() + " / " + p1.size() + " / " + p2.size() + "）",
                p0.size() == 2 && p1.size() == 2 && p2.size() == 1);
        List<String> stitched = new ArrayList<>(ids(p0));
        stitched.addAll(ids(p1));
        stitched.addAll(ids(p2));
        check("R2 三页拼回来与一页相同（" + stitched.size() + " 条）", stitched.equals(ids(all)));
        check("R2 跨页首尾相接：第 2 页首条排在第 1 页末条之后",
                p0.size() == 2 && p1.size() == 2
                        && after(p0.get(1), p1.get(0)));
        check("R2 没有重复条目（" + stitched.size() + " 条里 " + distinct(stitched) + " 个 id）",
                distinct(stitched) == stitched.size());

        RecipePagePayload first = query(0, 2, RecipeQueryPayload.SORT_OUTPUT, null);
        RecipePagePayload second = query(1, 2, RecipeQueryPayload.SORT_OUTPUT, null);
        check("R2 每页都回同一个 total（" + first.total() + " / " + second.total() + "）",
                first.total() == 5 && second.total() == 5);
        check("R2 每页都回同一个代次（" + first.generation() + " / " + second.generation() + "）",
                first.generation() == second.generation());
        check("R2 页码回显 = 请求的页码（0 / 1）", first.page() == 0 && second.page() == 1);
    }

    // ================================================================ R3 夹取

    /**
     * 客户端拿着<b>旧的</b>页码来问是常态（删完之后总页数变小），所以页码与页大小都得夹，
     * 不能报错、不能空手回。
     *
     * <p>这里刻意用「同一产物 × 40 条配方」造料：既能咬住 {@code MAX_PAGE_SIZE}，
     * 又不依赖 40 个跨版本都存在的物品（1.21.11 ~ 26.3 的物品表并不一样）。</p>
     */
    private static void r3() {
        clearBook();
        for (int i = 0; i < 40; i++) {
            learn(rec(FRAME, 1 + i, PLANKS, 1));
        }
        check("R3 造出 40 条配方（实际 " + data.recipeBookUsed() + "）", data.recipeBookUsed() == 40);
        check("R3 40 条同产物配方在索引里只占一项（实际 "
                + RecipeService.index(data).outputs().size() + "）",
                RecipeService.index(data).outputs().size() == 1);

        RecipePagePayload big = query(0, 9999, RecipeQueryPayload.SORT_OUTPUT, null);
        check("R3 页大小 9999 夹到 " + RecipeQueryPayload.MAX_PAGE_SIZE + "（实际 "
                + big.entries().size() + "）", big.entries().size() == RecipeQueryPayload.MAX_PAGE_SIZE);
        check("R3 但 total 报全量 40（实际 " + big.total() + "）", big.total() == 40);

        RecipePagePayload small = query(0, 0, RecipeQueryPayload.SORT_OUTPUT, null);
        check("R3 页大小 0 夹到 1 条（实际 " + small.entries().size() + "）", small.entries().size() == 1);

        RecipePagePayload over = query(99, 32, RecipeQueryPayload.SORT_OUTPUT, null);
        check("R3 页码 99 夹到最后一页 1（实际 " + over.page() + "）", over.page() == 1);
        check("R3 最后一页 8 条（实际 " + over.entries().size() + "）", over.entries().size() == 8);

        RecipePagePayload under = query(-5, 32, RecipeQueryPayload.SORT_OUTPUT, null);
        check("R3 页码 -5 夹到 0（实际 " + under.page() + "）", under.page() == 0);
        check("R3 第 0 页 32 条（实际 " + under.entries().size() + "）", under.entries().size() == 32);

        List<RecipePagePayload.Entry> p0 = entries(under);
        List<RecipePagePayload.Entry> p1 = entries(over);
        check("R3 两页拼起来是 40 条且首尾相接",
                p0.size() == 32 && p1.size() == 8 && after(p0.get(31), p1.get(0)));
    }

    // ================================================================ R4 RECENT 排序

    /**
     * 「最近学的在前」= 学习序倒排。{@code recipeTexts} 是 {@code LinkedHashSet}，
     * 插入序就是学习序 —— 这条性质一旦被换成无序集合，翻页看到的顺序会每次都不一样。
     */
    private static void r4() {
        clearBook();
        VoidWarehouseRecipes.Recipe a = rec(LADDER, 3, PLANKS, 2);
        VoidWarehouseRecipes.Recipe b = rec(BARREL, 1, PLANKS, 4);
        VoidWarehouseRecipes.Recipe c = rec(FRAME, 2, PLANKS, 1);
        learn(a);
        learn(b);
        learn(c);

        List<String> recent = ids(entries(query(0, 32, RecipeQueryPayload.SORT_RECENT, null)));
        check("R4 最近学的排最前：[" + c.output() + ", " + b.output() + ", " + a.output() + "]（实际 "
                + recent + "）", recent.equals(List.of(c.recipeId(), b.recipeId(), a.recipeId())));

        VoidWarehouseRecipes.Recipe d = rec(SWORD, 1, PLANKS, 2);
        learn(d);
        List<String> afterLearn = ids(entries(query(0, 32, RecipeQueryPayload.SORT_RECENT, null)));
        check("R4 再学一条 ⇒ 它排到最前（首条 " + afterLearn.get(0) + "）",
                !afterLearn.isEmpty() && afterLearn.get(0).equals(d.recipeId()));

        List<String> outputSort = ids(entries(query(0, 32, RecipeQueryPayload.SORT_OUTPUT, null)));
        check("R4 两种排序确实是两种序（最近序的首条不是字典序的首条）",
                !outputSort.isEmpty() && !outputSort.get(0).equals(recent.get(0)));
    }

    // ================================================================ R5 白名单过滤

    /**
     * 白名单是<b>客户端</b>搜索命中的产物清单 —— 服务端不解码中文，只按 id 过滤。
     * 未知 id 静默忽略（两端注册表理论上一致，但不假设），空白名单 = 不过滤。
     */
    private static void r5() {
        // 沿用 R4 的 4 条：梯子 / 木桶 / 物品展示框 / 木剑
        RecipePagePayload one = query(0, 32, RecipeQueryPayload.SORT_OUTPUT, List.of(BARREL));
        check("R5 白名单只留木桶：1 条（实际 " + one.total() + "）", one.total() == 1);
        check("R5 那一条的产物就是木桶（实际 " + outputOf(one) + "）", BARREL.equals(outputOf(one)));

        RecipePagePayload unknown = query(0, 32, RecipeQueryPayload.SORT_OUTPUT,
                List.of(BARREL, "minecraft:this_item_does_not_exist"));
        check("R5 白名单里的未知 id 静默忽略（仍是 1 条，实际 " + unknown.total() + "）",
                unknown.total() == 1);

        RecipePagePayload two = query(0, 32, RecipeQueryPayload.SORT_OUTPUT, List.of(SWORD, BARREL));
        check("R5 两个产物 ⇒ 2 条（实际 " + two.total() + "）", two.total() == 2);

        RecipePagePayload none = query(0, 32, RecipeQueryPayload.SORT_OUTPUT,
                List.of("minecraft:this_item_does_not_exist"));
        check("R5 白名单全不命中 ⇒ 0 条、空页（实际 " + none.total() + " / "
                + none.entries().size() + "）", none.total() == 0 && none.entries().isEmpty());
        check("R5 全不命中时页码仍是 0（不能夹成 -1）", none.page() == 0);

        RecipePagePayload all = query(0, 32, RecipeQueryPayload.SORT_OUTPUT, List.of());
        check("R5 空白名单 = 不过滤：4 条（实际 " + all.total() + "）", all.total() == 4);

        RecipePagePayload nulls = query(0, 32, RecipeQueryPayload.SORT_OUTPUT, null);
        check("R5 null 白名单也不过滤：4 条（实际 " + nulls.total() + "）", nulls.total() == 4);
    }

    // ================================================================ R6 删除回执

    /**
     * 逐条回执的四种结局：全成 / 部分成 / 一条没删 / 参数非法。
     *
     * <p>「已经不存在」<b>不是</b>整包失败 —— 另一个玩家可能刚删过同一条；
     * 整包失败会让客户端把真正删掉的那几条也当成失败，回滚界面之后就显示错了。</p>
     */
    private static void r6() {
        clearBook();
        VoidWarehouseRecipes.Recipe l1 = rec(LADDER, 3, PLANKS, 2);
        VoidWarehouseRecipes.Recipe l2 = rec(BARREL, 1, PLANKS, 4);
        VoidWarehouseRecipes.Recipe l3 = rec(FRAME, 2, PLANKS, 1);
        learn(l1);
        learn(l2);
        learn(l3);
        check("R6 造出 3 条（实际 " + data.recipeBookUsed() + "）", data.recipeBookUsed() == 3);

        int genBefore = data.recipeGeneration();
        RecipeService.DeleteOutcome ok = RecipeService.delete(data, List.of(l2.recipeId()));
        check("R6 删一条存在的 ⇒ OK（实际 " + statusName(ok.status()) + "）",
                ok.status() == RecipeDeleteResultPayload.OK);
        check("R6 回执里点名了删掉的那条", ok.removed().equals(List.of(l2.recipeId())));
        check("R6 OK 时没有失败项（实际 " + ok.failed().size() + "）", ok.failed().isEmpty());
        check("R6 代次 +1（" + genBefore + " → " + data.recipeGeneration() + "）",
                data.recipeGeneration() == genBefore + 1);
        check("R6 用量 -1（实际 " + data.recipeBookUsed() + "）", data.recipeBookUsed() == 2);
        check("R6 本子里不再认识这条 id", !data.knowsRecipeId(l2.recipeId()));
        check("R6 快照里也没有它了", !ids(data.recipeSnapshot()).contains(l2.recipeId()));

        int genAfterOk = data.recipeGeneration();
        RecipeService.DeleteOutcome gone = RecipeService.delete(data, List.of(l2.recipeId()));
        check("R6 再删同一条 ⇒ NOTHING（实际 " + statusName(gone.status()) + "）",
                gone.status() == RecipeDeleteResultPayload.NOTHING);
        check("R6 NOTHING 时 removed 为空", gone.removed().isEmpty());
        check("R6 失败原因是「不存在」（实际 " + reasonName(gone) + "）",
                gone.failed().size() == 1
                        && gone.failed().get(0).reason() == RecipeDeleteResultPayload.NOT_FOUND);
        check("R6 一条没删 ⇒ 代次不动（" + genAfterOk + " → " + data.recipeGeneration() + "）",
                data.recipeGeneration() == genAfterOk);

        int beforeMixed = data.recipeBookUsed();
        RecipeService.DeleteOutcome mixed = RecipeService.delete(data,
                List.of(l1.recipeId(), "minecraft:ghost*1;minecraft:oak_planks×1"));
        check("R6 一条存在 + 一条不存在 ⇒ PARTIAL（实际 " + statusName(mixed.status()) + "）",
                mixed.status() == RecipeDeleteResultPayload.PARTIAL);
        check("R6 PARTIAL 的 removed 只有那条真的（" + mixed.removed().size() + " 条）",
                mixed.removed().size() == 1 && mixed.removed().get(0).equals(l1.recipeId()));
        check("R6 PARTIAL 的 failed 只有那条假的（" + mixed.failed().size() + " 条）",
                mixed.failed().size() == 1);
        check("R6 PARTIAL 真的删掉了（用量 " + beforeMixed + " → " + data.recipeBookUsed() + "）",
                data.recipeBookUsed() == beforeMixed - 1);

        RecipeService.DeleteOutcome bad = RecipeService.delete(data, List.of("", repeat("x", 513)));
        check("R6 空 id 与超长 id ⇒ 两条 BAD_ID（实际 " + bad.failed().size() + " 条失败）",
                bad.failed().size() == 2
                        && bad.failed().get(0).reason() == RecipeDeleteResultPayload.BAD_ID
                        && bad.failed().get(1).reason() == RecipeDeleteResultPayload.BAD_ID);
        check("R6 全是非法 id ⇒ NOTHING（实际 " + statusName(bad.status()) + "）",
                bad.status() == RecipeDeleteResultPayload.NOTHING);
        check("R6 非法 id 不许碰到配方本（仍是 " + data.recipeBookUsed() + " 条）",
                data.recipeBookUsed() == 1);

        RecipeService.DeleteOutcome dup = RecipeService.delete(data,
                List.of(l3.recipeId(), l3.recipeId()));
        check("R6 同一条发两遍只删一次（removed " + dup.removed().size() + " 条）",
                dup.removed().size() == 1 && dup.status() == RecipeDeleteResultPayload.OK);
        check("R6 删空之后用量 0（实际 " + data.recipeBookUsed() + "）", data.recipeBookUsed() == 0);

        RecipeService.DeleteOutcome nothing = RecipeService.delete(data, null);
        check("R6 null 列表 ⇒ NOTHING（实际 " + statusName(nothing.status()) + "）",
                nothing.status() == RecipeDeleteResultPayload.NOTHING);

        RecipePagePayload emptyPage = query(3, 32, RecipeQueryPayload.SORT_OUTPUT, null);
        check("R6 删空后拿旧页码问 ⇒ 页码夹到 0、空页（实际 " + emptyPage.page() + " / "
                + emptyPage.total() + "）", emptyPage.page() == 0 && emptyPage.total() == 0
                && emptyPage.entries().isEmpty());
        check("R6 删空后索引报 0 条", RecipeService.index(data).total() == 0);
    }

    // ================================================================ R7 收尾五步 + 落盘

    /**
     * {@code forgetRecipes} 必须逐步对齐 {@code learnWithResult}（「增」的版本）：
     * 重建 → 代次 +1 → 三处展示缓存作废 → 标脏。少一步就是「删了还能合成」或「重启又回来」。
     *
     * <p>缓存作废这一条<b>必须先制造缓存再删</b>：直接问一次只会现算，
     * 现算当然是对的 —— 那测不到作废，测到的是「没缓存」。</p>
     */
    private static void r7() {
        clearBook();
        VoidWarehouseRecipes.Recipe a = rec(LADDER, 3, PLANKS, 2);
        VoidWarehouseRecipes.Recipe b = rec(BARREL, 1, PLANKS, 4);
        VoidWarehouseRecipes.Recipe c = rec(FRAME, 2, PLANKS, 1);
        learn(a);
        learn(b);
        learn(c);

        // ① 先把两个派生缓存「焐热」
        List<String> outputsWarm = data.recipeOutputs();
        List<String> orderedWarm = ids(data.recipeOrdered());
        check("R7 预热：产物缓存 3 项（实际 " + outputsWarm.size() + "）", outputsWarm.size() == 3);
        check("R7 预热：全序缓存 3 条（实际 " + orderedWarm.size() + "）", orderedWarm.size() == 3);

        int gen0 = data.recipeGeneration();
        int used0 = data.recipeBookUsed();
        int decoded0 = data.learnedRecipeCount();

        RecipeService.DeleteOutcome out = RecipeService.delete(data, List.of(a.recipeId()));
        check("R7 删除成功", out.status() == RecipeDeleteResultPayload.OK);

        check("R7 代次 +1（" + gen0 + " → " + data.recipeGeneration() + "）",
                data.recipeGeneration() == gen0 + 1);
        check("R7 用量 -1（" + used0 + " → " + data.recipeBookUsed() + "）",
                data.recipeBookUsed() == used0 - 1);
        check("R7 解码条数 -1（" + decoded0 + " → " + data.learnedRecipeCount() + "）",
                data.learnedRecipeCount() == decoded0 - 1);

        List<String> outputsNow = data.recipeOutputs();
        List<String> orderedNow = ids(data.recipeOrdered());
        check("R7 产物缓存已作废：不再含 " + a.output() + "（" + outputsNow + "）",
                !outputsNow.contains(a.output()) && outputsNow.size() == 2);
        check("R7 全序缓存已作废：不再含那条 recipeId（" + orderedNow.size() + " 条）",
                !orderedNow.contains(a.recipeId()) && orderedNow.size() == 2);
        check("R7 缓存确实换了一份（不是原地改）", outputsNow != outputsWarm);

        List<String> recent = ids(entries(query(0, 32, RecipeQueryPayload.SORT_RECENT, null)));
        check("R7 最近序里也没有它（" + recent.size() + " 条）",
                !recent.contains(a.recipeId()) && recent.size() == 2);

        // ② 落盘：被删的 id 不许再出现在编码结果里（否则重启就复活）
        Tag encoded = null;
        try {
            encoded = VoidWarehouseData.CODEC.encodeStart(NbtOps.INSTANCE, data).result().orElse(null);
        } catch (Throwable t) {
            System.out.println("RCP   skip 落盘编码抛异常：" + t);
        }
        if (encoded == null) {
            System.out.println("RCP   skip 落盘编码没成功，跳过「删掉的不会复活」这一条");
        } else {
            String dump = encoded.toString();
            checks++;
            if (dump.contains("ladder") || dump.contains("ladder".toUpperCase())) {
                failures++;
                System.out.println("RCP   FAIL R7 落盘数据里仍有被删的配方（ladder）");
            } else if (!dump.contains("barrel") && !dump.contains("item_frame")) {
                failures++;
                System.out.println("RCP   FAIL R7 落盘数据里连没删的都没了，判据不可信");
            } else {
                System.out.println("RCP   ok   R7 落盘数据里只剩没删的那两条（ladder 已消失）");
            }
        }

        // ③ 删掉之后能重新学回来（证明真从集合里移除，不是打了个「隐藏」标记）
        check("R7 删掉的条目可以重新学会（不再判 DUPLICATE）",
                data.learnWithResult(a) == VoidWarehouseData.LearnResult.LEARNED);
        check("R7 重学之后用量回到 " + used0 + "（实际 " + data.recipeBookUsed() + "）",
                data.recipeBookUsed() == used0);
        check("R7 重学之后又能问到它", data.knowsRecipeId(a.recipeId()));

        // ④ 满本警示的复位（capWarned）在这里不测：要真填到 MAX_RECIPES=2048 条，
        //    每次 learn 都整本重建，代价与本自检的目标不成比例。复位本身在 forgetRecipes
        //    里是一行赋值，且「删过之后腾出空间」的语义已由上面三条覆盖。
        System.out.println("RCP  trace R7 满本警示复位（capWarned）不用自检覆盖，理由见注释");
    }

    // ================================================================ R8 删完立刻不可得

    /**
     * 本轮最要紧的一条：<b>删掉配方后，合成页那一格必须当场解析不出条目</b>。
     *
     * <p>那一格钉的是 {@code itemId} 字符串，条目本身每次渲染都重新在
     * {@code exchangeOffers()} 里解析。所以只要 {@code forgetRecipes} 真的把
     * {@code offers} 置空（而不是等下一个 tick 自然过期），同一 tick 内就再也解析不到 ——
     * 玩家点下去拿到的是空，不是「按旧表做出来的东西」。</p>
     *
     * <p>对照组一并断言：<b>另一格的配方没被牵连</b>（证明不是整页坏掉），
     * 以及<b>重新学回来同一格立刻又能拿</b>（证明是实时解析而不是永久失落）。</p>
     */
    private static void r8() {
        clearBook();
        data.clearContent();
        data.insert(new ItemStack(Items.OAK_PLANKS, 64));
        bumpTick();

        VoidWarehouseRecipes.Recipe sword = rec(SWORD, 1, PLANKS, 2);
        VoidWarehouseRecipes.Recipe frame = rec(FRAME, 1, PLANKS, 1);
        learn(sword);
        learn(frame);
        bumpTick();

        page = new VoidWarehousePageContainer(
                data, new VoidWarehouseViews.View(0, false, false, 1, 0), false);
        page.noteInteraction();

        int swordSlot = craftSlotOf(SWORD);
        int frameSlot = craftSlotOf(FRAME);
        check("R8 合成页上找到剑那一格（第 " + swordSlot + " 格）", swordSlot >= 0);
        check("R8 合成页上找到展示框那一格（第 " + frameSlot + " 格）", frameSlot >= 0);
        check("R8 负向对照：删之前那一格就是剑（实际 " + describe(swordSlot) + "）",
                page.getItem(swordSlot).is(Items.WOODEN_SWORD));
        check("R8 删之前那一格解析得到一个可合成条目，且至少能做 1 个（"
                        + obtainableAt(swordSlot) + "）",
                page.slotAt(swordSlot).isExchange()
                        && SWORD.equals(page.slotAt(swordSlot).offer().itemId())
                        && page.slotAt(swordSlot).offer().obtainable().signum() > 0);

        int genBefore = data.recipeGeneration();
        RecipeService.DeleteOutcome out = RecipeService.delete(data, List.of(sword.recipeId()));
        check("R8 删除成功（" + statusName(out.status()) + "）",
                out.status() == RecipeDeleteResultPayload.OK);
        check("R8 删除推进了代次（" + genBefore + " → " + data.recipeGeneration() + "）",
                data.recipeGeneration() == genBefore + 1);

        // ⚠️ 不 bumpTick：这里就是要证明「同一个 tick 内立刻生效」，不接受「等 2 秒」
        //
        // 点击路径的第一件事就是 VoidWarehouseMenu#slotAt → pageContainer#slotAt，
        // 解析成空之后 withdrawFrom 拿到的就是空目标 —— 所以「这一格解析为空」
        // 等价于「点下去拿不到东西」，且这条判据咬的是真正被点击的那一处。
        check("R8 同一 tick 内合成页清单已不含剑（" + offerIds() + "）", !offerIds().contains(SWORD));
        check("R8 那一格立刻解析为空（钉住不许把删掉的条目留在页上）",
                page.slotAt(swordSlot).isEmpty());
        check("R8 图标也不再是剑（实际 " + describe(swordSlot) + "）",
                !page.getItem(swordSlot).is(Items.WOODEN_SWORD));
        check("R8 那一格没有可兑条目（obtainable 问不出来，实际 " + obtainableAt(swordSlot) + "）",
                page.slotAt(swordSlot).offer() == null);

        check("R8 对照：没删的展示框仍在那一格（实际 " + describe(frameSlot) + "）",
                page.getItem(frameSlot).is(Items.ITEM_FRAME));
        check("R8 对照：展示框仍可合成（" + obtainableAt(frameSlot) + "）",
                page.slotAt(frameSlot).isExchange()
                        && page.slotAt(frameSlot).offer().obtainable().signum() > 0);

        // 删掉再学回来：同一格立刻又能拿 —— 证明解析是实时的，不是永久失落
        learn(sword);
        bumpTick();
        check("R8 重新学回来 ⇒ 同一格立刻又是剑（实际 " + describe(swordSlot) + "）",
                page.getItem(swordSlot).is(Items.WOODEN_SWORD));
        check("R8 重新学回来 ⇒ 条目也回来了（" + obtainableAt(swordSlot) + "）",
                page.slotAt(swordSlot).isExchange()
                        && page.slotAt(swordSlot).offer().obtainable().signum() > 0);
    }

    // ================================================================ R9 规则闸门

    /**
     * 第一道闸门是规则：{@code voidWarehouse} + {@code voidWarehouseCraft} 都开才允许读写配方本。
     *
     * <p>规则关着时连「读」都不给，是为了守住「关着的规则不碰存档」这条不变式
     * —— 所以这里断言的是 {@code learnWithResult} 直接拒绝，而<b>不是</b>只看界面。
     */
    private static void r9() {
        int used = data.recipeBookUsed();
        VoidWarehouseSettings.voidWarehouseCraft = false;
        try {
            check("R9 规则关着时 craftEnabled() 为 false", !VoidWarehouseData.craftEnabled());
            check("R9 规则关着时学习被拒（DISABLED）",
                    data.learnWithResult(rec(CHEST, 1, PLANKS, 8))
                            == VoidWarehouseData.LearnResult.DISABLED);
            check("R9 规则关着时配方本没被动过（" + used + " → " + data.recipeBookUsed() + "）",
                    data.recipeBookUsed() == used);
        } finally {
            VoidWarehouseSettings.voidWarehouseCraft = true;
        }
        check("R9 重新打开后学习又能进（LEARNED）",
                data.learnWithResult(rec(CHEST, 1, PLANKS, 8))
                        == VoidWarehouseData.LearnResult.LEARNED);
        check("R9 重新打开后用量 +1（实际 " + data.recipeBookUsed() + "）",
                data.recipeBookUsed() == used + 1);
    }

    // ================================================================ 工具

    /**
     * 整本删空：用删除的主路径（{@code forgetRecipes}）而不是直接清集合。
     *
     * @return 清掉几条
     */
    private static int clearBook() {
        List<String> all = new ArrayList<>();
        for (VoidWarehouseRecipes.Recipe recipe : data.recipeSnapshot()) {
            all.add(recipe.recipeId());
        }
        return all.isEmpty() ? 0 : data.forgetRecipes(all).size();
    }

    /**
     * 手搓一条配方（内容合法即可，不要求原版配方表里真有它）。
     *
     * @param partCount 那样原料要几个
     */
    private static VoidWarehouseRecipes.Recipe rec(String output, int count, String part, int partCount) {
        return new VoidWarehouseRecipes.Recipe(null, output, count,
                List.of(new VoidWarehouseRecipes.Part(List.of(part), partCount)));
    }

    private static void learn(VoidWarehouseRecipes.Recipe recipe) {
        VoidWarehouseData.LearnResult result = data.learnWithResult(recipe);
        if (result != VoidWarehouseData.LearnResult.LEARNED) {
            System.out.println("RCP   warn 造料没学进去（" + result + "）：" + recipe.recipeId());
        }
    }

    private static RecipePagePayload query(int page, int pageSize, int sort, List<String> outputs) {
        return RecipeService.page(data, new RecipeQueryPayload(page, pageSize, sort, outputs));
    }

    private static List<RecipePagePayload.Entry> entries(RecipePagePayload payload) {
        return payload.entries();
    }

    private static List<String> ids(List<?> list) {
        List<String> out = new ArrayList<>(list.size());
        for (Object one : list) {
            if (one instanceof RecipePagePayload.Entry entry) {
                out.add(entry.recipeId());
            } else if (one instanceof VoidWarehouseRecipes.Recipe recipe) {
                out.add(recipe.recipeId());
            } else if (one != null) {
                out.add(String.valueOf(one));
            }
        }
        return out;
    }

    private static List<String> outputsOf(List<VoidWarehouseRecipes.Recipe> recipes) {
        List<String> out = new ArrayList<>(recipes.size());
        for (VoidWarehouseRecipes.Recipe recipe : recipes) {
            out.add(recipe.output());
        }
        return out;
    }

    /** 前一条严格排在后一条之前（产物 id → recipeId 两级字典序） */
    private static boolean after(RecipePagePayload.Entry before, RecipePagePayload.Entry next) {
        int byOutput = before.output().compareTo(next.output());
        if (byOutput != 0) {
            return byOutput < 0;
        }
        return before.recipeId().compareTo(next.recipeId()) < 0;
    }

    private static boolean strictlyOrdered(List<RecipePagePayload.Entry> list) {
        for (int i = 1; i < list.size(); i++) {
            if (!after(list.get(i - 1), list.get(i))) {
                System.out.println("RCP   乱序：" + list.get(i - 1).recipeId() + " → " + list.get(i).recipeId());
                return false;
            }
        }
        return true;
    }

    private static boolean ascending(List<String> list) {
        for (int i = 1; i < list.size(); i++) {
            if (list.get(i - 1).compareTo(list.get(i)) >= 0) {
                return false;
            }
        }
        return true;
    }

    private static boolean sameSet(List<String> a, List<String> b) {
        return new java.util.TreeSet<>(a).equals(new java.util.TreeSet<>(b));
    }

    private static int countOf(List<String> list, String value) {
        int n = 0;
        for (String one : list) {
            if (value.equals(one)) {
                n++;
            }
        }
        return n;
    }

    private static int distinct(List<String> list) {
        return new java.util.HashSet<>(list).size();
    }

    private static String outputOf(RecipePagePayload payload) {
        return payload.entries().isEmpty() ? "<空页>" : payload.entries().get(0).output();
    }

    /** 合成页上产物为 {@code itemId} 的那一格（找不到返回 -1） */
    private static int craftSlotOf(String itemId) {
        for (int slot = 0; slot < VoidWarehouseData.PAGE_SIZE; slot++) {
            VoidWarehouseData.DisplaySlot target = page.slotAt(slot);
            if (target.isExchange() && itemId.equals(target.offer().itemId())) {
                return slot;
            }
        }
        return -1;
    }

    /** 合成页这一格「还能做几个」（解析不出条目时返回 {@code <无条目>}） */
    private static String obtainableAt(int slot) {
        if (page == null || slot < 0) {
            return "<无界面>";
        }
        VoidWarehouseData.DisplaySlot target = page.slotAt(slot);
        return target.isExchange() ? target.offer().obtainable().toString() : "<无条目>";
    }

    /** 合成页清单里现在有哪些产物 id（诊断用） */
    private static String offerIds() {
        StringBuilder sb = new StringBuilder("[");
        for (VoidWarehouseData.ExchangeOffer offer : data.exchangeOffers()) {
            if (sb.length() > 1) {
                sb.append(", ");
            }
            sb.append(offer.itemId());
        }
        return sb.append(']').toString();
    }

    private static String describe(int slot) {
        if (page == null) {
            return "<无界面>";
        }
        ItemStack stack = page.getItem(slot);
        return (stack.isEmpty() ? "<空>" : stack.getItem().getDescriptionId()) + "×" + stack.getCount();
    }

    private static String statusName(int status) {
        return switch (status) {
            case RecipeDeleteResultPayload.OK -> "OK";
            case RecipeDeleteResultPayload.PARTIAL -> "PARTIAL";
            case RecipeDeleteResultPayload.NOTHING -> "NOTHING";
            case RecipeDeleteResultPayload.TOO_MANY -> "TOO_MANY";
            case RecipeDeleteResultPayload.THROTTLED -> "THROTTLED";
            case RecipeDeleteResultPayload.RULE_OFF -> "RULE_OFF";
            default -> "UNKNOWN(" + status + ")";
        };
    }

    private static String reasonName(RecipeService.DeleteOutcome outcome) {
        if (outcome.failed().isEmpty()) {
            return "<无失败项>";
        }
        int reason = outcome.failed().get(0).reason();
        return reason == RecipeDeleteResultPayload.BAD_ID ? "BAD_ID" : "NOT_FOUND";
    }

    private static String repeat(String text, int times) {
        StringBuilder sb = new StringBuilder(text.length() * times);
        for (int i = 0; i < times; i++) {
            sb.append(text);
        }
        return sb.toString();
    }

    /** 把服务端 tick 往前推一格：{@code exchangeOffers()} 的快照是<b>按 tick 合并</b>的 */
    private static void bumpTick() {
        VoidWarehouseData.noteServerTick((int) (VoidWarehouseData.nowTick() + 1));
    }

    private static void check(String label, boolean ok) {
        checks++;
        if (ok) {
            System.out.println("RCP   ok   " + label);
        } else {
            failures++;
            System.out.println("RCP   FAIL " + label);
        }
    }

    private static void finish() {
        done = true;
        // 收尾把配方本与仓库清干净：run 世界是持久的、仓库全存档唯一，
        // 留下的试样会让下一个自检读到别人的数据。
        try {
            if (data != null) {
                clearBook();
                data.clearContent();
            }
        } catch (Throwable ignored) {
            // 收尾失败不影响判据
        }
        try {
            VoidWarehouseSettings.voidWarehouse = savedWarehouse;
            VoidWarehouseSettings.voidWarehouseExchange = savedExchange;
            VoidWarehouseSettings.voidWarehouseCraft = savedCraft;
        } catch (Throwable ignored) {
            // 同上
        }
        System.out.println("SMOKE RESULT vw-recipe checks=" + checks + " failures=" + failures);
        server.halt(false);
    }
}
