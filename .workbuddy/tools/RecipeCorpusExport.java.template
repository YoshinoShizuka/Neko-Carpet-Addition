package neko.voidwarehouse;

import net.minecraft.core.Holder;
import net.minecraft.server.MinecraftServer;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.crafting.CraftingRecipe;
import net.minecraft.world.item.crafting.CustomRecipe;
import net.minecraft.world.item.crafting.RecipeHolder;
import net.minecraft.world.item.crafting.display.RecipeDisplay;
import net.minecraft.world.item.crafting.display.ShapedCraftingRecipeDisplay;
import net.minecraft.world.item.crafting.display.ShapelessCraftingRecipeDisplay;
import net.minecraft.world.item.crafting.display.SlotDisplay;

import java.io.BufferedWriter;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;
import java.util.TreeMap;

/**
 * 【一次性工具，26.3 专用】把当前 {@code RecipeManager} 里的<b>全部合成配方</b>导出成
 * 配方本能吃的文本，供五版本压测共用同一份语料。
 *
 * <h2>为什么要把语料固化成文件</h2>
 * <p>压测要在五个版本上跑，且【必须用同一批配方】—— 否则「26.3 有 1523 条、1.21.11 有 1490 条」
 * 这种差异会直接进到性能数字里，版本之间就没法比了。</p>
 * <p>而五个版本的配方 API 差异很大（26.x 是 {@code PlacementInfo} + {@code RecipeDisplay} 那一套，
 * 1.21.x 还是传统的 {@code getIngredients()}/{@code getResultItem()}），
 * 逐版本解析等于给自己造五份失配风险。所以：<b>只在 26.3 上真解析一次，
 * 落成文本，其余版本只读文本</b>。语料的可信度由 26.3 那一次保证，可比性由「同一份文件」保证。</p>
 *
 * <h2>口径：与真实玩家存档同构</h2>
 * <ul>
 *   <li>产物 id 走 {@link VoidWarehouseRecipeBook#idOf}（保留完整命名空间），与 {@code fromGrid} 同一套；</li>
 *   <li>一条配方一个 {@link VoidWarehouseRecipes.Recipe}，文本走 {@code encode}，
 *       所以 {@code recipeId} 天然与内容一致，和存档里长出来的那条逐字节相同；</li>
 *   <li><b>原料只取第一个候选</b>：真实玩家记下来的是他实际摆进格子的那一种
 *       （{@code #minecraft:planks} 只会是「橡木木板」），所以这里也取第一候选，
 *       保证语料的形态（单候选、深度、宽度）与线上存档一致；</li>
 *   <li>{@link CustomRecipe} 一律跳过 —— 与 {@code VoidWarehouseRecipeBook.resultOf} 的规则同源
 *       （产物带数据组件，学会了也只会给白板物品）。</li>
 * </ul>
 *
 * <h2>判据</h2>
 * <p>看日志里的 {@code CORPUS RESULT ... written=N}，并核对输出文件行数等于 N。
 * {@code runServer} 崩服也返回 {@code EXIT=0}，所以不能拿退出码当判据。</p>
 */
public final class RecipeCorpusExport {

    /** 等服务器把配方表读好再动手（首个 tick 时 RecipeManager 可能还没绑完） */
    private static final int WAIT_TICKS = 5;

    /** 输出文件；五版本压测读同一个路径 */
    static final Path OUT = Path.of("C:/tmp/nca_recipes_263.txt");

    private static boolean done;
    private static int tickIndex;

    private RecipeCorpusExport() {
    }

    public static void run(MinecraftServer server) {
        if (done) {
            return;
        }
        if (++tickIndex < WAIT_TICKS) {
            return;
        }
        done = true;
        try {
            export(server);
        } catch (Throwable t) {
            System.out.println("!! [CORPUS] 抛异常: " + t);
            t.printStackTrace(System.out);
        } finally {
            server.halt(false);
        }
    }

    private static void export(MinecraftServer server) throws Exception {
        // ---------------------------------------------------------- 枚举
        int totalHolders = 0;
        int notCrafting = 0;
        int special = 0;
        int noDisplay = 0;
        int oddDisplay = 0;
        int badResult = 0;
        int noParts = 0;

        /** 去重口径与配方本完全一致：文本本身就是标识 */
        Set<String> texts = new LinkedHashSet<>();
        Set<String> outputs = new HashSet<>();
        Set<String> rawItems = new HashSet<>();
        /** 原料项数 → 条数；用来看语料的「宽度」分布 */
        TreeMap<Integer, Integer> widthHist = new TreeMap<>();
        int duplicateText = 0;

        for (RecipeHolder<?> holder : server.getRecipeManager().getRecipes()) {
            totalHolders++;
            if (!(holder.value() instanceof CraftingRecipe crafting)) {
                notCrafting++;
                continue;
            }
            if (crafting instanceof CustomRecipe) {
                special++;
                continue;
            }

            List<RecipeDisplay> displays = crafting.display();
            if (displays == null || displays.isEmpty()) {
                noDisplay++;
                continue;
            }
            RecipeDisplay first = displays.get(0);

            List<SlotDisplay> ingredientSlots;
            if (first instanceof ShapedCraftingRecipeDisplay shaped) {
                ingredientSlots = shaped.ingredients();
            } else if (first instanceof ShapelessCraftingRecipeDisplay shapeless) {
                ingredientSlots = shapeless.ingredients();
            } else {
                // 26.x 还有别的 crafting display 类型（烟火、地图……），本模组本来也不记它们
                oddDisplay++;
                continue;
            }

            ItemStack result = stackOf(first.result());
            String outId = result.isEmpty() ? null : VoidWarehouseRecipeBook.idOf(result.getItem());
            if (outId == null) {
                badResult++;
                continue;
            }

            List<VoidWarehouseRecipes.Part> parts = new ArrayList<>();
            for (SlotDisplay slot : ingredientSlots) {
                String id = firstCandidateOf(slot);
                if (id == null) {
                    continue;   // 空格 / 读不出来，按原版的「空就是没有」处理
                }
                // 同一配方里同一种原料出现多次（例如 4 个木板摆成一条线）—— 合并不合并都合法，
                // 这里保持原样（一处一个 Part），与 fromGrid 的行为一致
                parts.add(new VoidWarehouseRecipes.Part(List.of(id), Math.max(1, countOf(slot))));
            }
            if (parts.isEmpty()) {
                noParts++;
                continue;
            }

            String text;
            try {
                text = VoidWarehouseRecipes.encode(new VoidWarehouseRecipes.Recipe(
                        null, outId, Math.max(1, result.getCount()), parts));
            } catch (RuntimeException ex) {
                badResult++;
                continue;
            }
            // 自证：编出来的一定能解回去，否则这条语料是坏的
            if (VoidWarehouseRecipes.decode(text) == null) {
                badResult++;
                continue;
            }
            if (!texts.add(text)) {
                duplicateText++;
            }
            outputs.add(outId);
            for (VoidWarehouseRecipes.Part part : parts) {
                rawItems.addAll(part.candidates());
            }
            widthHist.merge(parts.size(), 1, Integer::sum);
        }

        // ---------------------------------------------------------- 落盘
        Files.createDirectories(OUT.getParent());
        try (BufferedWriter w = Files.newBufferedWriter(OUT, StandardCharsets.UTF_8)) {
            for (String text : texts) {
                w.write(text);
                w.write('\n');
            }
        }

        // ---------------------------------------------------------- 报告
        System.out.println("### CORPUS 开始，输出 " + OUT);
        System.out.println("CORPUS 配方总数(RecipeManager)  : " + totalHolders);
        System.out.println("CORPUS   非 synthetic/crafting  : " + notCrafting + "（熔炉、锻造等）");
        System.out.println("CORPUS   CustomRecipe 跳过      : " + special);
        System.out.println("CORPUS   无 display             : " + noDisplay);
        System.out.println("CORPUS   其它 display 类型跳过  : " + oddDisplay);
        System.out.println("CORPUS   产物读不出             : " + badResult);
        System.out.println("CORPUS   原料为空               : " + noParts);
        System.out.println("CORPUS   文本重复(已去重)       : " + duplicateText);
        System.out.println("CORPUS 写入条数                 : " + texts.size());
        System.out.println("CORPUS 不同产物                 : " + outputs.size());
        System.out.println("CORPUS 不同原料物品             : " + rawItems.size());
        System.out.println("CORPUS 每条原料项数分布         : " + widthHist);
        System.out.println("CORPUS 平均原料项数             : "
                + String.format("%.2f", texts.isEmpty() ? 0.0 : rawItemsAndWidthSum(texts) / (double) texts.size()));
        System.out.println("CORPUS 文件大小                 : " + Files.size(OUT) + " 字节");
        System.out.println("CORPUS RESULT written=" + texts.size()
                + " outputs=" + outputs.size() + " rawItems=" + rawItems.size()
                + " bytes=" + Files.size(OUT));
    }

    /** 只为算「平均每条几个原料项」——从文本里数逗号，避免再存一份中间结构 */
    private static long rawItemsAndWidthSum(Set<String> texts) {
        long sum = 0;
        for (String text : texts) {
            int semi = text.indexOf(';');
            int commas = 0;
            for (int i = semi; i < text.length(); i++) {
                if (text.charAt(i) == ',') {
                    commas++;
                }
            }
            sum += commas + 1;
        }
        return sum;
    }

    /** {@link SlotDisplay} → {@code ItemStack}；不认识的返回 {@link ItemStack#EMPTY} */
    private static ItemStack stackOf(SlotDisplay display) {
        if (display instanceof SlotDisplay.ItemStackSlotDisplay stackDisplay) {
            try {
                ItemStack stack = stackDisplay.stack().create();
                return stack == null ? ItemStack.EMPTY : stack;
            } catch (RuntimeException ex) {
                return ItemStack.EMPTY;
            }
        }
        if (display instanceof SlotDisplay.ItemSlotDisplay itemDisplay) {
            try {
                Item item = itemDisplay.item().value();
                return item == null ? ItemStack.EMPTY : new ItemStack(item);
            } catch (RuntimeException ex) {
                return ItemStack.EMPTY;
            }
        }
        return ItemStack.EMPTY;
    }

    /** 原料槽 → 候选 id（只取第一个候选，见类注释）；空格返回 {@code null} */
    private static String firstCandidateOf(SlotDisplay display) {
        if (display instanceof SlotDisplay.ItemStackSlotDisplay || display instanceof SlotDisplay.ItemSlotDisplay) {
            ItemStack stack = stackOf(display);
            return stack.isEmpty() ? null : VoidWarehouseRecipeBook.idOf(stack.getItem());
        }
        if (display instanceof SlotDisplay.TagSlotDisplay tagDisplay) {
            try {
                for (Holder<Item> holder : tagDisplay.tag()) {
                    String id = VoidWarehouseRecipeBook.idOf(holder.value());
                    if (id != null) {
                        return id;   // 第一候选 = 真实玩家会摆的那一种
                    }
                }
            } catch (RuntimeException ex) {
                return null;
            }
        }
        return null;
    }

    private static int countOf(SlotDisplay display) {
        ItemStack stack = stackOf(display);
        return stack.isEmpty() ? 1 : stack.getCount();
    }
}
