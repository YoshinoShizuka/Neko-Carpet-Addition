package neko.voidwarehouse.restock;

import carpet.CarpetServer;
import com.mojang.authlib.GameProfile;
import io.netty.buffer.Unpooled;
import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
import net.fabricmc.fabric.api.networking.v1.ServerPlayNetworking;
import net.minecraft.network.Connection;
import net.minecraft.network.FriendlyByteBuf;
import net.minecraft.network.protocol.PacketFlow;
import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
import net.minecraft.server.MinecraftServer;
import net.minecraft.server.level.ClientInformation;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.server.level.ServerPlayer;
import net.minecraft.server.network.CommonListenerCookie;
import net.minecraft.server.network.ServerGamePacketListenerImpl;
import net.minecraft.world.entity.player.Inventory;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;

import java.util.List;
import java.util.UUID;

import neko.voidwarehouse.VoidWarehouse;
import neko.voidwarehouse.VoidWarehouseData;
import neko.voidwarehouse.VoidWarehouseSettings;

/**
 * 【临时自检】验证打印机补货这一套；验证完连同 hook 一起删掉。
 */
public final class RestockSelfCheck {

    private static boolean done = false;
    private static int checks = 0;
    private static int failures = 0;

    private RestockSelfCheck() {
    }

    public static void run(MinecraftServer server) {
        if (done) {
            return;
        }
        done = true;
        try {
            all(server);
        } catch (Throwable t) {
            failures++;
            System.out.println("!! 自检抛异常: " + t);
            t.printStackTrace(System.out);
        }
        System.out.println("SMOKE RESULT restock/26.3 checks=" + checks + " failures=" + failures);
        server.halt(false);
    }

    private static void check(String name, boolean ok) {
        checks++;
        if (!ok) {
            failures++;
            System.out.println("FAIL: " + name);
        }
    }

    private static void all(MinecraftServer server) {
        // ---- 1. 规则确实注册进了 Carpet ----
        check("R1 规则已注册", CarpetServer.settingsManager.getRule("voidWarehouseRestock") != null);

        ServerLevel level = server.overworld();
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();

        ServerPlayer player = fakePlayer(server, level);
        if (player == null) {
            check("R2 假玩家可构造", false);
            return;
        }
        check("R2 假玩家可构造", true);
        clearInventory(player);

        // ---- 2. 开关语义：主开关和补货开关任一关闭都必须是 RULE_OFF ----
        VoidWarehouseSettings.voidWarehouse = true;
        VoidWarehouseRestockSettings.voidWarehouseRestock = false;
        check("R3 补货规则关 → RULE_OFF",
                PrinterTakeService.take(server, player, List.of("minecraft:cobblestone")).status()
                        == PrinterTakeResultPayload.RULE_OFF);

        VoidWarehouseRestockSettings.voidWarehouseRestock = true;
        VoidWarehouseSettings.voidWarehouse = false;
        check("R4 主规则关 → RULE_OFF",
                PrinterTakeService.take(server, player, List.of("minecraft:cobblestone")).status()
                        == PrinterTakeResultPayload.RULE_OFF);

        VoidWarehouseSettings.voidWarehouse = true;
        VoidWarehouseRestockSettings.voidWarehouseRestock = true;

        // ---- 3. 非法输入 ----
        check("R5 空候选 → BAD_REQUEST",
                PrinterTakeService.take(server, player, List.of()).status()
                        == PrinterTakeResultPayload.BAD_REQUEST);
        check("R6 畸形 id 不抛异常且视为无货",
                PrinterTakeService.take(server, player, List.of("!!!! not an id !!!!")).status()
                        == PrinterTakeResultPayload.EMPTY);
        check("R7 空仓库 → EMPTY",
                PrinterTakeService.take(server, player, List.of("minecraft:cobblestone")).status()
                        == PrinterTakeResultPayload.EMPTY);

        // ---- 4. 正常取一组 ----
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 64));
        data.insert(new ItemStack(Items.COBBLESTONE, 136));
        int status = PrinterTakeService.take(server, player, List.of("minecraft:cobblestone")).status();
        check("R8 有货 → OK", status == PrinterTakeResultPayload.OK);
        check("R9 背包恰好到手 64", countOf(player, Items.COBBLESTONE) == 64);
        check("R10 仓库剩 136", data.amountOf(Items.COBBLESTONE).intValue() == 136);

        // ---- 5. 凑 stock 只有 5 时给 5（不是整批失败） ----
        clearInventory(player);
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 5));
        check("R11 库存不足一组 → 有多少给多少",
                PrinterTakeService.take(server, player, List.of("minecraft:cobblestone")).status()
                        == PrinterTakeResultPayload.OK);
        check("R12 到手 5", countOf(player, Items.COBBLESTONE) == 5);
        check("R13 仓库清零", data.amountOf(Items.COBBLESTONE).signum() == 0);

        // ---- 6. 背包已满：必须原样退还，仓库不许凭空消耗 ----
        clearInventory(player);
        fillInventory(player, new ItemStack(Items.STONE, 64));
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 64));
        check("R14 背包满 → INVENTORY_FULL",
                PrinterTakeService.take(server, player, List.of("minecraft:cobblestone")).status()
                        == PrinterTakeResultPayload.INVENTORY_FULL);
        check("R15 背包满时仓库零消耗", data.amountOf(Items.COBBLESTONE).intValue() == 64);

        // ---- 7. 只塞得下 3 个：给 3，其余 61 归还 ----
        clearInventory(player);
        fillInventory(player, new ItemStack(Items.STONE, 64));
        player.getInventory().setItem(35, ItemStack.EMPTY);
        player.getInventory().setItem(35, new ItemStack(Items.COBBLESTONE, 61));
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 64));
        check("R16 部分可放也返回 OK",
                PrinterTakeService.take(server, player, List.of("minecraft:cobblestone")).status()
                        == PrinterTakeResultPayload.OK);
        check("R17 原来 61 + 补到 64", countOf(player, Items.COBBLESTONE) == 64);
        check("R18 放不下的 61 已归还仓库", data.amountOf(Items.COBBLESTONE).intValue() == 61);

        // ---- 8. 潜影盒必须挡掉 ----
        clearInventory(player);
        data.clearContent();
        data.insert(new ItemStack(Items.SHULKER_BOX, 16));
        check("R19 潜影盒不会被取给客户端",
                PrinterTakeService.take(server, player, List.of("minecraft:shulker_box")).status()
                        == PrinterTakeResultPayload.EMPTY);
        check("R20 拿了之后背包仍是空的", countOf(player, Items.SHULKER_BOX) == 0);

        // ---- 9. 不可堆叠物品（剑）一次给 1 ----
        clearInventory(player);
        data.clearContent();
        data.insert(new ItemStack(Items.DIAMOND_SWORD, 10));
        check("R21 剑也能取",
                PrinterTakeService.take(server, player, List.of("minecraft:diamond_sword")).status()
                        == PrinterTakeResultPayload.OK);
        check("R22 剑到手 1 把", countOf(player, Items.DIAMOND_SWORD) == 1);
        check("R23 剑仓库剩 9", data.amountOf(Items.DIAMOND_SWORD).intValue() == 9);

        // ---- 10. 候选清单按序命中 ----
        clearInventory(player);
        data.clearContent();
        data.insert(new ItemStack(Items.ANDESITE, 64));
        check("R24 第一个候选无货则退到第二个",
                PrinterTakeService.take(server, player,
                        List.of("minecraft:cobblestone", "minecraft:andesite")).status()
                        == PrinterTakeResultPayload.OK);
        check("R25 命中的是第二个", countOf(player, Items.ANDESITE) == 64);

        // ---- 10b. TakeOutcome 带出来的三个数（聊天栏提示的取数依据）----
        // 聊天提示要显示「取走 N 个 / 剩余 M 个」，这两个值全部取自 TakeOutcome。
        // 一旦它们与真实背包/仓库状态不一致，玩家看到的提示就是假的 —— 所以单独钉一遍。
        clearInventory(player);
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 200));
        PrinterTakeService.TakeOutcome okOutcome =
                PrinterTakeService.take(server, player, List.of("minecraft:cobblestone"));
        check("R25b 成功时 delivered() 为真", okOutcome.delivered());
        check("R25c takenCount 与背包实得一致",
                okOutcome.takenCount() == 64 && countOf(player, Items.COBBLESTONE) == 64);
        check("R25d remaining 与仓库实况一致",
                okOutcome.remaining().intValue() == 136
                        && data.amountOf(Items.COBBLESTONE).intValue() == 136);
        check("R25e sample 是命中的那种物品（数量恒 1）",
                okOutcome.sample().getItem() == Items.COBBLESTONE
                        && okOutcome.sample().getCount() == 1);

        // 失败路径：takenCount 必须为 0，不然聊天栏会报出「取走了 N 个」但实际没给
        PrinterTakeService.TakeOutcome emptyOutcome =
                PrinterTakeService.take(server, player, List.of("minecraft:diamond_block"));
        check("R25f 失败时 delivered() 为假且 takenCount=0",
                !emptyOutcome.delivered() && emptyOutcome.takenCount() == 0);

        // 部分放下：takenCount 是「真的进了背包」的数量（3），remaining 是「退还之后」的
        // 真实剩余（61）—— 不是「取货前的 64 - 3 = 61」这种巧合，得分别验。
        clearInventory(player);
        fillInventory(player, new ItemStack(Items.STONE, 64));
        player.getInventory().setItem(35, new ItemStack(Items.COBBLESTONE, 61));
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 64));
        PrinterTakeService.TakeOutcome partial =
                PrinterTakeService.take(server, player, List.of("minecraft:cobblestone"));
        check("R25g 部分放下时 takenCount=3、remaining=61",
                partial.takenCount() == 3 && partial.remaining().intValue() == 61);

        // ---- 11. 网络层的两件事：通道注册 + 字节级往返 ----
        // 没有真客户端可以联调，这两项就把「拼不到 C2S 那一侧」的风险压到最低。
        check("R26 C2S 接收端已注册",
                net.fabricmc.fabric.api.networking.v1.ServerPlayNetworking.getGlobalReceivers()
                        .contains(PrinterTakePayload.TYPE.id()));

        // ---- 12. 单通道架构的回归断言（跨模组共用 payload 类时最容易踩的坑）----
        // 血泪史（两个阶段）：
        //  ① 最早两端各用自己的 payload 类、共用同一个通道名 → 编码时
        //     ClassCastException: VoidWarehouseTakePayload cannot be cast to PrinterTakePayload。
        //  ② 改成「两条通道名各走各的」→ 客户端发自家通道时，服务端 handler 仍然
        //     要 cast 成自己的类，还是炸；且服务端顺手注册 S2C 还会与客户端抢注册。
        // 最终解法：两端<b>共用同一个 payload 类</b>（同包同名），通道也收敛成一条。
        // 下面的断言就是钉住这个不变量 —— 谁再加第二条通道 / 再改一处名字，这里立刻红。
        check("R26b C2S 接收端挂着（单通道）",
                ServerPlayNetworking.getGlobalReceivers().contains(PrinterTakePayload.TYPE.id()));
        check("R26c 通道收敛为服务端命名空间",
                PrinterTakePayload.TYPE.id().getNamespace().equals("carpet_neko_addition")
                        && PrinterTakeResultPayload.TYPE.id().getNamespace()
                                .equals("carpet_neko_addition"));

        // 关键不变量：注册表里那条 C2S 记录绑的 codec，必须就是 PrinterTakePayload 自己的
        // codec。名字一样、但 codec 互换了（比如被另一个 mod 抢先注册）就说明架构又歪了。
        boolean c2sIsOurs = false;
        try {
            PayloadTypeRegistry.serverboundPlay()
                    .register(PrinterTakePayload.TYPE, PrinterTakePayload.CODEC);
        } catch (IllegalArgumentException already) {
            // 抛异常 = 这个 key 已被占用。占用者是不是我们？
            // 用「注册 PrinterTakeResultPayload 的 codec 到同一个 key 会不会也被拒」
            // 没法区分，改为直接断言：本条能注册成功（说明刚才没注册过）就不算 ours。
            c2sIsOurs = true;
        }
        check("R26d C2S 的 printer_take 通道已被本模组注册（顺序无关）", c2sIsOurs);

        // 两条 S2C/C2S 的名字必须不同，否则表里会互相覆盖
        check("R26e 取货与回执是两条不同通道",
                !PrinterTakePayload.TYPE.id().equals(PrinterTakeResultPayload.TYPE.id()));

        // 关键不变量：C2S 表里 printer_take 那条记录的 codec 必须能直接编解码
        // PrinterTakePayload 自己 —— 这正是「两端共用一个类」落地的直接证据。
        // 编码时 writeCap 走的就是这条 codec，能过就说明不会再 ClassCastException。
        //
        // 注意 PayloadTypeRegistry 接口上没有 get(id)（只有 register / registerLarge），
        // 唯一的只读入口在实现类 PayloadTypeRegistryImpl 上；这里两个都试：
        // 优先用接口 register 的返回值（最稳），拿不到再退到 Impl.get。
        boolean roundTripThroughRegistry = false;
        try {
            PrinterTakePayload probePayload = new PrinterTakePayload(7, List.of("minecraft:stone"));
            net.minecraft.network.protocol.common.custom.CustomPacketPayload.TypeAndCodec<?, ?>
                    entry = resolveRegisteredEntry();
            if (entry != null) {
                @SuppressWarnings("unchecked")
                net.minecraft.network.codec.StreamCodec<FriendlyByteBuf,
                        net.minecraft.network.protocol.common.custom.CustomPacketPayload> codec =
                        (net.minecraft.network.codec.StreamCodec<FriendlyByteBuf,
                                net.minecraft.network.protocol.common.custom.CustomPacketPayload>) entry.codec();
                FriendlyByteBuf probe = new FriendlyByteBuf(Unpooled.buffer());
                codec.encode(probe, probePayload);
                roundTripThroughRegistry = probePayload.equals(codec.decode(probe));
                probe.release();
            }
        } catch (Throwable t) {
            System.out.println("   注册表 codec 往返失败: " + t);
        }
        check("R26f 注册表里的 codec 能编解码本类（共用类落地的直接证据）", roundTripThroughRegistry);

        PrinterTakePayload request = new PrinterTakePayload(42,
                List.of("minecraft:stone", "minecraft:cobblestone"));
        FriendlyByteBuf buf = new FriendlyByteBuf(Unpooled.buffer());
        try {
            PrinterTakePayload.CODEC.encode(buf, request);
            PrinterTakePayload back = PrinterTakePayload.CODEC.decode(buf);
            check("R27 C2S 往返一致", request.equals(back));
            check("R28 C2S 字节刚好读完（没有残留/错位）", buf.readableBytes() == 0);

            buf.clear();
            PrinterTakeResultPayload result = new PrinterTakeResultPayload(42,
                    PrinterTakeResultPayload.INVENTORY_FULL);
            PrinterTakeResultPayload.CODEC.encode(buf, result);
            PrinterTakeResultPayload backResult = PrinterTakeResultPayload.CODEC.decode(buf);
            check("R29 S2C 往返一致", result.equals(backResult));
            check("R30 S2C 字节刚好读完", buf.readableBytes() == 0);
        } catch (Throwable t) {
            check("R27..R30 编解码不抛异常", false);
            System.out.println("   编解码失败: " + t);
        } finally {
            buf.release();
        }

        data.clearContent();
    }

    // ---------------------------------------------------------------- 辅助

    /**
     * 造一个「没真正连上线」的玩家。
     *
     * <p>与 1.21.11 那一版自检同一套写法：{@code Connection} 没有 channel，
     * 所以包只会入队而不会真的发出去，改背包是安全的。</p>
     */
    private static ServerPlayer fakePlayer(MinecraftServer server, ServerLevel level) {
        try {
            GameProfile profile = new GameProfile(UUID.randomUUID(), "RestockSelfCheck");
            ServerPlayer player = new ServerPlayer(server, level, profile, ClientInformation.createDefault());
            player.connection = new ServerGamePacketListenerImpl(
                    server, new Connection(PacketFlow.SERVERBOUND), player,
                    CommonListenerCookie.createInitial(profile, false));
            return player;
        } catch (Throwable t) {
            System.out.println("   假玩家构造失败: " + t);
            return null;
        }
    }

    private static int countOf(ServerPlayer player, Item item) {
        int total = 0;
        Inventory inv = player.getInventory();
        for (int i = 0; i < inv.getContainerSize(); i++) {
            ItemStack stack = inv.getItem(i);
            if (stack.getItem() == item) {
                total += stack.getCount();
            }
        }
        return total;
    }

    private static void clearInventory(ServerPlayer player) {
        Inventory inv = player.getInventory();
        for (int i = 0; i < inv.getContainerSize(); i++) {
            inv.setItem(i, ItemStack.EMPTY);
        }
    }

    private static void fillInventory(ServerPlayer player, ItemStack template) {
        Inventory inv = player.getInventory();
        for (int i = 0; i < 36; i++) {
            inv.setItem(i, template.copyWithCount(template.getCount()));
        }
    }

    /**
     * 取 C2S 表里 {@code printer_take} 那条记录（type + codec）。
     *
     * <p>{@code PayloadTypeRegistry} 这个<b>接口</b>只暴露 register / registerLarge，
     * 没有只读查询入口；真正的查表方法 {@code get(Identifier)} 在实现类
     * {@code PayloadTypeRegistryImpl} 上（也是 public）。这里直接强转过去用。</p>
     *
     * <p>本模组在编译期只有 Fabric 的 api 模块（implementation fabric-api），
     * 实现类在同一个 jar 里，所以强转不需要额外依赖。</p>
     */
    private static net.minecraft.network.protocol.common.custom.CustomPacketPayload.TypeAndCodec<?, ?>
            resolveRegisteredEntry() {
        Object registry = PayloadTypeRegistry.serverboundPlay();
        if (registry instanceof net.fabricmc.fabric.impl.networking.PayloadTypeRegistryImpl<?> impl) {
            return impl.get(PrinterTakePayload.TYPE.id());
        }
        return null;
    }
}
