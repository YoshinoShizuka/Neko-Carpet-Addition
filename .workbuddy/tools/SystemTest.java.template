        }
        System.out.println("SYSTEM TEST RESULT v26.3 checks=" + checks
                + " failures=" + failures + " skips=" + skips + " sink=" + sink);
        server.halt(false);
    }

    // ================================================================== 断言

    private static void check(String label, boolean ok) {
        checks++;
        if (!ok) {
            failures++;
            failedLabels.add(label);
        }
        System.out.println("   " + (ok ? "ok  " : "FAIL") + " " + label);
    }

    private static void skip(String why) {
        skips++;
        System.out.println("   skip " + why);
    }

    /** 计划里某个物品 id（9 合 1 口径，只留 path）的净增减 */
    private static BigInteger amountOfDelta(VoidWarehouseExchange.Plan plan, String itemId) {
        BigInteger sum = BigInteger.ZERO;
        for (VoidWarehouseExchange.Delta d : plan.deltas()) {
            if (d.itemId().equals(itemId)) {
                sum = sum.add(d.change());
            }
        }
        return sum;
    }

    private static BigInteger amountOf(Map<String, BigInteger> map, String id) {
        return map.getOrDefault(id, BigInteger.ZERO);
    }

    /**
     * 塞进去 {@code total} 个<b>互不相同</b>的物品。
     *
     * <p>同一物品进库会自动合并成一格，所以「塞 50 个石头」只占 1 格 ——
     * 想撑出第二页必须换 51 种物品。已在库里的会被合并、{@code entryCount} 不涨，自然跳过，
     * 所以这个方法可以反复调用来「接着填」。</p>
     */
    private static void fillDistinct(VoidWarehouseData target, int total) {
        for (Item item : net.minecraft.core.registries.BuiltInRegistries.ITEM) {
            if (target.entryCount() >= total) {
                return;
            }
            if (item == Items.AIR || target.amountOf(item).signum() > 0) {
                // 已经在库里的会「合并 +1」而不是「多占一格」—— 不排除掉，
                // 第二次调用会把总量撑爆（entryCount 不涨、总数狂涨）
                continue;
            }
            target.insert(new ItemStack(item, 1));
        }
    }
}
