        BlockPos hp = table.above();
        level.setBlock(hp, Blocks.HOPPER.defaultBlockState().setValue(HopperBlock.FACING, Direction.DOWN), 3);
        placed.add(hp);
        HopperBlockEntity hopper = (HopperBlockEntity) level.getBlockEntity(hp);
        if (hopper == null) {
            skip("漏斗方块实体拿不到");
            return;
        }

        // 上方放一个桶作为货源，模拟「上箱 → 漏斗 → 仓库」
        BlockPos chestPos = hp.above();
        level.setBlock(chestPos, Blocks.CHEST.defaultBlockState(), 3);
        placed.add(chestPos);
        var chest = HopperBlockEntity.getContainerAt(level, chestPos);
        if (chest == null) {
            skip("上方箱子拿不到");
            return;
        }

        long items = 0;
        int ticks = 0;
        long t0 = System.nanoTime();
        // 塞 200 tick 的货（每 tick 补满箱子）
        for (int i = 0; i < 200; i++) {
            for (int slot = 0; slot < chest.getContainerSize(); slot++) {
                if (chest.getItem(slot).isEmpty()) {
                    chest.setItem(slot, new ItemStack(Items.COBBLESTONE, 64));
                }
            }
            long before = data.amountOf(Items.COBBLESTONE).longValueExact();
            VoidWarehouseHopper.intake(level, hopper, false);
            items += data.amountOf(Items.COBBLESTONE).longValueExact() - before;
            ticks++;
        }
        double seconds = (System.nanoTime() - t0) / 1_000_000_000.0;
        System.out.printf("[PERF] %-48s %10.0f 个/秒（%d tick，%.0f 个/tick）%n",
                "漏斗入库吞吐（上箱连续供货）", items / seconds, ticks, (double) items / ticks);
        chest.clearContent();
    }

