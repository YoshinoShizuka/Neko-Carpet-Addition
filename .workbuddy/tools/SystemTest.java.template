    private interface Op {
        void run();
    }

    /** 微基准：warmup 后取多轮最小值（最小值比均值更能排除 GC/JIT 抖动） */
    private static double benchMicros(String label, int warmup, int rounds, Op op) {
        for (int i = 0; i < warmup; i++) {
            op.run();
        }
        // 自动定批：Windows 上 nanoTime 的实际分辨率约 100 ns，单次几十纳秒的操作会直接读成 0。
        // 所以先把「一批」凑到 200 us 以上，再除回单次 —— 否则报告里的 0.00 us 是假的。
        int batch = 1;
        long probe = timeBatch(op, batch);
        while (probe < 200_000L && batch < (1 << 20)) {
            batch *= 8;
            probe = timeBatch(op, batch);
        }
        long best = Long.MAX_VALUE;
        for (int i = 0; i < rounds; i++) {
            best = Math.min(best, timeBatch(op, batch));
        }
        double us = best / 1000.0 / batch;
        System.out.printf("[PERF] %-44s %10.3f us%s%n", label, us,
                batch > 1 ? "（批 " + batch + "）" : "");
        return us;
    }

    private static long timeBatch(Op op, int times) {
        long t0 = System.nanoTime();
        for (int i = 0; i < times; i++) {
            op.run();
        }
        return System.nanoTime() - t0;
    }

