    /**
     * 「可兑表」重算一次的成本。
     *
     * <p>必须<b>每轮都把缓存打掉</b>才能量到真东西：这个方法是带缓存的，
     * 缓存命中只有 0.1 us（那也是真实数字，但它量的是「命中」，不是「重算」）。
     * 改仓库内容就会让缓存失效 —— 界面每开一次、每次入库都会发生，所以「重算」才是
     * 玩家真正遇到的那个开销。</p>
     *
     * <p>填料要<b>只囤每条边的「下级」</b>：可兑条目 = 「仓库里一件都没有、但换得出来」，
     * 所以把下级囤爆、上级空着，才会得到最长的可兑列表（最坏情况）；
     * 反过来的「每种都囤一点」会让可兑列表变空，量到的是最便宜的情况。</p>
     */
    private static void offersRound(String label, int perItem) {
        int rounds = 5;
        long best = Long.MAX_VALUE;
        int offers = 0;
        for (int r = 0; r < rounds; r++) {
            data.clearContent();
            if (perItem > 0) {
                for (VoidWarehouseExchange.Edge edge : VoidWarehouseExchange.active().edges()) {
                    Item small = VoidWarehouseExchangeBootstrap.itemOf(edge.small());
                    if (small != null) {
                        data.insert(new ItemStack(small, perItem));
                    }
                }
            }
            data.insert(new ItemStack(Items.DIRT, 1));   // 保证条目数变化 → 缓存必定失效
            long t0 = System.nanoTime();
            offers = data.exchangeOffers().size();
            best = Math.min(best, System.nanoTime() - t0);
            sink += offers;
        }
        System.out.printf("[PERF] %-44s %10.3f ms（%d 条可兑）%n",
                "exchangeOffers 重算（" + label + "）", best / 1_000_000.0, offers);
    }

