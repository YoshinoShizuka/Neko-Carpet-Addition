                "填充后堆增长", (after - before) / 1024.0 / 1024.0, data.entryCount());
        data.clearContent();
        long cleared = usedHeap();
        System.out.printf("[PERF] %-48s %10.1f MB%n", "清空后堆回落", (cleared - before) / 1024.0 / 1024.0);
    }

    private static long usedHeap() {
        Runtime rt = Runtime.getRuntime();
        System.gc();
        try {
            Thread.sleep(50);
        } catch (InterruptedException ignored) {
            Thread.currentThread().interrupt();
        }
        return rt.totalMemory() - rt.freeMemory();
    }

    // ================================================================== 多人

    /**
     * 多玩家压力：N 个真实 ServerPlayer 各自持有界面、并发取货。
     *
     * <p>「并发」在服务端是<b>同一个 tick 内顺序执行</b>（Minecraft 的主循环单线程），
     * 所以这里量的是「N 个玩家在同一 tick 里各做一次动作」的总耗时 ——
     * 那才是 TPS 真正感受到的东西。折算到 20 TPS 的预算（50 ms/tick）就能看出能撑多少人。</p>
     */
    private static void multiplayer(MinecraftServer server) {
        System.out.println("[MP] 多玩家压力（每 tick 每玩家一次动作）");
        data.clearContent();
        for (int i = 0; i < 200; i++) {
            data.insert(new ItemStack(Items.STONE, 10000));
        }
        data.insert(new ItemStack(Items.COBBLESTONE, 100000));

        int[] players = {1, 5, 10, 20};
        for (int n : players) {
            List<ServerPlayer> group = bots.subList(0, Math.min(n, bots.size()));
            // 1) 每人开一次界面
            long t0 = System.nanoTime();
            List<VoidWarehouseMenu> menus = new ArrayList<>(group.size());
            for (ServerPlayer p : group) {
                menus.add(new VoidWarehouseMenu(1, p.getInventory(), data, p));
            }
            long openNs = System.nanoTime() - t0;

            // 2) 每人取 1 个（走数据层，与界面点击最终落到的是同一条路）
            t0 = System.nanoTime();
            for (ServerPlayer ignored : group) {
                sink += data.take(0, 1);
                data.insert(new ItemStack(Items.STONE, 1));
            }
            long takeNs = System.nanoTime() - t0;

            // 3) 每人翻一次页（视图状态）
            t0 = System.nanoTime();
            for (ServerPlayer p : group) {
                VoidWarehouseViews.View v = VoidWarehouseViews.viewFor(p);
                v.setPage(1);
                v.setPage(0);
            }
            long pageNs = System.nanoTime() - t0;

            // 4) 每人拉一整页（界面开着时每 tick 都在做的事 —— 这才是 TPS 的大头）
            t0 = System.nanoTime();
            for (ServerPlayer ignored : group) {
                for (int i = 0; i < VoidWarehouseData.PAGE_SIZE; i++) {
                    sink += data.displaySlotAt(i).isEmpty() ? 0 : 1;
                }
            }
            long syncNs = System.nanoTime() - t0;

            long totalNs = openNs + takeNs + pageNs + syncNs;
            double totalMs = totalNs / 1_000_000.0;
            System.out.printf("[MP] %-8s 打开 %7.3f | 取货 %7.3f | 翻页 %7.3f | 整页刷新 %7.3f"
                            + " | 合计 %7.3f ms | 占 50ms tick %5.1f%%%n",
                    n + " 人", openNs / 1_000_000.0, takeNs / 1_000_000.0,
                    pageNs / 1_000_000.0, syncNs / 1_000_000.0,
                    totalMs, totalMs / 50.0 * 100.0);
            check("MP" + n + " 单 tick 开销 < 10ms（留足 TPS 余量）", totalMs < 10.0);
        }

        // 极限：20 人连点 20 次/秒（每人每秒 20 次取货）
        List<ServerPlayer> group = bots;
        long t0 = System.nanoTime();
        int actions = 0;
        for (int round = 0; round < 20; round++) {
            for (ServerPlayer ignored : group) {
                sink += data.take(0, 1);
                data.insert(new ItemStack(Items.STONE, 1));
                actions++;
            }
        }
        double ms = (System.nanoTime() - t0) / 1_000_000.0;
        System.out.printf("[MP] %-8s %d 次动作合计 %.3f ms（单次 %.2f us）%n",
                group.size() + " 人×20 次", actions, ms, ms * 1000.0 / actions);
        check("MP 极限：单次动作 < 200us", ms * 1000.0 / actions < 200.0);

        // 真正的峰值：每人「入库一格 + 界面刷新」—— 入库会打掉可兑表缓存，
        // 刷新又要重算它。20 人挤在同一个 tick 里，就是 20 次全表重算。
        // 这才是「多人同时开着仓库界面干活」的最坏 tick（空转的 tick 只是上表那些微秒）。
        // 前提：仓库里得是「只囤下级」的形态，可兑条目才会拉满（40 条）——
        // 这一步实测过：仓库里只有石头时重算 0.02ms（0 条可兑），量不到最坏情况。
        data.clearContent();
        // 注意：性能组跑完会把开关关掉，峰值测试必须自己打开，否则可兑表恒为空、
        // 量出来的「峰值」是假的（第一版就踩了这个坑：0.043ms，因为一条可兑都没有）
        VoidWarehouseSettings.voidWarehouse = true;
        VoidWarehouseSettings.voidWarehouseExchange = true;
        for (VoidWarehouseExchange.Edge edge : VoidWarehouseExchange.active().edges()) {
            Item small = VoidWarehouseExchangeBootstrap.itemOf(edge.small());
            if (small != null) {
                data.insert(new ItemStack(small, 6400));
            }
        }
        check("MP 峰值前提：可兑表已拉到最坏形态", data.exchangeOffers().size() >= 30);
        int worstGroup = bots.size();
        t0 = System.nanoTime();
        for (int round = 0; round < 4; round++) {
            for (ServerPlayer ignored : bots) {
                data.insert(new ItemStack(Items.IRON_NUGGET, 64));   // 入库 → 缓存失效
                sink += data.exchangeOffers().size();                // 界面刷新 → 必须重算
            }
        }
        double worstMs = (System.nanoTime() - t0) / 1_000_000.0 / 4.0;
        System.out.printf("[MP] %-8s 入库+界面刷新 %.3f ms/次（折合 %.1f%% 的 50ms tick）%n",
                worstGroup + " 人峰值", worstMs, worstMs / 50.0 * 100.0);
        check("MP 峰值：20 人同 tick 各自入库+刷新仍 < 50ms（不丢 tick）", worstMs < 50.0);
    }

