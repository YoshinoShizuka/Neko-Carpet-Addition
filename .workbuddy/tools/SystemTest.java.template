    /**
     * 造 {@link #BOT_COUNT} 个<b>真实 {@link ServerPlayer} 对象</b>（无客户端）。
     *
     * <p>为什么不用 Fabric 的 {@code FakePlayer}：26.3 的 fabric-api 里已经没有这个类了。
     * 这里走原版自己的构造链 —— {@code ServerPlayer} + 一个 {@code SERVERBOUND} 的空
     * {@link Connection} + {@link ServerGamePacketListenerImpl}。有了连接，模组里
     * 「同步给客户端 / 发消息」的代码路径才会真的执行；拿不到连接时降级为纯数据层测试，
     * 而不是直接跳过整组（否则多人压力的结论就没有了）。</p>
     */
    private static void botsAndConnection(MinecraftServer server) {
        System.out.println("[ENV] 造 " + BOT_COUNT + " 个真实 ServerPlayer（无客户端）");
        for (int i = 0; i < BOT_COUNT; i++) {
            GameProfile profile = new GameProfile(UUID.randomUUID(), "sysbot" + i);
            ServerPlayer p = new ServerPlayer(server, level, profile, ClientInformation.createDefault());
            try {
                Connection conn = new Connection(PacketFlow.SERVERBOUND);
                p.connection = new ServerGamePacketListenerImpl(server, conn, p,
                        CommonListenerCookie.createInitial(profile, false));
                fakeConnection = true;
            } catch (Throwable t) {
                // 降级：没有连接时仍然能做数据层动作，只是发消息 / 同步会被跳过
                fakeConnection = false;
            }
            bots.add(p);
        }
        System.out.println("[ENV] 假连接可用 = " + fakeConnection);
    }

