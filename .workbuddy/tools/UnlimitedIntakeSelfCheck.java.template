    // ------------------------------------------------------------------ P. 旧存档污染治愈（本轮根因修复）

    /**
     * 模拟「种子清单上线前写下的污染旧存档」：漏斗里 {@code 橡木 石头}、filter 开关开着、
     * 但没有逐格种子（旧版没这概念）。加载这种存档原本会触发 {@code adoptLegacy}，
     * 把石头也认成分类物、写成永久的逐格种子，于是永远 {@code 橡木 石头 空 空 空}。
     *
     * <p>修复后：{@link VoidWarehouseClassifier#healLegacy} 在加载旧存档时直接清掉种子、关掉过滤；
     * 玩家重新手动指定（只放橡木）后，上方桶一半圆石一半橡木、圆石一个都进不来。</p>
     */
    private static void setupLegacyHeal(ServerLevel level, VoidWarehouseData data) {
        HopperBlockEntity hopper = setup(level, T, H);
        if (hopper == null) {
            check("P0 入库漏斗造出来了", false);
            return;
        }
        data.clearContent();
        // 模拟「旧版写下的污染存档」：橡木 + 石头躺在漏斗里，filter 开着，没有逐格种子
        hopper.setItem(0, new ItemStack(Items.OAK_LOG, 1));
        hopper.setItem(1, new ItemStack(Items.COBBLESTONE, 1));
        VoidWarehouseHopperFilter filter = (VoidWarehouseHopperFilter) hopper;
        filter.setClassifierFilter(true);
        // 用 healLegacy(filter, false) 模拟「加载旧存档」这一步（schema 标记缺失 = 旧存档）
        VoidWarehouseClassifier.healLegacy(filter, false);
        check("P1 旧存档加载后过滤被关掉（实际 " + filter.hasClassifierFilter() + "）", !filter.hasClassifierFilter());
        check("P2 污染种子被清空（seed0=" + filter.getClassifierSeed(0)
                + " seed1=" + filter.getClassifierSeed(1) + "）",
                filter.getClassifierSeed(0).isEmpty() && filter.getClassifierSeed(1).isEmpty());
        // 玩家重新手动指定：只放橡木
        hopper.setItem(0, new ItemStack(Items.OAK_LOG, 1));
        filter.setClassifierSeed(0, new ItemStack(Items.OAK_LOG, 1));
        filter.setClassifierFilter(true);
        Container barrel = placeBarrel(level, H.above());
        if (barrel == null) {
            check("P0 上方桶造出来了", false);
            return;
        }
        for (int i = 0; i < 13; i++) {
            barrel.setItem(i, new ItemStack(Items.COBBLESTONE, 64));
        }
        for (int i = 13; i < BARREL_SLOTS; i++) {
            barrel.setItem(i, new ItemStack(Items.OAK_LOG, 64));
        }
        barrel.setChanged();
    }

    private static void assertLegacyHeal(ServerLevel level, VoidWarehouseData data) {
        HopperBlockEntity hopper = hopperAt(level, H);
        Container barrel = barrelAt(level, H.above());
        if (hopper == null || barrel == null) {
            check("P3 漏斗 / 上方桶都还在", false);
            return;
        }
        long storedOak = amount(data, Items.OAK_LOG);
        long storedCobble = amount(data, Items.COBBLESTONE);
        long leftCobble = countIn(barrel, Items.COBBLESTONE);
        System.out.println("P 实测：仓库 oak=" + storedOak + " cobble=" + storedCobble
                + "；上方剩 cobble=" + leftCobble + "；漏斗格 " + snapshot(hopper));
        // 注意：setup 里放在漏斗 slot1 的「残留石头」不属于任何种子，会被 drain 当杂物清掉
        // 进库（cobble=1）；上方桶里的 832 个圆石因为不在白名单，一个都进不来。二者要分开看。
        check("P3 上方桶的圆石全被拦住，仅漏斗里残留的 1 个石头被清掉进库（cobble=" + storedCobble + "，应为 1）",
                storedCobble == 1);
        check("P4 圆石原样留在上方桶里（" + leftCobble + " / 832）", leftCobble == 832);
        check("P5 橡木全进库（" + storedOak + " / 896）", storedOak == 896);
        check("P6 漏斗里只剩玩家指定的那一格（格 " + snapshot(hopper) + "）", !spreadBeyond(hopper, 0));
        teardown(level, data, T, H);
    }

    // ------------------------------------------------------------------ Q. 顺序复现用户实机步骤 1-5

    /**
     * 用户实机反馈（本轮前还在复现的那个）：工作台 + 漏斗（口朝下指工作台）+ 箱子（漏斗上方），
     * 漏斗里只填 1 个橡木原木当分类物；先往箱子放 9 组橡木（被秒吸收），
     * 再放 9 组圆石 —— 期望圆石<b>一个都进不来</b>，漏斗永远只剩 {@code 1 0 0 0 0}，
     * 不能变成 {@code 橡木 圆石 空 空 空}（圆石被当成分类物占位）。
     *
     * <p>这一组把 M 组的「混合货物同时存在」拆成「先橡木、后圆石」两步，
     * 专门盯顺序是否会让圆石钻进来占位。</p>
     */
    private static void setupSeqClassifier(ServerLevel level, VoidWarehouseData data) {
        HopperBlockEntity hopper = setup(level, T, H);
        if (hopper == null) {
            check("Q0 入库漏斗造出来了", false);
            return;
        }
        check("Q0 入库漏斗造出来了", true);
        data.clearContent();
        Container barrel = placeBarrel(level, H.above());
        if (barrel == null) {
            check("Q0 上方容器造出来了", false);
            return;
        }
        // 步骤 3：玩家手动往漏斗里放 1 个橡木原木当分类物（只指定橡木）
        hopper.setItem(0, new ItemStack(Items.OAK_LOG, 1));
        VoidWarehouseHopperFilter filter = (VoidWarehouseHopperFilter) hopper;
        filter.setClassifierSeed(0, new ItemStack(Items.OAK_LOG, 1));
        filter.setClassifierFilter(true);
        // 步骤 4：箱子（这里用桶模拟）里放 9 组橡木
        fillBarrel(barrel, Items.OAK_LOG, 9, 64);
    }

    private static void assertSeqOakAbsorbed(ServerLevel level, VoidWarehouseData data) {
        HopperBlockEntity hopper = hopperAt(level, H);
        Container barrel = barrelAt(level, H.above());
        if (hopper == null || barrel == null) {
            check("Q1 漏斗 / 上方容器都还在", false);
            return;
        }
        long storedOak = amount(data, Items.OAK_LOG);
        long leftOak = countIn(barrel, Items.OAK_LOG);
        System.out.println("Q1 实测：仓库 oak=" + storedOak + "；上方剩 oak=" + leftOak
                + "；漏斗格 " + snapshot(hopper));
        check("Q1 橡木被秒吸收进仓库（" + storedOak + " / 576）", storedOak == 576);
        check("Q2 上方容器橡木被抽空（剩 " + leftOak + "）", leftOak == 0);
        check("Q3 漏斗只剩橡木余量 1 个（格 " + snapshot(hopper) + "）",
                snapshot(hopper).equals("1 0 0 0 0"));
        check("Q4 此时还没有圆石进库（" + amount(data, Items.COBBLESTONE) + "）",
                amount(data, Items.COBBLESTONE) == 0);
    }

    private static void addSeqCobble(ServerLevel level, VoidWarehouseData data) {
        Container barrel = barrelAt(level, H.above());
        if (barrel == null) {
            check("Q5 上方容器还在", false);
            return;
        }
        // 步骤 5：再往箱子里放 9 组圆石（橡木已被抽空，桶里只剩圆石）
        fillBarrel(barrel, Items.COBBLESTONE, 9, 64);
    }

    private static void assertSeqNoCobbleResidue(ServerLevel level, VoidWarehouseData data) {
        HopperBlockEntity hopper = hopperAt(level, H);
        Container barrel = barrelAt(level, H.above());
        if (hopper == null || barrel == null) {
            check("Q6 漏斗 / 上方容器都还在", false);
            return;
        }
        long storedCobble = amount(data, Items.COBBLESTONE);
        long leftCobble = countIn(barrel, Items.COBBLESTONE);
        long hopperCobble = countIn(hopper, Items.COBBLESTONE);
        System.out.println("Q6 实测：仓库 cobble=" + storedCobble + "；上方剩 cobble=" + leftCobble
                + "；漏斗格 " + snapshot(hopper) + "（期望 1 0 0 0 0，圆石绝不占位）");
        // 白名单里没有圆石 ⇒ 它一个都进不来：仓库 0、上方原样留着、漏斗不占位
        check("Q6 圆石一个都没进库（" + storedCobble + "）", storedCobble == 0);
        check("Q7 圆石原样留在上方容器（" + leftCobble + " / 576）", leftCobble == 576);
        check("Q8 漏斗没被圆石占位（格 " + snapshot(hopper) + "）",
                hopperCobble == 0 && snapshot(hopper).equals("1 0 0 0 0"));
        teardown(level, data, T, H);
    }

    /** {@code allowed} 以外的格子里还有没有东西（有 = 分类物被摊开 / 杂物占位）。 */
    private static boolean spreadBeyond(HopperBlockEntity hopper, int allowed) {        for (int i = 0; i < hopper.getContainerSize(); i++) {
            if (i != allowed && !hopper.getItem(i).isEmpty()) {
                return true;
            }
        }
        return false;
    }

    // ------------------------------------------------------------------ 工具

    /** 摆一个「口朝下指工作台」的入库漏斗（工作台登记为仓库终端），返回它的方块实体。 */
    private static HopperBlockEntity setup(ServerLevel level, BlockPos table, BlockPos pos) {
        // 上面几组可能在漏斗头顶留了桶，先清掉 —— 否则这一组会走去「上方容器」那条分支
        level.setBlock(pos.above(), Blocks.AIR.defaultBlockState(), 3);
        level.setBlock(table, Blocks.CRAFTING_TABLE.defaultBlockState(), 3);
        level.setBlock(pos, Blocks.HOPPER.defaultBlockState()
                .setValue(HopperBlock.FACING, Direction.DOWN)
                .setValue(HopperBlock.ENABLED, true), 3);
        VoidWarehouseTerminals.add(level, table);
        return hopperAt(level, pos);
    }

    private static HopperBlockEntity hopperAt(ServerLevel level, BlockPos pos) {
        BlockEntity raw = level.getBlockEntity(pos);
        return raw instanceof HopperBlockEntity hopper ? hopper : null;
    }

    /** 在指定位置摆一个桶并把它清空，返回它的容器视图。 */
    private static Container placeBarrel(ServerLevel level, BlockPos pos) {
        level.setBlock(pos, Blocks.BARREL.defaultBlockState(), 3);
        Container barrel = barrelAt(level, pos);
        if (barrel != null) {
            for (int i = 0; i < barrel.getContainerSize(); i++) {
                barrel.setItem(i, ItemStack.EMPTY);
            }
        }
        return barrel;
    }

    private static Container barrelAt(ServerLevel level, BlockPos pos) {
        BlockEntity raw = level.getBlockEntity(pos);
        return raw instanceof Container container ? container : null;
    }

    /** 往桶里前 {@code slots} 格各塞 {@code perSlot} 个。 */
    private static void fillBarrel(Container barrel, Item item, int slots, int perSlot) {
        for (int i = 0; i < slots && i < barrel.getContainerSize(); i++) {
            barrel.setItem(i, new ItemStack(item, perSlot));
        }
        barrel.setChanged();
    }

    private static void teardown(ServerLevel level, VoidWarehouseData data, BlockPos table, BlockPos pos) {
        HopperBlockEntity hopper = hopperAt(level, pos);
        if (hopper != null) {
            clearEntitiesAbove(level, hopper);
        }
        level.setBlock(pos.above(), Blocks.AIR.defaultBlockState(), 3);
        level.setBlock(pos, Blocks.AIR.defaultBlockState(), 3);
        level.setBlock(table, Blocks.AIR.defaultBlockState(), 3);
        VoidWarehouseTerminals.remove(level, table);
        data.clearContent();
    }

    /** 漏斗 5 格的数量快照，形如 {@code 1 0 0 0 0}，失败时一眼看出摊没摊开。 */
    private static String snapshot(HopperBlockEntity hopper) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < hopper.getContainerSize(); i++) {
            if (i > 0) {
                sb.append(' ');
            }
            ItemStack stack = hopper.getItem(i);
            sb.append(stack.isEmpty() ? "0" : stack.getCount());
        }
        return sb.toString();
    }

    /**
     * 在漏斗正上方撒 {@code times} 个实体（每个 {@code count} 个物品）。
     *
     * <p>Y 取 {@code +1.1}：物品实体自身有 0.25 的碰撞盒，这个高度稳稳落在
     * 原版吸力盒（实测 {@code y+0.1875 .. y+1.1875}）的中间。</p>
     *
     * @return 撒下去的物品<b>总个数</b>（不是实体个数）
     */
    private static long drop(ServerLevel level, HopperBlockEntity hopper, Item item, int count, int times) {
        for (int i = 0; i < times; i++) {
            dropOne(level, hopper, item, count);
        }
        return (long) count * times;
    }

    private static ItemEntity dropOne(ServerLevel level, HopperBlockEntity hopper, Item item, int count) {
        BlockPos pos = hopper.getBlockPos();
        ItemEntity entity = new ItemEntity(level, pos.getX() + 0.5D, pos.getY() + 1.1D, pos.getZ() + 0.5D,
                new ItemStack(item, count));
        entity.setDeltaMovement(Vec3.ZERO);
        level.addFreshEntity(entity);
        return entity;
    }

    /**
     * 大范围清场：把测试区里所有的掉落物都删掉。
     *
     * <p>比 {@link #clearEntitiesAbove} 可靠 —— 它用的「吸力盒」在刚撒下实体的那一帧
     * 查不到东西，残留的实体会一路污染到下一个场景的总量对账里。</p>
     */
    private static void wideCleanup(ServerLevel level) {
        net.minecraft.world.phys.AABB box = new net.minecraft.world.phys.AABB(-8D, 0D, -8D, 16D, 24D, 16D);
        for (ItemEntity entity : level.getEntitiesOfClass(ItemEntity.class, box,
                net.minecraft.world.entity.EntitySelector.ENTITY_STILL_ALIVE)) {
            entity.discard();
        }
    }

    /**
     * 数吸力范围内还剩多少个<b>物品</b>（不是实体个数）。
     *
     * <p>必须数物品、不能数实体：原版每 tick 会把<b>同坐标、同组件</b>的掉落物合并，
     * 6 个 count=1 的钻石会并成 1 个 count=6 的实体。数实体的话，
     * 「红石锁存时一个都不收」这种断言会间歇性地假失败（实测报过「剩 1 / 6」）。</p>
     */
    private static long itemsAbove(ServerLevel level, HopperBlockEntity hopper) {
        long total = 0;
        for (ItemEntity entity : HopperBlockEntity.getItemsAtAndAbove(level, hopper)) {
            if (!entity.isRemoved()) {
                total += entity.getItem().getCount();
            }
        }
        return total;
    }

    /** 清掉吸力范围内的掉落物。幂等硬要求：上一轮的残渣不能污染这一轮的断言。 */
    private static void clearEntitiesAbove(ServerLevel level, HopperBlockEntity hopper) {
        for (ItemEntity entity : HopperBlockEntity.getItemsAtAndAbove(level, hopper)) {
            entity.discard();
        }
    }

    private static long amount(VoidWarehouseData data, Item item) {
        BigInteger value = data.amountOf(item);
        return value == null ? 0L : value.longValue();
    }

    /** 数一个容器里某种物品的总个数（桶 / 漏斗都适用）。 */
    private static long countIn(Container container, Item item) {
        long total = 0;
        for (int i = 0; i < container.getContainerSize(); i++) {
            ItemStack stack = container.getItem(i);
            if (!stack.isEmpty() && stack.getItem() == item) {
                total += stack.getCount();
            }
        }
        return total;
    }

    private static final Field COOLDOWN_FIELD = findCooldownField();

    private static Field findCooldownField() {
        try {
            Field field = HopperBlockEntity.class.getDeclaredField("cooldownTime");
            field.setAccessible(true);
            return field;
        } catch (ReflectiveOperationException e) {
            System.out.println("!! 反射拿不到 cooldownTime: " + e);
            return null;
        }
    }

    private static void setCooldown(HopperBlockEntity hopper, int value) {
        try {
            COOLDOWN_FIELD.setInt(hopper, value);
        } catch (IllegalAccessException e) {
            System.out.println("!! set cooldownTime 失败: " + e);
        }
    }

    private static int cooldownOf(HopperBlockEntity hopper) {
        try {
            return COOLDOWN_FIELD.getInt(hopper);
        } catch (IllegalAccessException e) {
            System.out.println("!! read cooldownTime 失败: " + e);
            return -1;
        }
    }
}
