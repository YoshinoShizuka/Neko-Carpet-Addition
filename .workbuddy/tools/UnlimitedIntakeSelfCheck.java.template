     * 漏斗 slot0 手动摆 1 个橡木原木当分类物。
     *
     * <p>修复前：原版 {@code addItem} 按 slot 0→N 逐个试，slot0 被补满之后多出来的那 1 个
     * 就去开垦 slot1，一 tick 下来 5 格全变成 {@code 1 1 1 1 1} —— 玩家手动摆的分类只剩第一格，
     * 后面四格被货物占住，想加第二种分类物都没地方。</p>
     * <p>修复后：货物只进得了 slot0，而且 {@code drain} 只留 {@code KEEP} 个当种子，
     * 所以漏斗必须一直是 {@code 1 0 0 0 0}。</p>
     */
    private static void setupNoSpread(ServerLevel level, VoidWarehouseData data) {
        HopperBlockEntity hopper = setup(level, T, H);
        if (hopper == null) {
            check("J0 入库漏斗造出来了", false);
            return;
        }
        data.clearContent();
        Container barrel = placeBarrel(level, H.above());
        if (barrel == null) {
            check("J0 上方桶造出来了", false);
            return;
        }
        hopper.setItem(0, new ItemStack(Items.OAK_LOG, 1));
        VoidWarehouseHopperFilter seed2 = (VoidWarehouseHopperFilter) hopper;
        seed2.setClassifierSeed(0, new ItemStack(Items.OAK_LOG, 1));
        seed2.setClassifierFilter(true);
        fillBarrel(barrel, Items.OAK_LOG, BARREL_SLOTS, 64);
    }

    private static void assertNoSpread(ServerLevel level, VoidWarehouseData data) {
        HopperBlockEntity hopper = hopperAt(level, H);
        Container barrel = barrelAt(level, H.above());
        if (hopper == null || barrel == null) {
            check("J1 漏斗 / 上方桶都还在", false);
            return;
        }
        long stored = amount(data, Items.OAK_LOG);
        long leftAbove = countIn(barrel, Items.OAK_LOG);
        System.out.println("J 实测：仓库 oak=" + stored + "；上方剩 " + leftAbove
                + "；漏斗格 " + snapshot(hopper));
        // 分类物不许摊开：只有 slot0 有东西，后面 4 格必须全空
        boolean spread = false;
        for (int i = 1; i < hopper.getContainerSize(); i++) {
            if (!hopper.getItem(i).isEmpty()) {
                spread = true;
            }
        }
        check("J1 分类物没被摊到别的格子（格 " + snapshot(hopper) + "）", !spread);
        check("J2 slot0 只剩分类物余量 1 个（实际 " + hopper.getItem(0).getCount() + "）",
                hopper.getItem(0).getCount() == VoidWarehouseClassifier.KEEP);
        check("J3 1728 个橡木全进库（实际 " + stored + "）", stored == 1728L);
        check("J4 上方桶被抽空（剩 " + leftAbove + "）", leftAbove == 0);
        check("J5 总量守恒 1729 = " + (stored + leftAbove + countIn(hopper, Items.OAK_LOG)),
                stored + leftAbove + countIn(hopper, Items.OAK_LOG) == 1729L);
        teardown(level, data, T, H);
    }

