        check("H2 上方容器被抽空（剩 " + leftAbove + "）", leftAbove == 0);
        check("H3 总量守恒 320 = " + (stored + leftAbove + countIn(hopper, Items.COBBLESTONE)),
                stored + leftAbove + countIn(hopper, Items.COBBLESTONE) == 320);
