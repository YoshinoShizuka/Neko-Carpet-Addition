        check("P9 刚到阈值：「记住」1 行 +「快满」2 行 = 3 行（实测 " + near1.size() + "）",
                near1.size() == 3);
        check("P9b 快满那行写「快满了」并带「已用 / 上限」（千分位）", near1.size() == 3
                && near1.get(1).getString().contains("快满了")
                && near1.get(1).getString().contains("1,844 / 2,048"));
        List<Component> near2 = VoidWarehouseRecipeNotice.onCrafted(
                nearWho, false, VoidWarehouseData.LearnResult.LEARNED,
                fresh, List.of(), threshold + 1, max, 2_100L);
        check("P9c 同一玩家再学一条不再重复报快满（只剩 1 行，实测 " + near2.size() + "）",
                near2.size() == 1);

        // ---- P10/P11 满本：边沿说一次，之后 30 秒一次 ----
        UUID fullWho = UUID.randomUUID();
        List<Component> full1 = VoidWarehouseRecipeNotice.onCrafted(
                fullWho, false, VoidWarehouseData.LearnResult.FULL,
                fresh, List.of(), max, max, 3_000L);
        check("P10 满本第一次 → 2 行（实测 " + full1.size() + "）", full1.size() == 2);
        check("P10b 文案说清「已满」和「没记住」", full1.size() == 2
                && full1.get(0).getString().contains("已满")
                && full1.get(0).getString().contains("没记住"));
        List<Component> full2 = VoidWarehouseRecipeNotice.onCrafted(
                fullWho, false, VoidWarehouseData.LearnResult.FULL,
                fresh, List.of(), max, max, 3_100L);
        check("P11 30 秒内再合成不刷屏（0 行，实测 " + full2.size() + "）", full2.isEmpty());
        List<Component> full3 = VoidWarehouseRecipeNotice.onCrafted(
                fullWho, false, VoidWarehouseData.LearnResult.FULL,
                fresh, List.of(), max, max,
                3_000L + VoidWarehouseRecipeNotice.FULL_REPEAT_TICKS);
        check("P11b 过了 30 秒再提醒一次（2 行，实测 " + full3.size() + "）", full3.size() == 2);

        // ---- P12 用量掉回去之后，边沿标记要能复位 ----
        List<Component> back = VoidWarehouseRecipeNotice.onCrafted(
                fullWho, false, VoidWarehouseData.LearnResult.LEARNED,
                fresh, List.of(), 10, max, 4_000L);
        check("P12 用量掉回阈值以下 → 只发「记住」那行（实测 " + back.size() + "）", back.size() == 1);
        List<Component> again = VoidWarehouseRecipeNotice.onCrafted(
                fullWho, false, VoidWarehouseData.LearnResult.FULL,
                fresh, List.of(), max, max, 4_100L);
        check("P12b 再次变满时重新提示（否则「提示过」这个标记会一辈子卡住，实测 "
                + again.size() + " 行）", again.size() == 2);

        // ---- P13 双语：英文客户端拿英文，且不混中文 ----
        List<Component> en1 = VoidWarehouseRecipeNotice.onCrafted(
                UUID.randomUUID(), true, VoidWarehouseData.LearnResult.LEARNED,
                fresh, threeOld, 10, max, 5_000L);
        check("P13 英文客户端走英文文案", en1.size() == 2
                && en1.get(0).getString().contains("Learned recipe:"));
        check("P13b 英文版不混中文", en1.size() == 2
                && !en1.get(0).getString().contains("已记住")
                && !en1.get(1).getString().contains("还能这样合"));

        // ---- P14 一条配方的渲染形状 ----
        String desc = VoidWarehouseRecipeNotice.describe(fresh, false).getString();
        String descEn = VoidWarehouseRecipeNotice.describe(fresh, true).getString();
        // 探到的那条配方原料数量是循环变量决定的（7~20 里的第一个空位），
        // 所以这里不能写死「7」，要按 fresh 自己的数字验。
        int partCount = fresh.parts().get(0).count();
        System.out.println("      P 渲染样例：" + desc + "   |   " + descEn);
        check("P14 渲染成「原料数量 原料名 → 产物数量 产物名」（实测 " + desc + "）",
                desc.contains("→") && desc.contains(String.valueOf(partCount))
                        && desc.contains(String.valueOf(fresh.outputCount())));
        check("P14b 英文版同一形状、且不带中文箭头以外的中文",
                descEn.contains("→") && !descEn.contains("个"));

        // ---- P15 「学之前」的快照由数据层固化，别在调用方手写两行 ----
        // 产品侧唯一入口是 learnCapturingOthers：它先 recipesFor 再 learn，
        // 把最容易写反的那个顺序收进方法体。反了的话 othersBefore 里会有刚学的那条。
        VoidWarehouseRecipes.Recipe probe2 = null;
        for (int n = 21; n <= 30 && probe2 == null; n++) {
            VoidWarehouseRecipes.Recipe probe =
                    recipe(NOTICE_OUTPUT, 4, part("minecraft:oak_planks", n));
            if (!containsRecipe(data.recipesFor(NOTICE_OUTPUT), probe.recipeId())) {
                probe2 = probe;
            }
        }
        check("P15 前置：再造一条本轮没学过的配方", probe2 != null);
        if (probe2 != null) {
            int pre = data.recipesFor(NOTICE_OUTPUT).size();
            VoidWarehouseData.LearnOutcome outcome = data.learnCapturingOthers(probe2);
            check("P15a learnCapturingOthers 的结局是 LEARNED",
                    outcome.result() == VoidWarehouseData.LearnResult.LEARNED);
            check("P15b 交出来的快照是「学之前」那一份（" + pre + " 条，实测 "
                            + outcome.othersBefore().size() + " 条）",
                    outcome.othersBefore().size() == pre);
            check("P15c 快照里没有刚学进去的这条（顺序写反的话它就会在里面）",
                    !containsRecipe(outcome.othersBefore(), probe2.recipeId()));
        }

        // ---- Q 翻译契约：扩展必须自己把 lang 文件交给 Carpet ----
        // Carpet 构造 SettingsManager 时会遍历每个扩展调一次 canHasTranslations，
        // 而规则描述是在「解析规则那一刻」就从这张表里快照下来的（ParsedRule.description）。
        // 所以这个方法是契约、不是可选项：不实现它，六条规则会一起变成「没有描述」，
        // 而且不会有任何报错。历史上这几个键是被 autoMending 那个扩展顺带注册的 ——
        // 表面上能显示，但那是一条没人写下来的隐式依赖。
        VoidWarehouseExtension extension = null;
        for (carpet.CarpetExtension candidate : carpet.CarpetServer.extensions) {
            if (candidate instanceof VoidWarehouseExtension vw) {
                extension = vw;
                break;
            }
        }
        check("Q1 虚空仓库扩展已注册到 Carpet", extension != null);
        if (extension != null) {
            String[] rules = {"voidWarehouse", "voidWarehouseCraft", "voidWarehouseExchange",
                    "voidWarehouseBlockDrops", "voidWarehouseRestock", "voidWarehouseDirectPlace"};
            for (String lang : new String[]{"zh_cn", "en_us"}) {
                java.util.Map<String, String> map = extension.canHasTranslations(lang);
                int missing = 0;
                for (String rule : rules) {
                    if (!map.containsKey("carpet.rule." + rule + ".name")) {
                        missing++;
                    }
                    if (!map.containsKey("carpet.rule." + rule + ".desc")) {
                        missing++;
                    }
                }
                check("Q2 " + lang + " 的 6 条规则（名+描述共 12 键）由扩展自己交出（缺 "
                        + missing + " 项）", missing == 0);
            }
        }

        VoidWarehouseSettings.voidWarehouseExchange = false;
    }

    /** 两份配方列表的 recipeId 序列是否逐项相同 */
    private static boolean sameRecipeIds(List<VoidWarehouseRecipes.Recipe> a,
                                         List<VoidWarehouseRecipes.Recipe> b) {
        if (a == null || b == null || a.size() != b.size()) {
            return false;
        }
        for (int i = 0; i < a.size(); i++) {
            if (!a.get(i).recipeId().equals(b.get(i).recipeId())) {
                return false;
            }
        }
        return true;
    }

    /** 列表里有没有这条 recipeId */
    private static boolean containsRecipe(List<VoidWarehouseRecipes.Recipe> list, String recipeId) {
        if (list == null || recipeId == null) {
            return false;
        }
        for (VoidWarehouseRecipes.Recipe recipe : list) {
            if (recipeId.equals(recipe.recipeId())) {
                return true;
            }
        }
        return false;
    }

    /** 子串出现次数（用来数提示里列了几条配方、有几个箭头） */
    private static int countOccurrences(String text, String needle) {
        if (text == null || needle == null || needle.isEmpty()) {
            return 0;
        }
        int n = 0;
        int from = 0;
        while (true) {
            int at = text.indexOf(needle, from);
            if (at < 0) {
                return n;
            }
            n++;
            from = at + needle.length();
        }
    }

    /** 反射取 {@code VoidWarehouseData} 的私有字段（自检与产品代码同一个 classloader，setAccessible 可用） */
    private static java.lang.reflect.Field declaredField(String name) {
        try {
            java.lang.reflect.Field field = VoidWarehouseData.class.getDeclaredField(name);
            field.setAccessible(true);
            return field;
        } catch (ReflectiveOperationException ex) {
            return null;
        }
    }

    @SuppressWarnings("unchecked")
    private static Map<String, VoidWarehouseData.ExchangeOffer> craftOffersOf(VoidWarehouseData data) {
        java.lang.reflect.Field field = declaredField("craftOffers");
        if (field == null) {
            return null;
        }
        try {
            Object raw = field.get(data);
            return raw instanceof Map ? (Map<String, VoidWarehouseData.ExchangeOffer>) raw : null;
        } catch (ReflectiveOperationException ex) {
            return null;
        }
    }

    /** 所有产物依赖集里出现过的 id（并集）。不在这张表里的物品，改了不会让任何一格重算 */
    private static Set<String> allDependencyIds(VoidWarehouseData data) {
        java.lang.reflect.Field field = declaredField("craftDeps");
        if (field == null) {
            return null;
        }
        try {
            Object raw = field.get(data);
            if (!(raw instanceof Map)) {
                return null;
            }
            Set<String> all = new HashSet<>();
            for (Object value : ((Map<?, ?>) raw).values()) {
                if (!(value instanceof Set)) {
                    continue;
                }
                for (Object id : (Set<?>) value) {
                    if (id instanceof String) {
                        all.add((String) id);
                    }
                }
            }
            return all;
        } catch (ReflectiveOperationException ex) {
            return null;
        }
    }

    /** 产品代码里的 {@code CRAFT_DIRTY_LIMIT}（私有常量，反射读，避免测试里出现第二个真相） */
    private static Integer dirtyLimit() {
        java.lang.reflect.Field field = declaredField("CRAFT_DIRTY_LIMIT");
        if (field == null) {
            return null;
        }
        try {
            return field.getInt(null);
        } catch (ReflectiveOperationException | IllegalArgumentException ex) {
            return null;
        }
    }

    /**
     * 挑 {@code wanted} 种<b>不在任何依赖集里</b>的可入库物品，用来造「改了很多东西、
     * 但没有一个落在依赖集里」这种脏集合。
     *
     * <p>潜影盒排除掉：{@link VoidWarehouseData#insert} 会把非空盒拆成壳 + 箱 + 染料，
     * 一次 {@code insert} 就多记好几样物品，脏集合的size 会跟预期对不上。</p>
     */
    private static List<Item> pickFillerItems(Set<String> depIds, int wanted) {
        List<Item> picked = new ArrayList<>(wanted);
        for (Item item : BuiltInRegistries.ITEM) {
            if (picked.size() >= wanted) {
                break;
            }
            if (item == null || item == Items.AIR) {
                continue;
            }
            String itemId = VoidWarehouseRecipeBook.idOf(item);
            if (itemId == null || depIds.contains(itemId)) {
                continue;
            }
            ItemStack probe = new ItemStack(item, 1);
            if (VoidWarehouseShulker.isShulkerBox(probe) || !VoidWarehouseData.isInsertable(probe)) {
                continue;
            }
            picked.add(item);
        }
        return picked;
    }

    /**
     * 让每样物品各进出一趟仓库：净库存不变，但脏集合里会精确多出这些物品。
     *
     * @return 失败次数（入库或出库没成功都算，非 0 就说明脏集合的 size 不可信）
     */
    private static int touchAll(VoidWarehouseData data, List<Item> items) {
        int bad = 0;
        for (Item item : items) {
            if (!data.insert(new ItemStack(item, 1))) {
                bad++;
            }
            if (!data.takeItem(item, 1)) {
                bad++;
            }
        }
        return bad;
    }

    /** 两个 id 是不是同一件物品（9 合 1 只留 path、配方本是全名，两种口径都要认） */
    private static boolean isSameItem(String a, String b) {
        Item left = itemOfId(a);
        return left != null && left == itemOfId(b);
    }

    /**
     * id → Item，两种口径都认（9 合 1 只留 path、配方本是全名）。
     *
     * <p>⚠️ 别拿 {@code VoidWarehouseExchangeBootstrap.itemOf} 当兜底：它内部是
     * {@code Identifier#withDefaultNamespace}，对已经带冒号的字符串会拼成
     * {@code minecraft:minecraft:iron_block} 并当场抛 {@code IdentifierException}
     * —— 实测把 N 组整组炸掉，日志里只剩一句「自检抛异常」。</p>
     */
    private static Item itemOfId(String itemId) {
        if (itemId == null || itemId.isEmpty()) {
            return null;
        }
        String full = itemId.indexOf(':') >= 0 ? itemId : "minecraft:" + itemId;
        return VoidWarehouseRecipeBook.itemOf(full);
    }

    /** 整张表里第一对有重复的物品（没有则 null）；按 Item 对象比，绕开 id 口径 */
    private static String firstDuplicateItem(List<VoidWarehouseData.ExchangeOffer> offers) {
        Map<Item, String> seen = new LinkedHashMap<>();
        for (VoidWarehouseData.ExchangeOffer offer : offers) {
            Item item = itemOfId(offer.itemId());
            if (item == null) {
                continue;
            }
            String previous = seen.putIfAbsent(item, offer.itemId());
            if (previous != null) {
                return previous + " / " + offer.itemId();
            }
        }
        return null;
    }

    private static int countSameItem(List<VoidWarehouseData.ExchangeOffer> offers, String itemId) {
        int n = 0;
        for (VoidWarehouseData.ExchangeOffer offer : offers) {
            if (isSameItem(offer.itemId(), itemId)) {
                n++;
            }
        }
        return n;
    }

    /**
     * 可兑表里第一格指向 {@code itemId} 那件物品的条目；没有返回 {@code null}。
     *
     * <p>按 {@link Item} 对象比而不是按字符串比 —— 9 合 1 只留 path、配方本是全名，
     * 字符串层面的 {@code equals} 会把同一件东西当成两件（这正是 1.0.17 修掉的那个 bug 的形状，
     * 别在测试里再犯一次）。</p>
     */
    private static VoidWarehouseData.ExchangeOffer firstSameItem(
            List<VoidWarehouseData.ExchangeOffer> offers, String itemId) {
        for (VoidWarehouseData.ExchangeOffer offer : offers) {
            if (isSameItem(offer.itemId(), itemId)) {
                return offer;
            }
        }
        return null;
    }

