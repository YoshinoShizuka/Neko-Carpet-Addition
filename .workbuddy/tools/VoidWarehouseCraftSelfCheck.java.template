        check("P7c 同一玩家第二次就闭嘴（重复合成是常态，不能刷屏）",
                VoidWarehouseRecipeNotice.onCrafted(
                        dupWho, false, VoidWarehouseData.LearnResult.DUPLICATE,
                        fresh, sixOld, 10, max, 1_200L).isEmpty());
        check("P7d 换个玩家还会说（状态是按玩家分的）",
                VoidWarehouseRecipeNotice.onCrafted(
                        UUID.randomUUID(), false, VoidWarehouseData.LearnResult.DUPLICATE,
                        fresh, sixOld, 10, max, 1_000L).size() == 1);
        check("P7e 英文玩家的「已记过」是英文", VoidWarehouseRecipeNotice.onCrafted(
                        UUID.randomUUID(), true, VoidWarehouseData.LearnResult.DUPLICATE,
                        fresh, sixOld, 10, max, 1_000L).get(0).getString()
                .contains("already recorded"));
        check("P7f DISABLED 不发任何行", VoidWarehouseRecipeNotice.onCrafted(
                UUID.randomUUID(), false, VoidWarehouseData.LearnResult.DISABLED,
                fresh, sixOld, 10, max, 1_000L).isEmpty());

        // ---- P8 快满阈值：差一条不吭声、正好到就预警 ----
        int threshold = (int) (((long) max * VoidWarehouseRecipeNotice.NEAR_FULL_PERCENT + 99) / 100);
        check("P8 快满阈值 = ceil(" + max + " × " + VoidWarehouseRecipeNotice.NEAR_FULL_PERCENT
                + "%) = " + threshold, threshold == 1844);
        check("P8b 差一条不预警（" + (threshold - 1) + "）",
                !VoidWarehouseRecipeNotice.isNearFull(threshold - 1, max));
        check("P8c 正好到阈值就预警（" + threshold + "）",
                VoidWarehouseRecipeNotice.isNearFull(threshold, max));

        // ---- P9 快满只报一次 ----
        UUID nearWho = UUID.randomUUID();
        List<Component> near1 = VoidWarehouseRecipeNotice.onCrafted(
                nearWho, false, VoidWarehouseData.LearnResult.LEARNED,
