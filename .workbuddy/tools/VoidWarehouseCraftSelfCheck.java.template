        var decoded = VoidWarehouseData.CODEC.parse(NbtOps.INSTANCE, tag);
        VoidWarehouseData back = decoded.result().orElse(null);
        check("J2 解码成功", back != null);
        check("J2 物品条数一致", back != null && back.entryCount() == 2);
        check("J2 圆石 5 个", back != null && back.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(5)));
        check("J2 配方条数一致", back != null && back.learnedRecipeCount() == recipesBefore);
        check("J2 活塞配方活着", back != null && back.hasRecipeFor("minecraft:piston"));

        // 反证：混进一行坏数据只丢那一行，仓库物品一条不许少
        CompoundTag raw = (CompoundTag) tag;
        String blob = raw.getStringOr("learned_recipes", "");
        raw.putString("learned_recipes", blob + "\n这行是垃圾\n");
        VoidWarehouseData polluted = VoidWarehouseData.CODEC.parse(NbtOps.INSTANCE, raw).result().orElse(null);
        check("J3 坏行不牵连整表：仍然解码成功", polluted != null);
        check("J3 物品一条不少", polluted != null && polluted.entryCount() == 2);
        check("J3 坏行只丢它自己", polluted != null && polluted.learnedRecipeCount() == recipesBefore);
    }

    // ================================================================ K 往下钻

    /**
     * 玩家报的那个 bug：「合成过一次深色橡木木板和活塞，木板取完之后再取活塞，
     * 不会自动扣深色橡木原木」。
     *
     * <p>1.0.15 只做一层（原料必须仓库里现成），所以这条在 1.0.15 上是<b>必然红</b>的 ——
     * 这正是它值得单独成组的原因：它是玩家能看见的行为，必须有一条断言钉住。
     * 1.0.16 起最多往下钻 {@link VoidWarehouseRecipes#MAX_DEPTH} 层。</p>
     *
     * <p>每组都配了反证（同一份库存、不带子配方时必须失败），否则「绿」可能只是因为别的原因凑巧成立。</p>
     */
    private static void groupK_recursive(MinecraftServer server) {
        System.out.println("[K] 往下钻（原木 → 木板 → 活塞）");
        VoidWarehouseRecipes.Recipe planks =
                recipe("minecraft:dark_oak_planks", 4, part("minecraft:dark_oak_log", 1));
        VoidWarehouseRecipes.Recipe piston = recipe("minecraft:piston", 1,
                part("minecraft:dark_oak_planks", 3),
                part("minecraft:cobblestone", 4),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1));
        Map<String, List<VoidWarehouseRecipes.Recipe>> subs = new LinkedHashMap<>();
        subs.put("minecraft:dark_oak_planks", List.of(planks));

        // 木板 0 个、原木 1 个 —— 这就是玩家报的那个局面
        Map<String, BigInteger> onlyLog = stock("minecraft:dark_oak_log", 1,
                "minecraft:cobblestone", 4, "minecraft:iron_ingot", 1, "minecraft:redstone", 1);
        VoidWarehouseRecipes.Plan k1 = VoidWarehouseRecipes.plan(piston, BigInteger.ONE, onlyLog, subs);
        check("K1 木板没货、原木有货 → 取活塞必须成功", k1 != null);
        check("K1 扣的是原木 1 个", k1 != null
                && amountOf(k1.consumed(), "minecraft:dark_oak_log").equals(BigInteger.ONE));
        check("K1 木板一个都没扣（它本来就是做出来的）",
                k1 != null && amountOf(k1.consumed(), "minecraft:dark_oak_planks").signum() == 0);
        check("K1 多做的 1 个木板入账回仓库",
                k1 != null && amountOf(k1.surplus(), "minecraft:dark_oak_planks").equals(BigInteger.ONE));
        check("K1 其它原料照旧", k1 != null
                && amountOf(k1.consumed(), "minecraft:cobblestone").equals(BigInteger.valueOf(4))
                && amountOf(k1.consumed(), "minecraft:iron_ingot").equals(BigInteger.ONE)
                && amountOf(k1.consumed(), "minecraft:redstone").equals(BigInteger.ONE));

        // 反证：同一份库存，不往下钻就必须失败（证明 K1 真的咬住了递归，不是别的原因凑巧成功）
        check("K2 反证：不带子配方时必须失败",
                VoidWarehouseRecipes.plan(piston, BigInteger.ONE, onlyLog, NO_SUBS) == null);

        // 库存里有一半木板：先吃库存、不够的再钻（不是「一缺货就整项去做」）
        Map<String, BigInteger> halfPlanks = stock("minecraft:dark_oak_planks", 2,
                "minecraft:dark_oak_log", 1,
                "minecraft:cobblestone", 4, "minecraft:iron_ingot", 1, "minecraft:redstone", 1);
        VoidWarehouseRecipes.Plan k3 = VoidWarehouseRecipes.plan(piston, BigInteger.ONE, halfPlanks, subs);
        check("K3 木板够一半：先扣现成的 2 个", k3 != null
                && amountOf(k3.consumed(), "minecraft:dark_oak_planks").equals(BigInteger.valueOf(2)));
        check("K3 只补做 1 次（扣 1 原木）", k3 != null
                && amountOf(k3.consumed(), "minecraft:dark_oak_log").equals(BigInteger.ONE));
        check("K3 补做多出的 3 个木板入账", k3 != null
                && amountOf(k3.surplus(), "minecraft:dark_oak_planks").equals(BigInteger.valueOf(3)));

        // 上限：3 个原木 = 12 木板 = 4 个活塞
        BigInteger cap = VoidWarehouseRecipes.maxCraftable(piston,
                stock("minecraft:dark_oak_log", 3, "minecraft:cobblestone", 64,
                        "minecraft:iron_ingot", 16, "minecraft:redstone", 16), subs);
        check("K4 3 原木 → 4 个活塞", cap.equals(BigInteger.valueOf(4)));

        // 闭包：缺了「深一层」的料就是 1.0.15 那个 bug 的根因，这条直接钉住它
        Map<String, BigInteger> closure = VoidWarehouseRecipes.stockClosure(piston, subs,
                id -> "minecraft:dark_oak_log".equals(id) ? BigInteger.valueOf(7) : BigInteger.ZERO);
        check("K5 闭包含深一层的原木", closure.containsKey("minecraft:dark_oak_log"));
        check("K5 闭包里原木拿到的是真库存",
                amountOf(closure, "minecraft:dark_oak_log").equals(BigInteger.valueOf(7)));
        check("K5 闭包也含表层原料", closure.containsKey("minecraft:dark_oak_planks")
                && closure.containsKey("minecraft:redstone"));

        // 深度上限。
        // 记账方式：{@code supply} 在深度 d 允许「吃库存」，但只有 {@code d < MAX_DEPTH} 才允许
        // 「再做一层」。所以一条「根 + N 条子配方 + 最深处有料」的链，最后一次展开发生在
        // 深度 N−2，条件 N−2 < MAX_DEPTH ⇒ 正好 MAX_DEPTH+1 段能做，再多一段必须保守失败。
        int deepestOk = VoidWarehouseRecipes.MAX_DEPTH + 1;
        check("K6 正好 MAX_DEPTH 层：能做出来",
                VoidWarehouseRecipes.plan(recipe("t:l0", 1, part("t:l1", 1)), BigInteger.ONE,
                        stock("t:l" + deepestOk, 1), chainOf(deepestOk)) != null);
        int tooDeep = deepestOk + 1;
        check("K7 超过 MAX_DEPTH 层：保守失败（不是无限递归）",
                VoidWarehouseRecipes.plan(recipe("t:l0", 1, part("t:l1", 1)), BigInteger.ONE,
                        stock("t:l" + tooDeep, 1), chainOf(tooDeep)) == null);

        // 撞环：a ← b、b ← a，空库存时必须失败且不能炸（栈溢出会直接崩服）
        Map<String, List<VoidWarehouseRecipes.Recipe>> ring = new LinkedHashMap<>();
        VoidWarehouseRecipes.Recipe ra = recipe("t:a", 1, part("t:b", 1));
        VoidWarehouseRecipes.Recipe rb = recipe("t:b", 1, part("t:a", 1));
        ring.put("t:a", List.of(ra));
        ring.put("t:b", List.of(rb));
        check("K8 撞环：空库存返回 null 且不崩",
                VoidWarehouseRecipes.plan(ra, BigInteger.ONE, Map.of(), ring) == null);
        check("K8 撞环：但库存里有 b 时正常吃库存",
                VoidWarehouseRecipes.plan(ra, BigInteger.ONE, stock("t:b", 2), ring) != null);

        // ---- 真实服务端：仓库里只有原木，取活塞必须整条链路走通
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.DARK_OAK_LOG, 3));
        data.insert(new ItemStack(Items.COBBLESTONE, 12));
        data.insert(new ItemStack(Items.IRON_INGOT, 3));
        data.insert(new ItemStack(Items.REDSTONE, 3));
        data.learn(recipe("minecraft:dark_oak_planks", 4, part("minecraft:dark_oak_log", 1)));
        data.learn(recipe("minecraft:piston", 1,
                part("minecraft:dark_oak_planks", 3),
                part("minecraft:cobblestone", 4),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1)));

        check("K9 活塞库存为 0、木板库存为 0",
                data.amountOf(Items.PISTON).signum() == 0 && data.amountOf(Items.DARK_OAK_PLANKS).signum() == 0);
        check("K9 界面上出现「活塞（可合成）」一格", countOffers(data, "minecraft:piston") == 1);
        VoidWarehouseExchange.Plan took = data.planExchange(new ItemStack(Items.PISTON), BigInteger.valueOf(3));
        check("K10 只有原木也能规划出 3 个活塞", took != null);
        data.applyExchange(took);
        check("K10 原木 3→0（全被做成了木板）", data.amountOf(Items.DARK_OAK_LOG).signum() == 0);
        check("K10 木板 0→3（12 做出来 − 9 用掉）",
                data.amountOf(Items.DARK_OAK_PLANKS).equals(BigInteger.valueOf(3)));
        check("K10 圆石 / 铁锭 / 红石各扣 12 / 3 / 3",
                data.amountOf(Items.COBBLESTONE).signum() == 0
                        && data.amountOf(Items.IRON_INGOT).signum() == 0
                        && data.amountOf(Items.REDSTONE).signum() == 0);
        check("K10 活塞没有留在仓库", data.amountOf(Items.PISTON).signum() == 0);

        // 反证：把原木也抽干之后必须规划失败
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 12));
        data.insert(new ItemStack(Items.IRON_INGOT, 3));
        data.insert(new ItemStack(Items.REDSTONE, 3));
        check("K11 原木也没了 → 取活塞失败",
                data.planExchange(new ItemStack(Items.PISTON), BigInteger.ONE) == null);
        check("K11 失败时库存逐项未动",
                data.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(12))
                        && data.amountOf(Items.IRON_INGOT).equals(BigInteger.valueOf(3)));
    }

    // ================================================================ L 可互换原料（同一产物两条配方）

    /**
     * 同一产物有两条已学配方（橡木木板版 / 白桦木板版）时，到底挑哪一条、扣哪一种木板。
     *
     * <p>钉的是 1.0.15 修掉的一处真偏差：界面上的「可合成 N 个」由 {@code collectCraftOffers}
     * 取「各候选 maxCraftable 的<b>最大值</b>」，而「尽量给」当时按<b>学会顺序</b>取第一条 ——
     * 于是「先学会的那条料更少」时界面写 64、右键只给 1。所以这里故意把<b>料少的那条先学</b>，
     * 再断言「实际拿到的 == 界面写的」。</p>
     *
     * <p>用 DISPENSER / DROPPER 而不是 PISTON，是为了拿到干净的学会顺序：前面几组早就学过
     * 橡木版活塞了，再用活塞就构造不出「先学料少的」这个前提。</p>
     */
    private static void groupL_interchangeable(MinecraftServer server) {
        System.out.println("[L] 可互换原料（木板）");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        // 白桦只有 3 块（够 1 个），橡木 192 块（够 64 个）
        data.insert(new ItemStack(Items.BIRCH_PLANKS, 3));
        data.insert(new ItemStack(Items.OAK_PLANKS, 192));

        VoidWarehouseRecipes.Recipe birch = recipe("minecraft:dispenser", 1,
                part("minecraft:cobblestone", 4),
                part("minecraft:birch_planks", 3),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1));
        VoidWarehouseRecipes.Recipe oak = recipe("minecraft:dispenser", 1,
                part("minecraft:cobblestone", 4),
                part("minecraft:oak_planks", 3),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1));
        // 顺序关键：先学「料少」的白桦版，再学橡木版
        data.learn(birch);
        data.learn(oak);
        check("L1 同一产物两条配方都在（不按标签归组，各存一条）",
                data.hasRecipeFor("minecraft:dispenser"));

        data.insert(new ItemStack(Items.COBBLESTONE, 320));
        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        data.insert(new ItemStack(Items.REDSTONE, 64));

        // ① 界面口径：取两条里做得最多的那条 → 64
        BigInteger shown = BigInteger.ZERO;
        for (VoidWarehouseData.ExchangeOffer offer : data.exchangeOffers()) {
            if ("minecraft:dispenser".equals(offer.itemId())) {
                shown = offer.obtainable();
            }
        }
        check("L2 界面『可合成』取两条的最大值 = 64", shown.equals(BigInteger.valueOf(64)));

        // ② 执行口径必须与界面同一个数（这条就是本次修复的核心不变量）
        VoidWarehouseExchange.Plan partial =
                data.planExchangeMax(new ItemStack(Items.DISPENSER), BigInteger.valueOf(64));
        check("L3 先学料少的那条，『尽量给』仍等于界面写的 64（旧口径只给 1）",
                partial != null && partial.amount().equals(shown));

        // ③ 扣的必须是做得多的那一侧（橡木），白桦一块不动
        data.applyExchange(partial);
        check("L4 橡木 192→0（扣 192 = 64 次 × 3）",
                data.amountOf(Items.OAK_PLANKS).signum() == 0);
        check("L5 白桦 3 块一块没动",
                data.amountOf(Items.BIRCH_PLANKS).equals(BigInteger.valueOf(3)));

        // ④ 反证：橡木抽干、只剩白桦 3 块 → 只能给 1，扣的换成白桦
        data.clearContent();
        data.insert(new ItemStack(Items.BIRCH_PLANKS, 3));
        data.insert(new ItemStack(Items.COBBLESTONE, 320));
        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        data.insert(new ItemStack(Items.REDSTONE, 64));
        VoidWarehouseExchange.Plan onlyBirch =
                data.planExchangeMax(new ItemStack(Items.DISPENSER), BigInteger.valueOf(64));
        check("L6 只剩白桦时只给 1（不混搭、不凭空）",
                onlyBirch != null && onlyBirch.amount().equals(BigInteger.ONE));
        data.applyExchange(onlyBirch);
        check("L7 白桦 3→0", data.amountOf(Items.BIRCH_PLANKS).signum() == 0);

        // ⑤ 精确请求走「按学会顺序逐条试」：先学的白桦只够 1 个 → 自己要 3 个就落到橡木
        data.clearContent();
        data.insert(new ItemStack(Items.BIRCH_PLANKS, 3));
        data.insert(new ItemStack(Items.OAK_PLANKS, 192));
        data.insert(new ItemStack(Items.COBBLESTONE, 320));
        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        data.insert(new ItemStack(Items.REDSTONE, 64));
        VoidWarehouseExchange.Plan exact3 =
                data.planExchange(new ItemStack(Items.DISPENSER), BigInteger.valueOf(3));
        check("L8 精确取 3 个：白桦只够 1 → 落到橡木，仍给满 3",
                exact3 != null && exact3.amount().equals(BigInteger.valueOf(3)));

        // ⑥ 反证：只学过橡木版、仓库里只有白桦 → 必须做不出来（不跨木材通用）
        //    换一件没被前面的组学过的产物，避免「橡木版早就学会了」
        data.learn(recipe("minecraft:dropper", 1,
                part("minecraft:cobblestone", 7),
                part("minecraft:oak_planks", 1)));
        data.clearContent();
        data.insert(new ItemStack(Items.BIRCH_PLANKS, 64));
        data.insert(new ItemStack(Items.COBBLESTONE, 64));
        check("L9 只学过橡木版、仓库只有白桦 → 做不出来（原料被具体化）",
                data.planExchange(new ItemStack(Items.DROPPER), BigInteger.ONE) == null);
    }

    // ================================================================ 工具

    private static List<ItemStack> emptyGrid() {
        List<ItemStack> grid = new ArrayList<>(Collections.nCopies(9, ItemStack.EMPTY));
        return grid;
    }

    private static VoidWarehouseRecipes.Recipe pistonRecipe() {
        if (pistonRecipe == null) {
            pistonRecipe = recipe("minecraft:piston", 1,
                    part("minecraft:cobblestone", 4),
                    part("minecraft:oak_planks", 3),
                    part("minecraft:iron_ingot", 1),
                    part("minecraft:redstone", 1));
        }
        return pistonRecipe;
    }

    private static VoidWarehouseRecipes.Part part(String id, int count) {
        return new VoidWarehouseRecipes.Part(List.of(id), count);
    }

    private static VoidWarehouseRecipes.Recipe recipe(String output, int outputCount,
                                                      VoidWarehouseRecipes.Part... parts) {
        return new VoidWarehouseRecipes.Recipe(null, output, outputCount, Arrays.asList(parts));
    }

    /**
     * 造一条 {@code t:l0 ← t:l1 ← … ← t:l{segments}} 的链（每层 1:1），用来量深度上限。
     *
     * <p>返回的是 {@code byOutput}；调用方自己把料放在 {@code t:l{segments}} 上。</p>
     */
    private static Map<String, List<VoidWarehouseRecipes.Recipe>> chainOf(int segments) {
        Map<String, List<VoidWarehouseRecipes.Recipe>> map = new LinkedHashMap<>();
        for (int i = 0; i < segments; i++) {
            VoidWarehouseRecipes.Recipe r = recipe("t:l" + i, 1, part("t:l" + (i + 1), 1));
            map.put(r.output(), List.of(r));
        }
        return map;
    }

    private static Map<String, BigInteger> stock(Object... pairs) {        Map<String, BigInteger> map = new LinkedHashMap<>();
        for (int i = 0; i + 1 < pairs.length; i += 2) {
            map.put((String) pairs[i], BigInteger.valueOf(((Number) pairs[i + 1]).longValue()));
        }
        return map;
    }

    private static BigInteger amountOf(Map<String, BigInteger> map, String id) {
        return map.getOrDefault(id, BigInteger.ZERO);
    }

    /** 一张账的总量（{@code surplus} 从单个数字变成 map 之后，判「没有余量」要这么写） */
    private static BigInteger total(Map<String, BigInteger> map) {
        BigInteger sum = BigInteger.ZERO;
        for (BigInteger value : map.values()) {
            sum = sum.add(value);
        }
        return sum;
    }

    private static int partCount(VoidWarehouseRecipes.Recipe recipe, String id) {
        if (recipe == null) {
            return -1;
        }
        for (VoidWarehouseRecipes.Part part : recipe.parts()) {
            if (part.candidates().size() == 1 && id.equals(part.candidates().get(0))) {
                return part.count();
            }
        }
        return 0;
    }

    private static int countOffers(VoidWarehouseData data, String itemId) {
        int n = 0;
        for (VoidWarehouseData.ExchangeOffer offer : data.exchangeOffers()) {
            if (itemId.equals(offer.itemId())) {
                n++;
            }
        }
        return n;
    }

    private static void cleanup(MinecraftServer server) {
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 1234));
        data.insert(new ItemStack(Items.DIRT, 5678));
    }

    private static void finish(MinecraftServer server) {
        done = true;
        System.out.println("SMOKE RESULT vw-craft/26.3 checks=" + checks + " failures=" + failures);
        server.halt(false);
    }

    private static void check(String label, boolean ok) {
        checks++;
        if (!ok) {
            failures++;
        }
        System.out.println("   " + (ok ? "ok  " : "FAIL") + " " + label);
    }
}
