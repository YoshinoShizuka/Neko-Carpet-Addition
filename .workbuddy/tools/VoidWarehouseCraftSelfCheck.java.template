/**
 * 【临时自检】「配方学习 + 配方扣料」这一整条新链路。验证完删掉。
 *
 * <h2>要证的东西（每组都配反证）</h2>
 * <ol>
 *   <li><b>A 纯逻辑</b>：{@code plan} 的产出/原料/余量三条账在本例上都对；库存不足一律 null；
 *       <b>共享候选不重复计数</b>（反证：独立取 min 的写法会算出 3，正确值是 0）；</li>
 *   <li><b>B 口径一致</b>（fuzz）：{@code maxCraftable} 报出来的量，逐级 {@code plan} 必须条条成功 ——
 *       这一条直接对应「界面说能合成 N 个、点下去失败」那类事故；</li>
 *   <li><b>C 编解码</b>：往返一致、坏数据返回 null 而不抛、{@code recipeId == encode(recipe)}；</li>
 *   <li><b>D 真实配方解析</b>：拿真实的 3×3 网格问 {@code RecipeManager}，活塞必须解析成
 *       4 圆石 + 3 木板 + 1 铁锭 + 1 红石；<b>格里放整组 64 个圆石也只算 1 个</b>（一格算一个）；
 *       木棍必须拿到产出 4（多产出）；空网格 / 无配方网格 / special recipe 必须返回空；</li>
 *   <li><b>E 学习幂等</b>：同一条学两次条数不变；规则关掉时 {@code learn} 直接拒绝；</li>
 *   <li><b>F 端到端扣料</b>：仓库里放齐原料 → {@code planExchange(活塞)} 拿到计划 → {@code applyExchange}
 *       之后四种原料各减多少必须逐项精确，且<b>活塞不会因为合成而留在仓库里</b>；</li>
 *   <li><b>G 多产出余量</b>：2 原木取 5 木板 → 做 2 次、给 5 个、<b>剩余 3 个必须进仓库</b>
 *       （这一步错了就是刷物）；成品已有货时先扣库存、不再合成；</li>
 *   <li><b>H 回滚精确性</b>：{@code withdraw} 之后 {@code returnUnplaced(0)}，仓库必须逐项还原；</li>
 *   <li><b>I 规则关闭</b>：关掉配方扣料之后规划恒为 null、{@code learn} 恒为 false、
 *       虚拟条目里一条「可合成」都不许有；</li>
 *   <li><b>J 存档往返</b>：{@code CODEC} 编一遍再解一遍，配方不丢；混进一行坏数据只丢那一行、
 *       仓库物品一条不许少；</li>
 *   <li><b>K 往下钻</b>（1.0.16 修的玩家报障）：木板没货、原木有货时必须扣原木做木板；
 *       同一份库存不带子配方时必须失败（反证）；先吃库存再补做；闭包含深一层的料；
 *       深度上限 / 撞环必须保守失败且不崩；真服务端整条链路走通；</li>
 *   <li><b>M 增量等价</b>（R3）：可兑表改成「只重算受影响的产物」之后，每一次改动都必须与
 *       「整批重算」给出<b>逐字节相同</b>的结果（含顺序）。这组的风险不是算错而是<b>漏算</b> ——
 *       数量类断言看不出来，只有和一份从零算起的对照逐行比才抓得到。</li>
 *   <li><b>N 去重口径 / 脏物品阈值</b>：同一件物品同时被 9 合 1 与配方命中时只许占一格
 *       （这条去重曾经因为拿两套 id 口径互相比，<b>一次都没生效过</b>）；两条路比例不同时
 *       留下的那格必须还是 9 合 1 的账；界面上的数字按量取货必须真给得出来；外加
 *       {@code CRAFT_DIRTY_LIMIT} 的两侧边界 —— 恰好等于阈值走增量、多一个走整批。</li>
 *   <li><b>P 配方本聊天提示</b>：记住一条时说一声、同产物有别的配方时一并列出（最多 5 条
 *       + 「另有 N 条」）、快满预警一次、满了边沿说一次之后 30 秒一次、重复与规则关一个字
 *       都不说。重点在「同产物已有配方必须在 learn <b>之前</b>取」—— 反了就会把自己列进去。</li>
 * </ol>
 */
public final class VoidWarehouseCraftSelfCheck {

    /** 前几个 tick 先等配方表读好（配方跟着数据包重载，构造完成的那一刻不一定就绪） */
    private static final int WAIT_TICKS = 5;

    private static boolean done = false;
    private static int stage = 0;
    private static int tickIndex = 0;
    private static int checks = 0;
    private static int failures = 0;

    /** 自检里反复用到的那条配方（活塞） */
    private static VoidWarehouseRecipes.Recipe pistonRecipe;

    /**
     * 「不往下钻」的配方表，专门用来做反证。
     *
     * <p>K 组的核心是「同一份库存，带上子配方就能做、不带上就不能做」——
     * 少了这个反证，K1 绿也可能只是因为别的原因凑巧成功了。</p>
     */
    private static final Map<String, List<VoidWarehouseRecipes.Recipe>> NO_SUBS = Map.of();

    private VoidWarehouseCraftSelfCheck() {
    }

    public static void run(MinecraftServer server) {
        if (done) {
            return;
        }
        // 规则必须先开着，否则 craftEnabled() 恒为假，整组断言都在空转
        VoidWarehouseSettings.voidWarehouse = true;
        VoidWarehouseSettings.voidWarehouseCraft = true;
        try {
            step(server);
        } catch (Throwable t) {
            failures++;
            System.out.println("!! 自检抛异常: " + t);
            t.printStackTrace(System.out);
            finish(server);
        }
    }

    private static void step(MinecraftServer server) {
        switch (stage) {
            case 0:
                if (++tickIndex < WAIT_TICKS) {
                    return;
                }
                tickIndex = 0;
                break;
            case 1:
                groupA_pureLogic();
                break;
            case 2:
                groupB_boundConsistency();
                break;
            case 3:
                groupC_codec();
                break;
            case 4:
                groupD_realRecipe(server);
                break;
            case 5:
                groupE_learn(server);
                break;
            case 6:
                groupF_endToEnd(server);
                break;
            case 7:
                groupG_multiOutput(server);
                break;
            case 8:
                groupH_rollback(server);
                break;
            case 9:
                groupI_ruleOff(server);
                break;
            case 10:
                groupJ_savedData(server);
                break;
            case 11:
                groupK_recursive(server);
                break;
            case 12:
                groupL_interchangeable(server);
                break;
            case 13:
                groupM_incrementalEquivalence(server);
                break;
            case 14:
                groupN_dedupAndDirtyLimit(server);
                break;
            case 15:
                groupP_recipeNotice(server);
                break;
            case 16:
                cleanup(server);
                break;
            default:
                finish(server);
                return;
        }
        stage++;
    }

    // ================================================================ A 纯逻辑

    private static void groupA_pureLogic() {
        System.out.println("[A] 纯逻辑");
        VoidWarehouseRecipes.Recipe planks = recipe("minecraft:oak_planks", 4, part("minecraft:oak_log", 1));

        // 取 1 个木板：做 1 次，扣 1 原木，余 3 进仓库
        VoidWarehouseRecipes.Plan p1 = VoidWarehouseRecipes.plan(planks, BigInteger.ONE,
                stock("minecraft:oak_log", 1), NO_SUBS);
        check("A1 取 1 木板规划得出", p1 != null);
        check("A1 做 1 次", p1 != null && p1.crafts().equals(BigInteger.ONE));
        check("A1 只扣 1 原木", p1 != null && amountOf(p1.consumed(), "minecraft:oak_log").equals(BigInteger.ONE));
        check("A1 余量 3", p1 != null && amountOf(p1.surplus(), "minecraft:oak_planks").equals(BigInteger.valueOf(3)));

        // 取 5 个：做 2 次，扣 2 原木，余 3
        VoidWarehouseRecipes.Plan p5 = VoidWarehouseRecipes.plan(planks, BigInteger.valueOf(5),
                stock("minecraft:oak_log", 2), NO_SUBS);
        check("A2 取 5 木板做 2 次", p5 != null && p5.crafts().equals(BigInteger.valueOf(2)));
        check("A2 扣 2 原木", p5 != null && amountOf(p5.consumed(), "minecraft:oak_log").equals(BigInteger.valueOf(2)));
        check("A2 余量 3（8 做出来 − 5 给出）",
                p5 != null && amountOf(p5.surplus(), "minecraft:oak_planks").equals(BigInteger.valueOf(3)));

        // 反证：只有 1 个原木，取 5 个必须失败
        check("A3 原木不够时返回 null", VoidWarehouseRecipes.plan(planks, BigInteger.valueOf(5),
                stock("minecraft:oak_log", 1), NO_SUBS) == null);

        // 反证：原料一项都没有时返回 null
        check("A4 空库存返回 null",
                VoidWarehouseRecipes.plan(planks, BigInteger.ONE, Map.of(), NO_SUBS) == null);

        // 活塞（4 项原料，其中圆石要 4 个）
        VoidWarehouseRecipes.Recipe piston = pistonRecipe();
        Map<String, BigInteger> enough = new LinkedHashMap<>();
        enough.put("minecraft:cobblestone", BigInteger.valueOf(4));
        enough.put("minecraft:oak_planks", BigInteger.valueOf(3));
        enough.put("minecraft:iron_ingot", BigInteger.ONE);
        enough.put("minecraft:redstone", BigInteger.ONE);
        VoidWarehouseRecipes.Plan pp = VoidWarehouseRecipes.plan(piston, BigInteger.ONE, enough, NO_SUBS);
        check("A5 活塞规划得出", pp != null);
        check("A5 圆石扣 4", pp != null && amountOf(pp.consumed(), "minecraft:cobblestone")
                .equals(BigInteger.valueOf(4)));
        check("A5 没有余量（产出 1 给 1）", pp != null && total(pp.surplus()).signum() == 0);

        // 反证：少 1 个红石就必须失败（不能「少一样也算做出来了」）
        Map<String, BigInteger> noRedstone = new LinkedHashMap<>(enough);
        noRedstone.remove("minecraft:redstone");
        check("A6 缺红石返回 null",
                VoidWarehouseRecipes.plan(piston, BigInteger.ONE, noRedstone, NO_SUBS) == null);

        // 共享候选：两个原料项都只认 A，库存 A=3 → 最多做 1 次（要 2 个 A），不是 3 次。
        // 这是「逐项独立取 min」写法会算错的地方（那种写法给 3），也是这类算法最典型的刷物入口。
        VoidWarehouseRecipes.Recipe shared = recipe("t:out", 1, part("t:a", 1), part("t:a", 1));
        BigInteger sharedCap = VoidWarehouseRecipes.maxCraftable(shared, stock("t:a", 3), NO_SUBS);
        check("A7 共享原料不重复计数（3 个 A 只能做 1 次）", sharedCap.equals(BigInteger.ONE));
        check("A7 反证：plan(3) 必须失败", VoidWarehouseRecipes.plan(shared, BigInteger.valueOf(3),
                stock("t:a", 3), NO_SUBS) == null);
        check("A7 plan(1) 成功且共扣 2 个 A", sharedCap.equals(BigInteger.ONE)
                && amountOf(VoidWarehouseRecipes.plan(shared, BigInteger.ONE, stock("t:a", 3), NO_SUBS).consumed(),
                "t:a").equals(BigInteger.valueOf(2)));
    }

    // ================================================================ B 口径一致（fuzz）

    /**
     * 「界面说能合成多少个」与「真点下去能不能拿到」必须同源。
     *
     * <p>9 合 1 在 1.0.7 栽过的形态就是这两个数各算各的：tooltip 写 64、实际给 63。
     * 配方扣料这边两个数来自<b>同一次贪心</b>，所以这条 fuzz 应当全绿；
     * 一旦有人把 {@code maxCraftable} 改回「逐项独立取 min」，这里立刻会红。</p>
     */
    private static void groupB_boundConsistency() {
        System.out.println("[B] maxCraftable 与 plan 口径一致（fuzz 200 轮）");
        Random random = new Random(20261030L);
        String[] ids = {"t:a", "t:b", "t:c"};
        int bad = 0;
        int cases = 0;
        for (int round = 0; round < 200; round++) {
            Map<String, BigInteger> stock = new LinkedHashMap<>();
            for (String id : ids) {
                stock.put(id, BigInteger.valueOf(random.nextInt(21)));
            }
            // 随机一条 1~3 项、每项 1~2 个的配方，候选随机是两项的组合（制造共享库存）
            List<VoidWarehouseRecipes.Part> parts = new ArrayList<>();
            int n = 1 + random.nextInt(3);
            for (int i = 0; i < n; i++) {
                int pick = random.nextInt(4);
                List<String> cands = switch (pick) {
                    case 0 -> List.of("t:a");
                    case 1 -> List.of("t:b");
                    case 2 -> List.of("t:c");
                    default -> List.of("t:a", "t:b");
                };
                parts.add(new VoidWarehouseRecipes.Part(cands, 1 + random.nextInt(2)));
            }
            VoidWarehouseRecipes.Recipe r = new VoidWarehouseRecipes.Recipe("", "t:out",
                    1 + random.nextInt(4), parts);
            BigInteger cap = VoidWarehouseRecipes.maxCraftable(r, stock, NO_SUBS);
            BigInteger maxOut = cap;   // cap 已经是成品个数
            if (maxOut.signum() <= 0) {
                continue;
            }
            // 上限以内的每一个量都必须真能规划出来，且账目自洽
            for (long k = 1; k <= Math.min(maxOut.longValueExact(), 24L); k++) {
                cases++;
                VoidWarehouseRecipes.Plan plan =
                        VoidWarehouseRecipes.plan(r, BigInteger.valueOf(k), stock, NO_SUBS);
                if (plan == null) {
                    bad++;
                    System.out.println("   !! 上界说能做 " + maxOut + " 个，plan(" + k + ") 却失败；库存 "
                            + stock + " 配方 " + VoidWarehouseRecipes.encode(r));
                    break;
                }
                long out = (long) r.outputCount() * plan.crafts().longValueExact();
                if (out - total(plan.surplus()).longValueExact() != k) {
                    bad++;
                    System.out.println("   !! 账不平：要 " + k + "，做 " + out + "，余 " + plan.surplus());
                    break;
                }
                for (Map.Entry<String, BigInteger> e : plan.consumed().entrySet()) {
                    if (e.getValue().compareTo(stock.getOrDefault(e.getKey(), BigInteger.ZERO)) > 0) {
                        bad++;
                        System.out.println("   !! 多扣了：" + e.getKey() + " 扣 " + e.getValue()
                                + " 但库存只有 " + stock.getOrDefault(e.getKey(), BigInteger.ZERO));
                        break;
                    }
                }
            }
        }
        check("B1 fuzz 全部一致（" + cases + " 个量）", bad == 0);
        check("B2 fuzz 确实跑到了用例", cases > 500);

        // ---- B3/B4：带子配方的 fuzz（1.0.16 的递归路径）
        // 每个 item 都可能自己有一条「1 个 t:x → 2 个 t:y」的子配方，于是往下钻真的会发生。
        // 这里盯的是同一件事：上界说能做 n 个，plan(1..n) 必须条条成功、账必须平、
        // 而且扣掉的东西绝不超过库存（递归最容易在这里出错 —— 钻下去之后扣的是更深一层的料）。
        int badRec = 0;
        int casesRec = 0;
        for (int round = 0; round < 200; round++) {
            Map<String, BigInteger> stock = new LinkedHashMap<>();
            for (String id : ids) {
                stock.put(id, BigInteger.valueOf(random.nextInt(9)));
            }
            // 随机给 1~2 件物品各挂一条子配方（原料是另一件物品，产物数 1~4）
            Map<String, List<VoidWarehouseRecipes.Recipe>> byOutput = new LinkedHashMap<>();
            for (int i = 0; i < 2; i++) {
                String outId = ids[random.nextInt(ids.length)];
                String inId = ids[random.nextInt(ids.length)];
                if (outId.equals(inId)) {
                    continue;
                }
                byOutput.computeIfAbsent(outId, k -> new ArrayList<>()).add(
                        recipe(outId, 1 + random.nextInt(4), part(inId, 1 + random.nextInt(2))));
            }
            List<VoidWarehouseRecipes.Part> parts = new ArrayList<>();
            for (int i = 0; i < 1 + random.nextInt(3); i++) {
                parts.add(new VoidWarehouseRecipes.Part(List.of(ids[random.nextInt(ids.length)]),
                        1 + random.nextInt(2)));
            }
            VoidWarehouseRecipes.Recipe r = new VoidWarehouseRecipes.Recipe("", "t:out",
                    1 + random.nextInt(3), parts);
            BigInteger cap = VoidWarehouseRecipes.maxCraftable(r, stock, byOutput);
            if (cap.signum() <= 0) {
                continue;
            }
            for (long k = 1; k <= Math.min(cap.longValueExact(), 16L); k++) {
                casesRec++;
                VoidWarehouseRecipes.Plan plan =
                        VoidWarehouseRecipes.plan(r, BigInteger.valueOf(k), stock, byOutput);
                if (plan == null) {
                    badRec++;
                    System.out.println("   !! [递归] 上界 " + cap + " 个，plan(" + k + ") 失败；库存 " + stock
                            + " 子配方 " + byOutput.keySet() + " 配方 " + VoidWarehouseRecipes.encode(r));
                    break;
                }
                long out = (long) r.outputCount() * plan.crafts().longValueExact();
                // 账平判据只能看<b>根产物</b>的余量：往下钻之后 surplus 里还躺着中间产物
                // 多出来的部分（木板、木棍……），拿总量去比就是拿两件事对账。
                if (out - amountOf(plan.surplus(), r.output()).longValueExact() != k) {
                    badRec++;
                    System.out.println("   !! [递归] 账不平：要 " + k + "，做 " + out + "，余 " + plan.surplus());
                    break;
                }
                for (Map.Entry<String, BigInteger> e : plan.consumed().entrySet()) {
                    if (e.getValue().compareTo(stock.getOrDefault(e.getKey(), BigInteger.ZERO)) > 0) {
                        badRec++;
                        System.out.println("   !! [递归] 多扣了：" + e.getKey() + " 扣 " + e.getValue()
                                + " 但库存只有 " + stock.getOrDefault(e.getKey(), BigInteger.ZERO));
                        break;
                    }
                }
            }
        }
        check("B3 递归 fuzz 全部一致（" + casesRec + " 个量）", badRec == 0);
        check("B4 递归 fuzz 确实跑到了用例", casesRec > 200);
    }

    // ================================================================ C 编解码

    private static void groupC_codec() {
        System.out.println("[C] 编解码");
        VoidWarehouseRecipes.Recipe piston = pistonRecipe();
        String text = VoidWarehouseRecipes.encode(piston);
        check("C1 标识 == 编码内容", text.equals(piston.recipeId()));
        VoidWarehouseRecipes.Recipe back = VoidWarehouseRecipes.decode(text);
        check("C2 往返一致", back != null && VoidWarehouseRecipes.encode(back).equals(text));
        check("C2 产物与产出数还原", back != null && "minecraft:piston".equals(back.output())
                && back.outputCount() == 1);
        check("C2 原料项数还原", back != null && back.parts().size() == 4);

        // 反证：坏数据一律返回 null，绝不抛 —— 一条坏行不该让整个仓库读不出来
        check("C3 坏数据返回 null（无分号）", VoidWarehouseRecipes.decode("minecraft:piston*1") == null);
        check("C3 坏数据返回 null（无数乘号）", VoidWarehouseRecipes.decode("piston;x") == null);
        check("C3 坏数据返回 null（数量不是数）", VoidWarehouseRecipes.decode("piston*1;a×abc") == null);
        check("C3 null 安全", VoidWarehouseRecipes.decode(null) == null);
        check("C3 空串安全", VoidWarehouseRecipes.decode("") == null);

        List<VoidWarehouseRecipes.Recipe> mixed = VoidWarehouseRecipes.decodeAll(
                Arrays.asList(text, "垃圾数据", "piston*0;a×1", text));
        check("C4 decodeAll 跳过坏行且去重后保序", mixed.size() == 2
                && mixed.get(0).recipeId().equals(text));
    }

    // ================================================================ D 真实配方解析

    private static void groupD_realRecipe(MinecraftServer server) {
        System.out.println("[D] 真实配方解析");
        ServerLevel level = server.overworld();

        // 活塞：3 木板（上一排）+ 4 圆石 + 1 铁锭 + 1 红石
        //   木板 木板 木板
        //   圆石 铁锭 圆石
        //   圆石 红石 圆石
        // 关键是「圆石那一格放<b>整组 64 个</b>」：合成一次只吃 1 个，记账必须按「一格一个」
        List<ItemStack> grid = emptyGrid();
        grid.set(0, new ItemStack(Items.OAK_PLANKS));
        grid.set(1, new ItemStack(Items.OAK_PLANKS));
        grid.set(2, new ItemStack(Items.OAK_PLANKS));
        grid.set(3, new ItemStack(Items.COBBLESTONE, 64));
        grid.set(4, new ItemStack(Items.IRON_INGOT));
        grid.set(5, new ItemStack(Items.COBBLESTONE));
        grid.set(6, new ItemStack(Items.COBBLESTONE));
        grid.set(7, new ItemStack(Items.REDSTONE));
        grid.set(8, new ItemStack(Items.COBBLESTONE));
        CraftingInput input = CraftingInput.of(3, 3, grid);
        ItemStack result = VoidWarehouseRecipeBook.resultOf(server, level, input);
        check("D1 活塞配方被真实配方系统认出来", !result.isEmpty() && result.is(Items.PISTON));
        check("D1 一次产出 1 个", !result.isEmpty() && result.getCount() == 1);

        VoidWarehouseRecipes.Recipe parsed = VoidWarehouseRecipeBook.fromGrid(grid, result);
        check("D2 解析成一条配方", parsed != null);
        check("D2 产物是 minecraft:piston", parsed != null && "minecraft:piston".equals(parsed.output()));
        check("D2 原料 4 项", parsed != null && parsed.parts().size() == 4);
        check("D2 圆石 4 个（整组 64 也只算 4 个格子）",
                parsed != null && partCount(parsed, "minecraft:cobblestone") == 4);
        check("D2 木板 3 个", parsed != null && partCount(parsed, "minecraft:oak_planks") == 3);
        check("D2 铁锭 1 个", parsed != null && partCount(parsed, "minecraft:iron_ingot") == 1);
        check("D2 红石 1 个", parsed != null && partCount(parsed, "minecraft:redstone") == 1);
        pistonRecipe = parsed;

        // 木棍：2 木板竖着摆 → 一次出 4 个（多产出，outputCount 必须记成 4）
        List<ItemStack> stickGrid = emptyGrid();
        stickGrid.set(0, new ItemStack(Items.OAK_PLANKS));
        stickGrid.set(3, new ItemStack(Items.OAK_PLANKS));
        CraftingInput stickInput = CraftingInput.of(3, 3, stickGrid);
        ItemStack stickResult = VoidWarehouseRecipeBook.resultOf(server, level, stickInput);
        check("D3 木棍配方认出来且一次 4 个", !stickResult.isEmpty()
                && stickResult.is(Items.STICK) && stickResult.getCount() == 4);
        VoidWarehouseRecipes.Recipe stickRecipe =
                VoidWarehouseRecipeBook.fromGrid(stickGrid, stickResult);
        check("D3 产出数记成 4", stickRecipe != null && stickRecipe.outputCount() == 4);
        check("D3 原料是 2 个木板", stickRecipe != null && stickRecipe.parts().size() == 1
                && stickRecipe.parts().get(0).count() == 2);

        // 反证：空网格 / 无配方网格都必须是「不记」
        check("D4 空网格返回空", VoidWarehouseRecipeBook.resultOf(server, level,
                CraftingInput.of(3, 3, emptyGrid())).isEmpty());
        List<ItemStack> dirtGrid = emptyGrid();
        dirtGrid.set(0, new ItemStack(Items.DIRT));
        check("D4 没有配方的摆法返回空", VoidWarehouseRecipeBook.resultOf(server, level,
                CraftingInput.of(3, 3, dirtGrid)).isEmpty());
        // 反证：结果为空时 fromGrid 必须拒绝（不能记下一条「产物 ← 无需原料」）
        check("D5 产物为空时 fromGrid 拒绝", VoidWarehouseRecipeBook.fromGrid(grid, ItemStack.EMPTY) == null);
        // 反证：格子里有空气以外的读不出 id 的东西时 —— 用一个真实物品但产物为空的组合已覆盖；
        // 这里再确认「无产物就没有配方」这条不变量在编码层也成立
        check("D5 坏配方不会被编码出来",
                VoidWarehouseRecipeBook.fromGrid(emptyGrid(), result) == null);
    }

    // ================================================================ E 学习幂等

    private static void groupE_learn(MinecraftServer server) {
        System.out.println("[E] 学习幂等与规则开关");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();

        // ⚠️ 这一组必须写成「跨进程幂等」的形式：配方本是<b>存进存档</b>的，
        // 第二遍跑自检时活塞配方已经在文件里了，learn 正确地返回 false。
        // 所以「第一次学成功」不能断言成 true（那是「只看第一遍」的写法），
        // 只能断言成「要么这次学成功、要么它本来就在」——两者都说明它现在是可用的。
        boolean learnedNow = data.learn(pistonRecipe);
        int after = data.learnedRecipeCount();
        check("E1 学一条（首次 true / 读档回放后 false，两者都算过）",
                learnedNow || data.hasRecipeFor("minecraft:piston"));
        check("E1 条数至少 1", after >= 1);
        check("E2 同一条再学一次返回 false", !data.learn(pistonRecipe));
        check("E2 条数不变", data.learnedRecipeCount() == after);
        check("E3 学到的配方能被查到", data.hasRecipeFor("minecraft:piston"));

        VoidWarehouseSettings.voidWarehouseCraft = false;
        try {
            check("E4 规则关掉时 learn 拒绝", !data.learn(
                    recipe("minecraft:oak_planks", 4, part("minecraft:oak_log", 1))));
            check("E4 条数没变", data.learnedRecipeCount() == after);
        } finally {
            VoidWarehouseSettings.voidWarehouseCraft = true;
        }
    }

    // ================================================================ F 端到端扣料

    private static void groupF_endToEnd(MinecraftServer server) {
        System.out.println("[F] 端到端扣料");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 64));
        data.insert(new ItemStack(Items.OAK_PLANKS, 64));
        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        data.insert(new ItemStack(Items.REDSTONE, 64));
        data.learn(pistonRecipe);

        check("F1 活塞库存为 0", data.amountOf(Items.PISTON).signum() == 0);
        VoidWarehouseExchange.Plan plan = data.planExchange(new ItemStack(Items.PISTON), BigInteger.ONE);
        check("F1 规划得出", plan != null);
        check("F1 数量 1", plan != null && plan.amount().equals(BigInteger.ONE));
        // 规划是只读的：这一步仓库一个字节都不该动
        check("F2 规划不动库存（圆石还是 64）",
                data.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(64)));

        data.applyExchange(plan);
        check("F3 圆石 64→60", data.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(60)));
        check("F3 木板 64→61", data.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(61)));
        check("F3 铁锭 64→63", data.amountOf(Items.IRON_INGOT).equals(BigInteger.valueOf(63)));
        check("F3 红石 64→63", data.amountOf(Items.REDSTONE).equals(BigInteger.valueOf(63)));
        check("F4 活塞<b>没有</b>留在仓库（那是玩家的战利品）",
                data.amountOf(Items.PISTON).signum() == 0);

        // 反证：把红石抽干之后必须规划失败，且库存原样不动
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 64));
        data.insert(new ItemStack(Items.OAK_PLANKS, 64));
        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        check("F5 缺红石时规划返回 null",
                data.planExchange(new ItemStack(Items.PISTON), BigInteger.ONE) == null);
        check("F5 失败时库存逐项未动",
                data.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(64))
                        && data.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(64))
                        && data.amountOf(Items.IRON_INGOT).equals(BigInteger.valueOf(64)));

        // 「尽量给」：原料只够做 2 次时，planExchangeMax 要返回 2 而不是失败
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 8));
        data.insert(new ItemStack(Items.OAK_PLANKS, 6));
        data.insert(new ItemStack(Items.IRON_INGOT, 2));
        data.insert(new ItemStack(Items.REDSTONE, 2));
        VoidWarehouseExchange.Plan partial =
                data.planExchangeMax(new ItemStack(Items.PISTON), BigInteger.valueOf(64));
        check("F6 尽量给：只够 2 个就给 2 个", partial != null
                && partial.amount().equals(BigInteger.valueOf(2)));
    }

    // ================================================================ G 多产出余量

    private static void groupG_multiOutput(MinecraftServer server) {
        System.out.println("[G] 多产出与余量");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.OAK_LOG, 2));
        VoidWarehouseRecipes.Recipe planks = recipe("minecraft:oak_planks", 4, part("minecraft:oak_log", 1));
        data.learn(planks);

        check("G1 原木 2、木板 0", data.amountOf(Items.OAK_LOG).equals(BigInteger.valueOf(2))
                && data.amountOf(Items.OAK_PLANKS).signum() == 0);
        VoidWarehouseExchange.Plan plan = data.planExchange(new ItemStack(Items.OAK_PLANKS),
                BigInteger.valueOf(5));
        check("G1 取 5 个木板规划得出", plan != null && plan.amount().equals(BigInteger.valueOf(5)));
        data.applyExchange(plan);
        check("G2 原木 2→0（做 2 次）", data.amountOf(Items.OAK_LOG).signum() == 0);
        check("G2 余量 3 个木板进仓库（8 做出来 − 5 给出）",
                data.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(3)));

        // 成品已有货时：先扣库存，绝不再合成（否则就是「有货还扣原料」）
        VoidWarehouseExchange.Plan fromStock = data.planExchange(new ItemStack(Items.OAK_PLANKS),
                BigInteger.valueOf(2));
        check("G3 有货时规划得出", fromStock != null && fromStock.amount().equals(BigInteger.valueOf(2)));
        data.applyExchange(fromStock);
        check("G3 木板 3→1", data.amountOf(Items.OAK_PLANKS).equals(BigInteger.ONE));
        check("G3 没有再动原木（还是 0）", data.amountOf(Items.OAK_LOG).signum() == 0);

        // 反证：要 5 个但仓库只剩 1 个木板、0 原木 → 必须失败
        check("G4 库存与原料都不够时失败", data.planExchange(new ItemStack(Items.OAK_PLANKS),
                BigInteger.valueOf(5)) == null);
        check("G4 失败时木板仍是 1", data.amountOf(Items.OAK_PLANKS).equals(BigInteger.ONE));
    }

    // ================================================================ H 回滚

    private static void groupH_rollback(MinecraftServer server) {
        System.out.println("[H] 回滚精确性");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 20));
        data.insert(new ItemStack(Items.OAK_PLANKS, 20));
        data.insert(new ItemStack(Items.IRON_INGOT, 20));
        data.insert(new ItemStack(Items.REDSTONE, 20));
        data.insert(new ItemStack(Items.DIRT, 7));   // 与配方无关的干扰项
        data.learn(pistonRecipe);

        VoidWarehouseData.Withdrawal w = data.withdraw(new ItemStack(Items.PISTON), BigInteger.valueOf(3));
        check("H1 取出 3 个活塞", !w.isEmpty() && w.taken() == 3);
        check("H1 走的是多物品账（可反向执行）", w.viaExchange());
        check("H2 扣了：圆石 20→8", data.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(8)));
        check("H2 扣了：木板 20→11", data.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(11)));

        w.returnUnplaced(0);
        check("H3 整笔撤销：圆石回到 20", data.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(20)));
        check("H3 整笔撤销：木板回到 20", data.amountOf(Items.OAK_PLANKS).equals(BigInteger.valueOf(20)));
        check("H3 整笔撤销：铁锭回到 20", data.amountOf(Items.IRON_INGOT).equals(BigInteger.valueOf(20)));
        check("H3 整笔撤销：红石回到 20", data.amountOf(Items.REDSTONE).equals(BigInteger.valueOf(20)));
        check("H3 干扰项未受影响", data.amountOf(Items.DIRT).equals(BigInteger.valueOf(7)));
        check("H3 活塞仍然是 0", data.amountOf(Items.PISTON).signum() == 0);

        // 部分保留：只留下 1 个，其余退回
        VoidWarehouseData.Withdrawal w2 = data.withdraw(new ItemStack(Items.PISTON), BigInteger.valueOf(3));
        check("H4 再次取出 3 个", !w2.isEmpty() && w2.taken() == 3);
        w2.returnUnplaced(1);
        check("H4 只留 1 个：圆石扣 4（20→16）",
                data.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(16)));
        check("H4 只留 1 个：红石扣 1（20→19）",
                data.amountOf(Items.REDSTONE).equals(BigInteger.valueOf(19)));
    }

    // ================================================================ I 规则关闭

    private static void groupI_ruleOff(MinecraftServer server) {
        System.out.println("[I] 规则关闭");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 64));
        data.insert(new ItemStack(Items.OAK_PLANKS, 64));
        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        data.insert(new ItemStack(Items.REDSTONE, 64));
        data.learn(pistonRecipe);

        VoidWarehouseSettings.voidWarehouseCraft = false;
        try {
            check("I1 关掉后规划恒为 null",
                    data.planExchange(new ItemStack(Items.PISTON), BigInteger.ONE) == null);
            boolean anyCraft = false;
            for (VoidWarehouseData.ExchangeOffer offer : data.exchangeOffers()) {
                anyCraft |= offer.craft();
            }
            check("I1 关掉后没有「可合成」虚拟条目", !anyCraft);
        } finally {
            VoidWarehouseSettings.voidWarehouseCraft = true;
        }

        // 打开后必须真的出现「可合成」条目（活塞不在 9 合 1 表里，所以只可能来自配方扣料）
        boolean found = false;
        VoidWarehouseData.ExchangeOffer pistonOffer = null;
        for (VoidWarehouseData.ExchangeOffer offer : data.exchangeOffers()) {
            if ("minecraft:piston".equals(offer.itemId())) {
                found = true;
                pistonOffer = offer;
            }
        }
        check("I2 打开后出现活塞的「可合成」条目", found);
        check("I2 标记为配方扣料", found && pistonOffer.craft());
        check("I2 可合成 16 个（64 圆石 / 4 = 16）",
                found && pistonOffer.obtainable().equals(BigInteger.valueOf(16)));
        check("I2 条目里没有重复（活塞只出现一格）",
                countOffers(data, "minecraft:piston") == 1);

        VoidWarehouseSettings.voidWarehouse = false;
        try {
            boolean anyCraft = false;
            for (VoidWarehouseData.ExchangeOffer offer : data.exchangeOffers()) {
                anyCraft |= offer.craft();
            }
            check("I3 主开关关掉后同样一条都不显示", !anyCraft);
        } finally {
            VoidWarehouseSettings.voidWarehouse = true;
        }
    }

    // ================================================================ J 存档往返

    private static void groupJ_savedData(MinecraftServer server) {
        System.out.println("[J] 存档往返");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 5));
        data.insert(new ItemStack(Items.DIRT, 9));
        data.learn(pistonRecipe);
        int recipesBefore = data.learnedRecipeCount();

        var encoded = VoidWarehouseData.CODEC.encodeStart(NbtOps.INSTANCE, data);
        Tag tag = encoded.result().orElse(null);
        check("J1 编码成功", tag != null);
        var decoded = VoidWarehouseData.CODEC.parse(NbtOps.INSTANCE, tag);
        VoidWarehouseData back = decoded.result().orElse(null);
        check("J2 解码成功", back != null);
        check("J2 物品条数一致", back != null && back.entryCount() == 2);
        check("J2 圆石 5 个", back != null && back.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(5)));
        check("J2 配方条数一致", back != null && back.learnedRecipeCount() == recipesBefore);
        check("J2 活塞配方活着", back != null && back.hasRecipeFor("minecraft:piston"));

        // 反证：混进一行坏数据只丢那一行，仓库物品一条不许少
        CompoundTag raw = (CompoundTag) tag;
        String blob = raw.getStringOr("learned_recipes", "");
        raw.putString("learned_recipes", blob + "\n这行是垃圾\n");
        VoidWarehouseData polluted = VoidWarehouseData.CODEC.parse(NbtOps.INSTANCE, raw).result().orElse(null);
        check("J3 坏行不牵连整表：仍然解码成功", polluted != null);
        check("J3 物品一条不少", polluted != null && polluted.entryCount() == 2);
        check("J3 坏行只丢它自己", polluted != null && polluted.learnedRecipeCount() == recipesBefore);
    }

    // ================================================================ K 往下钻

    /**
     * 玩家报的那个 bug：「合成过一次深色橡木木板和活塞，木板取完之后再取活塞，
     * 不会自动扣深色橡木原木」。
     *
     * <p>1.0.15 只做一层（原料必须仓库里现成），所以这条在 1.0.15 上是<b>必然红</b>的 ——
     * 这正是它值得单独成组的原因：它是玩家能看见的行为，必须有一条断言钉住。
     * 1.0.16 起最多往下钻 {@link VoidWarehouseRecipes#MAX_DEPTH} 层。</p>
     *
     * <p>每组都配了反证（同一份库存、不带子配方时必须失败），否则「绿」可能只是因为别的原因凑巧成立。</p>
     */
    private static void groupK_recursive(MinecraftServer server) {
        System.out.println("[K] 往下钻（原木 → 木板 → 活塞）");
        VoidWarehouseRecipes.Recipe planks =
                recipe("minecraft:dark_oak_planks", 4, part("minecraft:dark_oak_log", 1));
        VoidWarehouseRecipes.Recipe piston = recipe("minecraft:piston", 1,
                part("minecraft:dark_oak_planks", 3),
                part("minecraft:cobblestone", 4),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1));
        Map<String, List<VoidWarehouseRecipes.Recipe>> subs = new LinkedHashMap<>();
        subs.put("minecraft:dark_oak_planks", List.of(planks));

        // 木板 0 个、原木 1 个 —— 这就是玩家报的那个局面
        Map<String, BigInteger> onlyLog = stock("minecraft:dark_oak_log", 1,
                "minecraft:cobblestone", 4, "minecraft:iron_ingot", 1, "minecraft:redstone", 1);
        VoidWarehouseRecipes.Plan k1 = VoidWarehouseRecipes.plan(piston, BigInteger.ONE, onlyLog, subs);
        check("K1 木板没货、原木有货 → 取活塞必须成功", k1 != null);
        check("K1 扣的是原木 1 个", k1 != null
                && amountOf(k1.consumed(), "minecraft:dark_oak_log").equals(BigInteger.ONE));
        check("K1 木板一个都没扣（它本来就是做出来的）",
                k1 != null && amountOf(k1.consumed(), "minecraft:dark_oak_planks").signum() == 0);
        check("K1 多做的 1 个木板入账回仓库",
                k1 != null && amountOf(k1.surplus(), "minecraft:dark_oak_planks").equals(BigInteger.ONE));
        check("K1 其它原料照旧", k1 != null
                && amountOf(k1.consumed(), "minecraft:cobblestone").equals(BigInteger.valueOf(4))
                && amountOf(k1.consumed(), "minecraft:iron_ingot").equals(BigInteger.ONE)
                && amountOf(k1.consumed(), "minecraft:redstone").equals(BigInteger.ONE));

        // 反证：同一份库存，不往下钻就必须失败（证明 K1 真的咬住了递归，不是别的原因凑巧成功）
        check("K2 反证：不带子配方时必须失败",
                VoidWarehouseRecipes.plan(piston, BigInteger.ONE, onlyLog, NO_SUBS) == null);

        // 库存里有一半木板：先吃库存、不够的再钻（不是「一缺货就整项去做」）
        Map<String, BigInteger> halfPlanks = stock("minecraft:dark_oak_planks", 2,
                "minecraft:dark_oak_log", 1,
                "minecraft:cobblestone", 4, "minecraft:iron_ingot", 1, "minecraft:redstone", 1);
        VoidWarehouseRecipes.Plan k3 = VoidWarehouseRecipes.plan(piston, BigInteger.ONE, halfPlanks, subs);
        check("K3 木板够一半：先扣现成的 2 个", k3 != null
                && amountOf(k3.consumed(), "minecraft:dark_oak_planks").equals(BigInteger.valueOf(2)));
        check("K3 只补做 1 次（扣 1 原木）", k3 != null
                && amountOf(k3.consumed(), "minecraft:dark_oak_log").equals(BigInteger.ONE));
        check("K3 补做多出的 3 个木板入账", k3 != null
                && amountOf(k3.surplus(), "minecraft:dark_oak_planks").equals(BigInteger.valueOf(3)));

        // 上限：3 个原木 = 12 木板 = 4 个活塞
        BigInteger cap = VoidWarehouseRecipes.maxCraftable(piston,
                stock("minecraft:dark_oak_log", 3, "minecraft:cobblestone", 64,
                        "minecraft:iron_ingot", 16, "minecraft:redstone", 16), subs);
        check("K4 3 原木 → 4 个活塞", cap.equals(BigInteger.valueOf(4)));

        // 闭包：缺了「深一层」的料就是 1.0.15 那个 bug 的根因，这条直接钉住它
        Map<String, BigInteger> closure = VoidWarehouseRecipes.stockClosure(piston, subs,
                id -> "minecraft:dark_oak_log".equals(id) ? BigInteger.valueOf(7) : BigInteger.ZERO);
        check("K5 闭包含深一层的原木", closure.containsKey("minecraft:dark_oak_log"));
        check("K5 闭包里原木拿到的是真库存",
                amountOf(closure, "minecraft:dark_oak_log").equals(BigInteger.valueOf(7)));
        check("K5 闭包也含表层原料", closure.containsKey("minecraft:dark_oak_planks")
                && closure.containsKey("minecraft:redstone"));

        // 深度上限。
        // 记账方式：{@code supply} 在深度 d 允许「吃库存」，但只有 {@code d < MAX_DEPTH} 才允许
        // 「再做一层」。所以一条「根 + N 条子配方 + 最深处有料」的链，最后一次展开发生在
        // 深度 N−2，条件 N−2 < MAX_DEPTH ⇒ 正好 MAX_DEPTH+1 段能做，再多一段必须保守失败。
        int deepestOk = VoidWarehouseRecipes.MAX_DEPTH + 1;
        check("K6 正好 MAX_DEPTH 层：能做出来",
                VoidWarehouseRecipes.plan(recipe("t:l0", 1, part("t:l1", 1)), BigInteger.ONE,
                        stock("t:l" + deepestOk, 1), chainOf(deepestOk)) != null);
        int tooDeep = deepestOk + 1;
        check("K7 超过 MAX_DEPTH 层：保守失败（不是无限递归）",
                VoidWarehouseRecipes.plan(recipe("t:l0", 1, part("t:l1", 1)), BigInteger.ONE,
                        stock("t:l" + tooDeep, 1), chainOf(tooDeep)) == null);

        // 撞环：a ← b、b ← a，空库存时必须失败且不能炸（栈溢出会直接崩服）
        Map<String, List<VoidWarehouseRecipes.Recipe>> ring = new LinkedHashMap<>();
        VoidWarehouseRecipes.Recipe ra = recipe("t:a", 1, part("t:b", 1));
        VoidWarehouseRecipes.Recipe rb = recipe("t:b", 1, part("t:a", 1));
        ring.put("t:a", List.of(ra));
        ring.put("t:b", List.of(rb));
        check("K8 撞环：空库存返回 null 且不崩",
                VoidWarehouseRecipes.plan(ra, BigInteger.ONE, Map.of(), ring) == null);
        check("K8 撞环：但库存里有 b 时正常吃库存",
                VoidWarehouseRecipes.plan(ra, BigInteger.ONE, stock("t:b", 2), ring) != null);

        // ---- 真实服务端：仓库里只有原木，取活塞必须整条链路走通
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.DARK_OAK_LOG, 3));
        data.insert(new ItemStack(Items.COBBLESTONE, 12));
        data.insert(new ItemStack(Items.IRON_INGOT, 3));
        data.insert(new ItemStack(Items.REDSTONE, 3));
        data.learn(recipe("minecraft:dark_oak_planks", 4, part("minecraft:dark_oak_log", 1)));
        data.learn(recipe("minecraft:piston", 1,
                part("minecraft:dark_oak_planks", 3),
                part("minecraft:cobblestone", 4),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1)));

        check("K9 活塞库存为 0、木板库存为 0",
                data.amountOf(Items.PISTON).signum() == 0 && data.amountOf(Items.DARK_OAK_PLANKS).signum() == 0);
        check("K9 界面上出现「活塞（可合成）」一格", countOffers(data, "minecraft:piston") == 1);
        VoidWarehouseExchange.Plan took = data.planExchange(new ItemStack(Items.PISTON), BigInteger.valueOf(3));
        check("K10 只有原木也能规划出 3 个活塞", took != null);
        data.applyExchange(took);
        check("K10 原木 3→0（全被做成了木板）", data.amountOf(Items.DARK_OAK_LOG).signum() == 0);
        check("K10 木板 0→3（12 做出来 − 9 用掉）",
                data.amountOf(Items.DARK_OAK_PLANKS).equals(BigInteger.valueOf(3)));
        check("K10 圆石 / 铁锭 / 红石各扣 12 / 3 / 3",
                data.amountOf(Items.COBBLESTONE).signum() == 0
                        && data.amountOf(Items.IRON_INGOT).signum() == 0
                        && data.amountOf(Items.REDSTONE).signum() == 0);
        check("K10 活塞没有留在仓库", data.amountOf(Items.PISTON).signum() == 0);

        // 反证：把原木也抽干之后必须规划失败
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 12));
        data.insert(new ItemStack(Items.IRON_INGOT, 3));
        data.insert(new ItemStack(Items.REDSTONE, 3));
        check("K11 原木也没了 → 取活塞失败",
                data.planExchange(new ItemStack(Items.PISTON), BigInteger.ONE) == null);
        check("K11 失败时库存逐项未动",
                data.amountOf(Items.COBBLESTONE).equals(BigInteger.valueOf(12))
                        && data.amountOf(Items.IRON_INGOT).equals(BigInteger.valueOf(3)));
    }

    // ================================================================ L 可互换原料（同一产物两条配方）

    /**
     * 同一产物有两条已学配方（橡木木板版 / 白桦木板版）时，到底挑哪一条、扣哪一种木板。
     *
     * <p>钉的是 1.0.15 修掉的一处真偏差：界面上的「可合成 N 个」由 {@code collectCraftOffers}
     * 取「各候选 maxCraftable 的<b>最大值</b>」，而「尽量给」当时按<b>学会顺序</b>取第一条 ——
     * 于是「先学会的那条料更少」时界面写 64、右键只给 1。所以这里故意把<b>料少的那条先学</b>，
     * 再断言「实际拿到的 == 界面写的」。</p>
     *
     * <p>用 DISPENSER / DROPPER 而不是 PISTON，是为了拿到干净的学会顺序：前面几组早就学过
     * 橡木版活塞了，再用活塞就构造不出「先学料少的」这个前提。</p>
     */
    private static void groupL_interchangeable(MinecraftServer server) {
        System.out.println("[L] 可互换原料（木板）");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        // 白桦只有 3 块（够 1 个），橡木 192 块（够 64 个）
        data.insert(new ItemStack(Items.BIRCH_PLANKS, 3));
        data.insert(new ItemStack(Items.OAK_PLANKS, 192));

        VoidWarehouseRecipes.Recipe birch = recipe("minecraft:dispenser", 1,
                part("minecraft:cobblestone", 4),
                part("minecraft:birch_planks", 3),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1));
        VoidWarehouseRecipes.Recipe oak = recipe("minecraft:dispenser", 1,
                part("minecraft:cobblestone", 4),
                part("minecraft:oak_planks", 3),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1));
        // 顺序关键：先学「料少」的白桦版，再学橡木版
        data.learn(birch);
        data.learn(oak);
        check("L1 同一产物两条配方都在（不按标签归组，各存一条）",
                data.hasRecipeFor("minecraft:dispenser"));

        data.insert(new ItemStack(Items.COBBLESTONE, 320));
        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        data.insert(new ItemStack(Items.REDSTONE, 64));

        // ① 界面口径：取两条里做得最多的那条 → 64
        BigInteger shown = BigInteger.ZERO;
        for (VoidWarehouseData.ExchangeOffer offer : data.exchangeOffers()) {
            if ("minecraft:dispenser".equals(offer.itemId())) {
                shown = offer.obtainable();
            }
        }
        check("L2 界面『可合成』取两条的最大值 = 64", shown.equals(BigInteger.valueOf(64)));

        // ② 执行口径必须与界面同一个数（这条就是本次修复的核心不变量）
        VoidWarehouseExchange.Plan partial =
                data.planExchangeMax(new ItemStack(Items.DISPENSER), BigInteger.valueOf(64));
        check("L3 先学料少的那条，『尽量给』仍等于界面写的 64（旧口径只给 1）",
                partial != null && partial.amount().equals(shown));

        // ③ 扣的必须是做得多的那一侧（橡木），白桦一块不动
        data.applyExchange(partial);
        check("L4 橡木 192→0（扣 192 = 64 次 × 3）",
                data.amountOf(Items.OAK_PLANKS).signum() == 0);
        check("L5 白桦 3 块一块没动",
                data.amountOf(Items.BIRCH_PLANKS).equals(BigInteger.valueOf(3)));

        // ④ 反证：橡木抽干、只剩白桦 3 块 → 只能给 1，扣的换成白桦
        data.clearContent();
        data.insert(new ItemStack(Items.BIRCH_PLANKS, 3));
        data.insert(new ItemStack(Items.COBBLESTONE, 320));
        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        data.insert(new ItemStack(Items.REDSTONE, 64));
        VoidWarehouseExchange.Plan onlyBirch =
                data.planExchangeMax(new ItemStack(Items.DISPENSER), BigInteger.valueOf(64));
        check("L6 只剩白桦时只给 1（不混搭、不凭空）",
                onlyBirch != null && onlyBirch.amount().equals(BigInteger.ONE));
        data.applyExchange(onlyBirch);
        check("L7 白桦 3→0", data.amountOf(Items.BIRCH_PLANKS).signum() == 0);

        // ⑤ 精确请求走「按学会顺序逐条试」：先学的白桦只够 1 个 → 自己要 3 个就落到橡木
        data.clearContent();
        data.insert(new ItemStack(Items.BIRCH_PLANKS, 3));
        data.insert(new ItemStack(Items.OAK_PLANKS, 192));
        data.insert(new ItemStack(Items.COBBLESTONE, 320));
        data.insert(new ItemStack(Items.IRON_INGOT, 64));
        data.insert(new ItemStack(Items.REDSTONE, 64));
        VoidWarehouseExchange.Plan exact3 =
                data.planExchange(new ItemStack(Items.DISPENSER), BigInteger.valueOf(3));
        check("L8 精确取 3 个：白桦只够 1 → 落到橡木，仍给满 3",
                exact3 != null && exact3.amount().equals(BigInteger.valueOf(3)));

        // ⑥ 反证：只学过橡木版、仓库里只有白桦 → 必须做不出来（不跨木材通用）
        //    换一件没被前面的组学过的产物，避免「橡木版早就学会了」
        data.learn(recipe("minecraft:dropper", 1,
                part("minecraft:cobblestone", 7),
                part("minecraft:oak_planks", 1)));
        data.clearContent();
        data.insert(new ItemStack(Items.BIRCH_PLANKS, 64));
        data.insert(new ItemStack(Items.COBBLESTONE, 64));
        check("L9 只学过橡木版、仓库只有白桦 → 做不出来（原料被具体化）",
                data.planExchange(new ItemStack(Items.DROPPER), BigInteger.ONE) == null);
    }

    // ================================================================ M 增量等价

    /**
     * 「按受影响产物增量重算」必须与「从零整批重算」给出<b>逐字节相同</b>的可兑表。
     *
     * <h2>为什么要这份测试，而不是只跑原来的那些断言</h2>
     * <p>增量重算的风险不是「算错」，而是<b>漏算</b>：某件物品变了、某个产物没被标记成受影响，
     * 于是那一格一直显示旧数字。这种错误在「数量对不对」这类断言上往往看不出来
     * （大多数产物的数字本来就该不动），只有把整张表拿去和一份<b>从零建起来的</b>比，
     * 才能同时覆盖「该变的变了」和「不该变的没变」。</p>
     *
     * <h2>对照怎么造</h2>
     * <p>把同一份库存原地清空再灌回，逼它走整批重算（细节与那个坑见
     * {@link #sameAfterFullRebuild}），再把两张表按字面量摊平比对。</p>
     *
     * <p><b>为什么要比顺序</b>：展示序（U2）要求同一份库存下先后一致；增量的实现如果
     * 改成「重算的产物挪到表尾」，数字全对、顺序却会跳。摊平里带顺序，一次就抓到。</p>
     */
    private static void groupM_incrementalEquivalence(MinecraftServer server) {
        System.out.println("[M] 增量重算与整批重算等价");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        for (VoidWarehouseRecipes.Recipe recipe : incrementalBook()) {
            data.learn(recipe);
        }
        // 数量故意取得不整齐：整十的数会把「差 1 个够不够」这类边界盖掉
        data.insert(new ItemStack(Items.COBBLESTONE, 37));
        data.insert(new ItemStack(Items.OAK_LOG, 11));
        data.insert(new ItemStack(Items.OAK_PLANKS, 5));
        data.insert(new ItemStack(Items.IRON_INGOT, 23));
        data.insert(new ItemStack(Items.REDSTONE, 3));
        data.insert(new ItemStack(Items.STICK, 9));
        data.insert(new ItemStack(Items.LEVER, 2));      // 本身就是产物：有货 → 不该出虚拟格
        data.insert(new ItemStack(Items.DIRT, 40));

        sameAfterFullRebuild(data, "M1 初始");

        // ① 最普通的一条路径：某格少 1 个
        data.takeItem(Items.COBBLESTONE, 1);
        sameAfterFullRebuild(data, "M2 圆石 37→36");

        // ② 产物自己进了仓库 → 那一格必须立刻消失（闸门看的是产物自己的数量）
        data.insert(new ItemStack(Items.PISTON, 1));
        sameAfterFullRebuild(data, "M3 活塞有货 → 该格消失");

        // ③ 又取空 → 那一格必须回来
        data.takeItem(Items.PISTON, 1);
        sameAfterFullRebuild(data, "M4 活塞取空 → 该格回来");

        // ④ 动最上游：原木少 4 → 木板、木棍、活塞三层都要跟着变
        data.takeItem(Items.OAK_LOG, 4);
        sameAfterFullRebuild(data, "M5 原木 11→7（三层下钻全变）");

        // ⑤ 把一种只被两条配方用到的原料抽干（整格移除）
        data.takeItem(Items.REDSTONE, 3);
        sameAfterFullRebuild(data, "M6 红石抽干（活塞/发射器同时失去配方）");

        // ⑥ 加一条新配方 → 配方本换版，依赖集要重建
        data.learn(recipe("minecraft:furnace", 1, part("minecraft:cobblestone", 8)));
        sameAfterFullRebuild(data, "M7 学一条新配方（依赖集重建）");

        // ⑦ 同一 tick 里连改三处、只读一次：脏集合必须累加，不能只记住最后一次
        data.takeItem(Items.COBBLESTONE, 5);
        data.takeItem(Items.OAK_LOG, 2);
        data.insert(new ItemStack(Items.IRON_INGOT, 4));
        sameAfterFullRebuild(data, "M8 同一 tick 连改三处");

        // ⑧ <b>只 clearContent()、什么都不灌就读一次</b>：这是唯一「库存整体归零、却没有逐件记账」
        //    的路径（changedItems 是空的）。快捷路径如果不看 craftCacheBusted，这里会把上一份
        //    还写着可兑格的表原样返回 —— 界面上一堆点下去凑不出来的幽灵格。
        data.clearContent();
        VoidWarehouseData.noteServerTick(900_000 + (++scratchTick));
        check("M9 清空后第一读是空表（快捷路径不许沿用旧表）", data.exchangeOffers().isEmpty());

        // ⑨ 重新灌回两种原料：新表必须从零算起
        data.insert(new ItemStack(Items.COBBLESTONE, 37));
        data.insert(new ItemStack(Items.OAK_LOG, 11));
        sameAfterFullRebuild(data, "M10 清空后重灌");

        // ⑩ 逐格抽干（走 consume 那条路）：所有产物必须一起消失
        data.takeItem(Items.COBBLESTONE, 37);
        data.takeItem(Items.OAK_LOG, 11);
        sameAfterFullRebuild(data, "M11 原料逐格抽干 → 全部消失");
    }

    /** 组内自增的假 tick：保证每次读都真的重算（同一 tick 内 exchangeOffers 会按 tick 合并） */
    private static int scratchTick;

    /**
     * 比对「增量重算」与「整批重算」两条路给出的可兑表，必须逐字节相同。
     *
     * <h2>对照怎么造</h2>
     * <p>把同一份库存原地清空再灌回：{@link VoidWarehouseData#clearContent()} 会把
     * 「下次必须整批重算」的标志置起来，于是紧接着的那一次读会<b>把每个产物都算一遍</b>。
     * 配方本一个字没动 —— 所以这确实是「同一份输入、两种算法」的对照。</p>
     *
     * <p>⚠️ 别改成「新建一个 VoidWarehouseData 灌同样的料」：{@code clearContent()} 只清库存、
     * <b>不清配方本</b>，新实例没法复刻前面几组学过的配方，两边输入立刻不一致
     * （实测：对照组少了 dropper、dispenser 的账单还差 9 个圆石）。教训是
     * 「对照组的输入必须由被测对象自己决定」，不能靠测试代码重新拼一遍。</p>
     */
    private static void sameAfterFullRebuild(VoidWarehouseData data, String label) {
        VoidWarehouseData.noteServerTick(900_000 + (++scratchTick));
        String got = dumpOffers(data.exchangeOffers());

        List<ItemStack> snapshot = new ArrayList<>();
        for (int i = 0; i < data.entryCount(); i++) {
            VoidWarehouseData.Entry entry = data.entryAt(i);
            if (entry != null && entry.amount().signum() > 0) {
                snapshot.add(entry.template().copyWithCount(entry.amount().intValue()));
            }
        }
        data.clearContent();
        for (ItemStack stack : snapshot) {
            data.insert(stack);
        }
        VoidWarehouseData.noteServerTick(900_000 + (++scratchTick));
        String want = dumpOffers(data.exchangeOffers());

        // 不额外要求 want 非空：M9 是「原料抽干」那一档，正确答案就是 0 条。
        // 「比对不是空转」由 M1~M8 兜着（那几档都有 2~4 条可兑）。
        boolean ok = got.equals(want);
        if (!ok) {
            System.out.println("   !! 增量与整批不一致：");
            String[] a = got.split("\n", -1);
            String[] b = want.split("\n", -1);
            int shown = 0;
            for (int i = 0; i < Math.max(a.length, b.length) && shown < 8; i++) {
                String x = i < a.length ? a[i] : "<少一行>";
                String y = i < b.length ? b[i] : "<少一行>";
                if (!x.equals(y)) {
                    System.out.println("      增量: " + x);
                    System.out.println("      整批: " + y);
                    shown++;
                }
            }
        }
        check(label + "（" + lineCount(want) + " 条可兑）", ok);
    }

    /** 可兑表摊平成一串字面量；顺序照原样，不做排序（顺序本身就是要证的东西） */
    private static String dumpOffers(List<VoidWarehouseData.ExchangeOffer> offers) {
        StringBuilder sb = new StringBuilder(offers.size() * 96);
        for (VoidWarehouseData.ExchangeOffer offer : offers) {
            sb.append(offer.itemId()).append('|')
                    .append(offer.obtainable()).append('|')
                    .append(offer.bulk()).append('|')
                    .append(offer.boxed()).append('|')
                    .append(offer.craft() ? 'C' : 'X').append('|');
            boolean first = true;
            for (VoidWarehouseExchange.Delta delta : offer.totalCost()) {
                if (!first) {
                    sb.append(',');
                }
                first = false;
                sb.append(delta.itemId()).append('=').append(delta.change());
            }
            sb.append('\n');
        }
        return sb.toString();
    }

    private static int lineCount(String text) {
        int n = 0;
        for (int i = 0; i < text.length(); i++) {
            if (text.charAt(i) == '\n') {
                n++;
            }
        }
        return n;
    }

    /**
     * M 组用的配方本：四条不同的失效路径各来一条 ——
     * 单层多产出、两层下钻、四原料单产出、候选原料（木板两种）、产物自己是别人的原料。
     */
    private static List<VoidWarehouseRecipes.Recipe> incrementalBook() {
        List<VoidWarehouseRecipes.Recipe> book = new ArrayList<>();
        book.add(recipe("minecraft:oak_planks", 4, part("minecraft:oak_log", 1)));
        book.add(recipe("minecraft:stick", 4, part("minecraft:oak_planks", 2)));
        book.add(recipe("minecraft:piston", 1,
                part("minecraft:cobblestone", 4),
                part("minecraft:oak_planks", 3),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1)));
        book.add(new VoidWarehouseRecipes.Recipe(null, "minecraft:dispenser", 1, List.of(
                new VoidWarehouseRecipes.Part(List.of("minecraft:oak_planks", "minecraft:birch_planks"), 3),
                part("minecraft:cobblestone", 7),
                part("minecraft:redstone", 1))));
        book.add(recipe("minecraft:sticky_piston", 1,
                part("minecraft:piston", 1),
                part("minecraft:slime_ball", 1)));
        book.add(recipe("minecraft:lever", 1,
                part("minecraft:cobblestone", 1),
                part("minecraft:stick", 1)));
        return book;
    }

    // ================================================================ N 组

    /** N 组故意塞进缓存的那一格：本身是产物、又不在 9 合 1 表里，不会和 N1 的去重纠缠 */
    private static final String POISON_ID = "minecraft:piston";

    /**
     * <h2>N1/N2 —— 去重口径</h2>
     * <p>9 合 1 表里本来就有 {@code iron_ingot → iron_block}（9:1），再学一条一模一样的换算，
     * 就是「同一件物品被两条路同时命中」。修口径之前这里会出两格：一格是 9 合 1 的
     * {@code "iron_block"}，一格是配方的 {@code "minecraft:iron_block"} ——
     * 界面上一格写「可兑」一格写「可合成」，玩家会以为能拿两份。</p>
     *
     * <p>N1b 是反证的另一半：只断言「只剩一格」还不够，还得断言<b>留下的是哪一格</b>。
     * 要是把方向写反（滤掉 9 合 1、留下配方），N1 照样绿。</p>
     *
     * <p>N2 把这件事抬成通用不变量：整张表里不许有两格指向<b>同一件物品</b>（按 Item 对象比，
     * 不受 id 口径影响）。它不依赖 {@code iron_block} 这个具体样本，任何一档语料只要
     * 同时命中两条路就会红。</p>
     *
     * <p>N1c 补的是 N1 的<b>一个盲点</b>：N1 学的那条配方写成 9:1，与 9 合 1 比例完全相同，
     * 于是「留下哪一格」在数字上看不出来（两格都给 2）。再学一条 4:1 的同一产物把两边逼开 ——
     * 配方那半给 4、9 合 1 给 2 —— 这时「只剩一格」和「那一格写的是 2」才同时有意义。
     * 这两件事必须一起成立：界面取货根本不看 {@code offer().craft()}，tooltip 的数字
     * 只要不是 9 合 1 那份，写的数就和实际扣的料不是一回事。</p>
     *
     * <p>N6 把「显示」和「取货」这两条并排放一次。它们是两条不同的路
     * （{@code planExchangeMax} 允许部分 / {@code planExchange} 要求精确），
     * 唯一必须守住的共同真相是：<b>界面写能拿几个，按量要几个就真能拿到几个</b>。
     * N6b 顺手把已知的那点不对称（按量要得更多时会整段让位给配方）钉成一条读数。</p>
     *
     * <h2>N3~N5 —— {@code CRAFT_DIRTY_LIMIT} 的两侧边界</h2>
     * <p>那条分支<b>没有可观测的行为差异</b>：整批和增量给出的结果本来就该一样，
     * 所以「跑完对比结果」根本测不出分支跑没跑。改成往私有缓存里<b>塞一条错值</b>，
     * 再看它有没有被纠正：</p>
     * <ul>
     *   <li>脏物品<b>全部不在任何产物的依赖集里</b> ⇒ 增量分支一格都不重算 ⇒ 错值原样留着；</li>
     *   <li>整批分支 ⇒ 每一格都重算 ⇒ 错值必然消失。</li>
     * </ul>
     * <p>于是「阈值种→错值还在、阈值+1 种→错值没了」这一对读数就把阈值钉在原地，
     * 也顺带证明那段循环体真的在跑，而不是永远进不去的死代码。</p>
     *
     * <p>阈值本身<b>反射读产品代码里的常量</b>，不在这里抄一份：抄一份就有两个真相，
     * 产品那边调了 96 而测试还按 96 造数据，测的就变成一条不存在的线。</p>
     */
    private static void groupN_dedupAndDirtyLimit(MinecraftServer server) {
        System.out.println("[N] 去重口径 / CRAFT_DIRTY_LIMIT 边界");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        // 9 合 1 规则<b>默认是关的</b>，不显式打开的话 collectNineInOneOffers 一条都不会产，
        // N1 就变成「只有配方那格」的假绿。开完在组尾还原，别把开关留给后面的组。
        VoidWarehouseSettings.voidWarehouseExchange = true;
        // 学不进去也算正常：配方本落在存档里、跨轮持久化，同一台机器第二次跑时这条已经在书里了。
        // 所以不拿 learn 的返回值当前置，改成下面直接看 craftOffers 里那一格有没有算出来。
        data.learn(recipe("minecraft:iron_block", 1, part("minecraft:iron_ingot", 9)));
        data.learn(recipe("minecraft:piston", 1,
                part("minecraft:cobblestone", 4),
                part("minecraft:oak_planks", 3),
                part("minecraft:iron_ingot", 1),
                part("minecraft:redstone", 1)));
        data.learn(recipe("minecraft:oak_planks", 4, part("minecraft:oak_log", 1)));
        data.insert(new ItemStack(Items.IRON_INGOT, 18));
        data.insert(new ItemStack(Items.COBBLESTONE, 40));
        data.insert(new ItemStack(Items.OAK_LOG, 8));
        data.insert(new ItemStack(Items.REDSTONE, 5));

        VoidWarehouseData.noteServerTick(910_000 + (++scratchTick));
        List<VoidWarehouseData.ExchangeOffer> offers = data.exchangeOffers();

        // 第一次读之后先取一份，只为 N0 前置用；N3 要用的那一份必须在 N1c 的 learn 之后重新取
        // （learn 会让 recipeGeneration++，下一次读走「配方本换版」那条分支、重新 new 一个 map）。
        Map<String, VoidWarehouseData.ExchangeOffer> initialCache = craftOffersOf(data);
        if (initialCache == null) {
            check("N0 反射取 craftOffers 失败（内部字段改名了？）", false);
            VoidWarehouseSettings.voidWarehouseExchange = false;
            return;
        }
        check("N0 前置：craftOffers 里 iron_block 那一格就是「能做」（不然 N1 测不到重复）",
                initialCache.get("minecraft:iron_block") != null);

        int ironBlock = 0;
        boolean nineInOneWon = false;
        for (VoidWarehouseData.ExchangeOffer offer : offers) {
            if (!isSameItem(offer.itemId(), "iron_block")) {
                continue;
            }
            ironBlock++;
            nineInOneWon |= !offer.craft();
        }
        check("N1 iron_block 同时命中 9 合 1 与配方时只占一格（实测 " + ironBlock + " 格）", ironBlock == 1);
        check("N1b 留下的那一格是 9 合 1（优先级口径）", nineInOneWon);

        String duplicate = firstDuplicateItem(offers);
        check("N2 整张可兑表没有两格指向同一件物品"
                + (duplicate == null ? "" : "（重复：" + duplicate + "）"), duplicate == null);

        // ---- N1c 两条路的比例不一样时，留下的那格必须还是 9 合 1 的账 ----
        // 上面 N1 那条配方写的是 9:1，<b>与 9 合 1 比例一模一样</b>，所以两格算出来的数都是 2。
        // 万一去重失效、玩家真的看见两格，两个数字也一样 —— 这组断言就测不出更难看的那种表现。
        // 这里再学一条 4:1 的 iron_block（1 块 = 4 锭）把两边逼开：配方那半 maxCraftable 给 4，
        // 9 合 1 给 2。期望仍然是「只出一格」且那一格写 2，因为——
        //   · {@code VoidWarehouseMenu#withdrawFrom} 只取 {@code target.template()}，
        //     <b>完全不看 {@code offer().craft()}</b>，取货永远按 {@code planExchange} 那条
        //     「9 合 1 优先」的路走；tooltip 写成 4 而实际扣 9 合 1 的料，就是「写的数不是给的数」。
        data.learn(recipe("minecraft:iron_block", 1, part("minecraft:iron_ingot", 4)));
        VoidWarehouseData.noteServerTick(910_000 + (++scratchTick));
        List<VoidWarehouseData.ExchangeOffer> strict = data.exchangeOffers();
        // 前置：先证明两条路真的算出了<b>不同的数</b>。少了这一条，万一那条 4:1 根本没进配方本
        // （本子满了 / recipeId 撞车 / learn 被规则开关挡掉），配方那半也会给 2，
        // 下面「那一格写的是 2」就变成一个恒真的空断言 —— 通过得毫无意义。
        // 这是 M 组「对照组构造错」的同一类坑：先确认对照组和实验组确实不同。
        Map<String, VoidWarehouseData.ExchangeOffer> strictCraft = craftOffersOf(data);
        VoidWarehouseData.ExchangeOffer craftHalf =
                strictCraft == null ? null : strictCraft.get("minecraft:iron_block");
        BigInteger craftOnly = craftHalf == null ? null : craftHalf.obtainable();
        check("N1c 前置：配方那半单独算出来是 4（实测 " + craftOnly + "），否则两格同数、测不出区别",
                craftOnly != null && craftOnly.equals(BigInteger.valueOf(4)));
        int strictCells = countSameItem(strict, "iron_block");
        check("N1c 再学一条 4:1 的 iron_block 之后仍然只占一格（实测 " + strictCells + " 格）",
                strictCells == 1);
        VoidWarehouseData.ExchangeOffer strictCell = firstSameItem(strict, "iron_block");
        BigInteger shown = strictCell == null ? null : strictCell.obtainable();
        check("N1c 那一格的数量取 9 合 1 口径的 2、不是配方的 4（实测 " + shown + "）",
                shown != null && shown.equals(BigInteger.valueOf(2)));

        // ---- N6 界面上写的数，按量取货必须真给得出来 ----
        // 界面走 {@code planExchangeMax(sample, 64)}（允许部分），按量取货走
        // {@code planExchange(sample, n)}（精确）。这里只钉一条真正的红线：
        // <b>界面写能拿 n 个，按量要 n 个就必须真拿到 n 个</b> —— 反过来（写的多、给的少）
        // 才是玩家点了没反应的病；写少给多只是不精确。所以判据是等号，不是「大于等于」，
        // 因为「要 n 却给了更多」同样是在动玩家没要的东西。
        ItemStack blockSample = new ItemStack(Items.IRON_BLOCK);
        VoidWarehouseExchange.Plan maxPlan = data.planExchangeMax(blockSample, BigInteger.valueOf(64));
        BigInteger displayed = maxPlan == null ? BigInteger.ZERO : maxPlan.amount();
        VoidWarehouseExchange.Plan exactPlan = displayed.signum() > 0
                ? data.planExchange(blockSample, displayed)
                : null;
        check("N6 界面写能拿 " + displayed + " 个 → 按量要 " + displayed + " 个必须正好拿到 "
                        + displayed + " 个（实测 " + (exactPlan == null ? "null" : exactPlan.amount()) + "）",
                exactPlan != null && exactPlan.amount().equals(displayed));
        // 已知边角，<b>钉住行为而不是钉住正确性</b>：按量<b>要得比界面多</b>时，9 合 1 兑不出
        // 整量会整段让位给配方那半，于是拿到配方的 4，而界面上的上限仍是 9 合 1 的 2。
        // 方向是「多给」，不会造成点了拿不到；但它确实违反了「tooltip 写的数就是实际给的数」。
        // 要修得动 {@code planExchange} 的分派顺序（先算 9 合 1 的上限再统一裁），属于语义变更，
        // 本轮只把它变成一条能看见的读数 —— 将来谁把这行改绿了，等于承认改了分派顺序。
        VoidWarehouseExchange.Plan greedy = data.planExchange(blockSample, BigInteger.valueOf(4));
        check("N6b 按量比界面多要时整段让位给配方那半（界面 " + displayed + " / 按量 "
                        + (greedy == null ? "null" : greedy.amount()) + "）—— 已知边角，钉住不修",
                greedy != null && greedy.amount().equals(BigInteger.valueOf(4))
                        && displayed.equals(BigInteger.valueOf(2)));

        // ---- N3 前置 ----
        Set<String> depIds = allDependencyIds(data);
        Integer limit = dirtyLimit();
        if (depIds == null || limit == null) {
            check("N3 反射取 craftDeps / CRAFT_DIRTY_LIMIT 失败（内部结构改名了？）", false);
            VoidWarehouseSettings.voidWarehouseExchange = false;
            return;
        }
        // ⚠️ 这里必须<b>重新取</b>一份缓存引用：上面 N1c 的 learn 会让 recipeGeneration++，
        // 下一次读走「配方本换版」那条分支、重新 new 一个 craftOffers map。
        // 还抱着 N0 那份 initialCache 的话，下面 put 进去的错值泼在一个已经被丢掉的对象上，
        // 读数变成「错值本来就不在」，看着像通过、其实什么都没测到。
        Map<String, VoidWarehouseData.ExchangeOffer> cache = craftOffersOf(data);
        if (cache == null) {
            check("N3 反射取 craftOffers 失败（内部字段改名了？）", false);
            VoidWarehouseSettings.voidWarehouseExchange = false;
            return;
        }
        check("N3 前置：piston 那一格在缓存里且答案是「能做」（脏水泼得上去）",
                cache.get(POISON_ID) != null && depIds.contains(POISON_ID));
        // ⚠️ 下面几条读数全靠「cache 一直是同一个 map 对象」。只有「配方本换版」那条分支
        // 会重新 new 一个，N3 之后不再 learn，所以不会被换掉；真被换掉的话 put 进去的错值
        // 会随之消失，读数就变成「错值本来就不在」，看着像通过、其实什么都没测到 ——
        // 所以 N5c 补一条对象同一性。这条坑是 M 组「对照组构造错」的同一类，写在前面提醒。
        List<Item> fillers = pickFillerItems(depIds, limit + 1);
        check("N3 前置：凑到 " + (limit + 1) + " 种不在任何依赖集里的填充物品（实测 "
                + fillers.size() + "）", fillers.size() == limit + 1);
        if (fillers.size() < limit + 1) {
            VoidWarehouseSettings.voidWarehouseExchange = false;
            return;
        }

        // ---- N4 恰好等于阈值：不超 ⇒ 走增量 ----
        cache.put(POISON_ID, null);
        int bad = touchAll(data, fillers.subList(0, limit));
        check("N4 前置：" + limit + " 种填充物全部入库 / 出库成功（失败 " + bad + " 次）", bad == 0);
        VoidWarehouseData.noteServerTick(910_000 + (++scratchTick));
        data.exchangeOffers();
        check("N4 " + limit + " 种脏物品（不超阈值）走增量分支 → 错值原样留着",
                cache.get(POISON_ID) == null);

        // ---- N5 阈值 +1：超 ⇒ 走整批 ----
        bad = touchAll(data, fillers);
        check("N5 前置：" + (limit + 1) + " 种填充物全部入库 / 出库成功（失败 " + bad + " 次）", bad == 0);
        VoidWarehouseData.noteServerTick(910_000 + (++scratchTick));
        List<VoidWarehouseData.ExchangeOffer> healed = data.exchangeOffers();
        check("N5 " + (limit + 1) + " 种脏物品（超阈值）走整批分支 → 错值被纠正",
                cache.get(POISON_ID) != null);
        check("N5b 纠正回来的 piston 真的回到可兑表里", countSameItem(healed, POISON_ID) == 1);
        check("N5c 缓存 map 始终是同一个对象（否则 N4/N5 的读数无意义）", cache == craftOffersOf(data));
        VoidWarehouseSettings.voidWarehouseExchange = false;
    }

    // ================================================================ P 组

    /** P 组用的产物：木棍。不在 9 合 1 表里，不会被 N 组那套去重搅进来 */
    private static final String NOTICE_OUTPUT = "minecraft:stick";

    /**
     * <h2>P —— 配方本的三种聊天提示：记住了 / 快满了 / 已满</h2>
     *
     * <p>这三件事全在 {@link VoidWarehouseRecipeNotice#onCrafted} 里判，而它<b>返回要发的行</b>
     * 而不是自己去发 —— 于是这里能直接断言「发了几行、写了什么」，不用造真玩家，
     * 也不用拦 {@code sendSystemMessage}。这是把「怎么用结果」和「结果本身」分开的副产品，
     * 不是为测试专门开的洞。</p>
     *
     * <p>用量与上限是<b>入参</b>而不是从 data 里读，所以「1843 条不吭声 / 1844 条预警 /
     * 满了边沿说一次、之后 30 秒一次」这些边界可以零成本造 —— 真把配方本填到 2048 条
     * 要几十秒，而且每学一条都触发一次全量重建。</p>
     *
     * <p><b>P2 是这组里最要紧的</b>：同产物已有配方必须在 {@code learn} <b>之前</b>取。
     * 两种顺序都跑一遍，断言「先取」那份不含自己、「后取」那份含自己 ——
     * 后者就是提示里出现「木棍还能这样合：…木棍」这种自指的病。</p>
     *
     * <p>⚠️ 配方本落在存档里、<b>跨进程持久化</b>，所以凡是要读真配方本的地方一律用
     * 「相对变化」断言（after == before + 1、contains），不写绝对条数；新配方也用探测法
     * 现找一条没学过的，不然第二次跑就全是 DUPLICATE。</p>
     */
    private static void groupP_recipeNotice(MinecraftServer server) {
        System.out.println("[P] 配方本聊天提示：记住 / 快满 / 已满");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        VoidWarehouseSettings.voidWarehouse = true;
        VoidWarehouseSettings.voidWarehouseCraft = true;
        VoidWarehouseSettings.voidWarehouseExchange = false;

        // 三条同产物、不同原料的木棍配方。用不同木板而不是同一种，recipeId 才各不相同
        // （同一种学两次会被 recipeTexts 去重掉，拿不到「多条同产物配方」这个场景）。
        VoidWarehouseRecipes.Recipe a = recipe(NOTICE_OUTPUT, 4, part("minecraft:oak_planks", 2));
        VoidWarehouseRecipes.Recipe b = recipe(NOTICE_OUTPUT, 4, part("minecraft:birch_planks", 2));
        VoidWarehouseRecipes.Recipe c = recipe(NOTICE_OUTPUT, 4, part("minecraft:spruce_planks", 3));
        data.learn(a);
        data.learn(b);
        data.learn(c);

        // ---- P0/P1 recipesFor：取得到、排序稳 ----
        List<VoidWarehouseRecipes.Recipe> before = data.recipesFor(NOTICE_OUTPUT);
        check("P0 recipesFor 含刚学的那三条（实测 " + before.size() + " 条）",
                before.size() >= 3 && containsRecipe(before, a.recipeId())
                        && containsRecipe(before, b.recipeId())
                        && containsRecipe(before, c.recipeId()));
        boolean ordered = true;
        for (int i = 1; i < before.size(); i++) {
            ordered &= before.get(i - 1).recipeId().compareTo(before.get(i).recipeId()) < 0;
        }
        check("P1 recipesFor 按 recipeId 升序（提示只列前几条，顺序不稳会让玩家以为配方本自己变了）",
                ordered);
        check("P1b 连续两次取，结果逐项相同", sameRecipeIds(before, data.recipesFor(NOTICE_OUTPUT)));

        // ---- P2 先取再学：新配方不许出现在「已有」里 ----
        // 找一条本子里还没有的配方。⚠️ 这里只能用 recipesFor 去「看」，**不能**用
        // learnWithResult 去试探 —— 试探本身就是学入，会把快照污染掉（第一版就这么错的：
        // 循环里 probe 一学进去，后面的 snapshot 就已经含它自己，P2a/P2b 当场双红）。
        VoidWarehouseRecipes.Recipe fresh = null;
        for (int n = 7; n <= 20 && fresh == null; n++) {
            // 7 个木板做木棍原版没有，但 Recipe 只是仓库自己的记录，不要求是原版真配方。
            // 从 7 试到 20 是为了跨轮稳定：跑过几遍之后前面几个都被学过了。
            VoidWarehouseRecipes.Recipe probe =
                    recipe(NOTICE_OUTPUT, 4, part("minecraft:oak_planks", n));
            if (!containsRecipe(data.recipesFor(NOTICE_OUTPUT), probe.recipeId())) {
                fresh = probe;
            }
        }
        check("P2 前置：找到一条本轮还没学过的配方（否则下面几条空转）", fresh != null);
        if (fresh == null) {
            VoidWarehouseSettings.voidWarehouseExchange = false;
            return;
        }
        List<VoidWarehouseRecipes.Recipe> snapshot = data.recipesFor(NOTICE_OUTPUT);
        int beforeSize = snapshot.size();
        check("P2a 学之前取的那份里没有它自己", !containsRecipe(snapshot, fresh.recipeId()));
        boolean learnedNow = data.learnWithResult(fresh) == VoidWarehouseData.LearnResult.LEARNED;
        check("P2b learnWithResult 对这条新配方返回 LEARNED", learnedNow);
        check("P2c 学之后份数 +1（实测 " + beforeSize + " → "
                        + data.recipesFor(NOTICE_OUTPUT).size() + "）",
                data.recipesFor(NOTICE_OUTPUT).size() == beforeSize + 1);
        check("P2d 学之后再取就会把它列进「已有」—— 这就是快照必须抢在 learn 之前的理由",
                containsRecipe(data.recipesFor(NOTICE_OUTPUT), fresh.recipeId()));

        // ---- P3 四种结局 ----
        check("P3 重复学同一条返回 DUPLICATE",
                data.learnWithResult(fresh) == VoidWarehouseData.LearnResult.DUPLICATE);
        VoidWarehouseSettings.voidWarehouseCraft = false;
        check("P3b 配方扣料规则关掉后返回 DISABLED",
                data.learnWithResult(recipe("minecraft:torch", 4, part("minecraft:stick", 1)))
                        == VoidWarehouseData.LearnResult.DISABLED);
        VoidWarehouseSettings.voidWarehouseCraft = true;

        // ---- P4 文案：一行「记住」+ 一行「还能这样合」（旧配方列表是入参，完全可控）----
        int max = VoidWarehouseRecipeBook.MAX_RECIPES;
        List<VoidWarehouseRecipes.Recipe> threeOld = List.of(a, b, c);
        List<Component> lines = VoidWarehouseRecipeNotice.onCrafted(
                UUID.randomUUID(), false, VoidWarehouseData.LearnResult.LEARNED,
                fresh, threeOld, 10, max, 1_000L);
        check("P4 学会一条且同产物有旧配方 → 2 行（实测 " + lines.size() + "）", lines.size() == 2);
        check("P4b 第一行是「已记住配方：…」", lines.size() == 2
                && lines.get(0).getString().contains("已记住配方："));
        check("P4c 第二行以「└ 」开头且写「还能这样合：」", lines.size() == 2
                && lines.get(1).getString().startsWith("└ ")
                && lines.get(1).getString().contains("还能这样合："));
        check("P4d 三条旧配方全列出来（箭头个数 == 3，实测 "
                        + (lines.size() == 2 ? countOccurrences(lines.get(1).getString(), "→") : -1) + "）",
                lines.size() == 2 && countOccurrences(lines.get(1).getString(), "→") == 3);
        check("P4e 新配方自己的形状出现在第一行（含箭头与产物数量）",
                lines.size() == 2 && lines.get(0).getString().contains("→")
                        && lines.get(0).getString().contains("4"));

        // ---- P5 没有旧配方 → 只有一行 ----
        List<Component> solo = VoidWarehouseRecipeNotice.onCrafted(
                UUID.randomUUID(), false, VoidWarehouseData.LearnResult.LEARNED,
                fresh, List.of(), 10, max, 1_000L);
        check("P5 同产物没有旧配方 → 只发 1 行（实测 " + solo.size() + "）", solo.size() == 1);

        // ---- P6 截断：最多 5 条 + 「另有 N 条」 ----
        List<VoidWarehouseRecipes.Recipe> sixOld = new ArrayList<>(6);
        sixOld.add(recipe(NOTICE_OUTPUT, 4, part("minecraft:acacia_planks", 2)));
        sixOld.add(recipe(NOTICE_OUTPUT, 4, part("minecraft:dark_oak_planks", 2)));
        sixOld.add(recipe(NOTICE_OUTPUT, 4, part("minecraft:mangrove_planks", 2)));
        sixOld.add(recipe(NOTICE_OUTPUT, 4, part("minecraft:cherry_planks", 2)));
        sixOld.add(recipe(NOTICE_OUTPUT, 4, part("minecraft:bamboo_planks", 2)));
        sixOld.add(recipe(NOTICE_OUTPUT, 4, part("minecraft:crimson_planks", 2)));
        List<Component> cut = VoidWarehouseRecipeNotice.onCrafted(
                UUID.randomUUID(), false, VoidWarehouseData.LearnResult.LEARNED,
                fresh, sixOld, 10, max, 1_000L);
        check("P6 6 条旧配方只列 5 条（实测箭头 "
                        + (cut.size() == 2 ? countOccurrences(cut.get(1).getString(), "→") : -1) + " 个）",
                cut.size() == 2 && countOccurrences(cut.get(1).getString(), "→") == 5);
        check("P6b 被截掉的写「另有 1 条」", cut.size() == 2
