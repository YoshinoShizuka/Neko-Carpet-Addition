                dupWho, false, VoidWarehouseData.LearnResult.DUPLICATE,
                fresh, sixOld, 10, max, 1_000L);
        check("P7 同一玩家第一次撞上「已记过」要说 1 行（实测 " + dup1.size() + "）", dup1.size() == 1);
        check("P7b 那行写「之前已经记过了」", dup1.size() == 1
