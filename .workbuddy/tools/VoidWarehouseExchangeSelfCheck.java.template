    // ================================================================ 工具：兑换

    /** 把「物品 id → 个数」的简写快照转成引擎要的 {@link VoidWarehouseExchange.Stock} */
    private static VoidWarehouseExchange.Stock stock(Map<String, Integer> snapshot) {
        Map<String, BigInteger> converted = new LinkedHashMap<>();
        for (Map.Entry<String, Integer> e : snapshot.entrySet()) {
            converted.put(e.getKey(), BigInteger.valueOf(e.getValue()));
        }
        return VoidWarehouseExchange.Stock.of(converted);
    }

    private static VoidWarehouseExchange.Plan plan(VoidWarehouseExchange.Table table, String itemId, long want,
                                                   Map<String, Integer> snapshot) {
        return VoidWarehouseExchange.plan(table, itemId, BigInteger.valueOf(want), stock(snapshot));
    }

    /** 账目里某个物品的净变化（没有该物品时为 0） */
    private static BigInteger change(VoidWarehouseExchange.Plan plan, String itemId) {
        return plan == null ? BigInteger.ZERO : plan.asMap().getOrDefault(itemId, BigInteger.ZERO);
    }

    /** 守恒判据：{@code Σ(delta × 9^(层级 − 最低层级)) == −amount × 9^(目标层级 − 最低层级)} */
    private static boolean conserved(VoidWarehouseExchange.Table table, VoidWarehouseExchange.Plan plan) {
        if (plan == null) {
            return false;
        }
        int min = Integer.MAX_VALUE;
        for (String itemId : table.items()) {
            min = Math.min(min, table.levelOf(itemId));
        }
        if (min == Integer.MAX_VALUE) {
            return false;
        }
        BigInteger left = BigInteger.ZERO;
        for (VoidWarehouseExchange.Delta delta : plan.deltas()) {
            left = left.add(delta.change().multiply(weight(table, delta.itemId(), min)));
        }
        BigInteger right = plan.amount().negate().multiply(weight(table, plan.itemId(), min));
        return left.equals(right);
    }

    private static BigInteger weight(VoidWarehouseExchange.Table table, String itemId, int minLevel) {
        return NINE.pow(table.levelOf(itemId) - minLevel);
    }

    private static void checkConserved(VoidWarehouseExchange.Table table, String label,
                                       VoidWarehouseExchange.Plan plan) {
        check(label + " 守恒（Σ 数量×9^层级 == −需求×9^目标层级）", conserved(table, plan));
    }

    private static String ledger(VoidWarehouseExchange.Plan plan) {
        if (plan == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append(plan.itemId()).append(" ×").append(plan.amount()).append(" [");
        boolean first = true;
        for (Map.Entry<String, BigInteger> e : plan.asMap().entrySet()) {
            if (!first) {
                sb.append(", ");
            }
            sb.append(e.getKey()).append(' ').append(e.getValue().signum() > 0 ? "+" : "").append(e.getValue());
            first = false;
        }
        return sb.append(']').toString();
    }

    // ================================================================ 工具：数据层

    private static void reset(VoidWarehouseData data, int nuggets) {
        data.clearContent();
        data.insert(new ItemStack(Items.IRON_NUGGET, nuggets));
    }

    private static Map<String, BigInteger> snapshot(VoidWarehouseData data) {
        Map<String, BigInteger> map = new LinkedHashMap<>();
        for (int i = 0; i < data.entryCount(); i++) {
            VoidWarehouseData.Entry entry = data.entryAt(i);
            if (entry == null) {
                continue;
            }
            String id = VoidWarehouseExchangeBootstrap.idOf(entry.template().getItem());
            map.put(id == null ? ("?" + i) : id, entry.amount());
        }
        return map;
    }

    private static boolean hasOffer(List<VoidWarehouseData.ExchangeOffer> offers, String itemId) {
        return offerOf(offers, itemId) != null;
    }

    private static VoidWarehouseData.ExchangeOffer offerOf(List<VoidWarehouseData.ExchangeOffer> offers,
                                                           String itemId) {
        for (VoidWarehouseData.ExchangeOffer offer : offers) {
            if (offer.itemId().equals(itemId)) {
                return offer;
            }
        }
        return null;
    }

    private static String describeOffers(List<VoidWarehouseData.ExchangeOffer> offers) {
        StringBuilder sb = new StringBuilder("[");
        boolean first = true;
        for (VoidWarehouseData.ExchangeOffer offer : offers) {
            if (!first) {
                sb.append(", ");
            }
            sb.append(offer.itemId()).append(" ×").append(offer.obtainable());
            first = false;
        }
        return sb.append(']').toString();
    }

    private static BigInteger amountAt(VoidWarehouseData data, int displayIndex) {
        VoidWarehouseData.DisplaySlot slot = data.displaySlotAt(displayIndex);
        if (slot.entry() != null) {
            return slot.entry().amount();
        }
        return slot.offer() == null ? BigInteger.ZERO : slot.offer().obtainable();
    }

    private static int findExchangeSlot(VoidWarehousePageContainer container, String itemId) {
        for (int slot = 0; slot < VoidWarehouseData.PAGE_SIZE; slot++) {
            VoidWarehouseData.DisplaySlot target = container.slotAt(slot);
            if (target.isExchange() && itemId.equals(target.offer().itemId())) {
                return slot;
            }
        }
        return -1;
    }

    // ================================================================ 工具：玩家 / 界面 / 聊天

    private static ServerPlayer player(MinecraftServer server, ServerLevel level) {
        try {
            GameProfile profile = new GameProfile(UUID.randomUUID(), "NekoExchangeCheck");
            ClientInformation info = ClientInformation.createDefault();
            ServerPlayer p = new ServerPlayer(server, level, profile, info);
            PacketListener listener = new ServerGamePacketListenerImpl(
                    server, new Connection(PacketFlow.SERVERBOUND), p,
                    CommonListenerCookie.createInitial(profile, false));
            p.connection = (ServerGamePacketListenerImpl) listener;
            forceClientLoaded(p.connection);
            return p;
        } catch (Throwable t) {
            System.out.println("   假玩家构造失败: " + t);
            return null;
        }
    }

    /** 手工造的连接没走完握手，不摁成已加载的话 handleUseItem 首行就 return */
    private static void forceClientLoaded(ServerGamePacketListenerImpl conn) {
        for (String name : new String[]{"waitingForRespawn", "clientLoadedTimeoutTimer"}) {
            try {
                Field f = ServerGamePacketListenerImpl.class.getDeclaredField(name);
                f.setAccessible(true);
                if (f.getType() == boolean.class) {
                    f.setBoolean(conn, false);
                } else {
                    f.setInt(conn, 0);
                }
            } catch (Throwable t) {
                System.out.println("   [diag] 强制已加载失败(" + name + "): " + t);
            }
        }
    }

    /** 走真实包链路开一次界面（与玩家右键工作台完全同一条路），失败返回 null */
    private static VoidWarehouseMenu openMenu(ServerPlayer player) {
        player.containerMenu = player.inventoryMenu;
        ItemStack trigger = new ItemStack(Items.CRAFTING_TABLE);
        trigger.set(DataComponents.CUSTOM_NAME, Component.literal(VoidWarehouseTrigger.ITEM_NAME));
        player.setItemInHand(InteractionHand.MAIN_HAND, trigger);
        try {
            player.connection.handleUseItem(new ServerboundUseItemPacket(
                    InteractionHand.MAIN_HAND, 0, player.getYRot(), player.getXRot()));
        } catch (Throwable t) {
            System.out.println("   [diag] 包路径抛异常: " + t);
        }
        return player.containerMenu instanceof VoidWarehouseMenu
                ? (VoidWarehouseMenu) player.containerMenu : null;
    }

    /** 反射调 {@code VoidWarehouseWithdraw.execute}（聊天按量取货的真正执行体） */
    private static boolean invokeWithdrawChat(ServerPlayer player, ItemStack sample, long amount) {
        try {
            Method m = VoidWarehouseWithdraw.class.getDeclaredMethod(
                    "execute", ServerPlayer.class, ItemStack.class, long.class);
            m.setAccessible(true);
            m.invoke(null, player, sample, amount);
            return true;
        } catch (Throwable t) {
            failures++;
            System.out.println("!! 反射调用 VoidWarehouseWithdraw.execute 失败: " + t);
            t.printStackTrace(System.out);
            return false;
        }
    }

    private static int countInInventory(ServerPlayer player, Item item) {
        int total = 0;
        var inventory = player.getInventory();
        for (int i = 0; i < inventory.getContainerSize(); i++) {
            ItemStack stack = inventory.getItem(i);
            if (!stack.isEmpty() && stack.getItem() == item) {
                total += stack.getCount();
            }
        }
        return total;
    }

    private static HopperBlockEntity asHopper(BlockEntity be) {
        return be instanceof HopperBlockEntity h ? h : null;
    }

    // ================================================================ 工具：组件

    private static List<Component> loreOf(ItemStack stack) {
        ItemLore lore = stack.get(DataComponents.LORE);
        return lore == null ? List.of() : lore.lines();
    }

    private static boolean contains(List<Component> lines, String needle) {
        return lineContaining(lines, needle) != null;
    }

    /** 返回第一条含 {@code needle} 的 lore 行原文（没有则 null）—— 用来咬「某一<em>行</em>」写的是什么 */
    private static String lineContaining(List<Component> lines, String needle) {
        for (Component line : lines) {
            String text = line.getString();
            if (text.contains(needle)) {
                return text;
            }
        }
        return null;
    }

    /**
     * 取一行里 {@code marker} <b>之后</b>的那一段（找不到就返回空串，行本身为 null 也是空串）。
     *
     * <p>为什么必须切段：单行文案里「可拆出 9 个，拆 铁块 1 个」前后各有一个数字，
     * 直接对整行找「 9 个」会永远命中前面那个「可拆出 9 个」，断言就成了空转。
     * 只有把「，拆 」之后那一段单独拿出来，才能证明消耗段写的是 1 不是 9。</p>
     */
    private static String segmentAfter(String line, String marker) {
        if (line == null) {
            return "";
        }
        int at = line.indexOf(marker);
        return at < 0 ? "" : line.substring(at + marker.length());
    }

    private static void dumpLore(String tag, List<Component> lore) {
        for (int i = 0; i < lore.size(); i++) {
            System.out.println("   [" + tag + " " + i + "] '" + lore.get(i).getString() + "'");
        }
    }

    private static void check(String label, boolean ok) {
        checks++;
        if (!ok) {
            failures++;
        }
        System.out.println("   " + (ok ? "ok  " : "FAIL") + " " + label);
    }
