        check("J1 pull 补入 10 个（90 铁粒 ÷ 9）", moved == 10);
        check("J2 漏斗第 0 格从 1 变成 11", slot0 == 11);
        check("J3 仓库铁粒归零", left.signum() == 0);
        check("J4 反证：漏斗里补的就是铁锭，没混进别的东西",
                hopper.getItem(0).getItem() == Items.IRON_INGOT);
    }

    // ================================================================ K 潜影盒模式
    //
    // 玩家报的 bug：盒模式下左键点「可兑」的绿宝石块，只给出一个装着「一组（64）」的盒子。
    // 根因是 offer.obtainable 当时按「一组」封顶，而一盒容量是 27 组 —— 于是可兑条目
    // 永远只能装 1/27 盒，而 tooltip 却写着「左键：兑换 1 盒（1728 个）」。
    // A~J 组一条盒模式用例都没有，所以这个 bug 从自检里整个漏了过去 —— 这就是补 K 组的理由。

    private static void boxModeChecks(MinecraftServer server) {
        System.out.println("=== K 潜影盒模式：可兑条目也要「尽量装满一盒」 ===");
        VoidWarehouseData data = VoidWarehouse.data(server);
        ServerLevel level = server.overworld();
        ServerPlayer player = player(server, level);
        check("K0 假玩家可构造", player != null);
        if (player == null) {
            return;
        }

        // ---- K1 玩家报的场景：仓库里一大堆绿宝石、0 个绿宝石块 ----
        prepare(data, player);
        data.insert(new ItemStack(Items.EMERALD, 6000));
        VoidWarehouseData.ExchangeOffer emeraldBlock = offerOf(data.exchangeOffers(), "emerald_block");
        check("K1 仓库里 0 个绿宝石块时，绿宝石块出现在可兑条目里", emeraldBlock != null);
        long obtainable = emeraldBlock == null ? 0L : emeraldBlock.obtainable().longValue();
        long boxCapacity = VoidWarehouseShulker.capacity(new ItemStack(Items.EMERALD_BLOCK));
        System.out.println("   [K] 绿宝石块可兑数量 = " + obtainable + "，一盒容量 = " + boxCapacity
                + "，一组 = " + new ItemStack(Items.EMERALD_BLOCK).getMaxStackSize());
        check("K2 可兑数量由库存推出来（6000 ÷ 9 = 666），不是固定上限（一盒容量仍是 1728）",
                obtainable == 666 && boxCapacity == 1728);

        // ---- K3 盒模式下左键点这一格 ----
        data.insert(new ItemStack(Items.SHULKER_SHELL, VoidWarehouseShulker.SHELL_COST));
        data.insert(new ItemStack(Items.CHEST, VoidWarehouseShulker.CHEST_COST));
        VoidWarehouseMenu menu = openMenu(player);
        check("K3 能打开虚空仓库界面", menu != null);
        if (menu != null) {
            VoidWarehousePageContainer container = (VoidWarehousePageContainer) menu.getContainer();
            check("K4 这一页确实是盒模式", container.shulkerMode());
            int slot = findExchangeSlot(container, "emerald_block");
            check("K5 界面里找得到「可兑」的绿宝石块格（容器下标 " + slot + "）", slot >= 0);
            if (slot >= 0) {
                menu.clicked(slot, 0, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                ItemStack box = findInInventory(player, Items.SHULKER_BOX);
                long packed = countInside(box, Items.EMERALD_BLOCK);
                System.out.println("   [K] 盒里装了 " + packed + " 个绿宝石块，仓库剩 "
                        + data.amountOf(Items.EMERALD) + " 个绿宝石");
                check("K6 背包里确实拿到 1 个潜影盒", !box.isEmpty());
                check("K7 盒里装的绿宝石块数 == 可兑数量（" + obtainable + "）", packed == obtainable);
                check("K8 反证：不是只给一组 64 —— 盒里远超 64 个（这就是玩家报的 bug）",
                        packed > 64);
                check("K9 账目对得上：6000 个绿宝石 − 666×9 = 6",
                        data.amountOf(Items.EMERALD).equals(BigInteger.valueOf(6)));
                check("K9b 反证：盒里是绿宝石块，不是绿宝石", countInside(box, Items.EMERALD) == 0);
                check("K10 装盒材料被扣掉了（潜影壳 0 / 箱子 0）",
                        data.amountOf(Items.SHULKER_SHELL).signum() == 0
                                && data.amountOf(Items.CHEST).signum() == 0);
            }
        }

        // ---- K11 反方向：料只够一点点时，绝不能多给 ----
        prepare(data, player);
        data.insert(new ItemStack(Items.EMERALD, 18));
        data.insert(new ItemStack(Items.SHULKER_SHELL, VoidWarehouseShulker.SHELL_COST));
        data.insert(new ItemStack(Items.CHEST, VoidWarehouseShulker.CHEST_COST));
        VoidWarehouseData.ExchangeOffer small = offerOf(data.exchangeOffers(), "emerald_block");
        check("K11 18 个绿宝石 → 可兑 2 个绿宝石块",
                small != null && small.obtainable().equals(BigInteger.valueOf(2)));
        VoidWarehouseMenu menu2 = openMenu(player);
        if (menu2 != null) {
            VoidWarehousePageContainer container2 = (VoidWarehousePageContainer) menu2.getContainer();
            int slot = findExchangeSlot(container2, "emerald_block");
            if (slot >= 0) {
                menu2.clicked(slot, 0, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                ItemStack box = findInInventory(player, Items.SHULKER_BOX);
                long packed = countInside(box, Items.EMERALD_BLOCK);
                System.out.println("   [K] 18 个绿宝石时盒里装了 " + packed + " 个绿宝石块");
                check("K12 盒里只有 2 个（料不够就装多少算多少，绝不多给一组）", packed == 2);
                check("K13 绿宝石归零（18 − 2×9 = 0）", data.amountOf(Items.EMERALD).signum() == 0);
            } else {
                check("K12 找得到 18 个绿宝石时的可兑格", false);
            }
        }

        // ---- K14 拆零场景也要能装盒 ----
        prepare(data, player);
        data.insert(new ItemStack(Items.IRON_BLOCK, 1));
        data.insert(new ItemStack(Items.SHULKER_SHELL, VoidWarehouseShulker.SHELL_COST));
        data.insert(new ItemStack(Items.CHEST, VoidWarehouseShulker.CHEST_COST));
        VoidWarehouseMenu menu3 = openMenu(player);
        if (menu3 != null) {
            VoidWarehousePageContainer container3 = (VoidWarehousePageContainer) menu3.getContainer();
            int slot = findExchangeSlot(container3, "iron_ingot");
            check("K14 拆零场景下也能在盒模式里找到可兑格", slot >= 0);
            if (slot >= 0) {
                menu3.clicked(slot, 0, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                ItemStack box = findInInventory(player, Items.SHULKER_BOX);
                long packed = countInside(box, Items.IRON_INGOT);
                check("K15 1 个铁块 → 盒里 9 个铁锭", packed == 9);
                check("K16 铁块被扣光", data.amountOf(Items.IRON_BLOCK).signum() == 0);
            }
        }

        // ---- K17 真实库存格的口径不能被带歪（本来就该装满一盒）----
        prepare(data, player);
        data.insert(new ItemStack(Items.EMERALD_BLOCK, 2000));
        data.insert(new ItemStack(Items.SHULKER_SHELL, VoidWarehouseShulker.SHELL_COST));
        data.insert(new ItemStack(Items.CHEST, VoidWarehouseShulker.CHEST_COST));
        VoidWarehouseMenu menu4 = openMenu(player);
        if (menu4 != null) {
            VoidWarehousePageContainer container4 = (VoidWarehousePageContainer) menu4.getContainer();
            int slot = findRealSlot(container4, Items.EMERALD_BLOCK);
            check("K17 真实库存格在盒模式里也能找到", slot >= 0);
            if (slot >= 0) {
                menu4.clicked(slot, 0, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                long packed = countInside(findInInventory(player, Items.SHULKER_BOX), Items.EMERALD_BLOCK);
                check("K18 真实格 2000 个 → 盒里 1728 个（一盒容量，与可兑条目同一口径）",
                        packed == boxCapacity);
                check("K19 仓库剩 272 个", data.amountOf(Items.EMERALD_BLOCK).equals(BigInteger.valueOf(272)));
            }
        }

        // ---- K20 玩家第三次报的场景：盒模式也必须按库存算，不是一盒容量 ----
        // 原话：「在处于潜影盒模式和普通模式情况下，可兑换的数量不应该以 1728 这种固定的数量来显示，
        // 而是根据仓库里面下一级的物品数量进行显示，例如 铁锭剩余 81 个，那么在金块那里，
        // 可兑换数量应显示为 9」。K 组之前只测了「料够多时装满一盒」，没测过「料不够时必须小」。
        prepare(data, player);
        data.insert(new ItemStack(Items.IRON_INGOT, 81));
        data.insert(new ItemStack(Items.SHULKER_SHELL, VoidWarehouseShulker.SHELL_COST));
        data.insert(new ItemStack(Items.CHEST, VoidWarehouseShulker.CHEST_COST));
        VoidWarehouseMenu menu5 = openMenu(player);
        if (menu5 != null) {
            VoidWarehousePageContainer container5 = (VoidWarehousePageContainer) menu5.getContainer();
            int slot = findExchangeSlot(container5, "iron_block");
            check("K20 盒模式下也找得到「可兑」的铁块格", slot >= 0);
            if (slot >= 0) {
                menu5.clicked(slot, 0, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                long packed = countInside(findInInventory(player, Items.SHULKER_BOX), Items.IRON_BLOCK);
                System.out.println("   [K] 81 个铁锭时盒里装了 " + packed + " 个铁块"
                        + "（一盒容量 " + boxCapacity + "）");
                check("K21 盒里 9 个铁块 —— 按库存算，不是 1728、也不是一组 64", packed == 9);
                check("K22 铁锭归零（81 − 9×9 = 0）", data.amountOf(Items.IRON_INGOT).signum() == 0);
            }
        }

        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
    }

    /** K 组每个场景的起手式：清仓库 / 清背包 / 关界面 / 开盒模式 */
    private static void prepare(VoidWarehouseData data, ServerPlayer player) {
        data.clearContent();
        player.getInventory().clearContent();
        if (player.containerMenu != player.inventoryMenu) {
            player.closeContainer();
        }
        player.containerMenu = player.inventoryMenu;
        VoidWarehouseViews.viewFor(player).setShulkerMode(true);
    }

    private static int findRealSlot(VoidWarehousePageContainer container, Item item) {
        for (int slot = 0; slot < VoidWarehouseData.PAGE_SIZE; slot++) {
            VoidWarehouseData.DisplaySlot target = container.slotAt(slot);
            if (target.entry() != null && target.entry().template().getItem() == item) {
                return slot;
            }
        }
        return -1;
    }

    private static ItemStack findInInventory(ServerPlayer player, Item item) {
        for (int i = 0; i < player.getInventory().getContainerSize(); i++) {
            ItemStack stack = player.getInventory().getItem(i);
            if (!stack.isEmpty() && stack.getItem() == item) {
                return stack;
            }
        }
        return ItemStack.EMPTY;
    }

    /** 数一个潜影盒里某种物品一共有多少个（空盒子返回 0） */
    private static long countInside(ItemStack box, Item item) {
        if (box.isEmpty()) {
            return 0L;
        }
        long total = 0L;
        for (ItemStack inside : VoidWarehouseShulker.contentsOf(box)) {
            if (inside.getItem() == item) {
                total += inside.getCount();
            }
        }
        return total;
    }

    // ================================================================ P 拆零不留零头
    //
    // 玩家原话：「假设仓库没有铜锭但拥有铜块，当铜锭显示可兑后，在普通模式下，
    // 右键一次取出 8 个，再次右键取出一组，这明显是有问题的。」
    //
    // 查出来的真相有两层：
    //   ① 老实现拆上级用的是 ceilDiv —— 为了凑满「一组 64」，它会拆 ceil(64/9) = 8 个铜块
    //      （= 72 个铜锭）→ 给 64 → <b>把 8 个零头写回仓库</b>。于是「一次取出」把仓库的
    //      <b>构成形态</b>改了（铜块少 8 个、凭空多出 8 个铜锭），下一次取货命中「成品有货」
    //      那条路，取货量就变成那个零头 8 —— 玩家看到的「右键一次 8 个」。
    //   ② 改成「只拆整块」之后又暴露出第二层：planMax 原本用<b>二分</b>，前提「能拿 5 个就
    //      一定能拿 4 个」在本规则里不成立（1~9 可行、10~17 不行、18 又可行），二分会落进
    //      洞里收敛，于是「一次取一组」给出 9 或 17 这种明显做不对的数。
    //      现在 planMax 换成「由价值上界往下逐个试」，不依赖任何单调性。
    // 现在拆上级只拆「用得完的整块」（floor，不够就逐块往下退），零头根本不产生。
    //
    // 玩家拍板的口径：右键「取一组」按整块拆、不留零头（9 个铜块 → 63，仓库剩 2 块）；
    // 左键「取 1 个」保持「拆 1 块 + 找零」（那是上一轮明确要的功能，不能砍）。

    private static void splitRemainderChecks(MinecraftServer server) {
        System.out.println("=== P 拆零不留零头：仓库只有上级时，取货不该改变仓库的构成 ===");
        VoidWarehouseData data = VoidWarehouse.data(server);
        ServerLevel level = server.overworld();
        ServerPlayer player = player(server, level);
        check("P0 假玩家可构造", player != null);
        if (player == null) {
            return;
        }
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.active();
        // 物品一律走引擎自己的 id→item 解析器：26.x 的 Items.COPPER_BLOCK 是
        // WeatheringCopperCollection（铜氧化四态集合）而不是 Item，直接构造 ItemStack 编译不过；
        // 用 id 解析还对五个版本一致。
        Item copperBlock = VoidWarehouseExchangeBootstrap.itemOf("copper_block");
        Item copperIngot = VoidWarehouseExchangeBootstrap.itemOf("copper_ingot");
        check("P1 铜粒 / 铜锭 / 铜块连成同一族（" + table.familyOf("copper_ingot") + "）",
                copperBlock != null && copperIngot != null
                        && table.familyOf("copper_ingot").containsAll(
                        java.util.List.of("copper_nugget", "copper_ingot", "copper_block")));
        if (copperBlock == null || copperIngot == null) {
            return;
        }

        // ---- P2~P6 纯算法：拆上级只拆整块 ----
        check("P2 9 个铜块取 64 个铜锭 —— <b>凑不出来</b>（64 不是整块量，凑满就得留 8 个零头）",
                plan(table, "copper_ingot", 64L, Map.of("copper_block", 9)) == null);
        VoidWarehouseExchange.Plan p63 = plan(table, "copper_ingot", 63L, Map.of("copper_block", 9));
        System.out.println("   [P] 9 铜块取 63 -> " + ledger(p63));
        check("P3 9 个铜块取 63 —— 可行，账目只有「铜块 −7」，零头为 0",
                p63 != null && p63.asMap().size() == 1
                        && change(p63, "copper_block").equals(BigInteger.valueOf(-7)));
        checkConserved(table, "P3b 整块拆", p63);

        VoidWarehouseExchange.Plan p1 = plan(table, "copper_ingot", 1L, Map.of("copper_block", 1));
        System.out.println("   [P] 1 铜块取 1 -> " + ledger(p1));
        check("P4 反证：左键取 1 个仍保留「拆 1 块 + 找零 8」（上一轮要的功能不能被砍掉）",
                p1 != null && change(p1, "copper_block").equals(ONE.negate())
                        && change(p1, "copper_ingot").equals(BigInteger.valueOf(8)));
        checkConserved(table, "P4b 找零", p1);

        // 整块拆完还差一点点时，用下级补 —— 老实现（ceil）做不到这一条
        Map<String, Integer> mixed = new LinkedHashMap<>();
        mixed.put("copper_block", 7);
        mixed.put("copper_nugget", 90);
        VoidWarehouseExchange.Plan p64 = plan(table, "copper_ingot", 64L, mixed);
        System.out.println("   [P] 7 铜块 + 90 铜粒取 64 -> " + ledger(p64));
        check("P5 混合库存能取满 64：7 块 = 63 差 1，用 9 个铜粒补齐，零头仍为 0",
                p64 != null && change(p64, "copper_block").equals(BigInteger.valueOf(-7))
                        && change(p64, "copper_nugget").equals(BigInteger.valueOf(-9)));
        checkConserved(table, "P5b 混合补零", p64);
        check("P6 1 铜块 + 90 铜粒取 11 —— 老实现要 2 块直接判无解，现在能凑出来",
                plan(table, "copper_ingot", 11L,
                        Map.of("copper_block", 1, "copper_nugget", 90)) != null);

        // 上级不够时要「少拆一块、把更多零头交给下级」—— 只试 floor(need / 9) 会漏掉这条路，
        // 于是「1 块 + 100 粒」被算成 17（9 + 8）而不是 20（9 + 11）：100 粒明明够 11 个铜锭，
        // 却被「必须拆 2 块」卡掉。这正是 P9 那个 9 的同源毛病在另一处的表现。
        VoidWarehouseExchange.Plan pNugMax = VoidWarehouseExchange.planMax(table, "copper_ingot",
                BigInteger.valueOf(64), stock(Map.of("copper_block", 1, "copper_nugget", 100)));
        System.out.println("   [P] 1 铜块 + 100 铜粒最多能取 " + ledger(pNugMax));
        check("P6b 1 铜块 + 100 铜粒「最多能取」= 20（9 + 11），不是 17",
                pNugMax != null && pNugMax.amount().equals(BigInteger.valueOf(20)));
        check("P6c 账目 = 铜块 −1、铜粒 −99（11 × 9），零头为 0",
                change(pNugMax, "copper_block").equals(ONE.negate())
                        && change(pNugMax, "copper_nugget").equals(BigInteger.valueOf(-99)));
        checkConserved(table, "P6d 少拆一块", pNugMax);
        check("P6e 反证：只有 1 铜块 + 8 铜粒时取 10 个凑不出来（零头 1 个铜锭要 9 粒）",
                plan(table, "copper_ingot", 10L,
                        Map.of("copper_block", 1, "copper_nugget", 8)) == null);

        // ---- P7~P11 真实界面：可兑数量 81 与「一次取货 63」都要显示对 ----
        prepare(data, player);
        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
        data.insert(new ItemStack(copperBlock, 9));
        VoidWarehouseData.ExchangeOffer offer = offerOf(data.exchangeOffers(), "copper_ingot");
        check("P7 9 个铜块时铜锭出现在可兑条目里", offer != null);
        if (offer != null) {
            System.out.println("   [P] 9 铜块：可兑 " + offer.obtainable() + "，一次取货 " + offer.bulk()
                    + "，一盒 " + offer.boxed());
            check("P8 可兑数量 = 81（9 个铜块能换的全部铜锭）",
                    offer.obtainable().equals(BigInteger.valueOf(81)));
            check("P9 一次「取一组」= <b>63</b> 而不是 64（64 要拆 8 块、会留下 8 个零头）",
                    offer.bulk().equals(BigInteger.valueOf(63)));
            List<Component> lore = loreOf(VoidWarehouseData.buildExchangeDisplay(offer, false));
            dumpLore("P-offer", lore);
            String bulkLine = lineContaining(lore, "右键：");
            check("P10 tooltip 的右键行写 63 并说明原因（按整块拆、不留零头）",
                    bulkLine != null && bulkLine.contains("63 个") && bulkLine.contains("不留零头"));
        }

        // ---- P11~P14 右键两次：63、18，全程不留零头 ----
        for (int round = 1; round <= 2; round++) {
            VoidWarehouseMenu menu = openMenu(player);
            check("P11." + round + " 界面可打开", menu != null);
            if (menu == null) {
                break;
            }
            VoidWarehousePageContainer container = (VoidWarehousePageContainer) menu.getContainer();
            int slot = findExchangeSlot(container, "copper_ingot");
            check("P11." + round + "b 找得到可兑槽", slot >= 0);
            if (slot < 0) {
                break;
            }
            int before = countInInventory(player, copperIngot);
            menu.clicked(slot, 1, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
            int got = countInInventory(player, copperIngot) - before;
            if (round == 1) {
                check("P11 右键第 1 次给 63 个", got == 63);
                check("P12 仓库只剩 2 个铜块、<b>没有任何零头铜锭</b>（" + snapshot(data) + "）",
                        snapshot(data).equals(Map.of("copper_block", BigInteger.valueOf(2))));
            } else {
                check("P13 右键第 2 次给 18 个（剩下那 2 块）", got == 18);
                check("P14 仓库清空（" + snapshot(data) + "）", snapshot(data).isEmpty());
            }
        }

        // ---- P15~P16 左键取 1 个：保持「找零」口径 ----
        prepare(data, player);
        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
        data.insert(new ItemStack(copperBlock, 9));
        VoidWarehouseMenu menu = openMenu(player);
        if (menu != null) {
            VoidWarehousePageContainer container = (VoidWarehousePageContainer) menu.getContainer();
            int slot = findExchangeSlot(container, "copper_ingot");
            check("P15 左键前找得到可兑槽", slot >= 0);
            if (slot >= 0) {
                int before = countInInventory(player, copperIngot);
                menu.clicked(slot, 0, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                check("P16 左键取到 1 个铜锭",
                        countInInventory(player, copperIngot) - before == 1);
            }
        }
        check("P17 左键之后仓库 = {铜块 8, 铜锭 8}（拆 1 块、找零 8，这是玩家要保留的口径）",
                snapshot(data).equals(Map.of("copper_block", BigInteger.valueOf(8),
                        "copper_ingot", BigInteger.valueOf(8))));

        // ---- P18~P19 潜影盒模式：一盒的上限（27 组）是 9 的倍数，整块拆刚好除尽 ----
        prepare(data, player);
        data.insert(new ItemStack(copperBlock, 9));
        data.insert(new ItemStack(Items.SHULKER_SHELL, VoidWarehouseShulker.SHELL_COST));
        data.insert(new ItemStack(Items.CHEST, VoidWarehouseShulker.CHEST_COST));
        VoidWarehouseData.ExchangeOffer boxOffer = offerOf(data.exchangeOffers(), "copper_ingot");
        check("P18 盒模式：一盒能装 81 个（9 块全拆正好 81，零头为 0，与工具提示同源）",
                boxOffer != null && boxOffer.boxed().equals(BigInteger.valueOf(81)));
        VoidWarehouseMenu boxMenu = openMenu(player);
        if (boxMenu != null) {
            VoidWarehousePageContainer boxContainer = (VoidWarehousePageContainer) boxMenu.getContainer();
            int boxSlot = findExchangeSlot(boxContainer, "copper_ingot");
            check("P19 盒模式下找得到可兑槽", boxSlot >= 0);
            if (boxSlot >= 0) {
                boxMenu.clicked(boxSlot, 0, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                long packed = countInside(findInInventory(player, Items.SHULKER_BOX), copperIngot);
                System.out.println("   [P] 盒里装了 " + packed + " 个铜锭");
                check("P19b 盒里正好 81 个（与 P18 的数字一致，不留零头）", packed == 81);
                check("P19c 仓库清空（" + snapshot(data) + "）", snapshot(data).isEmpty());
            }
        }

        // ---- P20~P23 上级不够的真实界面：一次「取一组」= 20（少拆一块、零头交给下级）----
        prepare(data, player);
        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
        Item copperNugget = VoidWarehouseExchangeBootstrap.itemOf("copper_nugget");
        data.insert(new ItemStack(copperBlock, 1));
        data.insert(new ItemStack(copperNugget, 100));
        VoidWarehouseData.ExchangeOffer thin = offerOf(data.exchangeOffers(), "copper_ingot");
        check("P20 1 铜块 + 100 铜粒：可兑 20 且一次取货 20（老实现只有 17）",
                thin != null && thin.obtainable().equals(BigInteger.valueOf(20))
                        && thin.bulk().equals(BigInteger.valueOf(20)));
        VoidWarehouseMenu thinMenu = openMenu(player);
        if (thinMenu != null) {
            VoidWarehousePageContainer thinContainer = (VoidWarehousePageContainer) thinMenu.getContainer();
            int thinSlot = findExchangeSlot(thinContainer, "copper_ingot");
            check("P21 找得到可兑槽", thinSlot >= 0);
            if (thinSlot >= 0) {
                int before = countInInventory(player, copperIngot);
                thinMenu.clicked(thinSlot, 1, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                check("P22 右键一次给 20 个（老实现只给 17）",
                        countInInventory(player, copperIngot) - before == 20);
                check("P23 仓库只剩 1 个铜粒（" + snapshot(data) + "）",
                        snapshot(data).equals(Map.of("copper_nugget", BigInteger.ONE)));
            }
        }

        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
    }

    // ================================================================ Q 非 9 比例（4:1 海晶石）

    /**
     * 这一组专测「比例不是 9」的那条边（{@code 4 海晶碎片 → 1 海晶石}）。
     *
     * <p>为什么非要有这一组：A~P 全部断言都建立在「一块 = 9 个」上，
     * 引擎里任何一处把 9 写死的地方，用 9:1 的物品测都是绿的 ——
     * 只有拿 4:1 的物品跑一遍，才会暴露「乘 9 而不是乘边上的比例」。</p>
     *
     * <p>同时咬住两条反证：<b>海晶石拆不回碎片</b>（原版没有那个配方）、
     * <b>海晶灯兑不出</b>（5 碎片 + 4 晶体，多原料，本规则不做）。</p>
     */
    private static void countChecks(MinecraftServer server) {
        System.out.println("=== Q 非 9 比例：4 海晶碎片 → 1 海晶石 ===");
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.Table.of(VoidWarehouseExchange.EDGES);

        // ---- 纯逻辑：4 个换 1 个，多一个少一个都不行 ----
        VoidWarehouseExchange.Plan p = plan(table, "prismarine", 1, Map.of("prismarine_shard", 4));
        System.out.println("   [Q] 4 碎片 -> 1 海晶石：" + ledger(p));
        check("Q1 4 碎片能兑 1 个海晶石，且只扣 4 碎片",
                p != null && p.asMap().size() == 1 && change(p, "prismarine_shard").equals(FOUR.negate()));
        checkConserved(table, "Q1 4 碎片 -> 1 海晶石", p);
        check("Q2 反证：3 碎片取 1 海晶石 无解（差一个就是差一个）",
                plan(table, "prismarine", 1, Map.of("prismarine_shard", 3)) == null);

        check("Q3 反证：1 个海晶石取 1 个碎片 无解（原版没有拆分配方，不能逆用 4:1）",
                plan(table, "prismarine_shard", 1, Map.of("prismarine", 1)) == null);

        p = VoidWarehouseExchange.planMax(table, "prismarine", BigInteger.valueOf(64),
                stock(Map.of("prismarine_shard", 9)));
        System.out.println("   [Q] 9 碎片最多能拿几个海晶石：" + ledger(p));
        check("Q4 9 碎片最多兑 2 个海晶石（9/4 = 2，剩 1 个碎片当零头）",
                p != null && p.amount().equals(BigInteger.TWO));
        checkConserved(table, "Q4 9 碎片尽力取海晶石", p);

        p = VoidWarehouseExchange.planMax(table, "prismarine_bricks", BigInteger.valueOf(64),
                stock(Map.of("prismarine_shard", 18)));
        System.out.println("   [Q] 18 碎片最多能拿几个海晶石砖：" + ledger(p));
        check("Q5 18 碎片最多兑 2 个海晶石砖（那条边还是 9:1）",
                p != null && p.amount().equals(BigInteger.TWO));
        checkConserved(table, "Q5 18 碎片尽力取海晶石砖", p);

        // ⚠️ 这条以前是反证（「海晶灯兑不出来」）。1.0.11 起海晶灯改走多原料配方，
        // 反证作废 —— 但也不能就这么删掉：Q 组是「表结构」的哨兵，
        // 这里改成确认「海晶灯确实进了表、确实有一条配方、确实和海晶碎片同族」，
        // 行为本身（能不能兑、能兑几个）由 R 组专测，不在这里重复。
        check("Q6 海晶灯已进表：1 条多原料配方，且与海晶碎片同族（行为见 R 组）",
                table.recipesOf("sea_lantern").size() == 1
                        && table.familyOf("sea_lantern").contains("prismarine_shard")
                        && table.familyOf("sea_lantern").contains("prismarine_crystals"));

        // ---- 数据层 / 界面：玩家真的右键一次会拿到几个 ----
        VoidWarehouseData data = VoidWarehouse.data(server);
        ServerLevel level = server.overworld();
        ServerPlayer player = player(server, level);
        check("Q6b 假玩家可构造", player != null);
        if (player == null) {
            return;
        }
        Item shard = VoidWarehouseExchangeBootstrap.itemOf("prismarine_shard");
        Item prismarine = VoidWarehouseExchangeBootstrap.itemOf("prismarine");
        if (shard == null || prismarine == null) {
            check("Q7 本版本里没有海晶碎片 / 海晶石（不该发生）", false);
            return;
        }

        prepare(data, player);
        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
        data.insert(new ItemStack(shard, 18));
        VoidWarehouseData.ExchangeOffer offer = offerOf(data.exchangeOffers(), "prismarine");
        check("Q7 仓库 18 碎片时，海晶石那格「可兑 4」（18/4，不是 18/9 = 2）",
                offer != null && offer.obtainable().equals(FOUR));
        check("Q8 一次取货量也是 4（与可兑数量同源，都来自规划器）",
                offer != null && offer.bulk().equals(FOUR));

        VoidWarehouseMenu menu = openMenu(player);
        if (menu != null) {
            VoidWarehousePageContainer container = (VoidWarehousePageContainer) menu.getContainer();
            int slot = findExchangeSlot(container, "prismarine");
            check("Q9 界面上找得到海晶石的可兑槽", slot >= 0);
            if (slot >= 0) {
                int before = countInInventory(player, prismarine);
                menu.clicked(slot, 1, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                check("Q10 右键一次真的拿到 4 个海晶石（不是 9 个）",
                        countInInventory(player, prismarine) - before == 4);
                check("Q11 仓库只剩 2 个碎片（" + snapshot(data) + "）",
                        snapshot(data).equals(Map.of("prismarine_shard", BigInteger.TWO)));
            }
        }

        // ---- 盒模式：一盒装得下就按料给，料不够绝不多给 ----
        prepare(data, player);
        data.insert(new ItemStack(shard, 18));
        data.insert(new ItemStack(Items.SHULKER_SHELL, VoidWarehouseShulker.SHELL_COST));
        data.insert(new ItemStack(Items.CHEST, VoidWarehouseShulker.CHEST_COST));
        VoidWarehouseData.ExchangeOffer boxed = offerOf(data.exchangeOffers(), "prismarine");
        check("Q12 盒模式下「一盒能装几个」还是 4（料只够 4 个，不许按一盒容量报数）",
                boxed != null && boxed.boxed().equals(FOUR));

        // ---- 混合族：一块海晶石 + 9 个碎片，够换 1 个砖 ----
        prepare(data, player);
        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
        data.insert(new ItemStack(prismarine, 1));
        data.insert(new ItemStack(shard, 9));
        VoidWarehouseData.ExchangeOffer mixed = offerOf(data.exchangeOffers(), "prismarine_bricks");
        check("Q13 1 海晶石 + 9 碎片：海晶石砖可兑 1（4 + 9 = 13 价值，一个砖要 9）",
                mixed != null && mixed.obtainable().equals(ONE) && mixed.bulk().equals(ONE));

        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
    }

    // ================================================================ R 多原料配方（海晶灯）

    /**
     * 玩家要求：「海晶灯设置为<b>只能使用原料兑换</b>」。
     *
     * <p>原版配方是 {@code SCS/CCC/SCS} —— <b>5 海晶碎片 + 4 海晶棱镜</b>。
     * 所以这一组要证两件事，缺一不可：</p>
     * <ol>
     *   <li><b>两种原料都真的被扣</b>：少一个碎片、少一个晶体都必须整次失败；</li>
     *   <li><b>不许拿同族成品折算</b>：海晶石（价值 4）、海晶石砖（价值 9）摆一堆也换不出海晶灯 ——
     *       哪怕价值上刚好够。这是「只能使用原料」这句话的实际含义，
     *       也是这套价值模型最容易犯的错（价值等价 ≠ 配方存在）。</li>
     * </ol>
     */
    private static void seaLanternChecks(MinecraftServer server) {
        System.out.println("=== R 多原料配方：海晶灯只能用原料兑换 ===");
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.Table.of(VoidWarehouseExchange.EDGES);

        VoidWarehouseExchange.Plan p = plan(table, "sea_lantern", 1,
                Map.of("prismarine_shard", 5, "prismarine_crystals", 4));
        System.out.println("   [R] 5 碎片 + 4 晶体 -> 海晶灯：" + ledger(p));
        check("R1 5 碎片 + 4 晶体 → 1 海晶灯，两种原料都扣",
                p != null && p.asMap().size() == 2
                        && change(p, "prismarine_shard").equals(BigInteger.valueOf(-5))
                        && change(p, "prismarine_crystals").equals(FOUR.negate()));
        checkConserved(table, "R1 原料换海晶灯", p);

        check("R2 反证：4 碎片 + 4 晶体（差一个碎片）→ 无解",
                plan(table, "sea_lantern", 1,
                        Map.of("prismarine_shard", 4, "prismarine_crystals", 4)) == null);
        check("R3 反证：5 碎片 + 3 晶体（差一个晶体）→ 无解",
                plan(table, "sea_lantern", 1,
                        Map.of("prismarine_shard", 5, "prismarine_crystals", 3)) == null);

        // ---- 「只能使用原料」：同族成品一件都不许折算过去 ----
        check("R4 反证：3 个海晶石（价值 12 ≥ 9）也换不出海晶灯",
                plan(table, "sea_lantern", 1, Map.of("prismarine", 3)) == null);
        check("R5 反证：1 个海晶石砖（价值正好 9）也换不出海晶灯",
                plan(table, "sea_lantern", 1, Map.of("prismarine_bricks", 1)) == null);
        check("R6 反证：1 个海晶灯拆不出碎片（原版没有拆解配方）",
                plan(table, "prismarine_shard", 1, Map.of("sea_lantern", 1)) == null);

        p = VoidWarehouseExchange.planMax(table, "sea_lantern", BigInteger.valueOf(64),
                stock(Map.of("prismarine_shard", 10, "prismarine_crystals", 8)));
        System.out.println("   [R] 10 碎片 + 8 晶体最多能拿：" + ledger(p));
        check("R7 10 碎片 + 8 晶体最多兑 2 个海晶灯",
                p != null && p.amount().equals(BigInteger.TWO));
        checkConserved(table, "R7 原料尽力换海晶灯", p);
        VoidWarehouseExchange.Plan nearly = VoidWarehouseExchange.planMax(table, "sea_lantern",
                BigInteger.valueOf(64), stock(Map.of("prismarine_shard", 9, "prismarine_crystals", 4)));
        check("R8 9 碎片 + 4 晶体只够 1 个（碎片不够第二个，不许凑）",
                nearly != null && nearly.amount().equals(ONE));

        // ---- 数据层 / 界面：玩家真的点一下会怎样 ----
        VoidWarehouseData data = VoidWarehouse.data(server);
        ServerLevel level = server.overworld();
        ServerPlayer player = player(server, level);
        check("R9 假玩家可构造", player != null);
        if (player == null) {
            return;
        }
        Item shard = VoidWarehouseExchangeBootstrap.itemOf("prismarine_shard");
        Item crystal = VoidWarehouseExchangeBootstrap.itemOf("prismarine_crystals");
        Item lantern = VoidWarehouseExchangeBootstrap.itemOf("sea_lantern");
        Item bricks = VoidWarehouseExchangeBootstrap.itemOf("prismarine_bricks");
        if (shard == null || crystal == null || lantern == null || bricks == null) {
            check("R10 本版本缺海晶灯 / 海晶棱镜（不该发生）", false);
            return;
        }

        prepare(data, player);
        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
        data.insert(new ItemStack(shard, 5));
        data.insert(new ItemStack(crystal, 4));
        VoidWarehouseData.ExchangeOffer offer = offerOf(data.exchangeOffers(), "sea_lantern");
        check("R10 仓库 5 碎片 + 4 晶体 → 海晶灯那格「可兑 1」",
                offer != null && offer.obtainable().equals(ONE));
        VoidWarehouseMenu menu = openMenu(player);
        if (menu != null) {
            VoidWarehousePageContainer container = (VoidWarehousePageContainer) menu.getContainer();
            int slot = findExchangeSlot(container, "sea_lantern");
            check("R11 界面上找得到海晶灯的可兑槽", slot >= 0);
            if (slot >= 0) {
                int before = countInInventory(player, lantern);
                menu.clicked(slot, 0, net.minecraft.world.inventory.ContainerInput.PICKUP, player);
                check("R12 左键真的拿到 1 个海晶灯", countInInventory(player, lantern) - before == 1);
                check("R13 仓库被清空（" + snapshot(data) + "）", snapshot(data).isEmpty());
            }
        }

        prepare(data, player);
        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
        data.insert(new ItemStack(shard, 4));
        data.insert(new ItemStack(crystal, 4));
        check("R14 反证：差一个碎片时，海晶灯不在可兑列表",
                offerOf(data.exchangeOffers(), "sea_lantern") == null);

        prepare(data, player);
        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
        data.insert(new ItemStack(bricks, 3));
        check("R15 反证：仓库只有海晶石砖时，海晶灯也不在可兑列表（不许折算）",
                offerOf(data.exchangeOffers(), "sea_lantern") == null);

        VoidWarehouseViews.viewFor(player).setShulkerMode(false);
    }

    private static void cleanup(MinecraftServer server) {
        ServerLevel level = server.overworld();
        if (hopperPos != null) {
            level.setBlock(hopperPos, Blocks.AIR.defaultBlockState(), 3);
            level.setChunkForced(HOPPER_X >> 4, HOPPER_Z >> 4, false);
        }
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.COBBLESTONE, 1234));
        data.insert(new ItemStack(Items.DIRT, 5678));
    }

    private static void finish(MinecraftServer server) {
        done = true;
        System.out.println("SMOKE RESULT vw-exchange/26.3 checks=" + checks + " failures=" + failures);
        server.halt(false);
    }

    // ================================================================ 工具：兑换

    /** 把「物品 id → 个数」的简写快照转成引擎要的 {@link VoidWarehouseExchange.Stock} */
    private static VoidWarehouseExchange.Stock stock(Map<String, Integer> snapshot) {
        Map<String, BigInteger> converted = new LinkedHashMap<>();
        for (Map.Entry<String, Integer> e : snapshot.entrySet()) {
            converted.put(e.getKey(), BigInteger.valueOf(e.getValue()));
        }
        return VoidWarehouseExchange.Stock.of(converted);
    }

    private static VoidWarehouseExchange.Plan plan(VoidWarehouseExchange.Table table, String itemId, long want,
                                                   Map<String, Integer> snapshot) {
        return VoidWarehouseExchange.plan(table, itemId, BigInteger.valueOf(want), stock(snapshot));
    }

    /** 账目里某个物品的净变化（没有该物品时为 0） */
    private static BigInteger change(VoidWarehouseExchange.Plan plan, String itemId) {
        return plan == null ? BigInteger.ZERO : plan.asMap().getOrDefault(itemId, BigInteger.ZERO);
    }

    /**
     * 守恒判据：{@code Σ(delta × 该物品价值) == −amount × 目标物品价值}。
     *
     * <p>价值直接从表里取（{@link VoidWarehouseExchange.Table#valueOf}），
     * <b>不再自己按 9 的幂算</b> —— 自己算等于把「9」这个前提又抄了一遍，
     * 表里一旦有多比例（4:1），断言就和被测代码一起错，测不出东西。</p>
     */
    private static boolean conserved(VoidWarehouseExchange.Table table, VoidWarehouseExchange.Plan plan) {
        if (plan == null) {
            return false;
        }
        BigInteger left = BigInteger.ZERO;
        for (VoidWarehouseExchange.Delta delta : plan.deltas()) {
            left = left.add(delta.change().multiply(table.valueOf(delta.itemId())));
        }
        BigInteger right = plan.amount().negate().multiply(table.valueOf(plan.itemId()));
        return left.equals(right);
    }

    private static void checkConserved(VoidWarehouseExchange.Table table, String label,
                                       VoidWarehouseExchange.Plan plan) {
        check(label + " 守恒（Σ 数量×价值 == −需求×目标价值）", conserved(table, plan));
    }

    private static String ledger(VoidWarehouseExchange.Plan plan) {
        if (plan == null) {
            return "null";
        }
        StringBuilder sb = new StringBuilder();
        sb.append(plan.itemId()).append(" ×").append(plan.amount()).append(" [");
        boolean first = true;
        for (Map.Entry<String, BigInteger> e : plan.asMap().entrySet()) {
            if (!first) {
                sb.append(", ");
            }
            sb.append(e.getKey()).append(' ').append(e.getValue().signum() > 0 ? "+" : "").append(e.getValue());
            first = false;
        }
        return sb.append(']').toString();
    }

    // ================================================================ 工具：数据层

    private static void reset(VoidWarehouseData data, int nuggets) {
        data.clearContent();
        data.insert(new ItemStack(Items.IRON_NUGGET, nuggets));
    }

    private static Map<String, BigInteger> snapshot(VoidWarehouseData data) {
        Map<String, BigInteger> map = new LinkedHashMap<>();
        for (int i = 0; i < data.entryCount(); i++) {
            VoidWarehouseData.Entry entry = data.entryAt(i);
            if (entry == null) {
                continue;
            }
            String id = VoidWarehouseExchangeBootstrap.idOf(entry.template().getItem());
            map.put(id == null ? ("?" + i) : id, entry.amount());
        }
        return map;
    }

    private static boolean hasOffer(List<VoidWarehouseData.ExchangeOffer> offers, String itemId) {
        return offerOf(offers, itemId) != null;
    }

    private static VoidWarehouseData.ExchangeOffer offerOf(List<VoidWarehouseData.ExchangeOffer> offers,
                                                           String itemId) {
        for (VoidWarehouseData.ExchangeOffer offer : offers) {
            if (offer.itemId().equals(itemId)) {
                return offer;
            }
        }
        return null;
    }

    private static String describeOffers(List<VoidWarehouseData.ExchangeOffer> offers) {
        StringBuilder sb = new StringBuilder("[");
        boolean first = true;
        for (VoidWarehouseData.ExchangeOffer offer : offers) {
            if (!first) {
                sb.append(", ");
            }
            sb.append(offer.itemId()).append(" ×").append(offer.obtainable());
            first = false;
        }
        return sb.append(']').toString();
    }

    private static BigInteger amountAt(VoidWarehouseData data, int displayIndex) {
        VoidWarehouseData.DisplaySlot slot = data.displaySlotAt(displayIndex);
        if (slot.entry() != null) {
            return slot.entry().amount();
        }
        return slot.offer() == null ? BigInteger.ZERO : slot.offer().obtainable();
    }

    private static int findExchangeSlot(VoidWarehousePageContainer container, String itemId) {
        for (int slot = 0; slot < VoidWarehouseData.PAGE_SIZE; slot++) {
            VoidWarehouseData.DisplaySlot target = container.slotAt(slot);
            if (target.isExchange() && itemId.equals(target.offer().itemId())) {
                return slot;
            }
        }
        return -1;
    }

    // ================================================================ 工具：玩家 / 界面 / 聊天

    private static ServerPlayer player(MinecraftServer server, ServerLevel level) {
        try {
            GameProfile profile = new GameProfile(UUID.randomUUID(), "NekoExchangeCheck");
            ClientInformation info = ClientInformation.createDefault();
            ServerPlayer p = new ServerPlayer(server, level, profile, info);
            PacketListener listener = new ServerGamePacketListenerImpl(
                    server, new Connection(PacketFlow.SERVERBOUND), p,
                    CommonListenerCookie.createInitial(profile, false));
            p.connection = (ServerGamePacketListenerImpl) listener;
            forceClientLoaded(p.connection);
            return p;
        } catch (Throwable t) {
            System.out.println("   假玩家构造失败: " + t);
            return null;
        }
    }

    /** 手工造的连接没走完握手，不摁成已加载的话 handleUseItem 首行就 return */
    private static void forceClientLoaded(ServerGamePacketListenerImpl conn) {
        for (String name : new String[]{"waitingForRespawn", "clientLoadedTimeoutTimer"}) {
            try {
                Field f = ServerGamePacketListenerImpl.class.getDeclaredField(name);
                f.setAccessible(true);
                if (f.getType() == boolean.class) {
                    f.setBoolean(conn, false);
                } else {
                    f.setInt(conn, 0);
                }
            } catch (Throwable t) {
                System.out.println("   [diag] 强制已加载失败(" + name + "): " + t);
            }
        }
    }

    /** 走真实包链路开一次界面（与玩家右键工作台完全同一条路），失败返回 null */
    private static VoidWarehouseMenu openMenu(ServerPlayer player) {
        player.containerMenu = player.inventoryMenu;
        ItemStack trigger = new ItemStack(Items.CRAFTING_TABLE);
        trigger.set(DataComponents.CUSTOM_NAME, Component.literal(VoidWarehouseTrigger.ITEM_NAME));
        player.setItemInHand(InteractionHand.MAIN_HAND, trigger);
        try {
            player.connection.handleUseItem(new ServerboundUseItemPacket(
                    InteractionHand.MAIN_HAND, 0, player.getYRot(), player.getXRot()));
        } catch (Throwable t) {
            System.out.println("   [diag] 包路径抛异常: " + t);
        }
        return player.containerMenu instanceof VoidWarehouseMenu
                ? (VoidWarehouseMenu) player.containerMenu : null;
    }

    /** 反射调 {@code VoidWarehouseWithdraw.execute}（聊天按量取货的真正执行体） */
    private static boolean invokeWithdrawChat(ServerPlayer player, ItemStack sample, long amount) {
        try {
            Method m = VoidWarehouseWithdraw.class.getDeclaredMethod(
                    "execute", ServerPlayer.class, ItemStack.class, long.class);
            m.setAccessible(true);
            m.invoke(null, player, sample, amount);
            return true;
        } catch (Throwable t) {
            failures++;
            System.out.println("!! 反射调用 VoidWarehouseWithdraw.execute 失败: " + t);
            t.printStackTrace(System.out);
            return false;
        }
    }

    private static int countInInventory(ServerPlayer player, Item item) {
        int total = 0;
        var inventory = player.getInventory();
        for (int i = 0; i < inventory.getContainerSize(); i++) {
            ItemStack stack = inventory.getItem(i);
            if (!stack.isEmpty() && stack.getItem() == item) {
                total += stack.getCount();
            }
        }
        return total;
    }

    private static HopperBlockEntity asHopper(BlockEntity be) {
        return be instanceof HopperBlockEntity h ? h : null;
    }

    // ================================================================ 工具：组件

    private static List<Component> loreOf(ItemStack stack) {
        ItemLore lore = stack.get(DataComponents.LORE);
        return lore == null ? List.of() : lore.lines();
    }

    private static boolean contains(List<Component> lines, String needle) {
        return lineContaining(lines, needle) != null;
    }

    /** 返回第一条含 {@code needle} 的 lore 行原文（没有则 null）—— 用来咬「某一<em>行</em>」写的是什么 */
    private static String lineContaining(List<Component> lines, String needle) {
        for (Component line : lines) {
            String text = line.getString();
            if (text.contains(needle)) {
                return text;
            }
        }
        return null;
    }

    /**
     * 取一行里 {@code marker} <b>之后</b>的那一段（找不到就返回空串，行本身为 null 也是空串）。
     *
     * <p>为什么必须切段：单行文案里「可拆出 9 个，拆 铁块 1 个」前后各有一个数字，
     * 直接对整行找「 9 个」会永远命中前面那个「可拆出 9 个」，断言就成了空转。
     * 只有把「，拆 」之后那一段单独拿出来，才能证明消耗段写的是 1 不是 9。</p>
     */
    private static String segmentAfter(String line, String marker) {
        if (line == null) {
            return "";
        }
        int at = line.indexOf(marker);
        return at < 0 ? "" : line.substring(at + marker.length());
    }

    private static void dumpLore(String tag, List<Component> lore) {
        for (int i = 0; i < lore.size(); i++) {
            System.out.println("   [" + tag + " " + i + "] '" + lore.get(i).getString() + "'");
        }
    }

    private static void check(String label, boolean ok) {
        checks++;
        if (!ok) {
            failures++;
        }
        System.out.println("   " + (ok ? "ok  " : "FAIL") + " " + label);
    }
