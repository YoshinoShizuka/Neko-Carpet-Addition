/**
 * 【临时自检】「虚空仓库 9 合 1 兑换」这一整条新链路。验证完删掉。
 *
 * <h2>要证的东西（每组都配反证）</h2>
 * <ol>
 *   <li><b>A 静态表</b>：29 条边 / 53 个物品 / 双向 20 + 只能向上 8 + 只能向下 1，层级自洽；</li>
 *   <li><b>B 启动复核</b>：拿真实 {@code RecipeManager} 复核后一条都没被砍（说明表与 26.3 的现实一致）；</li>
 *   <li><b>C 反向核对</b>：把表里每条边<b>还原成 9 个（或 1 个）真实物品</b>，交给真实配方系统去匹配，
 *       产出的东西必须正好是边的另一端 —— 这是「模式本身对不对」的独立第二意见，
 *       不依赖采集脚本没写错；</li>
 *   <li><b>D 守恒不变量</b>（纯逻辑）：{@code Σ(每条 delta × 9^层级) == −need × 9^目标层级}。
 *       这是「不可能刷物」的形式化判据；</li>
 *   <li><b>E 随机 fuzz</b>：随机库存 × 随机目标跑 150 次，凡是成功的规划全部必须守恒；</li>
 *   <li><b>F 数据层</b>：可兑条目入选条件、「统一展示序」与可兑条目数一致、数量次序是排列、虚拟格文案；</li>
 *   <li><b>G 回滚精确性</b>：取货失败时整个仓库逐项还原（含一条与兑换无关的干扰项）；</li>
 *   <li><b>H 四条入口一致</b>：API 直调 / 界面点格 / 打印机补货 / 聊天按量取货，扣的必须是同一笔账；</li>
 *   <li><b>I 规则关闭</b>：关掉规则后「可兑」格必须<b>立刻</b>消失（这条会咬住缓存没作废的 bug）；</li>
 *   <li><b>J 漏斗出料</b>：分类物是铁锭、仓库里只有铁粒时，漏斗真的被补上；</li>
 *   <li><b>K 潜影盒模式</b>：可兑条目在盒模式下也要「尽量装满一盒」（与真实库存格同口径），
 *       料不够时绝不多给 —— 这一组是玩家报「只给一组 64」之后补的，
 *       补它的理由就是 A~J 组一条盒模式用例都没有。</li>
 * </ol>
 *
 * <h2>反证组（区分「改对了」与「断言是空转」）</h2>
 * <ul>
 *   <li>有货时绝不兑换：仓里同时有 9 铁粒 + 1 铁锭，取 1 铁锭的账目必须<b>只有</b>铁锭 −1；</li>
 *   <li>单向不可逆：9 铜锭合不出 1 涂蜡铜块（断言返回 null）；浮冰拆不回冰；</li>
 *   <li>凑不够就整次失败：8 铁粒取 1 铁锭 = null，且仓库一个字节都没动；</li>
 *   <li>fuzz 成功次数 ≥ 30（否则「全部守恒」是空转）。</li>
 * </ul>
 */
public final class VoidWarehouseExchangeSelfCheck {

    private static final BigInteger ONE = BigInteger.ONE;
    private static final BigInteger NINE = BigInteger.valueOf(9);

    /** 前几个 tick 先等配方表读好（配方跟着数据包重载，构造完成的那一刻不一定就绪） */
    private static final int WAIT_TICKS = 5;

    private static final int HOPPER_X = 612;
    private static final int HOPPER_Y = 133;
    private static final int HOPPER_Z = 617;

    private static boolean done = false;
    private static int stage = 0;
    private static int tickIndex = 0;
    private static int waitHopper = 0;
    private static int checks = 0;
    private static int failures = 0;

    private static BlockPos hopperPos;
    private static HopperBlockEntity hopper;

    private VoidWarehouseExchangeSelfCheck() {
    }

    public static void run(MinecraftServer server) {
        if (done) {
            return;
        }
        // 规则必须先开着，否则 exchangeEnabled() 恒为假，整组断言都在空转
        VoidWarehouseSettings.voidWarehouse = true;
        VoidWarehouseSettings.voidWarehouseExchange = true;
        try {
            step(server);
        } catch (Throwable t) {
            failures++;
            System.out.println("!! 自检抛异常: " + t);
            t.printStackTrace(System.out);
            finish(server);
        }
    }

    private static void step(MinecraftServer server) {
        switch (stage) {
            case 0:
                if (++tickIndex < WAIT_TICKS) {
                    return;
                }
                tickIndex = 0;
                break;
            case 1:
                tableChecks();
                break;
            case 2:
                bootstrapChecks(server);
                break;
            case 3:
                recipeMatchChecks(server);
                break;
            case 4:
                conservationChecks();
                break;
            case 5:
                fuzzChecks();
                break;
            case 6:
                dataLayerChecks(server);
                break;
            case 7:
                rollbackChecks(server);
                break;
            case 8:
                entryPointChecks(server);
                break;
            case 9:
                ruleOffChecks(server);
                break;
            case 10:
                placeHopper(server);
                break;
            case 11:
                hopper = asHopper(server.overworld().getBlockEntity(hopperPos));
                if (hopper == null && ++waitHopper < 300) {
                    return;
                }
                break;
            case 12:
                hopperChecks(server);
                break;
            case 13:
                boxModeChecks(server);
                break;
            case 14:
                cleanup(server);
                break;
            default:
                finish(server);
                return;
        }
        stage++;
    }

    // ================================================================ A 静态表

    private static void tableChecks() {
        System.out.println("=== A 静态表 ===");
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.Table.of(VoidWarehouseExchange.EDGES);

        check("A1 声明 29 条边", VoidWarehouseExchange.EDGES.size() == 29);
        check("A2 建表后生效 29 条边", table.edges().size() == 29);
        check("A3 层级自相矛盾被丢掉的边 = 0", table.dropped().isEmpty());
        check("A4 表里共 53 个物品", table.items().size() == 53);

        int both = 0;
        int combineOnly = 0;
        int splitOnly = 0;
        for (VoidWarehouseExchange.Edge edge : table.edges()) {
            if (edge.canCombine() && edge.canSplit()) {
                both++;
            } else if (edge.canCombine()) {
                combineOnly++;
            } else {
                splitOnly++;
            }
        }
        check("A5 双向边 20 条（实际 " + both + "）", both == 20);
        check("A6 只能向上合成 8 条（实际 " + combineOnly + "）", combineOnly == 8);
        check("A7 只能向下拆分 1 条（实际 " + splitOnly + "）", splitOnly == 1);

        check("A8 铁粒层级 +1 == 铁锭层级", table.levelOf("iron_nugget") + 1 == table.levelOf("iron_ingot"));
        check("A9 铁锭层级 +1 == 铁块层级", table.levelOf("iron_ingot") + 1 == table.levelOf("iron_block"));
        check("A10 浮冰层级 +1 == 蓝冰层级", table.levelOf("packed_ice") + 1 == table.levelOf("blue_ice"));
        check("A11 冰层级 +2 == 蓝冰层级（三级链）", table.levelOf("ice") + 2 == table.levelOf("blue_ice"));

        check("A12 makersOf(铁锭) 含铁粒", table.makersOf("iron_ingot").contains("iron_nugget"));
        check("A13 splittersOf(铁锭) 含铁块", table.splittersOf("iron_ingot").contains("iron_block"));
        check("A14 反证：makersOf(涂蜡铜块) 为空（9 铜锭合不出涂蜡铜块）",
                table.makersOf("waxed_copper_block").isEmpty());
        check("A15 反证：splittersOf(涂蜡铜块) 为空（涂蜡铜块不可再拆）",
                table.splittersOf("waxed_copper_block").isEmpty());
        check("A16 反证：splittersOf(冰) 为空（浮冰拆不回冰）", table.splittersOf("ice").isEmpty());
        check("A17 反证：圆石不在表里", !table.contains("cobblestone"));
        check("A18 反证：泥土不在表里", !table.contains("dirt"));
    }

    // ================================================================ B 启动复核

    private static void bootstrapChecks(MinecraftServer server) {
        System.out.println("=== B 启动复核（真实 RecipeManager）===");
        System.out.println("   [B] 本服务器的配方总数 = " + server.getRecipeManager().getRecipes().size());
        VoidWarehouseExchangeBootstrap.Summary summary = VoidWarehouseExchangeBootstrap.bootstrap(server);
        System.out.println("   [B] " + summary);

        // 基准不能死写成 29：旧版本里没有硫磺 / 浓缩硫（26.2 才加的），那一条边<b>应该</b>被砍掉。
        // 正确口径是「本版本里两边物品都存在的边有几条」，跟 Summary 对得上才叫按事实收紧。
        int declared = VoidWarehouseExchange.EDGES.size();
        int unavailable = 0;
        for (VoidWarehouseExchange.Edge edge : VoidWarehouseExchange.EDGES) {
            if (VoidWarehouseExchangeBootstrap.itemOf(edge.small()) == null
                    || VoidWarehouseExchangeBootstrap.itemOf(edge.big()) == null) {
                unavailable++;
            }
        }
        System.out.println("   [B] 声明 " + declared + " 条边，其中 " + unavailable
                + " 条的物品在本版本不存在（26.2 起才有硫磺 / 浓缩硫）");

        check("B1 声明 29 条边（表本身不随版本变）", declared == 29);
        check("B2 作废条数 == 「物品在本版本不存在」的条数（" + unavailable + "，实际 "
                + summary.dropped() + "）", summary.dropped() == unavailable);
        check("B3 kept + dropped == declared", summary.kept() + summary.dropped() == declared);
        check("B4 没有被降级成单向的（版本差异只会整条没有，不会只剩半个方向）",
                summary.downgraded() == 0);
        check("B5 诊断信息条数 == 作废条数", summary.notes().size() == summary.dropped());
        check("B6 生效表建图层级自洽（没有边被丢掉）", VoidWarehouseExchange.active().dropped().isEmpty());
        check("B7 生效表条数 == Summary.kept()",
                VoidWarehouseExchange.active().edges().size() == summary.kept());
        check("B8 反证：itemOf(不存在的物品) 返回 null（复核的判据有牙）",
                VoidWarehouseExchangeBootstrap.itemOf("definitely_not_an_item_xyz") == null);
        check("B9 反证：idOf(空气) 返回 null（空物品不算任何一件东西）",
                VoidWarehouseExchangeBootstrap.idOf(Items.AIR) == null);
    }

    // ================================================================ C 反向核对（真实配方系统）

    private static void recipeMatchChecks(MinecraftServer server) {
        System.out.println("=== C 反向核对：把每条边还原成真实物品，交给真实配方系统匹配 ===");
        ServerLevel level = server.overworld();
        int combineOk = 0;
        int combineTotal = 0;
        int splitOk = 0;
        int splitTotal = 0;
        int skipped = 0;

        for (VoidWarehouseExchange.Edge edge : VoidWarehouseExchange.EDGES) {
            Item small = VoidWarehouseExchangeBootstrap.itemOf(edge.small());
            Item big = VoidWarehouseExchangeBootstrap.itemOf(edge.big());
            if (small == null || big == null) {
                // 这个版本里没有这件物品 —— 启动复核已经把整条边砍掉了，这里跳过
                skipped++;
                continue;
            }
            if (edge.canCombine()) {
                combineTotal++;
                // 3×3 全填满同一种物品（每个格子 1 个，共 9 个）
                if (matches(server, level, 3, 3, small, big, 1)) {
                    combineOk++;
                } else {
                    check("C 9×" + edge.small() + " 能合成 1×" + edge.big(), false);
                }
            }
            if (edge.canSplit()) {
                splitTotal++;
                // 1×1 只放 1 个
                if (matches(server, level, 1, 1, big, small, 9)) {
                    splitOk++;
                } else {
                    check("C 1×" + edge.big() + " 能拆成 9×" + edge.small(), false);
                }
            }
        }
        System.out.println("   [C] 9 合 1 匹配 " + combineOk + "/" + combineTotal
                + "，1 拆 9 匹配 " + splitOk + "/" + splitTotal + "，跳过（物品缺失）" + skipped);
        check("C1 全部 " + combineTotal + " 条可用的「9 合 1」都在真实配方系统里匹配成功",
                combineOk == combineTotal);
        check("C2 全部 " + splitTotal + " 条可用的「1 拆 9」都在真实配方系统里匹配成功",
                splitOk == splitTotal);
        check("C3 因物品缺失而跳过的条数 == 启动复核作废的条数（" + skipped + "）",
                skipped == VoidWarehouseExchangeBootstrap.summary().dropped());
        check("C4 反证：随便放 9 个圆石匹配不到铁锭（匹配方法有牙）",
                !matches(server, level, 3, 3, Items.COBBLESTONE, Items.IRON_INGOT, 1));
    }

    /** 把 {@code w×h} 个格子的输入喂给真实配方系统，看产出的东西是不是 {@code out × outCount} */
    private static boolean matches(MinecraftServer server, ServerLevel level, int w, int h,
                                   Item in, Item out, int outCount) {
        if (in == null || out == null) {
            return false;
        }
        List<ItemStack> items = new ArrayList<>(w * h);
        for (int i = 0; i < w * h; i++) {
            items.add(new ItemStack(in, 1));
        }
        CraftingInput input = CraftingInput.of(w, h, items);
        var found = server.getRecipeManager().getRecipeFor(RecipeType.CRAFTING, input, level);
        if (found.isEmpty()) {
            return false;
        }
        ItemStack result = found.get().value().assemble(input);
        return result.getCount() == outCount && result.getItem() == out;
    }

    // ================================================================ D 守恒 + 反证（纯逻辑）

    private static void conservationChecks() {
        System.out.println("=== D 纯逻辑：守恒不变量 + 反证组 ===");
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.Table.of(VoidWarehouseExchange.EDGES);

        check("D1 空库存取铁锭 -> 无解", plan(table, "iron_ingot", 1, Map.of("cobblestone", 9999)) == null);

        // ---- 反证：有货时绝不兑换 ----
        VoidWarehouseExchange.Plan p = plan(table, "iron_ingot", 1,
                Map.of("iron_nugget", 9, "iron_ingot", 1));
        System.out.println("   [D] 有 9 铁粒 + 1 铁锭，取 1 铁锭 -> " + ledger(p));
        check("D2 有货时取到 1 铁锭", p != null);
        check("D3 有货时账目里只有铁锭 −1（一个铁粒都没动）",
                p != null && p.asMap().size() == 1 && change(p, "iron_ingot").equals(ONE.negate()));

        p = plan(table, "iron_ingot", 5, Map.of("iron_block", 1, "iron_ingot", 5));
        System.out.println("   [D] 铁锭刚好够 5 个（另有 1 铁块），取 5 铁锭 -> " + ledger(p));
        check("D4 成品够时也不会去拆铁块", p != null && p.asMap().size() == 1
                && change(p, "iron_ingot").equals(BigInteger.valueOf(-5)));

        // ---- 下级合成 ----
        p = plan(table, "iron_ingot", 1, Map.of("iron_nugget", 9));
        System.out.println("   [D] 9 铁粒 -> 1 铁锭：" + ledger(p));
        check("D5 9 铁粒能兑 1 铁锭，且只扣 9 铁粒",
                p != null && p.asMap().size() == 1 && change(p, "iron_nugget").equals(NINE.negate()));
        checkConserved(table, "D5 9 铁粒 -> 1 铁锭", p);
        check("D6 反证：8 铁粒取 1 铁锭 无解", plan(table, "iron_ingot", 1, Map.of("iron_nugget", 8)) == null);
        check("D7 反证：90 铁粒取 11 铁锭 无解（不够 99）",
                plan(table, "iron_ingot", 11, Map.of("iron_nugget", 90)) == null);

        // ---- 拆上级找零 ----
        p = plan(table, "iron_ingot", 1, Map.of("iron_block", 1));
        System.out.println("   [D] 拆 1 铁块取 1 铁锭：" + ledger(p));
        check("D8 拆 1 铁块取 1 铁锭：铁块 −1 且找回 8 铁锭",
                p != null && change(p, "iron_block").equals(ONE.negate())
                        && change(p, "iron_ingot").equals(NINE.subtract(ONE)));
        checkConserved(table, "D8 拆铁块取铁锭", p);

        // ---- 三级链 ----
        p = plan(table, "blue_ice", 1, Map.of("ice", 81));
        System.out.println("   [D] 81 冰 -> 1 蓝冰：" + ledger(p));
        check("D9 81 冰 -> 1 蓝冰（跨两级）", p != null && change(p, "ice").equals(NINE.multiply(NINE).negate()));
        checkConserved(table, "D9 81 冰 -> 1 蓝冰", p);
        check("D10 反证：80 冰 -> 1 蓝冰 无解", plan(table, "blue_ice", 1, Map.of("ice", 80)) == null);

        // ---- 单向：只能向上 ----
        check("D11 反证：只有 1 浮冰时取冰 无解（浮冰拆不回冰）",
                plan(table, "ice", 1, Map.of("packed_ice", 1)) == null);
        p = plan(table, "packed_ice", 1, Map.of("ice", 9));
        check("D12 9 冰 -> 1 浮冰 可行", p != null);
        checkConserved(table, "D12 9 冰 -> 1 浮冰", p);

        // ---- 单向：只能向下 ----
        p = plan(table, "copper_ingot", 1, Map.of("waxed_copper_block", 1));
        System.out.println("   [D] 拆 1 涂蜡铜块取 1 铜锭：" + ledger(p));
        check("D13 拆 1 涂蜡铜块取 1 铜锭：涂蜡铜块 −1 且找回 8 铜锭",
                p != null && change(p, "waxed_copper_block").equals(ONE.negate())
                        && change(p, "copper_ingot").equals(NINE.subtract(ONE)));
        checkConserved(table, "D13 拆涂蜡铜块取铜锭", p);
        check("D14 反证：9 铜锭合不出 1 涂蜡铜块 无解",
                plan(table, "waxed_copper_block", 1, Map.of("copper_ingot", 9)) == null);

        // ---- 大数：跨两级只用原料 ----
        p = plan(table, "iron_block", 1, Map.of("iron_nugget", 81));
        System.out.println("   [D] 81 铁粒 -> 1 铁块：" + ledger(p));
        check("D15 81 铁粒 -> 1 铁块（铁粒→铁锭→铁块，跨两级只用原料）",
                p != null && p.asMap().size() == 1 && change(p, "iron_nugget").equals(BigInteger.valueOf(-81)));
        checkConserved(table, "D15 81 铁粒 -> 1 铁块", p);
        p = VoidWarehouseExchange.planMax(table, "iron_block", BigInteger.valueOf(100),
                stock(Map.of("iron_nugget", 729)));
        System.out.println("   [D] 729 铁粒最多能拿铁块：" + ledger(p));
        check("D15b 729 铁粒最多能拿 9 个铁块（729 = 9 × 81）",
                p != null && p.amount().equals(NINE));
        checkConserved(table, "D15b 729 铁粒尽力取铁块", p);

        // ---- planMax 尽力而为 ----
        p = VoidWarehouseExchange.planMax(table, "iron_ingot", BigInteger.valueOf(64),
                stock(Map.of("iron_nugget", 10)));
        check("D16 只有 10 铁粒时「最多能拿」= 1 个（不是整次失败）",
                p != null && p.amount().equals(ONE));
        checkConserved(table, "D16 尽力取", p);
        check("D17 反证：只有 8 铁粒时「最多能拿」= 无解",
                VoidWarehouseExchange.planMax(table, "iron_ingot", BigInteger.valueOf(64),
                        stock(Map.of("iron_nugget", 8))) == null);

        // ---- 计划本身是只读的 ----
        Map<String, Integer> frozen = new LinkedHashMap<>();
        frozen.put("iron_nugget", 90);
        VoidWarehouseExchange.Plan readOnly = plan(table, "iron_ingot", 3, frozen);
        check("D18 规划是只读的（调用方给的快照没被改）",
                readOnly != null && frozen.size() == 1 && frozen.get("iron_nugget") == 90);
        VoidWarehouseExchange.Plan negated = readOnly == null ? null : readOnly.negate();
        check("D19 Plan.negate() 把每一笔都反号",
                negated != null && change(negated, "iron_nugget").equals(change(readOnly, "iron_nugget").negate()));
    }

    // ================================================================ E fuzz

    private static void fuzzChecks() {
        System.out.println("=== E 随机库存 fuzz：任何成功规划都必须守恒 ===");
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.Table.of(VoidWarehouseExchange.EDGES);
        List<String> items = new ArrayList<>(table.items());
        Random rng = new Random(20261014L);

        int tried = 0;
        int succeeded = 0;
        int broken = 0;
        for (int iter = 0; iter < 150; iter++) {
            VoidWarehouseExchange.Edge edge = VoidWarehouseExchange.EDGES.get(
                    rng.nextInt(VoidWarehouseExchange.EDGES.size()));
            boolean upward = rng.nextBoolean();
            String target = upward ? edge.big() : edge.small();
            String source = upward ? edge.small() : edge.big();

            Map<String, Integer> snap = new LinkedHashMap<>();
            snap.put(source, rng.nextInt(400));
            int noise = rng.nextInt(3);
            for (int k = 0; k < noise; k++) {
                snap.merge(items.get(rng.nextInt(items.size())), rng.nextInt(50), Integer::sum);
            }

            BigInteger limit = BigInteger.valueOf(1 + rng.nextInt(64));
            tried++;
            VoidWarehouseExchange.Plan p = VoidWarehouseExchange.planMax(table, target, limit, stock(snap));
            if (p == null) {
                continue;
            }
            succeeded++;
            if (!conserved(table, p)) {
                broken++;
                System.out.println("   !! 不守恒: target=" + target + " limit=" + limit
                        + " stock=" + snap + " plan=" + ledger(p));
            }
        }
        System.out.println("   [E] 试了 " + tried + " 次，成功 " + succeeded + " 次，不守恒 " + broken + " 次");
        check("E1 fuzz 全部守恒（成功 " + succeeded + " / 不守恒 " + broken + "）", broken == 0);
        check("E2 反证：fuzz 至少成功 30 次（否则上一条是空转）", succeeded >= 30);
    }

