    // ================================================================ G 回滚精确性

    private static void rollbackChecks(MinecraftServer server) {
        System.out.println("=== G 回滚精确性（取货失败必须一个字节都不动）===");
        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.IRON_NUGGET, 100));
        data.insert(new ItemStack(Items.DIRT, 7));

        Map<String, BigInteger> before = snapshot(data);
        check("G0 起点仓库 = " + before, before.size() == 2);

        VoidWarehouseData.Withdrawal first = data.withdraw(new ItemStack(Items.IRON_INGOT), NINE.multiply(BigInteger.valueOf(64)));
        System.out.println("   [G] 100 铁粒取一组铁锭 -> 取到 " + (first.isEmpty() ? 0 : first.taken())
                + "，viaExchange=" + first.viaExchange());
        check("G1 100 铁粒能兑出 11 个铁锭（99 个铁粒，余 1 个不够再换）",
                !first.isEmpty() && first.taken() == 11);
        check("G2 走的确实是兑换那条路", first.viaExchange());
        check("G3 扣掉 99 铁粒后仓库剩 1（余数绝对不许被吃掉）",
                data.amountOf(Items.IRON_NUGGET).equals(ONE));
        check("G4 仓库里铁锭仍然是 0（那 11 个在 Withdrawal 手里，还没入包）",
                data.amountOf(Items.IRON_INGOT).signum() == 0);

        first.returnUnplaced(0);
        System.out.println("   [G] 整笔撤销后仓库 = " + snapshot(data));
        check("G5 整笔撤销后库存逐项还原（" + snapshot(data) + "）", snapshot(data).equals(before));
        check("G6 铁粒回到 100", data.amountOf(Items.IRON_NUGGET).equals(BigInteger.valueOf(100)));
        check("G7 铁锭仍然是 0", data.amountOf(Items.IRON_INGOT).signum() == 0);
        check("G8 反证：与兑换无关的干扰项（泥土 7 个）一个字没动",
                data.amountOf(Items.DIRT).equals(BigInteger.valueOf(7)));

        // 部分撤销：取 11 个，只留下 3 个
        VoidWarehouseData.Withdrawal second = data.withdraw(new ItemStack(Items.IRON_INGOT), NINE.multiply(BigInteger.valueOf(64)));
        check("G9 再取一次仍然是 11 个", !second.isEmpty() && second.taken() == 11);
        second.returnUnplaced(3);
        System.out.println("   [G] 只留 3 个之后：铁粒=" + data.amountOf(Items.IRON_NUGGET)
                + "，铁锭=" + data.amountOf(Items.IRON_INGOT));
        check("G10 只留 3 个时铁粒消耗 = 27（剩 73）",
                data.amountOf(Items.IRON_NUGGET).equals(BigInteger.valueOf(73)));
        check("G11 那 3 个在玩家手里，仓库里铁锭仍是 0",
                data.amountOf(Items.IRON_INGOT).signum() == 0);
        check("G12 干扰项仍然没动", data.amountOf(Items.DIRT).equals(BigInteger.valueOf(7)));
    }

