                p != null && p.asMap().size() == 1 && change(p, "iron_nugget").equals(NINE.negate()));
        checkConserved(table, "D5 9 铁粒 -> 1 铁锭", p);
        check("D6 反证：8 铁粒取 1 铁锭 无解", plan(table, "iron_ingot", 1, Map.of("iron_nugget", 8)) == null);
        check("D7 反证：90 铁粒取 11 铁锭 无解（不够 99）",
                plan(table, "iron_ingot", 11, Map.of("iron_nugget", 90)) == null);

        // ---- 拆上级找零 ----
        p = plan(table, "iron_ingot", 1, Map.of("iron_block", 1));
        System.out.println("   [D] 拆 1 铁块取 1 铁锭：" + ledger(p));
        check("D8 拆 1 铁块取 1 铁锭：铁块 −1 且找回 8 铁锭",
                p != null && change(p, "iron_block").equals(ONE.negate())
                        && change(p, "iron_ingot").equals(NINE.subtract(ONE)));
        checkConserved(table, "D8 拆铁块取铁锭", p);

        // ---- 三级链 ----
        p = plan(table, "blue_ice", 1, Map.of("ice", 81));
        System.out.println("   [D] 81 冰 -> 1 蓝冰：" + ledger(p));
        check("D9 81 冰 -> 1 蓝冰（跨两级）", p != null && change(p, "ice").equals(NINE.multiply(NINE).negate()));
        checkConserved(table, "D9 81 冰 -> 1 蓝冰", p);
        check("D10 反证：80 冰 -> 1 蓝冰 无解", plan(table, "blue_ice", 1, Map.of("ice", 80)) == null);

        // ---- 单向：只能向上 ----
        check("D11 反证：只有 1 浮冰时取冰 无解（浮冰拆不回冰）",
                plan(table, "ice", 1, Map.of("packed_ice", 1)) == null);
        p = plan(table, "packed_ice", 1, Map.of("ice", 9));
        check("D12 9 冰 -> 1 浮冰 可行", p != null);
        checkConserved(table, "D12 9 冰 -> 1 浮冰", p);

        // ---- 单向：只能向下 ----
        p = plan(table, "copper_ingot", 1, Map.of("waxed_copper_block", 1));
        System.out.println("   [D] 拆 1 涂蜡铜块取 1 铜锭：" + ledger(p));
        check("D13 拆 1 涂蜡铜块取 1 铜锭：涂蜡铜块 −1 且找回 8 铜锭",
                p != null && change(p, "waxed_copper_block").equals(ONE.negate())
                        && change(p, "copper_ingot").equals(NINE.subtract(ONE)));
        checkConserved(table, "D13 拆涂蜡铜块取铜锭", p);
        check("D14 反证：9 铜锭合不出 1 涂蜡铜块 无解",
                plan(table, "waxed_copper_block", 1, Map.of("copper_ingot", 9)) == null);

        // ---- 大数：跨两级只用原料 ----
        p = plan(table, "iron_block", 1, Map.of("iron_nugget", 81));
        System.out.println("   [D] 81 铁粒 -> 1 铁块：" + ledger(p));
        check("D15 81 铁粒 -> 1 铁块（铁粒→铁锭→铁块，跨两级只用原料）",
                p != null && p.asMap().size() == 1 && change(p, "iron_nugget").equals(BigInteger.valueOf(-81)));
        checkConserved(table, "D15 81 铁粒 -> 1 铁块", p);
        p = VoidWarehouseExchange.planMax(table, "iron_block", BigInteger.valueOf(100),
                stock(Map.of("iron_nugget", 729)));
        System.out.println("   [D] 729 铁粒最多能拿铁块：" + ledger(p));
        check("D15b 729 铁粒最多能拿 9 个铁块（729 = 9 × 81）",
                p != null && p.amount().equals(NINE));
        checkConserved(table, "D15b 729 铁粒尽力取铁块", p);

        // ---- planMax 尽力而为 ----
        p = VoidWarehouseExchange.planMax(table, "iron_ingot", BigInteger.valueOf(64),
                stock(Map.of("iron_nugget", 10)));
        check("D16 只有 10 铁粒时「最多能拿」= 1 个（不是整次失败）",
                p != null && p.amount().equals(ONE));
        checkConserved(table, "D16 尽力取", p);
        check("D17 反证：只有 8 铁粒时「最多能拿」= 无解",
                VoidWarehouseExchange.planMax(table, "iron_ingot", BigInteger.valueOf(64),
                        stock(Map.of("iron_nugget", 8))) == null);

        // ---- 计划本身是只读的 ----
        Map<String, Integer> frozen = new LinkedHashMap<>();
        frozen.put("iron_nugget", 90);
        VoidWarehouseExchange.Plan readOnly = plan(table, "iron_ingot", 3, frozen);
        check("D18 规划是只读的（调用方给的快照没被改）",
                readOnly != null && frozen.size() == 1 && frozen.get("iron_nugget") == 90);
        VoidWarehouseExchange.Plan negated = readOnly == null ? null : readOnly.negate();
        check("D19 Plan.negate() 把每一笔都反号",
                negated != null && change(negated, "iron_nugget").equals(change(readOnly, "iron_nugget").negate()));
    }

    // ================================================================ E fuzz

    private static void fuzzChecks() {
        System.out.println("=== E 随机库存 fuzz：任何成功规划都必须守恒 ===");
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.Table.of(VoidWarehouseExchange.EDGES);
        List<String> items = new ArrayList<>(table.items());
        Random rng = new Random(20261014L);

        int tried = 0;
        int succeeded = 0;
        int broken = 0;
        for (int iter = 0; iter < 150; iter++) {
            VoidWarehouseExchange.Edge edge = VoidWarehouseExchange.EDGES.get(
                    rng.nextInt(VoidWarehouseExchange.EDGES.size()));
            boolean upward = rng.nextBoolean();
            String target = upward ? edge.big() : edge.small();
            String source = upward ? edge.small() : edge.big();

            Map<String, Integer> snap = new LinkedHashMap<>();
            snap.put(source, rng.nextInt(400));
            int noise = rng.nextInt(3);
            for (int k = 0; k < noise; k++) {
                snap.merge(items.get(rng.nextInt(items.size())), rng.nextInt(50), Integer::sum);
            }

            BigInteger limit = BigInteger.valueOf(1 + rng.nextInt(64));
            tried++;
            VoidWarehouseExchange.Plan p = VoidWarehouseExchange.planMax(table, target, limit, stock(snap));
            if (p == null) {
                continue;
            }
            succeeded++;
            if (!conserved(table, p)) {
                broken++;
                System.out.println("   !! 不守恒: target=" + target + " limit=" + limit
                        + " stock=" + snap + " plan=" + ledger(p));
            }
        }
        System.out.println("   [E] 试了 " + tried + " 次，成功 " + succeeded + " 次，不守恒 " + broken + " 次");
        check("E1 fuzz 全部守恒（成功 " + succeeded + " / 不守恒 " + broken + "）", broken == 0);
        check("E2 反证：fuzz 至少成功 30 次（否则上一条是空转）", succeeded >= 30);
    }

