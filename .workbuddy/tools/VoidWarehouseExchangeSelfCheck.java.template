    /** K 组每个场景的起手式：清仓库 / 清背包 / 关界面 / 开盒模式 */
    private static void prepare(VoidWarehouseData data, ServerPlayer player) {
        data.clearContent();
        player.getInventory().clearContent();
        if (player.containerMenu != player.inventoryMenu) {
            player.closeContainer();
        }
        player.containerMenu = player.inventoryMenu;
        VoidWarehouseViews.viewFor(player).setShulkerMode(true);
    }

    private static int findRealSlot(VoidWarehousePageContainer container, Item item) {
        for (int slot = 0; slot < VoidWarehouseData.PAGE_SIZE; slot++) {
            VoidWarehouseData.DisplaySlot target = container.slotAt(slot);
            if (target.entry() != null && target.entry().template().getItem() == item) {
                return slot;
            }
        }
        return -1;
    }

    private static ItemStack findInInventory(ServerPlayer player, Item item) {
        for (int i = 0; i < player.getInventory().getContainerSize(); i++) {
            ItemStack stack = player.getInventory().getItem(i);
            if (!stack.isEmpty() && stack.getItem() == item) {
                return stack;
            }
        }
        return ItemStack.EMPTY;
    }

    /** 数一个潜影盒里某种物品一共有多少个（空盒子返回 0） */
    private static long countInside(ItemStack box, Item item) {
        if (box.isEmpty()) {
            return 0L;
        }
        long total = 0L;
        for (ItemStack inside : VoidWarehouseShulker.contentsOf(box)) {
            if (inside.getItem() == item) {
                total += inside.getCount();
            }
        }
        return total;
    }

