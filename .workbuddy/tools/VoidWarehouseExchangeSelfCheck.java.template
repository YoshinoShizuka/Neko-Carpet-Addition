            check("F31 盒模式操作行写的是<b>实际装进去的 9 个</b>，不是容量 1728",
                    boxLine != null && boxLine.contains("9 个") && !boxLine.contains("1728"));
        }

        // ---- F32~F35：上界算法本身的直接单测（不走界面，只喂快照）----
        VoidWarehouseExchange.Table familyTable = VoidWarehouseExchange.Table.of(VoidWarehouseExchange.EDGES);
        check("F32 maxObtainable：族外物品的库存一件都不算"
                        + "（仓库里 9999 个圆石，对铁族可兑数量毫无帮助）",
