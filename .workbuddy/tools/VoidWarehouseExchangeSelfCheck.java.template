    // ================================================================ I 规则关闭

    private static void ruleOffChecks(MinecraftServer server) {
        System.out.println("=== I 规则关闭：可兑格必须立刻消失（会咬住缓存没作废）===");
        VoidWarehouseData data = VoidWarehouse.data(server);
        reset(data, 90);

        // 先让缓存被热起来（这一步是关键：没热过的缓存测不出「关规则后没作废」）
        int warmOffers = data.exchangeOfferCount();
        int warmDisplay = data.displayCount();
        check("I1 规则开着时可兑条目 > 0（缓存被热起来）", warmOffers > 0);
        check("I2 规则开着时展示格数 > 真实格数", warmDisplay > data.entryCount());

        VoidWarehouseSettings.voidWarehouseExchange = false;
        try {
            check("I3 关规则后 exchangeEnabled() 为 false", !VoidWarehouseData.exchangeEnabled());
            check("I4 关规则后可兑条目立刻为空（缓存作废了）", data.exchangeOffers().isEmpty());
            check("I5 关规则后展示格数 == 真实格数（幽灵格没了）",
                    data.displayCount() == data.entryCount());
            check("I6 关规则后规划返回 null",
                    data.planExchange(new ItemStack(Items.IRON_INGOT), ONE) == null);
            check("I7 关规则后 withdraw 不会再兑换（只扣成品）",
                    data.withdraw(new ItemStack(Items.IRON_INGOT), ONE).isEmpty());
            check("I8 关规则后仓库一个字节都没动",
                    data.amountOf(Items.IRON_NUGGET).equals(BigInteger.valueOf(90)));
        } finally {
            VoidWarehouseSettings.voidWarehouseExchange = true;
        }

        check("I9 反证：规则开回来后可兑条目又回来了", data.exchangeOfferCount() > 0);
        VoidWarehouseSettings.voidWarehouse = false;
        try {
            check("I10 主开关关掉时 exchangeEnabled() 为 false", !VoidWarehouseData.exchangeEnabled());
            check("I11 主开关关掉时可兑条目为空", data.exchangeOffers().isEmpty());
        } finally {
            VoidWarehouseSettings.voidWarehouse = true;
        }
        check("I12 规则全部开回来", VoidWarehouseData.exchangeEnabled());
    }

    // ================================================================ J 漏斗出料

    private static void placeHopper(MinecraftServer server) {
        ServerLevel level = server.overworld();
        hopperPos = new BlockPos(HOPPER_X, HOPPER_Y, HOPPER_Z);
        level.setChunkForced(HOPPER_X >> 4, HOPPER_Z >> 4, true);
        // 注意：上方【不】放工作台 —— 那样 voidWarehouse 的 tick 会自己调 pull，
        // 和我手动调的那一次抢料，测量就不可复现了。直接手动调 pull 即可。
        level.setBlock(hopperPos, Blocks.HOPPER.defaultBlockState()
                .setValue(HopperBlock.FACING, Direction.DOWN)
                .setValue(HopperBlock.ENABLED, true), 3);
        System.out.println("[VWX] 漏斗已放置 " + hopperPos);
    }

    private static void hopperChecks(MinecraftServer server) {
        System.out.println("=== J 漏斗出料入口 ===");
        if (hopper == null) {
            check("J0 漏斗方块实体就位", false);
            return;
        }
        check("J0 漏斗方块实体就位", true);

        VoidWarehouseData data = VoidWarehouse.data(server);
        data.clearContent();
        data.insert(new ItemStack(Items.IRON_NUGGET, 90));

        // 分类物：漏斗第 0 格放 1 个铁锭（仓库里 0 个铁锭，只有铁粒）
        hopper.setItem(0, new ItemStack(Items.IRON_INGOT, 1));
