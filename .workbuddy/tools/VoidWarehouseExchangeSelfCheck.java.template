/**
 * 【临时自检】「虚空仓库 N 合 1 兑换」这一整条新链路。验证完删掉。
 *
 * <h2>要证的东西（每组都配反证）</h2>
 * <ol>
 *   <li><b>A 静态表</b>：30 条边 + 1 条多原料配方 / 56 个物品 / 双向 20 + 只能向上 9 + 只能向下 1，价值自洽
 *       （{@code value(big) == count × value(small)}）；</li>
 *   <li><b>B 启动复核</b>：拿真实 {@code RecipeManager} 复核后一条都没被砍（说明表与 26.3 的现实一致）；</li>
 *   <li><b>C 反向核对</b>：把表里每条边<b>按它自己的比例还原成真实物品</b>（9 个摆 3×3、4 个摆 2×2），
 *       交给真实配方系统去匹配，产出的东西必须正好是边的另一端 —— 这是「模式本身对不对」的独立第二意见，
 *       不依赖采集脚本没写错；</li>
 *   <li><b>D 守恒不变量</b>（纯逻辑）：{@code Σ(每条 delta × 该物品价值) == −need × 目标物品价值}。
 *       这是「不可能刷物」的形式化判据；</li>
 *   <li><b>E 随机 fuzz</b>：随机库存 × 随机目标跑 150 次，凡是成功的规划全部必须守恒；</li>
 *   <li><b>F 数据层</b>：可兑条目入选条件、「统一展示序」与可兑条目数一致、数量次序是排列、虚拟格文案；</li>
 *   <li><b>G 回滚精确性</b>：取货失败时整个仓库逐项还原（含一条与兑换无关的干扰项）；</li>
 *   <li><b>H 四条入口一致</b>：API 直调 / 界面点格 / 打印机补货 / 聊天按量取货，扣的必须是同一笔账；</li>
 *   <li><b>I 规则关闭</b>：关掉规则后「可兑」格必须<b>立刻</b>消失（这条会咬住缓存没作废的 bug）；</li>
 *   <li><b>J 漏斗出料</b>：分类物是铁锭、仓库里只有铁粒时，漏斗真的被补上；</li>
 *   <li><b>K 潜影盒模式</b>：可兑条目在盒模式下也要「尽量装满一盒」（与真实库存格同口径），
 *       料不够时绝不多给 —— 这一组是玩家报「只给一组 64」之后补的，
 *       补它的理由就是 A~J 组一条盒模式用例都没有；</li>
 *   <li><b>Q 非 9 比例</b>：{@code 4 海晶碎片 → 1 海晶石} 端到端跑一遍（含界面右键、盒模式、反证）。
 *       A~P 全部建立在「一块 = 9 个」上，引擎里任何一处把 9 写死，用 9:1 的物品测都是绿的 ——
 *       只有 4:1 能咬住这种 bug；</li>
 *   <li><b>R 多原料配方</b>：海晶灯（5 碎片 + 4 晶体）端到端跑一遍 —— 玩家要求「只能使用原料兑换」，
 *       所以要同时证「两种原料都真扣」和「同族成品一个都不许折算」。</li>
 * </ol>
 *
 * <h2>反证组（区分「改对了」与「断言是空转」）</h2>
 * <ul>
 *   <li>有货时绝不兑换：仓里同时有 9 铁粒 + 1 铁锭，取 1 铁锭的账目必须<b>只有</b>铁锭 −1；</li>
 *   <li>单向不可逆：9 铜锭合不出 1 涂蜡铜块（断言返回 null）；浮冰拆不回冰；
 *       1 个海晶石拆不出碎片（4:1 那条边只有合成方向）；</li>
 *   <li>凑不够就整次失败：8 铁粒取 1 铁锭 = null，3 个碎片取 1 海晶石 = null；</li>
 *   <li>多原料不许折算：海晶石 / 海晶石砖再多也换不出海晶灯，只有「5 碎片 + 4 晶体」才行；</li>
 *   <li>fuzz 成功次数 ≥ 30（否则「全部守恒」是空转）。</li>
 * </ul>
 */
public final class VoidWarehouseExchangeSelfCheck {

    private static final BigInteger ONE = BigInteger.ONE;
    private static final BigInteger FOUR = BigInteger.valueOf(4);
    private static final BigInteger NINE = BigInteger.valueOf(9);

    /** 前几个 tick 先等配方表读好（配方跟着数据包重载，构造完成的那一刻不一定就绪） */
    private static final int WAIT_TICKS = 5;

    private static final int HOPPER_X = 612;
    private static final int HOPPER_Y = 133;
    private static final int HOPPER_Z = 617;

    private static boolean done = false;
    private static int stage = 0;
    private static int tickIndex = 0;
    private static int waitHopper = 0;
    private static int checks = 0;
    private static int failures = 0;

    private static BlockPos hopperPos;
    private static HopperBlockEntity hopper;

    private VoidWarehouseExchangeSelfCheck() {
    }

    public static void run(MinecraftServer server) {
        if (done) {
            return;
        }
        // 规则必须先开着，否则 exchangeEnabled() 恒为假，整组断言都在空转
        VoidWarehouseSettings.voidWarehouse = true;
        VoidWarehouseSettings.voidWarehouseExchange = true;
        try {
            step(server);
        } catch (Throwable t) {
            failures++;
            System.out.println("!! 自检抛异常: " + t);
            t.printStackTrace(System.out);
            finish(server);
        }
    }

    private static void step(MinecraftServer server) {
        switch (stage) {
            case 0:
                if (++tickIndex < WAIT_TICKS) {
                    return;
                }
                tickIndex = 0;
                break;
            case 1:
                tableChecks();
                break;
            case 2:
                bootstrapChecks(server);
                break;
            case 3:
                recipeMatchChecks(server);
                break;
            case 4:
                conservationChecks();
                break;
            case 5:
                fuzzChecks();
                break;
            case 6:
                dataLayerChecks(server);
                break;
            case 7:
                rollbackChecks(server);
                break;
            case 8:
                entryPointChecks(server);
                break;
            case 9:
                ruleOffChecks(server);
                break;
            case 10:
                placeHopper(server);
                break;
            case 11:
                hopper = asHopper(server.overworld().getBlockEntity(hopperPos));
                if (hopper == null && ++waitHopper < 300) {
                    return;
                }
                break;
            case 12:
                hopperChecks(server);
                break;
            case 13:
                boxModeChecks(server);
                break;
            case 14:
                splitRemainderChecks(server);
                break;
            case 15:
                countChecks(server);
                break;
            case 16:
                seaLanternChecks(server);
                break;
            case 17:
                cleanup(server);
                break;
            default:
                finish(server);
                return;
        }
        stage++;
    }

    // ================================================================ A 静态表

    private static void tableChecks() {
        System.out.println("=== A 静态表 ===");
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.Table.of(VoidWarehouseExchange.EDGES);

        check("A1 声明 30 条边", VoidWarehouseExchange.EDGES.size() == 30);
        check("A2 建表后生效 30 条边", table.edges().size() == 30);
        check("A3 价值自相矛盾被丢掉的边 = 0", table.dropped().isEmpty());
        check("A4 表里共 56 个物品（54 个来自单原料边 + 海晶棱镜 / 海晶灯）", table.items().size() == 56);

        int both = 0;
        int combineOnly = 0;
        int splitOnly = 0;
        for (VoidWarehouseExchange.Edge edge : table.edges()) {
            if (edge.canCombine() && edge.canSplit()) {
                both++;
            } else if (edge.canCombine()) {
                combineOnly++;
            } else {
                splitOnly++;
            }
        }
        check("A5 双向边 20 条（实际 " + both + "）", both == 20);
        check("A6 只能向上合成 9 条（实际 " + combineOnly + "）", combineOnly == 9);
        check("A7 只能向下拆分 1 条（实际 " + splitOnly + "）", splitOnly == 1);

        // 价值（不是「层级」）：value(big) == count × value(small)
        check("A8 铁锭价值 = 9 × 铁粒价值",
                table.valueOf("iron_ingot").equals(table.valueOf("iron_nugget").multiply(NINE)));
        check("A9 铁块价值 = 9 × 铁锭价值",
                table.valueOf("iron_block").equals(table.valueOf("iron_ingot").multiply(NINE)));
        check("A10 蓝冰价值 = 9 × 浮冰价值",
                table.valueOf("blue_ice").equals(table.valueOf("packed_ice").multiply(NINE)));
        check("A11 蓝冰价值 = 81 × 冰价值（三级链）",
                table.valueOf("blue_ice").equals(table.valueOf("ice").multiply(NINE).multiply(NINE)));

        check("A12 makersOf(铁锭) 含铁粒", hasMaker(table, "iron_ingot", "iron_nugget"));
        check("A13 splittersOf(铁锭) 含铁块", hasSplitter(table, "iron_ingot", "iron_block"));
        check("A14 反证：makersOf(涂蜡铜块) 为空（9 铜锭合不出涂蜡铜块）",
                table.makersOf("waxed_copper_block").isEmpty());
        check("A15 反证：splittersOf(涂蜡铜块) 为空（涂蜡铜块不可再拆）",
                table.splittersOf("waxed_copper_block").isEmpty());
        check("A16 反证：splittersOf(冰) 为空（浮冰拆不回冰）", table.splittersOf("ice").isEmpty());
        check("A17 反证：圆石不在表里", !table.contains("cobblestone"));
        check("A18 反证：泥土不在表里", !table.contains("dirt"));

        // ---- 4:1 的那一条（全表唯一的非 9 比例）----
        check("A19 海晶石价值 = 4 × 海晶碎片价值（不是 9）",
                table.valueOf("prismarine").equals(table.valueOf("prismarine_shard").multiply(FOUR)));
        check("A20 海晶石砖价值 = 9 × 海晶碎片价值",
                table.valueOf("prismarine_bricks").equals(table.valueOf("prismarine_shard").multiply(NINE)));
        check("A21 海晶石与海晶石砖同族（碎片能往两边走）",
                table.familyOf("prismarine").contains("prismarine_bricks"));
        check("A22 makersOf(海晶石) 就是碎片这一条", hasMaker(table, "prismarine", "prismarine_shard")
                && table.makersOf("prismarine").size() == 1);
        check("A23 反证：splittersOf(海晶石) 为空（原版没有「1 海晶石 → 4 碎片」）",
                table.splittersOf("prismarine").isEmpty());
        // ---- 多原料配方（海晶灯）----
        check("A24 海晶灯在表里（5 碎片 + 4 晶体 的多原料配方）", table.contains("sea_lantern"));
        check("A25 多原料配方 1 条，且没有被丢弃（" + table.droppedRecipes() + "）",
                table.recipes().size() == 1 && table.droppedRecipes().isEmpty());
        check("A26 海晶灯价值 = 5 × 碎片 + 4 × 晶体（" + table.valueOf("sea_lantern") + "）",
                table.valueOf("sea_lantern").equals(
                        table.valueOf("prismarine_shard").multiply(BigInteger.valueOf(5))
                                .add(table.valueOf("prismarine_crystals").multiply(FOUR))));
        check("A27 海晶灯与碎片同族（原料和成品算一伙的）",
                table.familyOf("sea_lantern").contains("prismarine_shard")
                        && table.familyOf("sea_lantern").contains("prismarine_crystals"));
        check("A28 反证：暗海晶石不在表里（8 碎片 + 1 黑色染料，带染色的配方不收）",
                !table.contains("dark_prismarine"));
    }

    /** {@code item} 有没有「用 {@code small} 合成」这条边 */
    private static boolean hasMaker(VoidWarehouseExchange.Table table, String item, String small) {
        for (VoidWarehouseExchange.Edge edge : table.makersOf(item)) {
            if (edge.small().equals(small)) {
                return true;
            }
        }
        return false;
    }

    /** 生效表里有没有「做出 {@code output}」的多原料配方 */
    private static boolean hasRecipe(VoidWarehouseExchange.Table table, String output) {
        return !table.recipesOf(output).isEmpty();
    }

    /** {@code item} 有没有「从 {@code big} 拆出来」这条边 */
    private static boolean hasSplitter(VoidWarehouseExchange.Table table, String item, String big) {
        for (VoidWarehouseExchange.Edge edge : table.splittersOf(item)) {
            if (edge.big().equals(big)) {
                return true;
            }
        }
        return false;
    }

    // ================================================================ B 启动复核

    private static void bootstrapChecks(MinecraftServer server) {
        System.out.println("=== B 启动复核（真实 RecipeManager）===");
        System.out.println("   [B] 本服务器的配方总数 = " + server.getRecipeManager().getRecipes().size());
        VoidWarehouseExchangeBootstrap.Summary summary = VoidWarehouseExchangeBootstrap.bootstrap(server);
        System.out.println("   [B] " + summary);

        // 基准不能死写成 29：旧版本里没有硫磺 / 浓缩硫（26.2 才加的），那一条边<b>应该</b>被砍掉。
        // 正确口径是「本版本里两边物品都存在的边有几条」，跟 Summary 对得上才叫按事实收紧。
        int declared = VoidWarehouseExchange.EDGES.size();
        int unavailable = 0;
        for (VoidWarehouseExchange.Edge edge : VoidWarehouseExchange.EDGES) {
            if (VoidWarehouseExchangeBootstrap.itemOf(edge.small()) == null
                    || VoidWarehouseExchangeBootstrap.itemOf(edge.big()) == null) {
                unavailable++;
            }
        }
        System.out.println("   [B] 声明 " + declared + " 条边，其中 " + unavailable
                + " 条的物品在本版本不存在（26.2 起才有硫磺 / 浓缩硫）");

        check("B1 声明 30 条边（表本身不随版本变）", declared == 30);
        check("B2 作废条数 == 「物品在本版本不存在」的条数（" + unavailable + "，实际 "
                + summary.dropped() + "）", summary.dropped() == unavailable);
        check("B3 kept + dropped == declared", summary.kept() + summary.dropped() == declared);
        check("B4 没有被降级成单向的（版本差异只会整条没有，不会只剩半个方向）",
                summary.downgraded() == 0);
        check("B5 诊断信息条数 == 作废条数", summary.notes().size() == summary.dropped());
        check("B6 生效表建图层级自洽（没有边被丢掉）", VoidWarehouseExchange.active().dropped().isEmpty());
        check("B7 生效表条数 == Summary.kept()",
                VoidWarehouseExchange.active().edges().size() == summary.kept());
        check("B8 反证：itemOf(不存在的物品) 返回 null（复核的判据有牙）",
                VoidWarehouseExchangeBootstrap.itemOf("definitely_not_an_item_xyz") == null);
        check("B9 反证：idOf(空气) 返回 null（空物品不算任何一件东西）",
                VoidWarehouseExchangeBootstrap.idOf(Items.AIR) == null);
        check("B10 多原料配方 1 条全部生效（" + summary.recipesKept() + " / "
                + summary.recipesDeclared() + "）",
                summary.recipesKept() == 1 && summary.recipesDeclared() == 1);
        check("B11 生效表里确实有海晶灯这条配方", hasRecipe(VoidWarehouseExchange.active(), "sea_lantern"));
    }

    // ================================================================ C 反向核对（真实配方系统）

    private static void recipeMatchChecks(MinecraftServer server) {
        System.out.println("=== C 反向核对：把每条边还原成真实物品，交给真实配方系统匹配 ===");
        ServerLevel level = server.overworld();
        int combineOk = 0;
        int combineTotal = 0;
        int splitOk = 0;
        int splitTotal = 0;
        int skipped = 0;

        for (VoidWarehouseExchange.Edge edge : VoidWarehouseExchange.EDGES) {
            Item small = VoidWarehouseExchangeBootstrap.itemOf(edge.small());
            Item big = VoidWarehouseExchangeBootstrap.itemOf(edge.big());
            if (small == null || big == null) {
                // 这个版本里没有这件物品 —— 启动复核已经把整条边砍掉了，这里跳过
                skipped++;
                continue;
            }
            if (edge.canCombine()) {
                combineTotal++;
                // 按<b>这条边自己的比例</b>铺网格：9 个 → 3×3，4 个 → 2×2，其余一行平铺
                int[] grid = gridFor(edge.count());
                if (matches(server, level, grid[0], grid[1], small, big, 1)) {
                    combineOk++;
                } else {
                    check("C " + edge.count() + "×" + edge.small() + " 能合成 1×" + edge.big(), false);
                }
            }
            if (edge.canSplit()) {
                splitTotal++;
                // 1×1 只放 1 个，产出的个数必须是这条边的比例
                if (matches(server, level, 1, 1, big, small, edge.count())) {
                    splitOk++;
                } else {
                    check("C 1×" + edge.big() + " 能拆成 " + edge.count() + "×" + edge.small(), false);
                }
            }
        }
        System.out.println("   [C] N 合 1 匹配 " + combineOk + "/" + combineTotal
                + "，1 拆 N 匹配 " + splitOk + "/" + splitTotal + "，跳过（物品缺失）" + skipped);
        check("C1 全部 " + combineTotal + " 条可用的「N 合 1」都在真实配方系统里匹配成功",
                combineOk == combineTotal);
        check("C2 全部 " + splitTotal + " 条可用的「1 拆 N」都在真实配方系统里匹配成功",
                splitOk == splitTotal);
        check("C3 因物品缺失而跳过的条数 == 启动复核作废的条数（" + skipped + "）",
                skipped == VoidWarehouseExchangeBootstrap.summary().dropped());
        check("C4 反证：随便放 9 个圆石匹配不到铁锭（匹配方法有牙）",
                !matches(server, level, 3, 3, Items.COBBLESTONE, Items.IRON_INGOT, 1));
    }

    /**
     * 「{@code count} 个同种物品」在合成网格里怎么摆：9 → 3×3、4 → 2×2，
     * 其余（2 / 3）平铺成一行。原版只有 shapeless 的 9 项、shaped 的 3×3 与 2×2 三种形态，
     * 这几个分支够用；真出现摆不下的比例，匹配会失败并报出具体是哪条边。
     */
    private static int[] gridFor(int count) {
        if (count == 9) {
            return new int[]{3, 3};
        }
        if (count == 4) {
            return new int[]{2, 2};
        }
        return new int[]{count, 1};
    }

    /** 把 {@code w×h} 个格子的输入喂给真实配方系统，看产出的东西是不是 {@code out × outCount} */
    private static boolean matches(MinecraftServer server, ServerLevel level, int w, int h,
                                   Item in, Item out, int outCount) {
        if (in == null || out == null) {
            return false;
        }
        List<ItemStack> items = new ArrayList<>(w * h);
        for (int i = 0; i < w * h; i++) {
            items.add(new ItemStack(in, 1));
        }
        CraftingInput input = CraftingInput.of(w, h, items);
        var found = server.getRecipeManager().getRecipeFor(RecipeType.CRAFTING, input, level);
        if (found.isEmpty()) {
            return false;
        }
        ItemStack result = found.get().value().assemble(input);
        return result.getCount() == outCount && result.getItem() == out;
    }

    // ================================================================ D 守恒 + 反证（纯逻辑）

    private static void conservationChecks() {
        System.out.println("=== D 纯逻辑：守恒不变量 + 反证组 ===");
        VoidWarehouseExchange.Table table = VoidWarehouseExchange.Table.of(VoidWarehouseExchange.EDGES);

        check("D1 空库存取铁锭 -> 无解", plan(table, "iron_ingot", 1, Map.of("cobblestone", 9999)) == null);

        // ---- 反证：有货时绝不兑换 ----
        VoidWarehouseExchange.Plan p = plan(table, "iron_ingot", 1,
                Map.of("iron_nugget", 9, "iron_ingot", 1));
        System.out.println("   [D] 有 9 铁粒 + 1 铁锭，取 1 铁锭 -> " + ledger(p));
        check("D2 有货时取到 1 铁锭", p != null);
        check("D3 有货时账目里只有铁锭 −1（一个铁粒都没动）",
                p != null && p.asMap().size() == 1 && change(p, "iron_ingot").equals(ONE.negate()));

        p = plan(table, "iron_ingot", 5, Map.of("iron_block", 1, "iron_ingot", 5));
        System.out.println("   [D] 铁锭刚好够 5 个（另有 1 铁块），取 5 铁锭 -> " + ledger(p));
        check("D4 成品够时也不会去拆铁块", p != null && p.asMap().size() == 1
                && change(p, "iron_ingot").equals(BigInteger.valueOf(-5)));

        // ---- 下级合成 ----
