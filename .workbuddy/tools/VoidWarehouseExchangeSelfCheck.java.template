        int moved = VoidWarehouseExtractor.pull(server.overworld(), hopper);
        int slot0 = hopper.getItem(0).getCount();
        BigInteger left = data.amountOf(Items.IRON_NUGGET);
        System.out.println("   [J] pull 补入 " + moved + " 个，漏斗第 0 格 = " + slot0
